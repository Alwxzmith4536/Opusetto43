      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Effects</string>
          <string name="Source"><![CDATA[--[[
	Effects — client-side presentation of every Sukuna technique.

	The server decides *what* happens (hitboxes, damage, cooldowns) and fires
	"FX" events to all clients. This module turns each event into R15
	animation + VFX + sounds, and plays camera cinematics for the caster.
]]

local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = script.Parent
local Config = require(Shared.Config)
local PoseAnimator = require(Shared.PoseAnimator)
local Moves = require(Shared.Moves)
local VFX = require(Shared.VFX)
local Cine = require(Shared.Cinematics)
local Sounds = require(Shared.Sounds)
local Shrine = require(Shared.Shrine)

local Effects = {}
local H = {}

local player = Players.LocalPlayer
local C = Config.Colors
local T = Config.Timing
local UP = Vector3.yAxis

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

local function rootOf(character: Instance?): BasePart?
	if typeof(character) ~= "Instance" then
		return nil
	end
	local r = (character :: Instance):FindFirstChild("HumanoidRootPart")
	if r and r:IsA("BasePart") then
		return r
	end
	return nil
end

local function alive(character: Model?): boolean
	if not character or not character.Parent then
		return false
	end
	local h = character:FindFirstChildOfClass("Humanoid")
	return h ~= nil and h.Health > 0
end

local function isMine(character: Instance?): boolean
	return character ~= nil and character == player.Character
end

local function cinematic(character: Instance?): boolean
	return Config.Cinematics and isMine(character)
end

local function cameraNear(pos: Vector3, radius: number): boolean
	local cam = Workspace.CurrentCamera
	return cam ~= nil and (cam.CFrame.Position - pos).Magnitude <= radius
end

-- Plays a move: custom uploaded animation if configured, else procedural.
local function playMove(character: Model, moveName: string)
	local custom = Config.CustomAnimations[moveName]
	if custom and custom ~= "" then
		if isMine(character) then
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
			if animator then
				local anim = Instance.new("Animation")
				anim.AnimationId = custom
				local ok, track = pcall(function()
					return animator:LoadAnimation(anim)
				end)
				if ok and track then
					track.Priority = Enum.AnimationPriority.Action4
					track:Play(0.1)
				end
			end
		end
		return
	end
	PoseAnimator.play(character, Moves[moveName])
end

local function react(character: Model, heavy: boolean?)
	local rig = PoseAnimator.getRig(character)
	if not rig then
		return
	end
	local current = rig.track and rig.track.sequence
	if current == nil or current == Moves.Flinch or current == Moves.Stagger then
		rig:play(if heavy then Moves.Stagger else Moves.Flinch)
	end
end

local function groundY(pos: Vector3): number
	local g = VFX.ground(pos, 40)
	return if g then g.Position.Y else pos.Y - 3
end

----------------------------------------------------------------------
-- Local movement (dash / knockback on your own character)
----------------------------------------------------------------------

local function makeVelocity(hrp: BasePart, velocity: Vector3): LinearVelocity
	local att = hrp:FindFirstChild("RootAttachment")
	if not att or not att:IsA("Attachment") then
		att = Instance.new("Attachment")
		att.Name = "SukunaAttachment"
		att.Parent = hrp
	end
	local lv = Instance.new("LinearVelocity")
	lv.Name = "SukunaVelocity"
	lv.Attachment0 = att :: Attachment
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.MaxForce = 1e7
	lv.VectorVelocity = velocity
	lv.Parent = hrp
	return lv
end

function Effects.dashSelf(dest: Vector3, time: number)
	local hrp = rootOf(player.Character)
	if not hrp then
		return
	end
	local flatDest = Vector3.new(dest.X, hrp.Position.Y, dest.Z)
	if (flatDest - hrp.Position).Magnitude > 0.5 then
		hrp.CFrame = CFrame.lookAt(hrp.Position, flatDest)
	end
	local lv = makeVelocity(hrp, (flatDest - hrp.Position) / time)
	VFX.addUpdater(function(_, t)
		if not lv.Parent or not hrp.Parent then
			return false
		end
		local remaining = flatDest - hrp.Position
		remaining = Vector3.new(remaining.X, 0, remaining.Z)
		if t >= time + 0.05 or remaining.Magnitude < 1 then
			lv:Destroy()
			hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
			return false
		end
		lv.VectorVelocity = remaining.Unit * math.max(remaining.Magnitude / math.max(time - t, 0.04), 30)
		return true
	end)
end

function Effects.knockSelf(velocity: Vector3, duration: number?)
	local hrp = rootOf(player.Character)
	if typeof(velocity) ~= "Vector3" or not hrp then
		return
	end
	local d = math.clamp(duration or 0.2, 0.05, 1)
	local lv = makeVelocity(hrp, velocity)
	VFX.addUpdater(function(_, t)
		if not lv.Parent then
			return false
		end
		if t >= d then
			lv:Destroy()
			return false
		end
		lv.VectorVelocity = velocity * (1 - (t / d) * 0.5)
		return true
	end)
end

----------------------------------------------------------------------
-- Transformation
----------------------------------------------------------------------

function H.Transform(d)
	local char = d.char
	local hrp = rootOf(char)
	if not hrp then
		return
	end
	local Tt = T.Transform
	local mine = isMine(char)
	playMove(char, "Transform")

	-- Cursed energy torn out of the cube into the body
	local cube = Workspace:FindFirstChild(Config.Cube.Name)
	if cube and cube:IsA("BasePart") then
		VFX.sphere(cube.Position, 4, 14, 0.6, { color = C.Curse })
		VFX.light(cube.Position, C.Curse, 6, 30, 1.4)
		task.spawn(function()
			local t0 = os.clock()
			while os.clock() - t0 < Tt.Burst - 0.15 and hrp.Parent and cube.Parent do
				VFX.lightning(cube.Position, hrp.Position + Vector3.new(0, 0.6, 0), {
					color = if math.random() < 0.7 then C.Curse else C.Black,
					thickness = 0.24,
					segments = 10,
					life = 0.12,
				})
				task.wait(0.08)
			end
		end)
	end

	VFX.gather(hrp, Tt.Burst, 10)
	local stopAura = VFX.aura(char, 0.6)
	Sounds.play("Whoosh", hrp, { pitch = 0.45, volume = 1.2 })
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < Tt.Burst and hrp.Parent do
			local p = hrp.Position + VFX.randomUnit() * VFX.rand(1.5, 3.5)
			VFX.lightning(p, p + VFX.randomUnit() * VFX.rand(2, 4), {
				color = if math.random() < 0.5 then C.Curse else C.Black,
				thickness = 0.12,
				segments = 4,
				life = 0.1,
			})
			task.wait(0.05)
		end
	end)
	local gp0 = Vector3.new(hrp.Position.X, groundY(hrp.Position), hrp.Position.Z)
	VFX.cracks(gp0, 8, 6, 5)

	if cinematic(char) then
		Cine.grade({ TintColor = Color3.fromRGB(255, 205, 205), Saturation = -0.3, Contrast = 0.25 }, 0.6)
		Cine.shots(char, {
			{ dur = 1.55, eye = { Vector3.new(-3.2, 1.6, -5.2), Vector3.new(2.6, 1.0, -4.6) }, look = { Vector3.new(0, 1.2, 0), Vector3.new(0, 1.0, 0) }, fov = { 45, 38 } },
			{ dur = 0.5, eye = { Vector3.new(0, 2.5, -16), Vector3.new(0, 2.2, -12) }, look = { Vector3.new(0, 1.5, 0) }, fov = { 82, 62 }, style = "Quart", dir = "Out" },
			{ dur = 1.5, eye = { Vector3.new(1.5, 2.2, -7), Vector3.new(0.6, 1.95, -4.2) }, look = { Vector3.new(0, 1.85, 0), Vector3.new(0, 1.8, 0) }, fov = { 55, 42 } },
			{ dur = 0.45, eye = { Vector3.new(0.6, 1.95, -4.2), Vector3.new(3, 4, 9) }, look = { Vector3.new(0, 1.6, 0) }, fov = { 42, 70 }, style = "Quad", dir = "InOut" },
		})
		task.delay(0.35, function()
			Cine.caption("...Finally. A body of my own.", 1.0)
		end)
		task.delay(Tt.Duration - 0.2, function()
			Cine.resetGrade(0.8)
		end)
	end

	task.delay(Tt.Burst, function()
		if not hrp.Parent then
			return
		end
		stopAura()
		local pos = hrp.Position
		local gp = Vector3.new(pos.X, groundY(pos), pos.Z)
		VFX.sphere(pos, 2, 36, 0.75, { color = C.Curse })
		VFX.sphere(pos, 1, 16, 0.4, { color = C.SlashCore, material = Enum.Material.Neon, transparency = 0.2 })
		VFX.ring(gp + Vector3.new(0, 0.3, 0), 2, 42, 0.85, { color = C.Curse, thickness = 1.2 })
		VFX.ring(gp + Vector3.new(0, 0.4, 0), 1, 26, 0.6, { color = C.Black, thickness = 0.8 })
		VFX.crater(gp, 9, 16, 5)
		VFX.cracks(gp, 12, 10, 5)
		VFX.debris(gp, 14, 1.1)
		VFX.light(pos, C.Curse, 8, 50, 1.2)
		VFX.sparks(pos, 40)
		VFX.smokeBurst(gp, 18, 4, C.Black)
		VFX.highlight(char, C.Curse, 1.6, 0.4)
		Sounds.play("Launch", pos, { pitch = 0.5, volume = 1.3, rolloff = 400 })
		Sounds.play("Impact", pos, { pitch = 0.6 })
		Cine.shakeAt(pos, 1.2, 0.8, 120)
		local strong = VFX.aura(char, 1.6)
		task.delay(2.2, strong)
		if mine then
			Cine.flash(Color3.fromRGB(255, 40, 50), 0.3, 0.03, 0.05, 0.5)
			task.delay(0.35, function()
				Cine.title("両面宿儺", "RYOMEN SUKUNA — KING OF CURSES", 1.8)
			end)
		end
	end)
end

----------------------------------------------------------------------
-- Combo
----------------------------------------------------------------------

local COMBO_ROLL = { -20, 25, 80, -6 }

function H.Combo(d)
	local char = d.char
	local hrp = rootOf(char)
	local i = tonumber(d.index) or 1
	if not hrp then
		return
	end
	playMove(char, "Combo" .. i)
	Sounds.play("Swing", hrp, { pitch = 1.05 + i * 0.08, volume = 0.8 })
	task.delay(T.Combo.Hit - 0.03, function()
		if not hrp.Parent then
			return
		end
		local cf = hrp.CFrame * CFrame.new(0, 0.4, -2.4)
		VFX.crescent(cf * CFrame.Angles(0, 0, math.rad(COMBO_ROLL[i] or 0)), {
			width = if i == 4 then 7 else 4.5,
			thickness = 0.35,
			life = 0.18,
			velocity = hrp.CFrame.LookVector * 22,
			core = Color3.new(1, 1, 1),
			color = C.Curse,
		})
		if i == 4 then
			VFX.sphere(cf.Position, 1, 7, 0.25, { color = C.Curse })
		end
	end)
end

----------------------------------------------------------------------
-- Generic hit reaction
----------------------------------------------------------------------

function H.Hit(d)
	local char = d.char
	local hrp = rootOf(char)
	if not hrp then
		return
	end
	local pos = hrp.Position + VFX.randomUnit() * 0.6
	local kind = d.kind or "blunt"
	if kind == "slash" then
		VFX.cutLine(pos, VFX.randomUnit(), VFX.rand(5, 8), { thickness = 0.14, life = 0.25 })
		VFX.bloodMist(pos, 8)
		VFX.sparks(pos, 12)
		Sounds.play("Slash", pos, { pitch = VFX.rand(0.9, 1.25), volume = 0.7 })
	elseif kind == "burn" then
		VFX.fireBurst(pos, 8, 1.2, 10)
		Sounds.play("Impact", pos, { pitch = 0.7, volume = 0.6 })
	else
		VFX.sphere(pos, 0.5, if d.heavy then 9 else 5, 0.22, { color = C.SlashCore, material = Enum.Material.Neon, transparency = 0.3 })
		VFX.sparks(pos, if d.heavy then 28 else 14)
		Sounds.play("Impact", pos, { pitch = VFX.rand(0.9, 1.15) })
	end
	if not d.quiet then
		VFX.highlight(char, Color3.new(1, 1, 1), 0.18, 0.2)
	end
	react(char, d.heavy)
	Cine.shakeAt(pos, if d.heavy then 0.6 else 0.25, if d.heavy then 0.3 else 0.15, 60)
end

----------------------------------------------------------------------
-- Dismantle (解)
----------------------------------------------------------------------

function H.Dismantle(d)
	local char = d.char
	if not rootOf(char) then
		return
	end
	playMove(char, "Dismantle")
	local origin: CFrame = d.origin
	local life = d.range / d.speed
	for i, t in d.times do
		task.delay(t, function()
			local tilt = d.tilts[i] or 0
			VFX.crescent(origin * CFrame.Angles(0, 0, math.rad(tilt)), {
				width = d.width,
				bulge = d.width * 0.3,
				thickness = 0.8,
				life = life,
				velocity = origin.LookVector * d.speed,
			})
			Sounds.play("Slash", origin.Position, { pitch = VFX.rand(0.7, 0.85), volume = 1.0 })
			Sounds.play("Whoosh", origin.Position, { pitch = 1.6, volume = 0.5 })
			if i == 2 then
				for k = 1, 8 do
					task.delay(life * (k - 1) / 8, function()
						local p = origin.Position + origin.LookVector * (d.range * (k - 0.5) / 8)
						VFX.groundScar(p, origin.LookVector, d.range / 8 * 0.9, 0.3, 2.5)
					end)
				end
			end
			if i == 1 and isMine(char) then
				Cine.fovPunch(5)
			end
		end)
	end
end

----------------------------------------------------------------------
-- Cleave (捌)
----------------------------------------------------------------------

function H.Cleave(d)
	local char = d.char
	local hrp = rootOf(char)
	if not hrp then
		return
	end
	playMove(char, "Cleave")
	Sounds.play("Unsheath", hrp, { pitch = 0.8 })
	Sounds.play("Swing", hrp, { pitch = 0.7 })
	local thrp = rootOf(d.target)
	if isMine(char) then
		local dest
		if thrp then
			local offset = hrp.Position - thrp.Position
			offset = Vector3.new(offset.X, 0, offset.Z)
			if offset.Magnitude < 0.1 then
				offset = -hrp.CFrame.LookVector
			end
			dest = thrp.Position + offset.Unit * 3.2
		else
			dest = hrp.Position + hrp.CFrame.LookVector * 9
		end
		Effects.dashSelf(dest, T.Cleave.Arrive)
	end
	for k = 0, 3 do
		task.delay(k * 0.05, function()
			if char.Parent then
				VFX.afterimage(char, C.Curse, 0.3)
			end
		end)
	end
end

function H.CleaveCut(d)
	local thrp = rootOf(d.target)
	if not thrp then
		return
	end
	local pos = thrp.Position + Vector3.new(VFX.rand(-0.8, 0.8), VFX.rand(-1, 1.2), VFX.rand(-0.8, 0.8))
	local dir = VFX.randomUnit()
	VFX.cutLine(pos, dir, VFX.rand(5, 7.5), { thickness = 0.12, life = 0.22 })
	VFX.cutLine(pos, dir:Cross(VFX.randomUnit()), VFX.rand(4, 6), { thickness = 0.08, life = 0.2 })
	VFX.sparks(pos, 10)
	VFX.bloodMist(pos, 6)
	Sounds.play("Slash", pos, { pitch = VFX.rand(1.0, 1.4), volume = 0.6 })
	react(d.target, d.final)
	Cine.shakeAt(pos, 0.25, 0.1, 40)
	if d.final then
		local c = thrp.Position
		local cam = Workspace.CurrentCamera
		local right = if cam then cam.CFrame.RightVector else Vector3.xAxis
		VFX.cutLine(c, (right + UP).Unit, 11, { thickness = 0.3, life = 0.45 })
		VFX.cutLine(c, (right - UP).Unit, 11, { thickness = 0.3, life = 0.45 })
		VFX.sphere(c, 1, 12, 0.35, { color = C.Curse })
		VFX.bloodMist(c, 20)
		Sounds.play("Slash", c, { pitch = 0.6, volume = 1.2 })
		Cine.shakeAt(c, 0.8, 0.35, 70)
		if isMine(d.char) then
			Cine.impactFrame(0.08)
		end
	end
end

----------------------------------------------------------------------
-- Fuga (開)
----------------------------------------------------------------------

local fugaCleanup = setmetatable({}, { __mode = "k" })

function H.Fuga(d)
	local char = d.char
	local hrp = rootOf(char)
	if not hrp then
		return
	end
	local Tf = T.Fuga
	playMove(char, "Fuga")
	Sounds.play("Whoosh", hrp, { pitch = 0.6, volume = 1.1 })

	local rhand = char:FindFirstChild("RightHand")
	local lhand = char:FindFirstChild("LeftHand")
	local pieces = {}
	local function cleanup()
		for _, p in pieces do
			if typeof(p) == "Instance" then
				p:Destroy()
			end
		end
		table.clear(pieces)
	end
	fugaCleanup[char] = cleanup
	task.delay(Tf.Release + 0.6, cleanup)

	-- Flame gathering in the right palm
	if rhand and rhand:IsA("BasePart") then
		local flame = VFX.emitter(rhand, {
			Texture = VFX.Textures.Fire,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, C.FireHot),
				ColorSequenceKeypoint.new(0.5, C.Fire),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(140, 10, 0)),
			}),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) }),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) }),
			Lifetime = NumberRange.new(0.25, 0.5),
			Speed = NumberRange.new(1, 3),
			Acceleration = Vector3.new(0, 10, 0),
			Rate = 90,
			RotSpeed = NumberRange.new(-180, 180),
			Rotation = NumberRange.new(0, 360),
			Enabled = true,
		})
		local light = Instance.new("PointLight")
		light.Color = C.Fire
		light.Range = 12
		light.Brightness = 3
		light.Parent = rhand
		table.insert(pieces, flame)
		table.insert(pieces, light)
	end

	-- The fire bow + arrow form between the hands
	task.delay(1.0, function()
		if not (rhand and lhand and rhand:IsA("BasePart") and lhand:IsA("BasePart")) or fugaCleanup[char] ~= cleanup then
			return
		end
		local shaft = VFX.part({ Size = Vector3.new(0.35, 0.35, 4), Color = C.FireHot })
		local shaftGlow = VFX.part({ Size = Vector3.new(1, 1, 4.4), Color = C.Fire, Material = Enum.Material.ForceField })
		local top = VFX.attachmentAt(lhand.Position)
		local bottom = VFX.attachmentAt(lhand.Position)
		local bow = Instance.new("Beam")
		bow.Attachment0 = top
		bow.Attachment1 = bottom
		bow.Width0 = 0.5
		bow.Width1 = 0.5
		bow.Segments = 20
		bow.FaceCamera = true
		bow.LightEmission = 1
		bow.LightInfluence = 0
		bow.Brightness = 4
		bow.Color = ColorSequence.new(C.FireHot, C.Fire)
		bow.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.6),
			NumberSequenceKeypoint.new(0.5, 0),
			NumberSequenceKeypoint.new(1, 0.6),
		})
		bow.CurveSize0 = 1.6
		bow.CurveSize1 = 1.6
		bow.Parent = top
		for _, p in { shaft, shaftGlow, top, bottom } do
			table.insert(pieces, p)
		end
		Sounds.play("Unsheath", lhand, { pitch = 0.6 })
		VFX.fireBurst(lhand.Position, 14, 0.8, 8)
		VFX.addUpdater(function()
			if not shaft.Parent or not lhand.Parent or not rhand.Parent then
				return false
			end
			local axis = lhand.Position - rhand.Position
			if axis.Magnitude < 0.2 then
				axis = hrp.CFrame.LookVector
			end
			axis = axis.Unit
			local tail = rhand.Position
			local tip = lhand.Position + axis * 1.6
			local len = (tip - tail).Magnitude
			local mid = (tip + tail) / 2
			shaft.Size = Vector3.new(0.35, 0.35, len)
			shaft.CFrame = CFrame.lookAt(mid, tip)
			shaftGlow.Size = Vector3.new(1, 1, len * 1.08)
			shaftGlow.CFrame = shaft.CFrame
			local side = axis:Cross(UP)
			if side.Magnitude < 0.1 then
				side = Vector3.xAxis
			end
			local up = side.Unit:Cross(axis).Unit
			local center = lhand.Position
			top.WorldCFrame = CFrame.fromMatrix(center + up * 2.6 - axis * 0.9, axis, up)
			bottom.WorldCFrame = CFrame.fromMatrix(center - up * 2.6 - axis * 0.9, -axis, up)
			return true
		end)
	end)

	if cinematic(char) then
		Cine.shots(char, {
			{ dur = 0.95, eye = { Vector3.new(2.2, 1.6, -3.4), Vector3.new(1.6, 1.3, -2.8) }, look = { Vector3.new(0.6, 0.6, -0.8) }, fov = { 50, 42 } },
			{ dur = 0.6, eye = { Vector3.new(1.7, 2.1, 4.8), Vector3.new(1.5, 2.0, 4.3) }, look = { Vector3.new(0, 1.2, -25) }, fov = { 60, 52 } },
			{ dur = 0.45, eye = { Vector3.new(1.4, 1.9, 4.2), Vector3.new(1.1, 1.8, 3.4) }, look = { Vector3.new(0, 1.2, -30) }, fov = { 52, 40 }, style = "Quart", dir = "In" },
			{ dur = 0.5, eye = { Vector3.new(1.1, 1.8, 3.4), Vector3.new(2.5, 3.5, 9) }, look = { Vector3.new(0, 1.2, -30) }, fov = { 40, 70 }, style = "Quad", dir = "Out" },
		})
		task.delay(0.15, function()
			Cine.title("開", "FUGA", 0.9)
		end)
		task.delay(1.0, function()
			Cine.caption("「開」 — Furnace, Open.", 0.9)
		end)
	end
end

function Effects.fugaExplosion(pos: Vector3, radius: number)
	local gy = groundY(pos)
	local gp = Vector3.new(pos.X, math.min(gy, pos.Y), pos.Z)
	VFX.light(pos, C.Fire, 10, radius * 3, 1.6)
	VFX.sphere(pos, 2, radius * 2.2, 0.9, { color = C.Fire, material = Enum.Material.Neon, transparency = 0.05, style = "Quint" })
	VFX.sphere(pos, 2, radius * 1.3, 0.6, { color = C.FireHot, material = Enum.Material.Neon })
	VFX.sphere(pos, radius, radius * 3.2, 1.0, { color = C.Fire })

	local pillar = VFX.part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(4, radius * 0.8, radius * 0.8),
		CFrame = CFrame.new(gp + Vector3.new(0, 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = C.Fire,
		Transparency = 0.1,
	})
	VFX.tween(pillar, 1.2, {
		Size = Vector3.new(90, radius * 0.4, radius * 0.4),
		CFrame = CFrame.new(gp + Vector3.new(0, 45, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Transparency = 1,
	}, "Quart", "Out")
	Debris:AddItem(pillar, 1.3)

	VFX.ring(gp + Vector3.new(0, 0.5, 0), 2, radius * 2.4, 1.0, { color = C.Fire, thickness = 2 })
	VFX.ring(gp + Vector3.new(0, 0.6, 0), 1, radius * 1.6, 0.8, { color = C.FireHot, thickness = 1 })
	VFX.fireBurst(pos, 60, 4, 45)
	VFX.smokeBurst(gp, 30, 6)
	VFX.sparks(pos, 50, C.Fire)
	VFX.crater(gp, radius * 0.55, 18, 6)
	VFX.debris(gp, 22, 1.4, 1.3)

	local boom = Instance.new("Explosion")
	boom.Position = pos
	boom.BlastPressure = 0
	boom.BlastRadius = 0
	boom.DestroyJointRadiusPercent = 0
	boom.ExplosionType = Enum.ExplosionType.NoCraters
	boom.Visible = false
	boom.Parent = Workspace

	Sounds.play("Launch", pos, { pitch = 0.35, volume = 1.5, rolloff = 600 })
	Sounds.play("Impact", pos, { pitch = 0.4, volume = 1.5, rolloff = 600 })
	Cine.shakeAt(pos, 2.0, 1.1, radius * 9)
	if cameraNear(pos, radius * 5) then
		Cine.flash(Color3.fromRGB(255, 170, 80), 0.35, 0.03, 0.05, 0.6)
	end

	-- Lingering flames
	local burn = Config.Abilities.Fuga.BurnDuration
	local holder = VFX.part({
		Size = Vector3.new(radius * 1.1, 1, radius * 1.1),
		CFrame = CFrame.new(gp + Vector3.new(0, 0.5, 0)),
		Transparency = 1,
	})
	local flames = VFX.emitter(holder, {
		Texture = VFX.Textures.Fire,
		Color = ColorSequence.new(C.FireHot, C.Fire),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) }),
		Lifetime = NumberRange.new(0.6, 1.2),
		Speed = NumberRange.new(2, 6),
		Acceleration = Vector3.new(0, 10, 0),
		Rate = 80,
		Rotation = NumberRange.new(0, 360),
		Enabled = true,
	})
	local glow = Instance.new("PointLight")
	glow.Color = C.Fire
	glow.Range = radius * 1.5
	glow.Brightness = 2
	glow.Parent = holder
	task.delay(burn, function()
		flames.Enabled = false
		VFX.tween(glow, 1, { Brightness = 0 })
	end)
	Debris:AddItem(holder, burn + 1.5)
end

function H.FugaRelease(d)
	local origin: Vector3 = d.origin
	local hitPos: Vector3 = d.hitPos
	local travel = math.max(tonumber(d.travel) or 0.1, 0.05)
	local cleanup = d.char and fugaCleanup[d.char]
	if cleanup then
		cleanup()
	end
	Sounds.play("Launch", origin, { pitch = 0.8, volume = 1.2 })
	if d.char and rootOf(d.char) then
		VFX.fireBurst(origin, 20, 1.2, 18)
	end

	local dir = hitPos - origin
	dir = if dir.Magnitude > 0.01 then dir.Unit else Vector3.new(0, 0, -1)
	local arrow = VFX.part({ Size = Vector3.new(0.6, 0.6, 5), CFrame = CFrame.lookAt(origin, origin + dir), Color = C.FireHot })
	local glow = VFX.part({ Size = Vector3.new(1.8, 1.8, 7), CFrame = arrow.CFrame, Color = C.Fire, Material = Enum.Material.ForceField })
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0.5, 0, 0)
	a0.Parent = arrow
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(-0.5, 0, 0)
	a1.Parent = arrow
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.35
	trail.LightEmission = 1
	trail.LightInfluence = 0
	trail.FaceCamera = true
	trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 0) })
	trail.Color = ColorSequence.new(C.FireHot, C.Fire)
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	trail.Parent = arrow
	VFX.emitter(arrow, {
		Texture = VFX.Textures.Fire,
		Color = ColorSequence.new(C.FireHot, C.Fire),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.8), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) }),
		Lifetime = NumberRange.new(0.25, 0.45),
		Speed = NumberRange.new(1, 3),
		Rate = 220,
		Rotation = NumberRange.new(0, 360),
		Enabled = true,
	})
	local light = Instance.new("PointLight")
	light.Color = C.Fire
	light.Range = 22
	light.Brightness = 4
	light.Parent = arrow

	VFX.addUpdater(function(_, t)
		local a = math.clamp(t / travel, 0, 1)
		local p = origin:Lerp(hitPos, a)
		local cf = CFrame.lookAt(p, p + dir)
		arrow.CFrame = cf
		glow.CFrame = cf
		if a >= 1 then
			arrow:Destroy()
			glow:Destroy()
			Effects.fugaExplosion(hitPos, d.radius or 26)
			return false
		end
		return true
	end)
end

----------------------------------------------------------------------
-- Domain Expansion: Malevolent Shrine
----------------------------------------------------------------------

local domainCount = 0
local savedLighting = nil

function Effects.domainLighting(on: boolean)
	if on then
		domainCount += 1
		if domainCount > 1 then
			return
		end
		savedLighting = {
			Ambient = Lighting.Ambient,
			OutdoorAmbient = Lighting.OutdoorAmbient,
			Brightness = Lighting.Brightness,
			ClockTime = Lighting.ClockTime,
			ExposureCompensation = Lighting.ExposureCompensation,
			FogColor = Lighting.FogColor,
			FogEnd = Lighting.FogEnd,
			FogStart = Lighting.FogStart,
		}
		local atm = Lighting:FindFirstChildOfClass("Atmosphere")
		if atm then
			savedLighting.atm = atm
			savedLighting.atmProps = {
				Density = atm.Density,
				Color = atm.Color,
				Decay = atm.Decay,
				Haze = atm.Haze,
				Glare = atm.Glare,
			}
			VFX.tween(atm, 0.4, {
				Density = 0.45,
				Color = Color3.fromRGB(150, 20, 25),
				Decay = Color3.fromRGB(90, 0, 10),
				Haze = 2.6,
				Glare = 0.4,
			})
		end
		VFX.tween(Lighting, 0.4, {
			Ambient = Color3.fromRGB(90, 10, 15),
			OutdoorAmbient = Color3.fromRGB(120, 25, 30),
			Brightness = 1.4,
			ClockTime = 18.3,
			ExposureCompensation = -0.2,
			FogColor = Color3.fromRGB(70, 0, 5),
			FogEnd = 400,
			FogStart = 40,
		})
		Cine.grade({ TintColor = Color3.fromRGB(255, 205, 205), Saturation = 0.1, Contrast = 0.2 }, 0.4)
	else
		domainCount = math.max(domainCount - 1, 0)
		if domainCount > 0 or not savedLighting then
			return
		end
		local saved = savedLighting
		savedLighting = nil
		if saved.atm and saved.atm.Parent then
			VFX.tween(saved.atm, 1.2, saved.atmProps)
		end
		VFX.tween(Lighting, 1.2, {
			Ambient = saved.Ambient,
			OutdoorAmbient = saved.OutdoorAmbient,
			Brightness = saved.Brightness,
			ClockTime = saved.ClockTime,
			ExposureCompensation = saved.ExposureCompensation,
			FogColor = saved.FogColor,
			FogEnd = saved.FogEnd,
			FogStart = saved.FogStart,
		})
		Cine.resetGrade(1.2)
	end
end

local function spawnDomainSlash(center: Vector3, gy: number, radius: number)
	local r = radius * math.sqrt(math.random())
	local ang = math.random() * math.pi * 2
	local p = Vector3.new(center.X + math.cos(ang) * r, gy + VFX.rand(0.8, 10), center.Z + math.sin(ang) * r)
	if math.random() < 0.6 then
		local dir = Vector3.new(VFX.rand(-1, 1), VFX.rand(-0.6, 0.6), VFX.rand(-1, 1))
		if dir.Magnitude < 0.1 then
			dir = Vector3.xAxis
		end
		VFX.cutLine(p, dir, VFX.rand(6, 15), { thickness = VFX.rand(0.08, 0.2), life = VFX.rand(0.18, 0.3) })
	else
		local cf = CFrame.new(p) * CFrame.Angles(VFX.rand(-0.6, 0.6), VFX.rand(0, 6.28), VFX.rand(-1.2, 1.2))
		VFX.crescent(cf, { width = VFX.rand(5, 11), thickness = 0.5, life = 0.25, velocity = cf.LookVector * VFX.rand(20, 50) })
	end
	if math.random() < 0.25 then
		VFX.groundScar(Vector3.new(p.X, gy + 1, p.Z), VFX.randomUnit(), VFX.rand(3, 8), 0.25, 2)
	end
end

function H.Domain(d)
	local char = d.char
	local hrp = rootOf(char)
	if not hrp then
		return
	end
	local Td = T.Domain
	local center: Vector3 = d.center
	local look: Vector3 = d.look
	local radius: number = d.radius
	local gy: number = d.ground or groundY(center)
	local inRange = function()
		return cameraNear(center, radius * 2.2)
	end

	playMove(char, "Domain")
	local stopAura = VFX.aura(char, 1.2)
	task.delay(Td.Expand + 0.8, stopAura)
	Sounds.play("Whoosh", hrp, { pitch = 0.35, volume = 1.4 })
	VFX.gather(hrp, Td.Expand, 12)

	if cinematic(char) then
		Cine.shots(char, {
			{ dur = 1.25, eye = { Vector3.new(0.4, 0.8, -3.6), Vector3.new(0.2, 0.75, -2.9) }, look = { Vector3.new(0, 0.6, -0.6) }, fov = { 42, 36 } },
			{ dur = 1.2, eye = { Vector3.new(-1.2, 1.0, -3.4), Vector3.new(-0.6, 1.3, -2.7) }, look = { Vector3.new(0, 1.65, 0) }, fov = { 46, 34 } },
			{ dur = 1.7, eye = { Vector3.new(14, 6, -22), Vector3.new(22, 14, -34) }, look = { Vector3.new(0, 12, 22), Vector3.new(0, 14, 24) }, fov = { 65, 72 }, style = "Quad", dir = "Out" },
			{ dur = 0.6, eye = { Vector3.new(22, 14, -34), Vector3.new(4, 5, 12) }, look = { Vector3.new(0, 14, 24), Vector3.new(0, 2, -6) }, fov = { 72, 70 } },
		})
		task.delay(0.25, function()
			Cine.title("領域展開", "DOMAIN EXPANSION", 1.0)
		end)
		task.delay(1.4, function()
			Cine.title("伏魔御厨子", "MALEVOLENT SHRINE", 1.2)
		end)
	end

	-- The world blinks to black just before the shrine appears.
	task.delay(Td.Expand - 0.35, function()
		if inRange() and alive(char) then
			Cine.flash(Color3.new(0, 0, 0), 0, 0.12, 0.25, 0.45)
		end
	end)

	task.delay(Td.Expand, function()
		if not alive(char) then
			return
		end
		local shrinePos = Vector3.new(center.X, gy, center.Z) - look * 30
		local shrineCF = CFrame.lookAt(shrinePos, shrinePos + look)
		local model, height = Shrine.build(shrineCF)
		model:PivotTo(shrineCF * CFrame.new(0, -height - 2, 0))
		model.Parent = VFX.folder()

		local pool = VFX.part({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, 4, 4),
			CFrame = CFrame.new(center.X, gy + 0.06, center.Z) * CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromRGB(85, 0, 6),
			Material = Enum.Material.SmoothPlastic,
			Reflectance = 0.25,
			Transparency = 0.05,
		})
		VFX.tween(pool, 1.3, { Size = Vector3.new(0.3, radius * 2, radius * 2) }, "Quart", "Out")

		local lit = inRange()
		if lit then
			Effects.domainLighting(true)
		end
		Sounds.play("Launch", shrinePos, { pitch = 0.3, volume = 1.6, rolloff = 500 })
		Sounds.play("Whoosh", shrinePos, { pitch = 0.25, volume = 1.4, rolloff = 500 })
		Cine.shakeAt(center, 1.4, 1.4, radius * 2.5)
		local gp = Vector3.new(center.X, gy, center.Z)
		VFX.ring(gp + Vector3.new(0, 0.3, 0), 4, radius, 1.2, { color = C.Curse, thickness = 1.5 })
		VFX.smokeBurst(shrinePos, 30, 8, C.Black)
		VFX.debris(shrinePos, 20, 1.6, 1.5)
		VFX.cracks(gp, 14, 14, 7)

		local collapsed = false
		local function collapse()
			if collapsed then
				return
			end
			collapsed = true
			local fromCF = model:GetPivot()
			VFX.addUpdater(function(_, t)
				local a = math.clamp(t / 1.0, 0, 1)
				if model.Parent then
					model:PivotTo(fromCF * CFrame.new(0, -(height + 2) * a * a, 0))
				end
				if a >= 1 then
					model:Destroy()
					return false
				end
				return true
			end)
			VFX.tween(pool, 1, { Size = Vector3.new(0.3, 4, 4), Transparency = 1 }, "Quad", "In")
			Debris:AddItem(pool, 1.1)
			VFX.smokeBurst(shrinePos, 20, 8, C.Black)
			if lit then
				Effects.domainLighting(false)
			end
		end

		-- Shrine rises out of the ground
		VFX.addUpdater(function(_, t)
			if collapsed or not model.Parent then
				return false
			end
			local a = math.clamp(t / 1.3, 0, 1)
			local e = 1 - (1 - a) ^ 4
			local jitter = (1 - a) * 0.4
			model:PivotTo(shrineCF * CFrame.new(VFX.rand(-jitter, jitter), -(height + 2) * (1 - e), VFX.rand(-jitter, jitter)))
			return a < 1
		end)

		-- Lifecycle + endless slashing
		local stormStart = Td.SlashStart - Td.Expand
		local stormEnd = Td.SlashEnd - Td.Expand
		local collapseAt = Td.Collapse - Td.Expand
		local acc, soundAcc = 0, 0
		VFX.addUpdater(function(dt, t)
			if collapsed then
				return false
			end
			if t >= collapseAt or not alive(char) then
				collapse()
				return false
			end
			if t >= stormStart and t < stormEnd then
				acc += dt * 20
				while acc >= 1 do
					acc -= 1
					spawnDomainSlash(center, gy, radius)
				end
				soundAcc += dt
				if soundAcc >= 0.11 then
					soundAcc = 0
					local cam = Workspace.CurrentCamera
					if cam and inRange() then
						local p = cam.CFrame.Position + VFX.randomUnit() * 10
						Sounds.play("Slash", p, { pitch = VFX.rand(0.8, 1.5), volume = 0.45 })
					end
				end
				if cameraNear(center, radius) then
					Cine.shake(0.22, 0.15)
				end
			end
			return true
		end)
	end)
end

function H.DomainHits(d)
	if type(d.targets) ~= "table" then
		return
	end
	for i, char in d.targets do
		local hrp = rootOf(char)
		if hrp then
			local pos = hrp.Position + VFX.randomUnit()
			VFX.cutLine(pos, VFX.randomUnit(), VFX.rand(4, 7), { thickness = 0.12, life = 0.2 })
			VFX.bloodMist(pos, 4)
			react(char, false)
			if i == 1 then
				Sounds.play("Slash", pos, { pitch = VFX.rand(1, 1.3), volume = 0.6 })
			end
		end
	end
end

----------------------------------------------------------------------
-- World Cutting Slash
----------------------------------------------------------------------

function Effects.worldRift(origin: CFrame, length: number, height: number, mine: boolean)
	local look = Vector3.new(origin.LookVector.X, 0, origin.LookVector.Z).Unit
	local right = look:Cross(UP).Unit
	local gy = groundY(origin.Position)
	local base = Vector3.new(origin.Position.X, gy, origin.Position.Z)
	local h = height * 0.5
	local lift = Vector3.new(0, h / 2 - 2, 0)
	local center = base + look * (length / 2 + 2) + lift
	local cf = CFrame.fromMatrix(center, right, UP)

	-- 1) A white line races out across the world
	local line = VFX.part({ Size = Vector3.new(0.15, h, 0.2), CFrame = CFrame.fromMatrix(base + look * 2 + lift, right, UP), Color = C.SlashCore })
	VFX.addUpdater(function(_, t)
		if not line.Parent then
			return false
		end
		local a = math.clamp(t / 0.12, 0, 1)
		local L = math.max(length * a, 0.2)
		line.Size = Vector3.new(0.15, h, L)
		line.CFrame = CFrame.fromMatrix(base + look * (2 + L / 2) + lift, right, UP)
		return a < 1
	end)
	if mine then
		Cine.impactFrame(0.12)
	end
	if cameraNear(center, length) then
		Cine.flash(Color3.new(1, 1, 1), 0.2, 0.02, 0.06, 0.5)
	end
	Sounds.play("Slash", origin.Position, { pitch = 0.35, volume = 2, rolloff = 800 })
	Sounds.play("Launch", origin.Position, { pitch = 0.45, volume = 1.4, rolloff = 800 })
	Cine.shakeAt(center, 2.2, 1.2, length * 1.2)

	-- 2) Space itself splits open
	task.delay(0.14, function()
		VFX.tween(line, 0.3, { Transparency = 1 })
		Debris:AddItem(line, 0.35)
		local rift = VFX.part({ Size = Vector3.new(0.2, h, length), CFrame = cf, Color = C.Black, Material = Enum.Material.SmoothPlastic })
		local edgeL = VFX.part({ Size = Vector3.new(0.14, h, length), CFrame = cf * CFrame.new(-0.25, 0, 0), Color = C.SlashCore })
		local edgeR = VFX.part({ Size = Vector3.new(0.14, h, length), CFrame = cf * CFrame.new(0.25, 0, 0), Color = C.SlashCore })
		local glow = VFX.part({ Size = Vector3.new(3, h * 1.02, length * 1.01), CFrame = cf, Color = C.SlashGlow, Material = Enum.Material.ForceField, Transparency = 0.3 })
		VFX.tween(rift, 0.35, { Size = Vector3.new(2.2, h, length) }, "Quint", "Out")
		VFX.tween(edgeL, 0.35, { CFrame = cf * CFrame.new(-1.2, 0, 0) }, "Quint", "Out")
		VFX.tween(edgeR, 0.35, { CFrame = cf * CFrame.new(1.2, 0, 0) }, "Quint", "Out")
		task.delay(1.5, function()
			for _, p in { rift, edgeL, edgeR, glow } do
				VFX.tween(p, 0.9, { Transparency = 1 }, "Quad", "In")
				Debris:AddItem(p, 1)
			end
		end)

		-- Ground fissure + rocks thrown up along the cut
		local fissureCF = CFrame.fromMatrix(base + look * (length / 2 + 2) + Vector3.new(0, 0.05, 0), right, UP)
		local fissure = VFX.part({ Size = Vector3.new(2.6, 0.1, length), CFrame = fissureCF, Color = C.Black, Material = Enum.Material.SmoothPlastic })
		local ember = VFX.part({ Size = Vector3.new(0.6, 0.12, length), CFrame = fissureCF, Color = C.Curse })
		task.delay(5, function()
			VFX.tween(fissure, 1.5, { Transparency = 1 })
			VFX.tween(ember, 1.5, { Transparency = 1 })
		end)
		Debris:AddItem(fissure, 6.6)
		Debris:AddItem(ember, 6.6)
		for k = 1, 10 do
			task.delay(k * 0.02, function()
				local p = base + look * (length * k / 11)
				VFX.debris(p, 4, 1.2)
				VFX.smokeBurst(p, 4, 4)
			end)
		end
		for k = 1, 16 do
			local along = base + look * (length * k / 17)
			for _, side in { -1, 1 } do
				local at = along + right * side * VFX.rand(2.2, 3.4)
				local s = VFX.rand(1.6, 3)
				local final = CFrame.lookAt(at, at + right * side) * CFrame.Angles(math.rad(VFX.rand(30, 55)), 0, 0)
				local rock = VFX.part({
					Size = Vector3.new(s, s * 0.6, s * 1.2),
					CFrame = final - Vector3.new(0, s, 0),
					Color = Color3.fromRGB(60, 54, 52),
					Material = Enum.Material.Slate,
				})
				VFX.tween(rock, 0.2, { CFrame = final }, "Back", "Out")
				task.delay(5, function()
					VFX.tween(rock, 1, { CFrame = final - Vector3.new(0, s * 1.5, 0), Transparency = 1 }, "Quad", "In")
				end)
				Debris:AddItem(rock, 6.1)
			end
		end
	end)
end

function H.WorldSlash(d)
	local char = d.char
	local hrp = rootOf(char)
	if not hrp then
		return
	end
	local Tw = T.WorldSlash
	local mine = isMine(char)
	playMove(char, "WorldSlash")
	local stopAura = VFX.aura(char, 1.0)
	task.delay(Tw.Slash + 0.6, stopAura)
	Sounds.play("Whoosh", hrp, { pitch = 0.4, volume = 1.2 })

	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < Tw.Slash and hrp.Parent do
			local rh = char:FindFirstChild("RightHand")
			if rh and rh:IsA("BasePart") then
				local p = rh.Position
				VFX.lightning(p, p + VFX.randomUnit() * VFX.rand(1.5, 3), {
					thickness = 0.08,
					segments = 4,
					life = 0.08,
					color = if math.random() < 0.5 then C.SlashCore else C.Curse,
				})
			end
			task.wait(0.06)
		end
	end)

	if cinematic(char) then
		Cine.grade({ Saturation = -0.4, Contrast = 0.3, TintColor = Color3.fromRGB(255, 225, 225) }, 0.8)
		Cine.shots(char, {
			{ dur = 2.15, eye = { Vector3.new(1.2, 1.9, -4.2), Vector3.new(0.5, 1.8, -3.0) }, look = { Vector3.new(0.2, 1.7, 0) }, fov = { 48, 34 } },
			{ dur = 0.35, eye = { Vector3.new(9, 3, 4), Vector3.new(10, 3.5, 5) }, look = { Vector3.new(0, 3, -12) }, fov = { 60, 64 } },
			{ dur = 1.1, eye = { Vector3.new(26, 18, -10), Vector3.new(34, 26, -30) }, look = { Vector3.new(0, 5, -60), Vector3.new(0, 4, -110) }, fov = { 70, 75 }, style = "Quad", dir = "Out" },
		})
		task.delay(0.2, function()
			Cine.caption("竜鱗 — Dragon Scale", 0.55)
		end)
		task.delay(0.8, function()
			Cine.caption("反発 — Recoil", 0.55)
		end)
		task.delay(1.4, function()
			Cine.caption("番いの流星 — Twin Meteors", 0.6)
		end)
		task.delay(Tw.Slash + 0.05, function()
			Cine.title("世界を断つ斬撃", "WORLD CUTTING SLASH", 1.1)
		end)
		task.delay(Tw.Duration, function()
			Cine.resetGrade(0.8)
		end)
	end

	task.delay(Tw.Slash, function()
		Effects.worldRift(d.origin, d.length, d.height, mine)
	end)
end

----------------------------------------------------------------------
-- Dispatcher
----------------------------------------------------------------------

function Effects.handle(name: string, data)
	local handler = H[name]
	if not handler or type(data) ~= "table" then
		return
	end
	task.spawn(function()
		local ok, err = pcall(handler, data)
		if not ok then
			warn("[SukunaFX] " .. tostring(name) .. ": " .. tostring(err))
		end
	end)
end

return Effects
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Moves</string>
          <string name="Source"><![CDATA[--[[
	Moves — keyframed R15 pose sequences for every Sukuna technique.

	Joint angle convention (degrees, applied in YXZ order on the joint):
	  Shoulders  x+ raise arm forward (90 = straight ahead, 180 = up)
	             z+ raise RIGHT arm out to the side, z- raise LEFT arm out
	             y+ swing a raised arm toward the character's left
	  Elbows     x+ bend the forearm forward / inward
	  Waist/Root x+ lean back, x- bow forward, y+ twist left, z+ tilt left
	  Neck       x+ look up, x- look down, y+ turn left
	  Hips       x+ leg forward, z+ right leg out / z- left leg out
	  Knees      x- bend
	  crouch     solves hips/knees/ankles + root drop with feet planted
	  shake      trembling intensity (degrees) — cursed energy surging
]]

local Moves = {}

local rad = math.rad

local function A(x: number?, y: number?, z: number?): CFrame
	return CFrame.fromEulerAnglesYXZ(rad(x or 0), rad(y or 0), rad(z or 0))
end

local function AP(x: number?, y: number?, z: number?, px: number?, py: number?, pz: number?): CFrame
	return CFrame.new(px or 0, py or 0, pz or 0) * A(x, y, z)
end

local Style = Enum.EasingStyle
local Dir = Enum.EasingDirection

local function K(t: number, pose, style: string?, dir: string?)
	return {
		t = t,
		pose = pose,
		style = Style[style or "Sine"],
		dir = Dir[dir or "InOut"],
	}
end

-- Shallow-merge pose tables (later tables override earlier ones).
local function with(...)
	local out = {}
	for i = 1, select("#", ...) do
		local t = select(i, ...)
		for k, v in t do
			out[k] = v
		end
	end
	return out
end

local relaxed = {
	RightShoulder = A(4, 0, 9),
	LeftShoulder = A(4, 0, -9),
	RightElbow = A(14),
	LeftElbow = A(14),
}

----------------------------------------------------------------------
-- Transformation: clutch head → struggle → cursed energy burst → laugh
----------------------------------------------------------------------
do
	local hunch = {
		Waist = A(-38, 0, 0),
		Neck = A(-26, 0, 0),
		RightShoulder = A(140, 0, 25),
		LeftShoulder = A(140, 0, -25),
		RightElbow = A(122),
		LeftElbow = A(122),
		RightWrist = A(-20),
		LeftWrist = A(-20),
		crouch = 30,
		shake = 2.5,
	}
	local struggle = with(hunch, {
		Waist = A(-30, 9, -7),
		Neck = A(-18, 12, 9),
		RightShoulder = A(132, 0, 34),
		LeftShoulder = A(146, 0, -20),
		crouch = 36,
		shake = 5.5,
	})
	local burst = {
		Root = AP(0, 0, 0, 0, 0.15, 0),
		Waist = A(22, 0, 0),
		Neck = A(32, 0, 0),
		RightShoulder = A(0, 20, 115),
		LeftShoulder = A(0, -20, -115),
		RightElbow = A(25),
		LeftElbow = A(25),
		RightWrist = A(0, 0, 15),
		LeftWrist = A(0, 0, -15),
		RightHip = A(0, 0, 8),
		LeftHip = A(0, 0, -8),
		crouch = 6,
		shake = 1.4,
	}
	local laughUp = with(burst, { Neck = A(40, 0, 0), Waist = A(27, 0, 0), shake = 1.0 })
	local laughDown = with(burst, { Neck = A(24, 0, 0), Waist = A(17, 0, 0), shake = 1.0 })
	local stance = with(relaxed, {
		Waist = A(-4, 12, 0),
		Neck = A(-7, -12, 0),
		crouch = 4,
	})

	Moves.Transform = {
		duration = 3.9,
		blendOut = 0.45,
		keys = {
			K(0.3, hunch, "Quad", "Out"),
			K(1.25, struggle, "Sine", "InOut"),
			K(1.6, burst, "Back", "Out"),
			K(1.95, laughUp),
			K(2.2, laughDown),
			K(2.45, laughUp),
			K(2.7, laughDown),
			K(2.95, laughUp),
			K(3.5, stance, "Quad", "InOut"),
		},
	}
end

----------------------------------------------------------------------
-- Combo: jab → hook → uppercut → roundhouse kick
----------------------------------------------------------------------
do
	local jabWind = {
		Waist = A(0, -18, 0),
		Neck = A(0, 15, 0),
		RightShoulder = A(55, 0, 10),
		RightElbow = A(110),
		LeftShoulder = A(60, 0, -10),
		LeftElbow = A(115),
		crouch = 12,
	}
	local jab = {
		Waist = A(-6, 28, 0),
		Neck = A(0, -24, 0),
		RightShoulder = A(92, 8, 0),
		RightElbow = A(4),
		LeftShoulder = A(55, 0, -15),
		LeftElbow = A(120),
		RightHip = A(10),
		LeftHip = A(-8),
		crouch = 14,
	}
	Moves.Combo1 = {
		duration = 0.36,
		blendOut = 0.22,
		keys = { K(0.07, jabWind, "Quad", "Out"), K(0.14, jab, "Quint", "Out"), K(0.3, jab) },
	}

	local hookWind = {
		Waist = A(0, 22, 0),
		Neck = A(0, -18, 0),
		LeftShoulder = A(0, 12, -78),
		LeftElbow = A(70),
		RightShoulder = A(60, 0, 10),
		RightElbow = A(115),
		crouch = 14,
	}
	local hook = {
		Waist = A(-5, -32, 0),
		Neck = A(0, 28, 0),
		LeftShoulder = A(0, -62, -85),
		LeftElbow = A(88),
		RightShoulder = A(50, 0, 15),
		RightElbow = A(120),
		LeftHip = A(10),
		RightHip = A(-8),
		crouch = 16,
	}
	Moves.Combo2 = {
		duration = 0.38,
		blendOut = 0.22,
		keys = { K(0.08, hookWind, "Quad", "Out"), K(0.16, hook, "Quint", "Out"), K(0.32, hook) },
	}

	local upWind = {
		Waist = A(-18, -14, 0),
		Neck = A(8, 10, 0),
		RightShoulder = A(15, 0, 15),
		RightElbow = A(115),
		LeftShoulder = A(60, 0, -15),
		LeftElbow = A(110),
		crouch = 28,
	}
	local upper = {
		Root = AP(0, 0, 0, 0, 0.25, 0),
		Waist = A(14, 22, 0),
		Neck = A(18, -15, 0),
		RightShoulder = A(155, 10, 0),
		RightElbow = A(55),
		LeftShoulder = A(40, 0, -25),
		LeftElbow = A(100),
		crouch = 2,
	}
	Moves.Combo3 = {
		duration = 0.4,
		blendOut = 0.25,
		keys = { K(0.09, upWind, "Quad", "Out"), K(0.18, upper, "Back", "Out"), K(0.34, upper) },
	}

	local kickWind = {
		Root = A(0, -22, 0),
		Waist = A(-6, -8, 0),
		Neck = A(0, 20, 0),
		RightShoulder = A(20, 0, 40),
		RightElbow = A(40),
		LeftShoulder = A(30, 0, -50),
		LeftElbow = A(60),
		RightHip = A(-25, 0, 10),
		RightKnee = A(-50),
		crouch = 10,
	}
	local kick = {
		Root = A(0, 50, 14),
		Waist = A(0, -12, 8),
		Neck = A(0, -38, -10),
		RightHip = A(10, 0, 82),
		RightKnee = A(-12),
		LeftHip = A(0, 0, -6),
		LeftKnee = A(-20),
		LeftShoulder = A(10, 0, -80),
		LeftElbow = A(35),
		RightShoulder = A(15, 0, 55),
		RightElbow = A(60),
		crouch = 6,
	}
	Moves.Combo4 = {
		duration = 0.48,
		blendOut = 0.3,
		keys = { K(0.09, kickWind, "Quad", "Out"), K(0.19, kick, "Back", "Out"), K(0.38, kick) },
	}
end

----------------------------------------------------------------------
-- Dismantle (解): three casual flicks, each launches a flying slash
----------------------------------------------------------------------
do
	local left = { LeftShoulder = A(8, 0, -12), LeftElbow = A(20) }
	local wind = with(left, {
		Waist = A(0, 32, 0),
		Neck = A(-4, -28, 0),
		RightShoulder = A(90, 75, 0),
		RightElbow = A(35),
		RightWrist = A(0, 0, -20),
		crouch = 8,
	})
	local slash1 = with(left, {
		Waist = A(-4, -28, 0),
		Neck = A(-4, 24, 0),
		RightShoulder = A(88, -65, 0),
		RightElbow = A(5),
		RightWrist = A(0, 0, 15),
		crouch = 10,
	})
	local slash2 = with(left, {
		Waist = A(-4, 14, 0),
		Neck = A(-4, -12, 0),
		RightShoulder = A(104, 35, 0),
		RightElbow = A(22),
		crouch = 10,
	})
	local slash3 = with(left, {
		Waist = A(-6, -24, 0),
		Neck = A(-4, 20, 0),
		RightShoulder = A(80, -50, 0),
		RightElbow = A(4),
		crouch = 12,
	})
	Moves.Dismantle = {
		duration = 0.85,
		blendOut = 0.3,
		keys = {
			K(0.16, wind, "Quad", "Out"),
			K(0.28, slash1, "Quint", "Out"),
			K(0.44, slash2, "Quint", "Out"),
			K(0.6, slash3, "Quint", "Out"),
			K(0.75, slash3),
		},
	}
end

----------------------------------------------------------------------
-- Cleave (捌): dash in, palm on the target, rapid adaptive cuts, sweep out
----------------------------------------------------------------------
do
	local dash = {
		Root = A(-18, 0, 0),
		Waist = A(-10, 0, 0),
		Neck = A(12, 0, 0),
		RightShoulder = A(-35, 0, 10),
		RightElbow = A(25),
		LeftShoulder = A(-30, 0, -10),
		LeftElbow = A(25),
		crouch = 18,
	}
	local reach = {
		Root = A(-6, 0, 0),
		Waist = A(-8, 25, 0),
		Neck = A(0, -22, 0),
		RightShoulder = A(92, -6, 0),
		RightElbow = A(8),
		RightWrist = A(-25),
		LeftShoulder = A(15, 0, -20),
		LeftElbow = A(30),
		RightHip = A(25),
		RightKnee = A(-20),
		LeftHip = A(-20),
		crouch = 14,
	}
	local hold = with(reach, { shake = 1.8 })
	local sweep = {
		Waist = A(-4, -35, 0),
		Neck = A(0, 25, 0),
		RightShoulder = A(85, -75, 0),
		RightElbow = A(5),
		LeftShoulder = A(10, 0, -25),
		LeftElbow = A(20),
		crouch = 10,
	}
	Moves.Cleave = {
		duration = 1.15,
		blendOut = 0.3,
		keys = {
			K(0.08, dash, "Quad", "Out"),
			K(0.22, reach, "Back", "Out"),
			K(0.85, hold),
			K(0.98, sweep, "Quint", "Out"),
			K(1.1, sweep),
		},
	}
end

----------------------------------------------------------------------
-- Fuga (開): flame in the palm → draw the fire bow → release
----------------------------------------------------------------------
do
	local legs = {
		LeftHip = A(22, 0, -8),
		LeftKnee = A(-18),
		RightHip = A(-18, 0, 8),
		RightKnee = A(-12),
	}
	local open = {
		Waist = A(-4, -10, 0),
		Neck = A(-14, 8, 0),
		RightShoulder = A(55, 30, 0),
		RightElbow = A(95),
		RightWrist = A(-30),
		LeftShoulder = A(10, 0, -15),
		LeftElbow = A(20),
		crouch = 10,
	}
	local gaze = with(open, { Neck = A(-20, 10, 0), shake = 1.0 })
	local draw = with(legs, {
		Waist = A(0, -22, 0),
		Neck = A(0, 22, 0),
		LeftShoulder = A(90, 22, 0),
		LeftElbow = A(0),
		LeftWrist = A(10),
		RightShoulder = A(0, -35, 88),
		RightElbow = A(125),
		crouch = 16,
	})
	local tension = with(draw, { RightShoulder = A(0, -46, 88), shake = 1.6 })
	local release = with(legs, {
		Root = A(5, 0, 0),
		Waist = A(6, -30, 0),
		Neck = A(4, 26, 0),
		LeftShoulder = A(90, 22, 0),
		LeftElbow = A(0),
		RightShoulder = A(0, -72, 80),
		RightElbow = A(25),
		crouch = 14,
	})
	Moves.Fuga = {
		duration = 2.3,
		blendOut = 0.4,
		keys = {
			K(0.3, open, "Quad", "Out"),
			K(0.75, gaze),
			K(1.05, draw, "Back", "Out"),
			K(1.5, tension),
			K(1.6, release, "Quint", "Out"),
			K(2.15, release),
		},
	}
end

----------------------------------------------------------------------
-- Domain Expansion: Malevolent Shrine — hand sign, then arms spread
----------------------------------------------------------------------
do
	local sign = {
		Waist = A(-3, 0, 0),
		Neck = A(-8, 0, 0),
		RightShoulder = A(62, 45, 0),
		RightElbow = A(100),
		RightWrist = A(0, -25, 0),
		LeftShoulder = A(62, -45, 0),
		LeftElbow = A(100),
		LeftWrist = A(0, 25, 0),
		crouch = 6,
	}
	local sign2 = with(sign, { Neck = A(-2, 0, 0), shake = 1.4 })
	local reveal = {
		Waist = A(10, 0, 0),
		Neck = A(14, 0, 0),
		RightShoulder = A(0, 18, 72),
		LeftShoulder = A(0, -18, -72),
		RightElbow = A(30),
		LeftElbow = A(30),
		crouch = 0,
		shake = 0.6,
	}
	local stance = with(relaxed, { Waist = A(-2, 8, 0), Neck = A(-8, -8, 0) })
	Moves.Domain = {
		duration = 4.4,
		blendOut = 0.4,
		keys = {
			K(0.35, sign, "Quad", "Out"),
			K(2.2, sign2),
			K(2.6, reveal, "Back", "Out"),
			K(3.8, reveal),
			K(4.3, stance),
		},
	}
end

----------------------------------------------------------------------
-- World Cutting Slash: chant with raised hand → overhead → cleave down
----------------------------------------------------------------------
do
	local chant = {
		Waist = A(-4, 0, 0),
		Neck = A(-6, 0, 0),
		RightShoulder = A(118, 22, 0),
		RightElbow = A(75),
		LeftShoulder = A(55, -35, 0),
		LeftElbow = A(105),
		crouch = 8,
	}
	local chant2 = with(chant, { shake = 2.2 })
	local raise = {
		Root = AP(0, 0, 0, 0, 0.2, 0),
		Waist = A(14, 0, 0),
		Neck = A(12, 0, 0),
		RightShoulder = A(172, 0, 8),
		RightElbow = A(2),
		LeftShoulder = A(35, 0, -30),
		LeftElbow = A(40),
		crouch = 4,
	}
	local slash = {
		Waist = A(-32, 0, 0),
		Neck = A(-6, 0, 0),
		RightShoulder = A(72, -8, 0),
		RightElbow = A(5),
		LeftShoulder = A(-25, 0, -25),
		LeftElbow = A(20),
		RightHip = A(-15),
		LeftHip = A(28),
		LeftKnee = A(-25),
		crouch = 26,
	}
	Moves.WorldSlash = {
		duration = 3.6,
		blendOut = 0.45,
		keys = {
			K(0.35, chant, "Quad", "Out"),
			K(1.9, chant2),
			K(2.2, raise, "Back", "Out"),
			K(2.35, slash, "Quint", "Out"),
			K(3.2, slash),
		},
	}
end

----------------------------------------------------------------------
-- Hit reactions (played on whoever gets hit)
----------------------------------------------------------------------
do
	local flinch = {
		Waist = A(16, 0, 0),
		Neck = A(18, 0, 0),
		RightShoulder = A(25, 0, 20),
		LeftShoulder = A(25, 0, -20),
		RightElbow = A(40),
		LeftElbow = A(40),
		crouch = 8,
	}
	Moves.Flinch = {
		duration = 0.16,
		blendOut = 0.22,
		keys = { K(0.06, flinch, "Quad", "Out") },
	}

	local stagger = {
		Root = A(-10, 0, 0),
		Waist = A(28, 0, 6),
		Neck = A(30, 0, 0),
		RightShoulder = A(40, 0, 50),
		LeftShoulder = A(40, 0, -50),
		RightElbow = A(30),
		LeftElbow = A(30),
		crouch = 14,
	}
	Moves.Stagger = {
		duration = 0.45,
		blendOut = 0.35,
		keys = { K(0.08, stagger, "Back", "Out"), K(0.4, stagger) },
	}
end

return Moves
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">PoseAnimator</string>
          <string name="Source"><![CDATA[--[[
	PoseAnimator — procedural keyframe animation for R15 characters.

	Works without uploading any animation assets: each client offsets the R15
	Motor6D.C0 joints toward keyframed poses (with easing, blending, crouch
	solving and "power shake"). The player's normal R15 animations keep running
	underneath, so the moves blend in and out of idle/walk naturally.

	Every client animates every character locally, so all players see the
	moves smoothly (C0 changes are never sent over the network).
]]

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local PoseAnimator = {}

-- Motor6D name -> the body part it lives in (standard R15 rig).
local JOINTS = {
	Root = "LowerTorso",
	Waist = "UpperTorso",
	Neck = "Head",
	LeftShoulder = "LeftUpperArm",
	LeftElbow = "LeftLowerArm",
	LeftWrist = "LeftHand",
	RightShoulder = "RightUpperArm",
	RightElbow = "RightLowerArm",
	RightWrist = "RightHand",
	LeftHip = "LeftUpperLeg",
	LeftKnee = "LeftLowerLeg",
	LeftAnkle = "LeftFoot",
	RightHip = "RightUpperLeg",
	RightKnee = "RightLowerLeg",
	RightAnkle = "RightFoot",
}
PoseAnimator.Joints = JOINTS

local IDENTITY = CFrame.identity
local SIDES = { "Left", "Right" }

local rigs = setmetatable({}, { __mode = "k" })
local playing = {}
local connection: RBXScriptConnection? = nil

local function ease(alpha: number, style: Enum.EasingStyle?, direction: Enum.EasingDirection?): number
	if alpha <= 0 then
		return 0
	elseif alpha >= 1 then
		return 1
	end
	return TweenService:GetValue(alpha, style or Enum.EasingStyle.Sine, direction or Enum.EasingDirection.InOut)
end

local Rig = {}
Rig.__index = Rig

function Rig:isValid(): boolean
	if not self.character.Parent then
		return false
	end
	for _, motor in self.motors do
		if not motor.Parent then
			return false
		end
	end
	return true
end

function Rig:refreshBase()
	for name, motor in self.motors do
		self.base[name] = motor.C0
	end
	self:measureLegs()
	table.clear(self.cache)
end

function Rig:measureLegs()
	local hip, knee, ankle = self.motors.LeftHip, self.motors.LeftKnee, self.motors.LeftAnkle
	if hip and knee then
		self.thigh = math.clamp((hip.C1.Position - knee.C0.Position).Magnitude, 0.3, 5)
	end
	if knee and ankle then
		self.shin = math.clamp((knee.C1.Position - ankle.C0.Position).Magnitude, 0.3, 5)
	end
end

-- Converts a pose description into joint offsets for this specific rig.
-- Supports `crouch` (degrees): bends hips/knees/ankles and lowers the root
-- so the feet stay planted, using this avatar's real leg lengths.
function Rig:resolve(pose)
	local cached = self.cache[pose]
	if cached then
		return cached
	end
	local out = {}
	for key, value in pose do
		if typeof(value) == "CFrame" then
			out[key] = value
		end
	end
	local crouch = pose.crouch
	if crouch and crouch ~= 0 then
		local a = math.rad(crouch)
		local drop = (self.thigh + self.shin) * (1 - math.cos(a))
		out.Root = CFrame.new(0, -drop, 0) * (out.Root or IDENTITY)
		for _, side in SIDES do
			out[side .. "Hip"] = (out[side .. "Hip"] or IDENTITY) * CFrame.Angles(a, 0, 0)
			out[side .. "Knee"] = (out[side .. "Knee"] or IDENTITY) * CFrame.Angles(-2 * a, 0, 0)
			out[side .. "Ankle"] = (out[side .. "Ankle"] or IDENTITY) * CFrame.Angles(a, 0, 0)
		end
	end
	self.cache[pose] = out
	return out
end

function Rig:sample(track, t: number)
	local keys = track.sequence.keys
	local first = keys[1]
	local fromPose, toPose, alpha, fromShake, toShake

	if t < first.t then
		fromPose = track.from
		toPose = self:resolve(first.pose)
		alpha = ease(t / first.t, first.style, first.dir)
		fromShake = track.fromShake
		toShake = first.pose.shake or 0
	else
		local k0, k1 = keys[#keys], nil
		for i = 1, #keys - 1 do
			if t < keys[i + 1].t then
				k0, k1 = keys[i], keys[i + 1]
				break
			end
		end
		fromPose = self:resolve(k0.pose)
		fromShake = k0.pose.shake or 0
		if k1 then
			toPose = self:resolve(k1.pose)
			toShake = k1.pose.shake or 0
			alpha = ease((t - k0.t) / (k1.t - k0.t), k1.style, k1.dir)
		else
			toPose = fromPose
			toShake = fromShake
			alpha = 1
		end
	end

	local out = {}
	for name in self.motors do
		local a = fromPose[name]
		local b = toPose[name]
		if a or b then
			out[name] = (a or IDENTITY):Lerp(b or IDENTITY, alpha)
		end
	end
	local shakeAlpha = math.clamp(alpha, 0, 1)
	return out, fromShake + (toShake - fromShake) * shakeAlpha
end

function Rig:apply(offsets, shake: number, t: number)
	if shake > 0.01 then
		local s = self.seed
		local r = math.rad(shake) * 2
		local n1 = math.noise(t * 17.3, s, 0.5)
		local n2 = math.noise(s, t * 19.1, 1.5)
		local n3 = math.noise(t * 15.7, 2.5, s)
		offsets.Waist = (offsets.Waist or IDENTITY) * CFrame.Angles(n1 * r, n2 * r, n3 * r * 0.6)
		offsets.Neck = (offsets.Neck or IDENTITY) * CFrame.Angles(n2 * r * 0.8, n3 * r, n1 * r * 0.5)
		offsets.RightShoulder = (offsets.RightShoulder or IDENTITY) * CFrame.Angles(n3 * r * 0.5, 0, n1 * r * 0.5)
		offsets.LeftShoulder = (offsets.LeftShoulder or IDENTITY) * CFrame.Angles(n1 * r * 0.5, 0, n2 * r * 0.5)
	end
	for name, motor in self.motors do
		local offset = offsets[name]
		if offset then
			motor.C0 = self.base[name] * offset
		elseif self.current[name] then
			motor.C0 = self.base[name]
		end
	end
	self.current = offsets
end

function Rig:restore()
	for name, motor in self.motors do
		if motor.Parent then
			motor.C0 = self.base[name]
		end
	end
	self.current = {}
end

-- Returns false once the track has fully blended out.
function Rig:step(now: number): boolean
	local track = self.track
	local sequence = track.sequence
	local t = (now - track.start) * track.speed
	local duration = track.cutoff or sequence.duration
	local offsets, shake

	if t < duration then
		offsets, shake = self:sample(track, t)
		track.last = table.clone(offsets)
		track.lastShake = shake
	else
		local blend = track.blendOut or sequence.blendOut or 0.3
		local a = if blend > 0 then (t - duration) / blend else 1
		if a >= 1 then
			self:restore()
			self.track = nil
			return false
		end
		a = ease(a, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		offsets = {}
		for name, cf in track.last or {} do
			offsets[name] = cf:Lerp(IDENTITY, a)
		end
		shake = (track.lastShake or 0) * (1 - a)
	end

	self:apply(offsets, shake, t)
	return true
end

function Rig:play(sequence, options)
	options = options or {}
	if not self.track and next(self.current) == nil then
		self:refreshBase()
	end
	local track = {
		sequence = sequence,
		start = os.clock(),
		speed = options.speed or 1,
		from = table.clone(self.current),
		fromShake = 0,
		last = nil,
		lastShake = 0,
		cutoff = nil,
		blendOut = nil,
	}
	if self.track then
		track.fromShake = self.track.lastShake or 0
	end
	self.track = track
	playing[self] = true
	PoseAnimator._ensureLoop()
	return track
end

-- Ends the current move early, blending back to normal animation.
function Rig:stop(fade: number?)
	local track = self.track
	if not track then
		return
	end
	local t = (os.clock() - track.start) * track.speed
	track.cutoff = math.min(t, track.cutoff or track.sequence.duration)
	track.blendOut = fade or 0.2
end

function Rig:isPlaying(sequence): boolean
	return self.track ~= nil and (sequence == nil or self.track.sequence == sequence)
end

local function onStep()
	local now = os.clock()
	for rig in playing do
		if rig.track and rig:isValid() then
			local ok, alive = pcall(rig.step, rig, now)
			if not ok or not alive then
				if not ok then
					warn("[PoseAnimator]", alive)
					rig:restore()
					rig.track = nil
				end
				playing[rig] = nil
			end
		else
			rig.track = nil
			playing[rig] = nil
		end
	end
	if next(playing) == nil and connection then
		connection:Disconnect()
		connection = nil
	end
end

function PoseAnimator._ensureLoop()
	if not connection then
		connection = RunService.PreRender:Connect(onStep)
	end
end

-- Returns the rig controller for an R15 character (or nil for R6 / broken rigs).
function PoseAnimator.getRig(character: Model?)
	if not character then
		return nil
	end
	local existing = rigs[character]
	if existing then
		if existing:isValid() then
			return existing
		end
		rigs[character] = nil
		playing[existing] = nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R15 then
		return nil
	end
	local motors, base = {}, {}
	for jointName, partName in JOINTS do
		local part = character:FindFirstChild(partName)
		local motor = part and part:FindFirstChild(jointName)
		if motor and motor:IsA("Motor6D") then
			motors[jointName] = motor
			base[jointName] = motor.C0
		end
	end
	if not motors.Root or not motors.Waist then
		return nil
	end
	local rig = setmetatable({
		character = character,
		humanoid = humanoid,
		motors = motors,
		base = base,
		current = {},
		track = nil,
		cache = {},
		thigh = 1,
		shin = 1,
		seed = math.random() * 1000,
	}, Rig)
	rig:measureLegs()
	rigs[character] = rig
	return rig
end

-- Convenience: play a sequence on a character. Returns the track or nil.
function PoseAnimator.play(character: Model?, sequence, options)
	if not sequence then
		return nil
	end
	local rig = PoseAnimator.getRig(character)
	if not rig then
		return nil
	end
	return rig:play(sequence, options)
end

function PoseAnimator.stop(character: Model?, fade: number?)
	local rig = character and rigs[character]
	if rig then
		rig:stop(fade)
	end
end

return PoseAnimator
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Shrine</string>
          <string name="Source"><![CDATA[--[[
	Shrine — builds Sukuna's Malevolent Shrine (伏魔御厨子) out of parts:
	stone base, red lacquer pillars, a fanged maw glowing from within,
	two tiers of temple roofs, horns on the ridge, lanterns and piles of skulls.

	Local space: origin = ground centre, -Z = the front of the shrine.
]]

local Shrine = {}

local COL = {
	stone = Color3.fromRGB(44, 38, 40),
	stoneDark = Color3.fromRGB(28, 24, 26),
	wood = Color3.fromRGB(56, 20, 18),
	lacquer = Color3.fromRGB(125, 16, 20),
	roof = Color3.fromRGB(24, 20, 22),
	trim = Color3.fromRGB(165, 122, 62),
	bone = Color3.fromRGB(228, 216, 192),
	flesh = Color3.fromRGB(96, 24, 30),
	maw = Color3.fromRGB(80, 0, 4),
	black = Color3.fromRGB(10, 6, 6),
}

local M = Enum.Material

function Shrine.build(origin: CFrame, scale: number?)
	local s = scale or 1
	local rng = Random.new()
	local model = Instance.new("Model")
	model.Name = "MalevolentShrine"

	local function P(size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, className: string?)
		local p = Instance.new(className or "Part") :: BasePart
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Size = size * s
		p.CFrame = origin * (CFrame.new(cf.Position * s) * cf.Rotation)
		p.Color = color
		p.Material = material or M.SmoothPlastic
		p.Parent = model
		return p
	end

	local function cylinder(a: Vector3, b: Vector3, d: number, color: Color3, material: Enum.Material?)
		local mid = (a + b) / 2
		local len = (b - a).Magnitude
		local p = P(Vector3.new(len, d, d), CFrame.lookAt(mid, b) * CFrame.Angles(0, math.pi / 2, 0), color, material)
		p.Shape = Enum.PartType.Cylinder
		return p
	end

	local function ball(pos: Vector3, d: number, color: Color3, material: Enum.Material?)
		local p = P(Vector3.one * d, CFrame.new(pos), color, material)
		p.Shape = Enum.PartType.Ball
		return p
	end

	local VERTICAL = CFrame.Angles(0, 0, math.pi / 2)

	------------------------------------------------------------------
	-- Stone base + stairs
	------------------------------------------------------------------
	local base = P(Vector3.new(46, 2, 36), CFrame.new(0, 1, 0), COL.stoneDark, M.Slate)
	P(Vector3.new(40, 2, 30), CFrame.new(0, 3, 0), COL.stone, M.Slate)
	P(Vector3.new(34, 1.4, 24), CFrame.new(0, 4.7, 0), COL.wood, M.WoodPlanks)
	P(Vector3.new(12, 0.7, 2), CFrame.new(0, 0.35, -19), COL.stone, M.Slate)
	P(Vector3.new(12, 1, 2), CFrame.new(0, 2.5, -16), COL.stone, M.Slate)
	P(Vector3.new(12, 0.7, 2), CFrame.new(0, 4.35, -13), COL.stone, M.Slate)

	------------------------------------------------------------------
	-- Pillars and walls
	------------------------------------------------------------------
	for _, x in { -14, -6, 6, 14 } do
		for _, z in { -10, 10 } do
			local pillar = P(Vector3.new(15, 1.8, 1.8), CFrame.new(x, 12.9, z) * VERTICAL, COL.lacquer, M.SmoothPlastic)
			pillar.Shape = Enum.PartType.Cylinder
			P(Vector3.new(2.6, 0.8, 2.6), CFrame.new(x, 5.8, z), COL.stone, M.Slate)
			P(Vector3.new(2.6, 0.6, 2.6), CFrame.new(x, 20.1, z), COL.trim, M.Metal)
		end
	end
	P(Vector3.new(28, 15, 0.8), CFrame.new(0, 12.9, 10.4), COL.wood, M.WoodPlanks)
	P(Vector3.new(0.8, 15, 20), CFrame.new(-14.4, 12.9, 0), COL.wood, M.WoodPlanks)
	P(Vector3.new(0.8, 15, 20), CFrame.new(14.4, 12.9, 0), COL.wood, M.WoodPlanks)
	for _, x in { -10, 10 } do
		P(Vector3.new(7, 15, 0.6), CFrame.new(x, 12.9, -10.2), COL.wood, M.WoodPlanks)
		for _, y in { 8.5, 12.9, 17.3 } do
			P(Vector3.new(7.2, 0.4, 0.8), CFrame.new(x, y, -10.4), COL.lacquer)
		end
		for _, dx in { -1.8, 0, 1.8 } do
			P(Vector3.new(0.3, 14, 0.75), CFrame.new(x + dx, 12.9, -10.4), COL.stoneDark)
		end
	end
	P(Vector3.new(32, 1.2, 1.4), CFrame.new(0, 20.1, -10.2), COL.lacquer)
	P(Vector3.new(32, 1.2, 1.4), CFrame.new(0, 20.1, 10.2), COL.lacquer)

	------------------------------------------------------------------
	-- The maw: glowing throat, gums and fangs
	------------------------------------------------------------------
	local maw = P(Vector3.new(10.4, 14, 0.4), CFrame.new(0, 12.6, -8.6), COL.maw, M.Neon)
	local mawLight = Instance.new("PointLight")
	mawLight.Color = Color3.fromRGB(255, 30, 30)
	mawLight.Range = 34 * s
	mawLight.Brightness = 5
	mawLight.Parent = maw
	P(Vector3.new(11, 2.4, 1.8), CFrame.new(0, 18.8, -10.2), COL.flesh)
	P(Vector3.new(11, 1.6, 1.8), CFrame.new(0, 6.2, -10.2), COL.flesh)
	local diamond = CFrame.Angles(0, 0, math.rad(45))
	for _, x in { -4.5, -3, -1.5, 0, 1.5, 3, 4.5 } do
		local size = if math.abs(x) == 3 then 1.9 else 1.1
		P(Vector3.new(size, size, 0.7), CFrame.new(x, 17.6, -10.2) * diamond, COL.bone)
	end
	for _, x in { -3.75, -2.25, -0.75, 0.75, 2.25, 3.75 } do
		local size = if math.abs(x) == 2.25 then 1.6 else 1.0
		P(Vector3.new(size, size, 0.7), CFrame.new(x, 7.0, -10.2) * diamond, COL.bone)
	end

	------------------------------------------------------------------
	-- Lower roof (solid gable from two wedges) + eaves, rafters, upturns
	------------------------------------------------------------------
	P(Vector3.new(42, 6, 15), CFrame.new(0, 23.4, -7.5), COL.roof, M.Slate, "WedgePart")
	P(Vector3.new(42, 6, 15), CFrame.new(0, 23.4, 7.5) * CFrame.Angles(0, math.pi, 0), COL.roof, M.Slate, "WedgePart")
	P(Vector3.new(42, 0.5, 0.6), CFrame.new(0, 20.4, -15), COL.lacquer)
	P(Vector3.new(42, 0.5, 0.6), CFrame.new(0, 20.4, 15), COL.lacquer)
	P(Vector3.new(44, 1, 1), CFrame.new(0, 26.6, 0), COL.roof, M.Slate)
	for _, x in { -22.3, 22.3 } do
		P(Vector3.new(1.2, 1.4, 1.4), CFrame.new(x, 26.8, 0), COL.trim, M.Metal)
	end
	for x = -20, 20, 2.5 do
		P(Vector3.new(0.4, 0.4, 2.6), CFrame.new(x, 20.05, -13.6), COL.wood)
		P(Vector3.new(0.4, 0.4, 2.6), CFrame.new(x, 20.05, 13.6), COL.wood)
	end
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local corner = Vector3.new(21 * sx, 20.6, 15 * sz)
			P(Vector3.new(0.7, 0.7, 3.2), CFrame.lookAt(corner, corner + Vector3.new(sx, 0.9, sz)), COL.trim, M.Metal)
		end
	end

	------------------------------------------------------------------
	-- Upper hall + nameplate + upper roof
	------------------------------------------------------------------
	P(Vector3.new(18, 5, 12), CFrame.new(0, 26.6, 0), COL.wood, M.WoodPlanks)
	for _, x in { -8.6, 8.6 } do
		for _, z in { -5.6, 5.6 } do
			local post = P(Vector3.new(5, 0.9, 0.9), CFrame.new(x, 26.6, z) * VERTICAL, COL.lacquer)
			post.Shape = Enum.PartType.Cylinder
		end
	end
	P(Vector3.new(20, 0.4, 0.4), CFrame.new(0, 25, -6.6), COL.lacquer)
	local plaque = P(Vector3.new(7, 1.8, 0.3), CFrame.new(0, 26.8, -6.2), COL.black)
	local surface = Instance.new("SurfaceGui")
	surface.Face = Enum.NormalId.Front
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.PixelsPerStud = 40
	surface.LightInfluence = 0
	surface.Parent = plaque
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Enum.Font.GothamBlack
	text.Text = "伏魔御厨子"
	text.TextScaled = true
	text.TextColor3 = COL.trim
	text.Parent = surface

	P(Vector3.new(30, 5, 11), CFrame.new(0, 31.6, -5.5), COL.roof, M.Slate, "WedgePart")
	P(Vector3.new(30, 5, 11), CFrame.new(0, 31.6, 5.5) * CFrame.Angles(0, math.pi, 0), COL.roof, M.Slate, "WedgePart")
	P(Vector3.new(30, 0.4, 0.5), CFrame.new(0, 29.1, -11), COL.lacquer)
	P(Vector3.new(30, 0.4, 0.5), CFrame.new(0, 29.1, 11), COL.lacquer)
	P(Vector3.new(31, 0.9, 0.9), CFrame.new(0, 34.2, 0), COL.roof, M.Slate)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			local corner = Vector3.new(15 * sx, 29.3, 11 * sz)
			P(Vector3.new(0.6, 0.6, 2.6), CFrame.lookAt(corner, corner + Vector3.new(sx, 0.9, sz)), COL.trim, M.Metal)
		end
	end

	------------------------------------------------------------------
	-- Horns on the ridge
	------------------------------------------------------------------
	for _, sx in { -1, 1 } do
		local pts = {
			Vector3.new(3 * sx, 34.4, 0),
			Vector3.new(6.5 * sx, 37, 0),
			Vector3.new(8 * sx, 40.5, 0),
			Vector3.new(7.2 * sx, 43.5, 0),
		}
		local widths = { 1.4, 1.05, 0.65 }
		for i = 1, 3 do
			cylinder(pts[i], pts[i + 1], widths[i], COL.bone)
			ball(pts[i + 1], widths[i] * 0.95, COL.bone)
		end
		ball(pts[1], 1.6, COL.bone)
	end

	------------------------------------------------------------------
	-- Lanterns
	------------------------------------------------------------------
	for _, x in { -9, 9 } do
		local z = -24
		P(Vector3.new(1.6, 0.6, 1.6), CFrame.new(x, 0.3, z), COL.stone, M.Slate)
		P(Vector3.new(0.7, 3, 0.7), CFrame.new(x, 2.1, z), COL.stone, M.Slate)
		local lamp = P(Vector3.new(1.4, 1.4, 1.4), CFrame.new(x, 4.3, z), Color3.fromRGB(255, 70, 40), M.Neon)
		local l = Instance.new("PointLight")
		l.Color = Color3.fromRGB(255, 60, 40)
		l.Range = 14 * s
		l.Brightness = 2
		l.Parent = lamp
		P(Vector3.new(2.2, 0.4, 2.2), CFrame.new(x, 5.2, z), COL.stone, M.Slate)
		P(Vector3.new(0.8, 0.6, 0.8), CFrame.new(x, 5.7, z), COL.stone, M.Slate)
	end

	------------------------------------------------------------------
	-- Skulls and bones scattered around the shrine
	------------------------------------------------------------------
	local function skull(pos: Vector3, facing: Vector3, size: number)
		local cf = CFrame.lookAt(pos, pos + facing) * CFrame.Angles(math.rad(rng:NextNumber(-20, 20)), 0, math.rad(rng:NextNumber(-25, 25)))
		local function at(offset: Vector3)
			return (cf * (offset * size))
		end
		ball(pos, 1.7 * size, COL.bone)
		ball(at(Vector3.new(0.33, 0.1, -0.68)), 0.5 * size, COL.black)
		ball(at(Vector3.new(-0.33, 0.1, -0.68)), 0.5 * size, COL.black)
		ball(at(Vector3.new(0, -0.2, -0.8)), 0.28 * size, COL.black)
		P(Vector3.new(1.0, 0.45, 0.8) * size, cf * CFrame.new(Vector3.new(0, -0.62, -0.28) * size), COL.bone)
	end
	for _ = 1, 34 do
		local ang = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(1.0, 1.35)
		local pos = Vector3.new(math.cos(ang) * 24 * r, 0.6, math.sin(ang) * 19 * r)
		if not (math.abs(pos.X) < 7 and pos.Z < -17) then -- keep the stairs clear
			skull(pos, Vector3.new(pos.X, 0, pos.Z).Unit, rng:NextNumber(0.8, 1.25))
		end
	end
	for i = 1, 6 do
		local x = (i % 2 == 0 and 1 or -1) * rng:NextNumber(8, 14)
		skull(Vector3.new(x, 2.7, -16.3), Vector3.new(0, 0, -1), 0.75)
	end
	for _ = 1, 12 do
		local ang = rng:NextNumber(0, math.pi * 2)
		local center = Vector3.new(math.cos(ang) * rng:NextNumber(24, 32), 0.3, math.sin(ang) * rng:NextNumber(20, 27))
		local dir = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1)).Unit * 1.5
		cylinder(center - dir, center + dir, 0.35, COL.bone)
		ball(center - dir, 0.6, COL.bone)
		ball(center + dir, 0.6, COL.bone)
	end

	------------------------------------------------------------------
	-- Embers rising from the roof and smoke at the base
	------------------------------------------------------------------
	local emberHolder = P(Vector3.new(36, 1, 26), CFrame.new(0, 24, 0), COL.black)
	emberHolder.Transparency = 1
	local embers = Instance.new("ParticleEmitter")
	embers.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	embers.Color = ColorSequence.new(Color3.fromRGB(255, 70, 60), Color3.fromRGB(150, 0, 10))
	embers.LightEmission = 1
	embers.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	embers.Lifetime = NumberRange.new(2, 4)
	embers.Speed = NumberRange.new(2, 7)
	embers.SpreadAngle = Vector2.new(60, 60)
	embers.Acceleration = Vector3.new(0, 4, 0)
	embers.Rate = 40
	embers.Parent = emberHolder

	local smokeHolder = P(Vector3.new(46, 1, 36), CFrame.new(0, 1, 0), COL.black)
	smokeHolder.Transparency = 1
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
	smoke.Color = ColorSequence.new(Color3.fromRGB(30, 8, 10))
	smoke.LightInfluence = 1
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 9) })
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1) })
	smoke.Lifetime = NumberRange.new(3, 5)
	smoke.Speed = NumberRange.new(1, 3)
	smoke.Rate = 8
	smoke.Parent = smokeHolder

	model.PrimaryPart = base
	model.WorldPivot = origin
	return model, 44 * s
end

return Shrine
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Sounds</string>
          <string name="Source"><![CDATA[--[[
	Sounds — tiny helper for one-shot 3D / 2D sounds defined in Config.Sounds.
]]

local Debris = game:GetService("Debris")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local Config = require(script.Parent.Config)

local Sounds = {}

--[[
	where: BasePart / Attachment (3D, follows it), Vector3 (3D at a point) or nil (2D)
	opts: { pitch = number, volume = number (multiplier), rolloff = number }
]]
function Sounds.play(name: string, where: (Instance | Vector3)?, opts)
	local def = Config.Sounds[name]
	if not def or def.Id == "" then
		return nil
	end
	opts = opts or {}
	local sound = Instance.new("Sound")
	sound.SoundId = def.Id
	sound.Volume = (def.Volume or 0.7) * (opts.volume or 1)
	sound.PlaybackSpeed = opts.pitch or 1
	sound.RollOffMaxDistance = opts.rolloff or 220
	sound.RollOffMinDistance = 12

	local holder: Instance? = nil
	if typeof(where) == "Vector3" then
		local a = Instance.new("Attachment")
		a.Parent = Workspace.Terrain
		a.WorldPosition = where
		holder = a
		sound.Parent = a
	elseif typeof(where) == "Instance" then
		sound.Parent = where
	else
		sound.Parent = SoundService
	end

	sound:Play()
	local lifetime = 6 / math.max(sound.PlaybackSpeed, 0.1)
	Debris:AddItem(holder or sound, lifetime)
	return sound
end

return Sounds
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">VFX</string>
          <string name="Source"><![CDATA[--[[
	VFX — client-side effect builders (slashes, shockwaves, lightning, debris,
	craters, particles, auras, afterimages). Every effect is created locally on
	each client so it is smooth, and cleaned up automatically.
]]

local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(script.Parent.Config)
local C = Config.Colors

local VFX = {}

VFX.Textures = {
	Sparkle = "rbxasset://textures/particles/sparkles_main.dds",
	Fire = "rbxasset://textures/particles/fire_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
}

local random = Random.new()

----------------------------------------------------------------------
-- Infrastructure
----------------------------------------------------------------------

local folder: Folder? = nil
function VFX.folder(): Folder
	if folder and folder.Parent then
		return folder
	end
	local f = Workspace:FindFirstChild("SukunaFX_Local")
	if not f then
		f = Instance.new("Folder")
		f.Name = "SukunaFX_Local"
		f.Parent = Workspace
	end
	folder = f
	return f
end

-- One Heartbeat loop drives every animated effect.
local updaters = {}
local loop: RBXScriptConnection? = nil
local function runUpdaters(dt: number)
	for fn, data in updaters do
		data.elapsed += dt
		local ok, keep = pcall(fn, dt, data.elapsed)
		if not ok then
			warn("[SukunaVFX]", keep)
			updaters[fn] = nil
		elseif keep == false then
			updaters[fn] = nil
		end
	end
	if next(updaters) == nil and loop then
		loop:Disconnect()
		loop = nil
	end
end

function VFX.addUpdater(fn: (number, number) -> boolean?)
	updaters[fn] = { elapsed = 0 }
	if not loop then
		loop = RunService.Heartbeat:Connect(runUpdaters)
	end
end

function VFX.tween(instance: Instance, time: number, props, style: string?, dir: string?): Tween
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(time, (Enum.EasingStyle :: any)[style or "Quad"], (Enum.EasingDirection :: any)[dir or "Out"]),
		props
	)
	tween:Play()
	return tween
end

function VFX.part(props): BasePart
	local className = props.ClassName or "Part"
	local p = Instance.new(className) :: BasePart
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		if k ~= "ClassName" and k ~= "Parent" then
			(p :: any)[k] = v
		end
	end
	p.Parent = props.Parent or VFX.folder()
	return p
end

function VFX.attachmentAt(cf: CFrame | Vector3): Attachment
	local a = Instance.new("Attachment")
	a.Parent = Workspace.Terrain
	if typeof(cf) == "Vector3" then
		a.WorldPosition = cf
	else
		a.WorldCFrame = cf
	end
	return a
end

local function fadeSequence(base: { { number } }, fade: number): NumberSequence
	local points = {}
	for _, kp in base do
		table.insert(points, NumberSequenceKeypoint.new(kp[1], 1 - (1 - kp[2]) * (1 - fade)))
	end
	return NumberSequence.new(points)
end

function VFX.randomUnit(): Vector3
	return random:NextUnitVector()
end

function VFX.rand(a: number, b: number): number
	return random:NextNumber(a, b)
end

----------------------------------------------------------------------
-- Ground helpers
----------------------------------------------------------------------

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
groundParams.IgnoreWater = true

local function refreshGroundFilter()
	local list = { VFX.folder() }
	for _, plr in game:GetService("Players"):GetPlayers() do
		if plr.Character then
			table.insert(list, plr.Character)
		end
	end
	local fx = Workspace:FindFirstChild("SukunaFX")
	if fx then
		table.insert(list, fx)
	end
	local dummies = Workspace:FindFirstChild("SukunaDummies")
	if dummies then
		table.insert(list, dummies)
	end
	groundParams.FilterDescendantsInstances = list
end

-- Returns position, normal, color, material of the ground below a point.
function VFX.ground(pos: Vector3, depth: number?)
	refreshGroundFilter()
	local result = Workspace:Raycast(pos + Vector3.new(0, 4, 0), Vector3.new(0, -(depth or 60), 0), groundParams)
	if not result then
		return nil
	end
	local color = Color3.fromRGB(70, 66, 64)
	local material = Enum.Material.Slate
	local inst = result.Instance
	if inst:IsA("BasePart") and not inst:IsA("Terrain") then
		color = inst.Color
		material = inst.Material
	elseif inst:IsA("Terrain") then
		material = result.Material
		local ok, c = pcall(function()
			return Workspace.Terrain:GetMaterialColor(result.Material)
		end)
		if ok then
			color = c
		end
	end
	if material == Enum.Material.Neon or material == Enum.Material.ForceField or material == Enum.Material.Glass then
		material = Enum.Material.Slate
	end
	return {
		Position = result.Position,
		Normal = result.Normal,
		Color = color,
		Material = material,
	}
end

----------------------------------------------------------------------
-- Slashes
----------------------------------------------------------------------

--[[
	Crescent slash made of two curved beams (bright core + red glow).
	opts: width, bulge, thickness, life, velocity (Vector3), color, core
]]
function VFX.crescent(cf: CFrame, opts)
	opts = opts or {}
	local width = opts.width or 10
	local bulge = opts.bulge or width * 0.35
	local thickness = opts.thickness or 0.9
	local life = opts.life or 0.35
	local velocity: Vector3 = opts.velocity or Vector3.zero
	local k = bulge / 0.75

	local function place(frame: CFrame)
		local forward = frame.LookVector
		local up = frame.UpVector
		local leftTip = frame.Position - frame.RightVector * (width / 2)
		local rightTip = frame.Position + frame.RightVector * (width / 2)
		return CFrame.fromMatrix(leftTip, forward, up), CFrame.fromMatrix(rightTip, -forward, up)
	end

	local c0, c1 = place(cf)
	local a0 = VFX.attachmentAt(c0)
	local a1 = VFX.attachmentAt(c1)

	local coreShape = { { 0, 1 }, { 0.18, 0.35 }, { 0.5, 0 }, { 0.82, 0.35 }, { 1, 1 } }
	local glowShape = { { 0, 1 }, { 0.25, 0.55 }, { 0.5, 0.25 }, { 0.75, 0.55 }, { 1, 1 } }

	local function beam(color: Color3, w: number, shape, z: number)
		local b = Instance.new("Beam")
		b.Attachment0 = a0
		b.Attachment1 = a1
		b.CurveSize0 = k
		b.CurveSize1 = k
		b.Width0 = w
		b.Width1 = w
		b.Segments = 24
		b.FaceCamera = true
		b.LightEmission = 1
		b.LightInfluence = 0
		b.Brightness = 4
		b.ZOffset = z
		b.Color = ColorSequence.new(color)
		b.Transparency = fadeSequence(shape, 0)
		b.Parent = a0
		return b
	end
	local glow = beam(opts.color or C.SlashGlow, thickness * 2.6, glowShape, 0)
	local core = beam(opts.core or C.SlashCore, thickness, coreShape, 0.5)

	local frame = cf
	VFX.addUpdater(function(dt, t)
		if not a0.Parent then
			return false
		end
		frame = frame + velocity * dt
		local n0, n1 = place(frame)
		a0.WorldCFrame = n0
		a1.WorldCFrame = n1
		local fade = math.clamp((t - life * 0.55) / (life * 0.45), 0, 1)
		core.Transparency = fadeSequence(coreShape, fade)
		glow.Transparency = fadeSequence(glowShape, fade)
		if t >= life then
			a0:Destroy()
			a1:Destroy()
			return false
		end
		return true
	end)
	return frame
end

-- Straight razor-thin cut line that snaps open then fades (Cleave / Domain).
function VFX.cutLine(center: Vector3, direction: Vector3, length: number, opts)
	opts = opts or {}
	local thickness = opts.thickness or 0.18
	local life = opts.life or 0.28
	local cf = CFrame.lookAt(center, center + direction.Unit)
	local core = VFX.part({
		Size = Vector3.new(thickness, thickness, 0.1),
		CFrame = cf,
		Color = opts.core or C.SlashCore,
		Transparency = 0,
	})
	local glow = VFX.part({
		Size = Vector3.new(thickness * 3.2, thickness * 3.2, 0.1),
		CFrame = cf,
		Color = opts.color or C.SlashGlow,
		Transparency = 0.45,
		Material = Enum.Material.ForceField,
	})
	VFX.tween(core, life * 0.3, { Size = Vector3.new(thickness, thickness, length) }, "Quint", "Out")
	VFX.tween(glow, life * 0.3, { Size = Vector3.new(thickness * 3.2, thickness * 3.2, length * 1.05) }, "Quint", "Out")
	task.delay(life * 0.35, function()
		VFX.tween(core, life * 0.65, { Transparency = 1, Size = Vector3.new(0.02, 0.02, length * 1.1) }, "Quad", "In")
		VFX.tween(glow, life * 0.65, { Transparency = 1 }, "Quad", "In")
	end)
	Debris:AddItem(core, life + 0.1)
	Debris:AddItem(glow, life + 0.1)
end

-- Black scar left on the ground by a slash. Fades after a few seconds.
function VFX.groundScar(pos: Vector3, direction: Vector3, length: number, width: number?, life: number?)
	local g = VFX.ground(pos, 20)
	if not g then
		return
	end
	local flat = Vector3.new(direction.X, 0, direction.Z)
	if flat.Magnitude < 0.01 then
		flat = Vector3.new(0, 0, -1)
	end
	local at = g.Position + Vector3.new(0, 0.03, 0)
	local cf = CFrame.lookAt(at, at + flat.Unit)
	local scar = VFX.part({
		Size = Vector3.new(width or 0.35, 0.06, length),
		CFrame = cf,
		Color = C.Black,
		Material = Enum.Material.SmoothPlastic,
		Transparency = 0.05,
	})
	local glowLine = VFX.part({
		Size = Vector3.new((width or 0.35) * 0.35, 0.07, length * 0.96),
		CFrame = cf,
		Color = C.Curse,
		Transparency = 0.2,
	})
	VFX.tween(glowLine, 0.8, { Transparency = 1 }, "Quad", "In")
	task.delay(life or 3, function()
		VFX.tween(scar, 1.2, { Transparency = 1 })
	end)
	Debris:AddItem(scar, (life or 3) + 1.3)
	Debris:AddItem(glowLine, 1)
end

----------------------------------------------------------------------
-- Shockwaves, rings, flashes
----------------------------------------------------------------------

function VFX.sphere(pos: Vector3, fromSize: number, toSize: number, life: number, opts)
	opts = opts or {}
	local p = VFX.part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * fromSize,
		CFrame = CFrame.new(pos),
		Color = opts.color or C.Curse,
		Material = opts.material or Enum.Material.ForceField,
		Transparency = opts.transparency or 0,
	})
	VFX.tween(p, life, { Size = Vector3.one * toSize, Transparency = 1 }, opts.style or "Quart", "Out")
	Debris:AddItem(p, life + 0.05)
	return p
end

-- Flat expanding ring built from segments (crisp on any ground).
function VFX.ring(pos: Vector3, fromRadius: number, toRadius: number, life: number, opts)
	opts = opts or {}
	local count = opts.segments or 22
	local thickness = opts.thickness or 0.6
	local height = opts.height or 0.5
	local color = opts.color or C.Curse
	local tilt = opts.cframe or CFrame.new(pos)
	local parts = {}
	for i = 1, count do
		parts[i] = VFX.part({
			Size = Vector3.new(thickness, height, 1),
			Color = color,
			Transparency = opts.transparency or 0.1,
			Material = opts.material or Enum.Material.Neon,
		})
	end
	VFX.addUpdater(function(_, t)
		local a = math.clamp(t / life, 0, 1)
		local eased = 1 - (1 - a) ^ 3
		local r = fromRadius + (toRadius - fromRadius) * eased
		local seg = 2 * math.pi * r / count * 1.08
		local transparency = (opts.transparency or 0.1) + (1 - (opts.transparency or 0.1)) * a
		for i, p in parts do
			local ang = (i / count) * math.pi * 2
			local offset = Vector3.new(math.cos(ang) * r, 0, math.sin(ang) * r)
			local at = tilt * offset
			p.Size = Vector3.new(thickness * (1 - a * 0.6), height, seg)
			p.CFrame = CFrame.lookAt(at, at + (tilt.Rotation * Vector3.new(-math.sin(ang), 0, math.cos(ang))), tilt.UpVector)
			p.Transparency = transparency
		end
		if a >= 1 then
			for _, p in parts do
				p:Destroy()
			end
			return false
		end
		return true
	end)
end

function VFX.light(pos: Vector3, color: Color3, brightness: number, range: number, life: number)
	local holder = VFX.part({
		Size = Vector3.one * 0.2,
		CFrame = CFrame.new(pos),
		Transparency = 1,
	})
	local light = Instance.new("PointLight")
	light.Color = color
	light.Brightness = brightness
	light.Range = range
	light.Shadows = false
	light.Parent = holder
	VFX.tween(light, life, { Brightness = 0 }, "Quad", "In")
	Debris:AddItem(holder, life + 0.05)
	return light
end

----------------------------------------------------------------------
-- Particles
----------------------------------------------------------------------

function VFX.emitter(parent: Instance, props): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Texture = VFX.Textures.Sparkle
	e.LightEmission = 1
	e.LightInfluence = 0
	e.Enabled = false
	for k, v in props do
		(e :: any)[k] = v
	end
	e.Parent = parent
	return e
end

-- One-shot burst at a world position.
function VFX.burst(pos: Vector3, count: number, props)
	local a = VFX.attachmentAt(pos)
	local e = VFX.emitter(a, props)
	e:Emit(count)
	local maxLife = (props.Lifetime and props.Lifetime.Max) or 1
	Debris:AddItem(a, maxLife + 0.2)
	return e
end

function VFX.sparks(pos: Vector3, count: number?, color: Color3?)
	VFX.burst(pos, count or 18, {
		Color = ColorSequence.new(color or C.SlashGlow, C.SlashCore),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) }),
		Lifetime = NumberRange.new(0.2, 0.45),
		Speed = NumberRange.new(25, 55),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 6,
		Squash = NumberSequence.new(-1.5),
		Transparency = NumberSequence.new(0),
	})
end

function VFX.bloodMist(pos: Vector3, count: number?)
	VFX.burst(pos, count or 10, {
		Texture = VFX.Textures.Smoke,
		Color = ColorSequence.new(C.Blood, C.CurseDark),
		LightEmission = 0.2,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 2.4) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) }),
		Lifetime = NumberRange.new(0.35, 0.7),
		Speed = NumberRange.new(6, 14),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 4,
		Acceleration = Vector3.new(0, -12, 0),
	})
end

function VFX.fireBurst(pos: Vector3, count: number, size: number, speed: number)
	VFX.burst(pos, count, {
		Texture = VFX.Textures.Fire,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, C.FireHot),
			ColorSequenceKeypoint.new(0.4, C.Fire),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 10, 0)),
		}),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, size * 2.2) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) }),
		Lifetime = NumberRange.new(0.5, 1.1),
		Speed = NumberRange.new(speed * 0.4, speed),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 3,
		Acceleration = Vector3.new(0, 18, 0),
		RotSpeed = NumberRange.new(-120, 120),
		Rotation = NumberRange.new(0, 360),
	})
end

function VFX.smokeBurst(pos: Vector3, count: number, size: number, color: Color3?)
	VFX.burst(pos, count, {
		Texture = VFX.Textures.Smoke,
		Color = ColorSequence.new(color or Color3.fromRGB(40, 30, 30)),
		LightEmission = 0,
		LightInfluence = 1,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, size * 2.5) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) }),
		Lifetime = NumberRange.new(1.2, 2.4),
		Speed = NumberRange.new(4, 16),
		SpreadAngle = Vector2.new(180, 60),
		Drag = 2,
		Acceleration = Vector3.new(0, 4, 0),
		RotSpeed = NumberRange.new(-40, 40),
		Rotation = NumberRange.new(0, 360),
	})
end

-- Particles pulled inward toward a point (cursed energy gathering).
function VFX.gather(parent: BasePart, duration: number, radius: number?)
	local e = VFX.emitter(parent, {
		Shape = Enum.ParticleEmitterShape.Sphere,
		ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface,
		Color = ColorSequence.new(C.Curse, C.CurseDark),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.5, 0.45), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new(0.1),
		Lifetime = NumberRange.new(0.35, 0.5),
		Speed = NumberRange.new((radius or 9) * 1.6, (radius or 9) * 2.2),
		Rate = 140,
		Squash = NumberSequence.new(-1.2),
		LockedToPart = true,
	})
	-- An inward-facing sphere emitter uses the part size as the shell, so size an invisible shell part.
	local shell = VFX.part({
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * (radius or 9) * 2,
		CFrame = parent.CFrame,
		Transparency = 1,
	})
	e.Parent = shell
	e.Enabled = true
	VFX.addUpdater(function(_, t)
		if not shell.Parent or not parent.Parent then
			return false
		end
		shell.CFrame = parent.CFrame
		if t >= duration then
			e.Enabled = false
			Debris:AddItem(shell, 0.6)
			return false
		end
		return true
	end)
end

----------------------------------------------------------------------
-- Lightning
----------------------------------------------------------------------

function VFX.lightning(p0: Vector3, p1: Vector3, opts)
	opts = opts or {}
	local segments = opts.segments or 7
	local jitter = opts.jitter or ((p1 - p0).Magnitude * 0.12)
	local thickness = opts.thickness or 0.18
	local life = opts.life or 0.14
	local color = opts.color or C.Curse
	local last = p0
	local parts = {}
	for i = 1, segments do
		local a = i / segments
		local point = p0:Lerp(p1, a)
		if i < segments then
			point += VFX.randomUnit() * jitter * random:NextNumber(0.3, 1)
		end
		local len = (point - last).Magnitude
		if len > 0.01 then
			table.insert(parts, VFX.part({
				Size = Vector3.new(thickness, thickness, len),
				CFrame = CFrame.lookAt((last + point) / 2, point),
				Color = color,
			}))
		end
		last = point
	end
	for _, p in parts do
		VFX.tween(p, life, { Transparency = 1, Size = Vector3.new(0.02, 0.02, p.Size.Z) }, "Quad", "In")
		Debris:AddItem(p, life + 0.05)
	end
end

----------------------------------------------------------------------
-- Rocks, debris, craters
----------------------------------------------------------------------

function VFX.debris(pos: Vector3, count: number, power: number?, size: number?)
	local g = VFX.ground(pos, 30)
	local color = g and g.Color or Color3.fromRGB(80, 74, 70)
	local material = g and g.Material or Enum.Material.Slate
	local base = g and g.Position or pos
	for _ = 1, count do
		local s = random:NextNumber(0.5, 1.4) * (size or 1)
		local rock = VFX.part({
			Size = Vector3.new(s, s * random:NextNumber(0.6, 1.1), s),
			CFrame = CFrame.new(base + Vector3.new(random:NextNumber(-2, 2), 0.6, random:NextNumber(-2, 2)))
				* CFrame.Angles(random:NextNumber(0, 6.28), random:NextNumber(0, 6.28), 0),
			Color = color:Lerp(Color3.new(0, 0, 0), random:NextNumber(0, 0.3)),
			Material = material,
			Anchored = false,
			CanCollide = true,
		})
		pcall(function()
			rock.CollisionGroup = "SukunaDebris" -- registered by the server; never trips characters
		end)
		local dir = Vector3.new(random:NextNumber(-1, 1), random:NextNumber(0.9, 1.8), random:NextNumber(-1, 1)).Unit
		rock.AssemblyLinearVelocity = dir * random:NextNumber(25, 55) * (power or 1)
		rock.AssemblyAngularVelocity = VFX.randomUnit() * 15
		task.delay(random:NextNumber(2, 3), function()
			if rock.Parent then
				rock.Anchored = true
				rock.CanCollide = false
				VFX.tween(rock, 0.8, { Transparency = 1, Size = rock.Size * 0.3 })
			end
		end)
		Debris:AddItem(rock, 4)
	end
end

-- Ring of jagged rocks pushed up out of the ground.
function VFX.crater(pos: Vector3, radius: number, count: number?, life: number?)
	local g = VFX.ground(pos, 30)
	if not g then
		return
	end
	local center = g.Position
	local n = count or 14
	for i = 1, n do
		local ang = (i / n) * math.pi * 2 + random:NextNumber(-0.15, 0.15)
		local r = radius * random:NextNumber(0.85, 1.1)
		local s = radius * random:NextNumber(0.22, 0.34)
		local at = center + Vector3.new(math.cos(ang) * r, 0, math.sin(ang) * r)
		local outward = (at - center).Unit
		local final = CFrame.lookAt(at, at + outward) * CFrame.Angles(math.rad(random:NextNumber(25, 50)), 0, math.rad(random:NextNumber(-15, 15)))
		local rock = VFX.part({
			Size = Vector3.new(s, s * 0.7, s * 1.1),
			CFrame = final - Vector3.new(0, s, 0),
			Color = g.Color:Lerp(Color3.new(0, 0, 0), random:NextNumber(0.05, 0.3)),
			Material = g.Material,
			CanCollide = false,
		})
		VFX.tween(rock, 0.18, { CFrame = final }, "Back", "Out")
		task.delay(life or 4, function()
			if rock.Parent then
				VFX.tween(rock, 1, { CFrame = final - Vector3.new(0, s * 1.5, 0), Transparency = 1 }, "Quad", "In")
			end
		end)
		Debris:AddItem(rock, (life or 4) + 1.1)
	end
	-- Scorched centre
	local scorch = VFX.part({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.08, radius * 2, radius * 2),
		CFrame = CFrame.new(center + Vector3.new(0, 0.04, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(20, 12, 12),
		Material = Enum.Material.Slate,
		Transparency = 0.15,
	})
	task.delay(life or 4, function()
		VFX.tween(scorch, 1, { Transparency = 1 })
	end)
	Debris:AddItem(scorch, (life or 4) + 1.1)
end

-- Cracks radiating out on the ground.
function VFX.cracks(pos: Vector3, count: number, length: number, life: number?)
	for i = 1, count do
		local ang = (i / count) * math.pi * 2 + random:NextNumber(-0.3, 0.3)
		local dir = Vector3.new(math.cos(ang), 0, math.sin(ang))
		local len = length * random:NextNumber(0.6, 1.2)
		VFX.groundScar(pos + dir * (len / 2 + 1), dir, len, random:NextNumber(0.2, 0.45), life)
	end
end

----------------------------------------------------------------------
-- Character effects
----------------------------------------------------------------------

-- Red/black flaming aura. Returns a function that stops it.
function VFX.aura(character: Model, strength: number?)
	local intensity = strength or 1
	local emitters = {}
	local function addTo(partName: string, rate: number, size: number)
		local part = character:FindFirstChild(partName)
		if not part or not part:IsA("BasePart") then
			return
		end
		table.insert(emitters, VFX.emitter(part, {
			Texture = VFX.Textures.Fire,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 70)),
				ColorSequenceKeypoint.new(0.5, C.Curse),
				ColorSequenceKeypoint.new(1, C.Black),
			}),
			LightEmission = 0.7,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, 0) }),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) }),
			Lifetime = NumberRange.new(0.4, 0.8),
			Speed = NumberRange.new(2, 5),
			Acceleration = Vector3.new(0, 14, 0),
			Rate = rate * intensity,
			SpreadAngle = Vector2.new(25, 25),
			RotSpeed = NumberRange.new(-90, 90),
			Rotation = NumberRange.new(0, 360),
			Enabled = true,
		}))
		table.insert(emitters, VFX.emitter(part, {
			Texture = VFX.Textures.Smoke,
			Color = ColorSequence.new(C.Black),
			LightEmission = 0,
			LightInfluence = 1,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size * 0.8), NumberSequenceKeypoint.new(1, size * 1.6) }),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) }),
			Lifetime = NumberRange.new(0.6, 1),
			Speed = NumberRange.new(1, 3),
			Acceleration = Vector3.new(0, 8, 0),
			Rate = rate * 0.4 * intensity,
			Enabled = true,
		}))
	end
	addTo("UpperTorso", 40, 1.6)
	addTo("LowerTorso", 22, 1.3)
	addTo("RightLowerArm", 14, 0.8)
	addTo("LeftLowerArm", 14, 0.8)
	addTo("RightLowerLeg", 10, 0.8)
	addTo("LeftLowerLeg", 10, 0.8)
	return function()
		for _, e in emitters do
			e.Enabled = false
			Debris:AddItem(e, 1.2)
		end
	end
end

function VFX.highlight(character: Model, color: Color3, life: number, fill: number?)
	local h = Instance.new("Highlight")
	h.FillColor = color
	h.OutlineColor = color
	h.FillTransparency = fill or 0.6
	h.OutlineTransparency = 0
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Adornee = character
	h.Parent = VFX.folder()
	VFX.tween(h, life, { FillTransparency = 1, OutlineTransparency = 1 }, "Quad", "In")
	Debris:AddItem(h, life + 0.05)
	return h
end

-- Neon ghost copies of the body (dash afterimage).
function VFX.afterimage(character: Model, color: Color3?, life: number?)
	for _, child in character:GetChildren() do
		if child:IsA("BasePart") and child.Name ~= "HumanoidRootPart" and child.Transparency < 1 then
			local ok, ghost = pcall(function()
				local was = child.Archivable
				child.Archivable = true
				local clone = child:Clone()
				child.Archivable = was
				return clone
			end)
			if ok and ghost then
				ghost:ClearAllChildren()
				ghost.Anchored = true
				ghost.CanCollide = false
				ghost.CanQuery = false
				ghost.CanTouch = false
				ghost.CastShadow = false
				ghost.Massless = true
				ghost.Material = Enum.Material.ForceField
				ghost.Color = color or C.Curse
				ghost.Transparency = 0.1
				ghost.CFrame = child.CFrame
				if ghost:IsA("MeshPart") then
					ghost.TextureID = ""
				end
				ghost.Parent = VFX.folder()
				VFX.tween(ghost, life or 0.35, { Transparency = 1 }, "Quad", "In")
				Debris:AddItem(ghost, (life or 0.35) + 0.05)
			end
		end
	end
end

return VFX
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="15">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="16">
      <Properties>
        <string name="Name">SukunaServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	SukunaServer — authoritative side of the Sukuna powers.

	• Click the red cube → transformation (markings, stats, aura) → powers.
	• Validates every ability request (state, cooldowns), runs hitboxes,
	  damage, stuns and knockback, and broadcasts "FX" events so every client
	  plays the matching R15 animation, VFX and cinematics.
	• Spawns R15 training dummies to test on.
]]

local Debris = game:GetService("Debris")
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("SukunaShared")
local Config = require(Shared:WaitForChild("Config"))

local AB = Config.Abilities
local T = Config.Timing
local C = Config.Colors

----------------------------------------------------------------------
-- Networking
----------------------------------------------------------------------

local remote = Shared:FindFirstChild("SukunaRemote")
if not remote then
	remote = Instance.new("RemoteEvent")
	remote.Name = "SukunaRemote"
	remote.Parent = Shared
end

local function fx(name: string, data)
	remote:FireAllClients("FX", name, data)
end

local function notify(player: Player, text: string)
	remote:FireClient(player, "Notify", text)
end

----------------------------------------------------------------------
-- Collision groups: client debris never trips characters
----------------------------------------------------------------------

pcall(function()
	PhysicsService:RegisterCollisionGroup("SukunaDebris")
	PhysicsService:RegisterCollisionGroup("SukunaCharacters")
	PhysicsService:CollisionGroupSetCollidable("SukunaDebris", "SukunaCharacters", false)
	PhysicsService:CollisionGroupSetCollidable("SukunaDebris", "SukunaDebris", false)
end)

local function setCharacterGroup(character: Model)
	local function apply(d: Instance)
		if d:IsA("BasePart") then
			d.CollisionGroup = "SukunaCharacters"
		end
	end
	for _, d in character:GetDescendants() do
		apply(d)
	end
	character.DescendantAdded:Connect(apply)
end

----------------------------------------------------------------------
-- Character helpers
----------------------------------------------------------------------

local function partsOf(character: Model?)
	if not character then
		return nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if humanoid and root and root:IsA("BasePart") then
		return humanoid, root
	end
	return nil, nil
end

local function alive(character: Model?): boolean
	local humanoid = partsOf(character)
	return humanoid ~= nil and humanoid.Health > 0 and character ~= nil and character.Parent ~= nil
end

local function rootOfHumanoid(humanoid: Humanoid): BasePart?
	local r = humanoid.Parent and humanoid.Parent:FindFirstChild("HumanoidRootPart")
	return if r and r:IsA("BasePart") then r else nil
end

local function flatDirection(root: BasePart, aim: Vector3?): Vector3
	local look = root.CFrame.LookVector
	look = Vector3.new(look.X, 0, look.Z)
	if look.Magnitude < 0.01 then
		look = Vector3.new(0, 0, -1)
	end
	look = look.Unit
	if aim then
		local d = Vector3.new(aim.X - root.Position.X, 0, aim.Z - root.Position.Z)
		if d.Magnitude > 2 and d.Unit:Dot(look) > 0.3 then
			return d.Unit
		end
	end
	return look
end

----------------------------------------------------------------------
-- Movement locks (stuns / move commitment), stacked safely
----------------------------------------------------------------------

local locks = {}

local function applyLock(humanoid: Humanoid)
	local l = locks[humanoid]
	if not l then
		return
	end
	local speed = math.huge
	for _, s in l.entries do
		speed = math.min(speed, s)
	end
	humanoid.WalkSpeed = speed
	humanoid.JumpPower = 0
	humanoid.JumpHeight = 0
end

local function lock(humanoid: Humanoid, speed: number?): () -> ()
	local l = locks[humanoid]
	if not l then
		l = {
			entries = {},
			walk = humanoid.WalkSpeed,
			jumpPower = humanoid.JumpPower,
			jumpHeight = humanoid.JumpHeight,
		}
		locks[humanoid] = l
	end
	local token = {}
	l.entries[token] = speed or 0
	applyLock(humanoid)
	local released = false
	return function()
		if released then
			return
		end
		released = true
		l.entries[token] = nil
		if next(l.entries) == nil then
			if locks[humanoid] == l then
				locks[humanoid] = nil
			end
			if humanoid.Parent then
				humanoid.WalkSpeed = l.walk
				humanoid.JumpPower = l.jumpPower
				humanoid.JumpHeight = l.jumpHeight
			end
		else
			applyLock(humanoid)
		end
	end
end

local function lockFor(humanoid: Humanoid, duration: number, speed: number?)
	task.delay(duration, lock(humanoid, speed))
end

local function setBaseWalkSpeed(humanoid: Humanoid, speed: number)
	local l = locks[humanoid]
	if l then
		l.walk = speed
	else
		humanoid.WalkSpeed = speed
	end
end

local stunnedUntil = setmetatable({}, { __mode = "k" })

local function stun(humanoid: Humanoid, duration: number, speed: number?)
	local untilTime = os.clock() + duration
	if (speed or 0) == 0 then
		stunnedUntil[humanoid] = math.max(stunnedUntil[humanoid] or 0, untilTime)
	end
	lockFor(humanoid, duration, speed or 0)
end

local function isStunned(humanoid: Humanoid): boolean
	return (stunnedUntil[humanoid] or 0) > os.clock()
end

local function invulnerable(character: Model, duration: number)
	local ff = Instance.new("ForceField")
	ff.Name = "SukunaGuard"
	ff.Visible = false
	ff.Parent = character
	Debris:AddItem(ff, duration)
	return ff
end

----------------------------------------------------------------------
-- Hit detection & damage
----------------------------------------------------------------------

local function overlapParams(exclude: Model?): OverlapParams
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local list = {}
	if exclude then
		table.insert(list, exclude)
	end
	params.FilterDescendantsInstances = list
	return params
end

local function humanoidsFromParts(parts: { BasePart }, exclude: Model?): { Humanoid }
	local found, out = {}, {}
	for _, part in parts do
		local model = part:FindFirstAncestorOfClass("Model")
		while model and not model:FindFirstChildOfClass("Humanoid") do
			model = model:FindFirstAncestorOfClass("Model")
		end
		if model and model ~= exclude then
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.Health > 0 and not found[humanoid] then
				found[humanoid] = true
				table.insert(out, humanoid)
			end
		end
	end
	return out
end

local function queryBox(cf: CFrame, size: Vector3, exclude: Model?): { Humanoid }
	return humanoidsFromParts(Workspace:GetPartBoundsInBox(cf, size, overlapParams(exclude)), exclude)
end

local function queryRadius(pos: Vector3, radius: number, exclude: Model?): { Humanoid }
	return humanoidsFromParts(Workspace:GetPartBoundsInRadius(pos, radius, overlapParams(exclude)), exclude)
end

local function applyVelocity(root: BasePart, velocity: Vector3, duration: number)
	local att = root:FindFirstChild("RootAttachment")
	if not att or not att:IsA("Attachment") then
		att = Instance.new("Attachment")
		att.Parent = root
	end
	local lv = Instance.new("LinearVelocity")
	lv.Attachment0 = att :: Attachment
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.MaxForce = 1e7
	lv.VectorVelocity = velocity
	lv.Parent = root
	Debris:AddItem(lv, duration)
end

local function knockback(character: Model, velocity: Vector3, duration: number?)
	local humanoid, root = partsOf(character)
	if not humanoid or not root then
		return
	end
	local target = Players:GetPlayerFromCharacter(character)
	if target then
		remote:FireClient(target, "Knockback", velocity, duration or 0.2)
	else
		applyVelocity(root, velocity, duration or 0.2)
	end
end

local function tag(humanoid: Humanoid, attacker: Player)
	local old = humanoid:FindFirstChild("creator")
	if old then
		old:Destroy()
	end
	local creator = Instance.new("ObjectValue")
	creator.Name = "creator"
	creator.Value = attacker
	creator.Parent = humanoid
	Debris:AddItem(creator, 3)
end

--[[
	opts: kind ("blunt" | "slash" | "burn"), heavy, knock (Vector3),
	      knockTime, stun (seconds), fx (false = no hit FX), quiet
]]
local function damage(attacker: Player, humanoid: Humanoid, amount: number, opts)
	opts = opts or {}
	local character = humanoid.Parent :: Model?
	if not character or humanoid.Health <= 0 then
		return false
	end
	if not Config.DamagePlayers and Players:GetPlayerFromCharacter(character) then
		return false
	end
	tag(humanoid, attacker)
	humanoid:TakeDamage(amount)
	if opts.stun then
		stun(humanoid, opts.stun, opts.stunSpeed)
	end
	if opts.knock then
		knockback(character, opts.knock, opts.knockTime)
	end
	if opts.fx ~= false then
		fx("Hit", { char = character, kind = opts.kind or "blunt", heavy = opts.heavy, quiet = opts.quiet })
	end
	return true
end

-- Moving hitbox for projectiles such as Dismantle's flying slashes.
local function sweep(origin: CFrame, speed: number, range: number, size: Vector3, exclude: Model?, onHit: (Humanoid) -> ())
	local traveled = 0
	local hit = {}
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function(dt)
		local from = traveled
		traveled = math.min(traveled + speed * dt, range)
		local len = traveled - from + size.Z
		local cf = origin * CFrame.new(0, 0, -(from + traveled) / 2)
		for _, humanoid in queryBox(cf, Vector3.new(size.X, size.Y, len), exclude) do
			if not hit[humanoid] then
				hit[humanoid] = true
				task.spawn(onHit, humanoid)
			end
		end
		if traveled >= range then
			conn:Disconnect()
		end
	end)
end

----------------------------------------------------------------------
-- Sukuna's markings (face lines, extra eyes, arm bands, chest lines)
----------------------------------------------------------------------

local function decor(folder: Folder, parentPart: BasePart, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?)
	local p = Instance.new("Part")
	p.Name = "Marking"
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = parentPart.CFrame * offset
	local weld = Instance.new("Weld")
	weld.Part0 = parentPart
	weld.Part1 = p
	weld.C0 = offset
	weld.Parent = p
	p.Parent = folder
	return p
end

local function visualSize(part: BasePart): Vector3
	local mesh = part:FindFirstChildOfClass("SpecialMesh")
	if mesh then
		if mesh.MeshType == Enum.MeshType.Head then
			return Vector3.new(part.Size.X * mesh.Scale.X * 0.5, part.Size.Y * mesh.Scale.Y, part.Size.Z * mesh.Scale.Z)
		end
		return part.Size * mesh.Scale
	end
	return part.Size
end

local function applyMarkings(character: Model)
	local old = character:FindFirstChild("SukunaMarkings")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "SukunaMarkings"
	folder.Parent = character
	local black = C.Black

	local head = character:FindFirstChild("Head")
	if Config.FaceMarkings and head and head:IsA("BasePart") then
		local s = visualSize(head)
		local w, h, dz = s.X, s.Y, s.Z / 2
		local r = w / 2
		-- Place a flat mark on the rounded front of the head.
		local function face(xn: number, yn: number, roll: number, size: Vector3, color: Color3, material: Enum.Material?)
			local x = math.clamp(xn * w, -r * 0.95, r * 0.95)
			local theta = math.asin(x / r)
			local z = -math.cos(theta) * dz
			local offset = CFrame.new(math.sin(theta) * r, yn * h, z + 0.005) * CFrame.Angles(0, -theta, math.rad(roll))
			decor(folder, head, size, offset, color, material)
		end
		for _, side in { -1, 1 } do
			-- glowing red eyes
			face(0.17 * side, 0.1, 0, Vector3.new(w * 0.11, h * 0.05, 0.04), C.Curse, Enum.Material.Neon)
			-- second pair of eyes opening beneath them
			face(0.19 * side, -0.02, -8 * side, Vector3.new(w * 0.14, h * 0.035, 0.04), black)
			face(0.19 * side, -0.02, -8 * side, Vector3.new(w * 0.07, h * 0.018, 0.05), C.Curse, Enum.Material.Neon)
			-- the two cheek lines
			face(0.22 * side, -0.12, 10 * side, Vector3.new(w * 0.26, h * 0.035, 0.04), black)
			face(0.22 * side, -0.2, 10 * side, Vector3.new(w * 0.24, h * 0.035, 0.04), black)
			-- forehead marks
			face(0.08 * side, 0.27, -35 * side, Vector3.new(w * 0.16, h * 0.03, 0.04), black)
		end
		face(0, 0.33, 0, Vector3.new(w * 0.035, h * 0.12, 0.04), black)
	end

	if Config.BodyMarkings then
		-- black bands around the forearms and upper arms
		for _, side in { "Left", "Right" } do
			local lower = character:FindFirstChild(side .. "LowerArm")
			if lower and lower:IsA("BasePart") then
				local s = lower.Size
				for _, y in { -0.22, -0.34 } do
					decor(folder, lower, Vector3.new(s.X + 0.05, 0.07, s.Z + 0.05), CFrame.new(0, y * s.Y, 0), black)
				end
			end
			local upper = character:FindFirstChild(side .. "UpperArm")
			if upper and upper:IsA("BasePart") then
				local s = upper.Size
				decor(folder, upper, Vector3.new(s.X + 0.05, 0.07, s.Z + 0.05), CFrame.new(0, 0.05 * s.Y, 0), black)
			end
		end
		-- chest and abdomen lines
		local torso = character:FindFirstChild("UpperTorso")
		if torso and torso:IsA("BasePart") then
			local s = torso.Size
			local front = -s.Z / 2 - 0.01
			for _, side in { -1, 1 } do
				decor(folder, torso, Vector3.new(s.X * 0.28, 0.06, 0.03), CFrame.new(side * s.X * 0.22, s.Y * 0.12, front) * CFrame.Angles(0, 0, math.rad(-12 * side)), black)
				decor(folder, torso, Vector3.new(s.X * 0.22, 0.06, 0.03), CFrame.new(side * s.X * 0.2, s.Y * 0.01, front) * CFrame.Angles(0, 0, math.rad(-12 * side)), black)
				decor(folder, torso, Vector3.new(s.X * 0.16, 0.06, 0.03), CFrame.new(side * s.X * 0.14, -s.Y * 0.3, front), black)
			end
		end
	end
end

local function applyAura(character: Model)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root or root:FindFirstChild("SukunaAura") then
		return
	end
	local aura = Instance.new("ParticleEmitter")
	aura.Name = "SukunaAura"
	aura.Texture = "rbxasset://textures/particles/fire_main.dds"
	aura.Color = ColorSequence.new(C.Curse, C.Black)
	aura.LightEmission = 0.6
	aura.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) })
	aura.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
	aura.Lifetime = NumberRange.new(0.5, 0.9)
	aura.Speed = NumberRange.new(1, 2.5)
	aura.Acceleration = Vector3.new(0, 7, 0)
	aura.Rate = 14
	aura.RotSpeed = NumberRange.new(-60, 60)
	aura.Rotation = NumberRange.new(0, 360)
	aura.Parent = root
	local glow = Instance.new("PointLight")
	glow.Name = "SukunaGlow"
	glow.Color = C.Curse
	glow.Range = 7
	glow.Brightness = 0.7
	glow.Parent = root
end

local function applyPowerState(player: Player, character: Model)
	local humanoid = partsOf(character)
	if not humanoid then
		return
	end
	applyMarkings(character)
	applyAura(character)
	humanoid.MaxHealth = Config.Stats.MaxHealth
	humanoid.Health = Config.Stats.MaxHealth
	setBaseWalkSpeed(humanoid, Config.Stats.WalkSpeed)
	character:SetAttribute("SukunaActive", true)
	player:SetAttribute("SukunaPowered", true)
end

----------------------------------------------------------------------
-- Player state
----------------------------------------------------------------------

local states = {}

local function stateOf(player: Player)
	local s = states[player]
	if not s then
		s = {
			busyUntil = 0,
			cooldowns = {},
			combo = 0,
			lastCombo = 0,
			transforming = false,
			domainActive = false,
		}
		states[player] = s
	end
	return s
end

----------------------------------------------------------------------
-- The red cube: transformation
----------------------------------------------------------------------

local cube = Workspace:WaitForChild(Config.Cube.Name, 30)

local function grantPowers(player: Player)
	local character = player.Character
	local humanoid, root = partsOf(character)
	if not character or not humanoid or not root or humanoid.Health <= 0 then
		return
	end
	if Config.RequireR15 and humanoid.RigType ~= Enum.HumanoidRigType.R15 then
		notify(player, "Sukuna's power needs an R15 avatar (Game Settings → Avatar → R15).")
		return
	end
	local st = stateOf(player)
	if st.transforming then
		return
	end
	if character:GetAttribute("SukunaActive") then
		notify(player, "You already carry the King of Curses.")
		return
	end
	if cube and cube:IsA("BasePart") and (root.Position - cube.Position).Magnitude > Config.Cube.ClickDistance + 10 then
		return
	end

	st.transforming = true
	st.busyUntil = os.clock() + T.Transform.Duration
	local release = lock(humanoid)
	invulnerable(character, T.Transform.Duration)
	fx("Transform", { char = character })

	task.delay(T.Transform.Burst, function()
		if alive(character) then
			applyPowerState(player, character)
			for _, h in queryRadius(root.Position, 14, character) do
				local r = rootOfHumanoid(h)
				if r then
					local away = Vector3.new(r.Position.X - root.Position.X, 0, r.Position.Z - root.Position.Z)
					away = if away.Magnitude > 0.1 then away.Unit else Vector3.xAxis
					knockback(h.Parent :: Model, away * 70 + Vector3.new(0, 35, 0), 0.25)
				end
			end
		end
	end)
	task.delay(T.Transform.Duration, function()
		release()
		st.transforming = false
	end)
end

----------------------------------------------------------------------
-- Abilities
----------------------------------------------------------------------

local Abilities = {}

function Abilities.Combo(player: Player, st, character: Model, humanoid: Humanoid, root: BasePart, aim: Vector3?)
	local ab = AB.Combo
	local now = os.clock()
	if now - st.lastCombo > 0.95 then
		st.combo = 0
	end
	st.combo = st.combo % 4 + 1
	st.lastCombo = now
	local index = st.combo
	lockFor(humanoid, T.Combo.Busy, 4)
	fx("Combo", { char = character, index = index })
	task.delay(T.Combo.Hit, function()
		if not alive(character) then
			return
		end
		local cf = root.CFrame * CFrame.new(0, 0, -ab.Range / 2)
		local look = root.CFrame.LookVector
		for _, h in queryBox(cf, Vector3.new(5.5, 6, ab.Range), character) do
			local finisher = index == 4
			damage(player, h, ab.Damage[index], {
				kind = "blunt",
				heavy = finisher,
				knock = if finisher then look * 60 + Vector3.new(0, 28, 0) else look * 10,
				knockTime = if finisher then 0.25 else 0.12,
				stun = if finisher then 0.7 else 0.4,
			})
		end
	end)
	local cooldown = if index == 4 then ab.FinisherCooldown else ab.Cooldown
	return T.Combo.Busy, cooldown, true
end

function Abilities.Dismantle(player: Player, st, character: Model, humanoid: Humanoid, root: BasePart, aim: Vector3?)
	local ab, Tt = AB.Dismantle, T.Dismantle
	local dir = flatDirection(root, aim)
	local start = root.Position + Vector3.new(0, 0.6, 0) + dir * 2
	local origin = CFrame.lookAt(start, start + dir)
	lockFor(humanoid, Tt.Duration, 2)
	fx("Dismantle", {
		char = character,
		origin = origin,
		speed = ab.Speed,
		range = ab.Range,
		width = ab.Width,
		times = Tt.SlashTimes,
		tilts = ab.Tilts,
	})
	for _, t in Tt.SlashTimes do
		task.delay(t, function()
			if not alive(character) then
				return
			end
			sweep(origin, ab.Speed, ab.Range, Vector3.new(ab.Width, 6, 3), character, function(h)
				damage(player, h, ab.Damage, {
					kind = "slash",
					knock = dir * 14,
					knockTime = 0.1,
					stun = 0.35,
				})
			end)
		end)
	end
	return Tt.Duration, ab.Cooldown
end

function Abilities.Cleave(player: Player, st, character: Model, humanoid: Humanoid, root: BasePart, aim: Vector3?)
	local ab, Tt = AB.Cleave, T.Cleave
	local look = flatDirection(root, aim)
	-- pick the closest target in front of Sukuna
	local best, bestScore = nil, math.huge
	for _, h in queryRadius(root.Position, ab.Range, character) do
		local r = rootOfHumanoid(h)
		if r then
			local offset = r.Position - root.Position
			local flat = Vector3.new(offset.X, 0, offset.Z)
			local facing = if flat.Magnitude > 0.1 then flat.Unit:Dot(look) else 1
			if facing > 0.25 then
				local score = flat.Magnitude * (1.6 - facing)
				if score < bestScore then
					best, bestScore = h, score
				end
			end
		end
	end
	lockFor(humanoid, Tt.Duration)
	fx("Cleave", { char = character, target = best and best.Parent })
	if not best then
		return Tt.Duration, ab.WhiffCooldown
	end
	local target = best
	task.delay(Tt.CutStart, function()
		local tr = rootOfHumanoid(target)
		if not alive(character) or target.Health <= 0 or not tr then
			return
		end
		if (tr.Position - root.Position).Magnitude > ab.Range + 8 then
			return
		end
		stun(target, ab.Cuts * Tt.CutInterval + 0.5)
		for i = 1, ab.Cuts do
			task.delay((i - 1) * Tt.CutInterval, function()
				if target.Health <= 0 or not target.Parent then
					return
				end
				local final = i == ab.Cuts
				local amount = ab.DamagePerCut + target.MaxHealth * ab.PercentPerCut
				local away = Vector3.new(tr.Position.X - root.Position.X, 0, tr.Position.Z - root.Position.Z)
				away = if away.Magnitude > 0.1 then away.Unit else look
				damage(player, target, amount, {
					fx = false,
					knock = if final then away * 75 + Vector3.new(0, 30, 0) else nil,
					knockTime = 0.25,
				})
				fx("CleaveCut", { char = character, target = target.Parent, index = i, final = final })
			end)
		end
	end)
	return Tt.Duration, ab.Cooldown
end

local function rayParams(exclude: Model?): RaycastParams
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local list = {}
	if exclude then
		table.insert(list, exclude)
	end
	local fxFolder = Workspace:FindFirstChild("SukunaFX_Local")
	if fxFolder then
		table.insert(list, fxFolder)
	end
	params.FilterDescendantsInstances = list
	params.IgnoreWater = true
	return params
end

local function fugaExplosion(player: Player, character: Model, pos: Vector3)
	local ab = AB.Fuga
	for _, h in queryRadius(pos, ab.Radius, character) do
		local r = rootOfHumanoid(h)
		local offset = if r then r.Position - pos else Vector3.yAxis
		local dist = offset.Magnitude
		local falloff = 1 - math.clamp(dist / ab.Radius, 0, 1) * 0.5
		local away = Vector3.new(offset.X, 0, offset.Z)
		away = if away.Magnitude > 0.1 then away.Unit else Vector3.xAxis
		damage(player, h, ab.Damage * falloff, {
			kind = "burn",
			heavy = true,
			knock = away * 80 + Vector3.new(0, 50, 0),
			knockTime = 0.3,
			stun = 0.8,
		})
	end
	-- lingering flames
	task.spawn(function()
		local finish = os.clock() + ab.BurnDuration
		while os.clock() < finish do
			task.wait(0.5)
			for _, h in queryRadius(pos, ab.Radius * 0.55, character) do
				damage(player, h, ab.BurnDamage, { kind = "burn", quiet = true })
			end
		end
	end)
end

function Abilities.Fuga(player: Player, st, character: Model, humanoid: Humanoid, root: BasePart, aim: Vector3?)
	local ab, Tt = AB.Fuga, T.Fuga
	lockFor(humanoid, Tt.Duration)
	fx("Fuga", { char = character })
	task.delay(Tt.Release, function()
		if not alive(character) then
			return
		end
		local look = root.CFrame.LookVector
		local origin = (root.CFrame * CFrame.new(0.2, 0.9, -2.4)).Position
		local target = aim or (origin + look * ab.MaxRange)
		local dir = target - origin
		dir = if dir.Magnitude > 1 then dir.Unit else look
		if dir:Dot(look) < 0.2 then
			dir = look
		end
		local result = Workspace:Raycast(origin, dir * ab.MaxRange, rayParams(character))
		local hitPos = if result then result.Position else origin + dir * ab.MaxRange
		local travel = (hitPos - origin).Magnitude / ab.Speed
		fx("FugaRelease", {
			char = character,
			origin = origin,
			hitPos = hitPos,
			travel = travel,
			radius = ab.Radius,
		})
		task.delay(travel, function()
			fugaExplosion(player, character, hitPos)
		end)
	end)
	return Tt.Duration, ab.Cooldown
end

function Abilities.Domain(player: Player, st, character: Model, humanoid: Humanoid, root: BasePart, aim: Vector3?)
	local ab, Td = AB.Domain, T.Domain
	if st.domainActive then
		return nil
	end
	st.domainActive = true
	local look = flatDirection(root, nil)
	local center = root.Position
	local ground = Workspace:Raycast(center, Vector3.new(0, -40, 0), rayParams(character))
	local groundY = if ground then ground.Position.Y else center.Y - 3

	lockFor(humanoid, Td.CasterLock)
	invulnerable(character, Td.CasterLock)
	fx("Domain", {
		char = character,
		center = center,
		look = look,
		ground = groundY,
		radius = ab.Radius,
	})

	task.delay(Td.SlashStart, function()
		local finish = os.clock() + (Td.SlashEnd - Td.SlashStart)
		while os.clock() < finish and alive(character) do
			local hits = {}
			for _, h in queryRadius(center, ab.Radius, character) do
				if damage(player, h, ab.TickDamage, { fx = false, stun = ab.TickRate + 0.05, stunSpeed = ab.SlowSpeed }) then
					table.insert(hits, h.Parent)
				end
			end
			if #hits > 0 then
				fx("DomainHits", { char = character, targets = hits })
			end
			task.wait(ab.TickRate)
		end
		st.domainActive = false
	end)
	-- safety: never leave the flag stuck
	task.delay(Td.Collapse + 1, function()
		st.domainActive = false
	end)
	return Td.CasterLock, ab.Cooldown
end

function Abilities.WorldSlash(player: Player, st, character: Model, humanoid: Humanoid, root: BasePart, aim: Vector3?)
	local ab, Tw = AB.WorldSlash, T.WorldSlash
	local look = flatDirection(root, aim)
	local origin = CFrame.lookAt(root.Position, root.Position + look)
	lockFor(humanoid, Tw.Duration)
	invulnerable(character, Tw.Slash + 0.3)
	fx("WorldSlash", { char = character, origin = origin, length = ab.Length, height = ab.Height })
	task.delay(Tw.Slash, function()
		if not alive(character) then
			return
		end
		local cf = origin * CFrame.new(0, ab.Height / 2 - 6, -ab.Length / 2)
		for _, h in queryBox(cf, Vector3.new(ab.Width, ab.Height, ab.Length), character) do
			local r = rootOfHumanoid(h)
			local side = if r then math.sign(origin.RightVector:Dot(r.Position - origin.Position)) else 1
			if side == 0 then
				side = 1
			end
			damage(player, h, ab.Damage, {
				kind = "slash",
				heavy = true,
				knock = origin.RightVector * side * 60 + Vector3.new(0, 30, 0),
				knockTime = 0.3,
				stun = 1,
			})
		end
	end)
	return Tw.Duration, ab.Cooldown
end

local function useAbility(player: Player, name: string, aim: Vector3?)
	local handler = Abilities[name]
	if not handler or not AB[name] then
		return
	end
	if not player:GetAttribute("SukunaPowered") then
		return
	end
	local character = player.Character
	local humanoid, root = partsOf(character)
	if not character or not humanoid or not root or humanoid.Health <= 0 then
		return
	end
	if not character:GetAttribute("SukunaActive") then
		return
	end
	local st = stateOf(player)
	local now = os.clock()
	if st.transforming or now < st.busyUntil or now < (st.cooldowns[name] or 0) or isStunned(humanoid) then
		return
	end
	local ok, busy, cooldown, silent = pcall(handler, player, st, character, humanoid, root, aim)
	if not ok then
		warn("[SukunaServer] " .. name .. " failed: " .. tostring(busy))
		return
	end
	if not busy then
		return
	end
	st.busyUntil = now + busy
	st.cooldowns[name] = now + cooldown
	if not silent then
		remote:FireClient(player, "Cooldown", name, cooldown)
	end
end

remote.OnServerEvent:Connect(function(player: Player, action, payload)
	if action ~= "Ability" or type(payload) ~= "table" then
		return
	end
	local name = payload.name
	if type(name) ~= "string" then
		return
	end
	local aim = payload.aim
	if typeof(aim) ~= "Vector3" or aim ~= aim or aim.Magnitude > 1e6 then
		aim = nil
	end
	useAbility(player, name, aim)
end)

----------------------------------------------------------------------
-- Players
----------------------------------------------------------------------

local function onCharacter(player: Player, character: Model)
	setCharacterGroup(character)
	local st = stateOf(player)
	st.busyUntil = 0
	st.transforming = false
	st.combo = 0
	if not player:GetAttribute("SukunaPowered") then
		return
	end
	if not Config.KeepPowersOnRespawn then
		player:SetAttribute("SukunaPowered", false)
		return
	end
	-- wait until the avatar's body parts are loaded so markings stick
	local start = os.clock()
	while not player:HasAppearanceLoaded() and os.clock() - start < 6 do
		task.wait(0.2)
	end
	task.wait(0.3)
	if player.Character == character and alive(character) then
		applyPowerState(player, character)
	end
end

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
end)
for _, player in Players:GetPlayers() do
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
end

Players.PlayerRemoving:Connect(function(player)
	states[player] = nil
end)

----------------------------------------------------------------------
-- Cube setup
----------------------------------------------------------------------

if cube and cube:IsA("BasePart") then
	local detector = cube:FindFirstChildOfClass("ClickDetector")
	if not detector then
		detector = Instance.new("ClickDetector")
		detector.Parent = cube
	end
	detector.MaxActivationDistance = Config.Cube.ClickDistance

	if not cube:FindFirstChild("SukunaLabel") then
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "SukunaLabel"
		billboard.Size = UDim2.fromOffset(260, 70)
		billboard.StudsOffset = Vector3.new(0, 4.2, 0)
		billboard.MaxDistance = 90
		billboard.LightInfluence = 0
		billboard.Parent = cube

		local title = Instance.new("TextLabel")
		title.BackgroundTransparency = 1
		title.Size = UDim2.fromScale(1, 0.6)
		title.Font = Enum.Font.GothamBlack
		title.Text = "両面宿儺 · SUKUNA'S FINGER"
		title.TextScaled = true
		title.TextColor3 = Color3.fromRGB(255, 230, 230)
		title.Parent = billboard
		local stroke = Instance.new("UIStroke")
		stroke.Color = Color3.fromRGB(150, 0, 15)
		stroke.Thickness = 2
		stroke.Parent = title

		local hint = Instance.new("TextLabel")
		hint.BackgroundTransparency = 1
		hint.Position = UDim2.fromScale(0, 0.6)
		hint.Size = UDim2.fromScale(1, 0.4)
		hint.Font = Enum.Font.GothamBold
		hint.Text = "Click to awaken the King of Curses"
		hint.TextScaled = true
		hint.TextColor3 = Color3.fromRGB(255, 90, 100)
		hint.Parent = billboard
	end

	if not cube:FindFirstChild("CurseParticles") then
		local particles = Instance.new("ParticleEmitter")
		particles.Name = "CurseParticles"
		particles.Color = ColorSequence.new(C.Curse, C.Black)
		particles.LightEmission = 1
		particles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) })
		particles.Lifetime = NumberRange.new(1, 2)
		particles.Speed = NumberRange.new(1, 3)
		particles.SpreadAngle = Vector2.new(180, 180)
		particles.Acceleration = Vector3.new(0, 2, 0)
		particles.Rate = 25
		particles.Parent = cube
	end
	if not cube:FindFirstChildOfClass("PointLight") then
		local light = Instance.new("PointLight")
		light.Color = C.Curse
		light.Range = 14
		light.Brightness = 3
		light.Parent = cube
	end

	detector.MouseClick:Connect(grantPowers)
else
	warn("[SukunaServer] Could not find a part named '" .. Config.Cube.Name .. "' in Workspace.")
end

----------------------------------------------------------------------
-- Training dummies (R15)
----------------------------------------------------------------------

if Config.Dummies.Enabled then
	local folder = Workspace:FindFirstChild("SukunaDummies") or Instance.new("Folder")
	folder.Name = "SukunaDummies"
	folder.Parent = Workspace

	local basePos = if cube and cube:IsA("BasePart") then cube.Position else Vector3.new(0, 4, 0)
	-- dummies stand on the far side of the cube (the spawn is on its +Z side)
	local baseLook = if cube and cube:IsA("BasePart") then cube.CFrame.LookVector else Vector3.new(0, 0, -1)
	baseLook = Vector3.new(baseLook.X, 0, baseLook.Z).Unit

	local function spawnDummy(slot: number)
		local ok, model = pcall(function()
			local desc = Instance.new("HumanoidDescription")
			local skin = Color3.fromRGB(110, 100, 120)
			desc.HeadColor = skin
			desc.TorsoColor = Color3.fromRGB(60, 50, 70)
			desc.LeftArmColor = skin
			desc.RightArmColor = skin
			desc.LeftLegColor = Color3.fromRGB(45, 40, 55)
			desc.RightLegColor = Color3.fromRGB(45, 40, 55)
			return Players:CreateHumanoidModelFromDescriptionAsync(desc, Enum.HumanoidRigType.R15)
		end)
		if not ok or not model then
			warn("[SukunaServer] Could not create dummy: " .. tostring(model))
			return
		end
		model.Name = "Cursed Spirit Dummy"
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.DisplayName = "Cursed Spirit"
			humanoid.MaxHealth = Config.Dummies.Health
			humanoid.Health = Config.Dummies.Health
			humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOn
		end
		local count = Config.Dummies.Count
		local right = baseLook:Cross(Vector3.yAxis)
		local spread = (slot - (count + 1) / 2) * 9
		local pos = basePos + baseLook * Config.Dummies.Distance + right * spread
		local ray = Workspace:Raycast(pos + Vector3.new(0, 20, 0), Vector3.new(0, -60, 0), rayParams(nil))
		local groundY = if ray then ray.Position.Y else 0
		local hip = if humanoid then humanoid.HipHeight else 2
		local rootPart = model:FindFirstChild("HumanoidRootPart")
		local rootHalf = if rootPart and rootPart:IsA("BasePart") then rootPart.Size.Y / 2 else 1
		local spawnPos = Vector3.new(pos.X, groundY + hip + rootHalf + 0.1, pos.Z)
		model:PivotTo(CFrame.lookAt(spawnPos, spawnPos - baseLook))
		model.Parent = folder
		setCharacterGroup(model)
		if rootPart and rootPart:IsA("BasePart") then
			pcall(function()
				rootPart:SetNetworkOwner(nil)
			end)
		end
		if humanoid then
			humanoid.Died:Connect(function()
				task.wait(Config.Dummies.RespawnTime)
				model:Destroy()
				spawnDummy(slot)
			end)
		end
	end

	task.spawn(function()
		for i = 1, Config.Dummies.Count do
			spawnDummy(i)
		end
	end)
end

print("[SukunaServer] Ready — click the red cube to receive Sukuna's power.")
