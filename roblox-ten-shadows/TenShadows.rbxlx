			{"Halo1", "Block", {1.2, 0.22, 0.22}, {1.905, 13.3, 1.6}, {0, 0, 120}, {255, 226, 150}, "Neon", "Body", 0},
			{"Halo2", "Block", {1.2, 0.22, 0.22}, {1.1, 14.105, 1.6}, {0, 0, 150}, {255, 226, 150}, "Neon", "Body", 0},
