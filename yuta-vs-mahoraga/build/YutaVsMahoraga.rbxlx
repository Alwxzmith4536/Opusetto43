      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[--!strict
-- Small math helpers shared by server and client.

local Util = {}

function Util.flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

function Util.flatUnit(v: Vector3, fallback: Vector3?): Vector3
	local f = Vector3.new(v.X, 0, v.Z)
	if f.Magnitude < 1e-4 then
		return fallback or Vector3.new(0, 0, -1)
	end
	return f.Unit
end

function Util.now(): number
	return workspace:GetServerTimeNow()
end

function Util.lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

function Util.clamp01(t: number): number
	return math.clamp(t, 0, 1)
end

-- Horizontal facing frame at `pos` looking along `dir`.
function Util.facing(pos: Vector3, dir: Vector3): CFrame
	local d = Util.flatUnit(dir)
	return CFrame.lookAt(pos, pos + d)
end

function Util.formatTime(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

function Util.randomBetween(rng: Random, a: number, b: number): number
	return a + (b - a) * rng:NextNumber()
end

-- Picks a key from { key = weight } using `rng`.
function Util.weightedPick(rng: Random, weights: { [string]: number }): string?
	local total = 0
	for _, w in weights do
		total += w
	end
	if total <= 0 then
		return nil
	end
	local roll = rng:NextNumber() * total
	local last: string? = nil
	for key, w in weights do
		last = key
		roll -= w
		if roll <= 0 then
			return key
		end
	end
	return last
end

return Util
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="16">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="17">
      <Properties>
        <string name="Name">JJKServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Yuta Okkotsu vs Mahoraga: server entry point.
-- Builds the arena first (so nobody spawns into the void), then starts the kit and the altar.

local World = require(script:WaitForChild("World"))
local YutaKit = require(script:WaitForChild("YutaKit"))

World.start()
YutaKit.start()

print("[JJK] Yuta Okkotsu vs Mahoraga is ready. Hold P at the altar to summon Mahoraga.")
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Combat</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Server combat core: who can hit whom, hit shapes, damage, stuns, knockback,
	blocking and damage numbers.

	No instant kills from the boss: every Mahoraga hit on a player is capped at
	Config.Boss.MaxHitFraction of the player's max health, and each hit grants a
	short immunity window (Config.Boss.HitInvulnerability) so multi-hit attacks
	cannot stack into a one-shot.
]]

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("JJKShared")
local Config = require(Shared:WaitForChild("Config"))
local Palette = require(Shared:WaitForChild("Palette"))
local FX = require(script.Parent.FX)

export type Kind = "Player" | "Boss" | "Dummy"

export type HitInfo = {
	Type: string, -- adaptation category, e.g. "Katana"
	CastId: string?, -- shared by every tick of one cast
	Knockback: Vector3?,
	KnockbackTime: number?,
	Stun: number?,
	Unblockable: boolean?,
	Color: Color3?,
	Tag: string?, -- set by ModifyIncoming: "adapt", "immune", "infinity"
}

export type Entity = {
	Model: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	Kind: Kind,
	Player: Player?,
	Radius: number,
	HalfHeight: number,
	StunnedUntil: number,
	ImmuneUntil: number,
	DodgeUntil: number,
	Blocking: boolean,
	ModifyIncoming: ((amount: number, info: HitInfo, attacker: Entity?) -> number)?,
	ModifyStun: ((duration: number, info: HitInfo) -> number)?,
	OnDamaged: ((amount: number, info: HitInfo, attacker: Entity?) -> ())?,
	Controller: any?, -- the boss object, for adaptation queries
}

local Combat = {}

local entities: { [Model]: Entity } = {}

function Combat.register(model: Model, humanoid: Humanoid, root: BasePart, kind: Kind, player: Player?): Entity
	local entity: Entity = {
		Model = model,
		Humanoid = humanoid,
		Root = root,
		Kind = kind,
		Player = player,
		Radius = (model:GetAttribute("JJK_HitRadius") :: number?) or 1.8,
		HalfHeight = (model:GetAttribute("JJK_HitHalfHeight") :: number?) or 3,
		StunnedUntil = 0,
		ImmuneUntil = 0,
		DodgeUntil = 0,
		Blocking = false,
	}
	entities[model] = entity
	model.AncestryChanged:Connect(function(_, parent)
		if parent == nil and entities[model] == entity then
			entities[model] = nil
		end
	end)
	return entity
end

function Combat.unregister(entity: Entity)
	if entities[entity.Model] == entity then
		entities[entity.Model] = nil
	end
end

function Combat.get(model: Model): Entity?
	return entities[model]
end

function Combat.isAlive(e: Entity): boolean
	return entities[e.Model] == e and e.Humanoid.Health > 0 and e.Model.Parent ~= nil and e.Root.Parent ~= nil
end

function Combat.isEnemy(a: Entity, b: Entity): boolean
	if a == b then
		return false
	end
	if a.Kind == "Player" then
		if b.Kind == "Player" then
			return Config.Rules.PvP
		end
		return true
	elseif a.Kind == "Boss" then
		return b.Kind == "Player"
	end
	return false
end

function Combat.enemiesOf(attacker: Entity): { Entity }
	local list = {}
	for _, e in entities do
		if Combat.isEnemy(attacker, e) and Combat.isAlive(e) then
			table.insert(list, e)
		end
	end
	return list
end

function Combat.alliesOf(entity: Entity): { Entity }
	local list = {}
	for _, e in entities do
		if e ~= entity and e.Kind == entity.Kind and Combat.isAlive(e) then
			table.insert(list, e)
		end
	end
	return list
end

function Combat.query(attacker: Entity, test: (Entity) -> boolean): { Entity }
	local list = {}
	for _, e in Combat.enemiesOf(attacker) do
		if test(e) then
			table.insert(list, e)
		end
	end
	return list
end

-- Hit shapes treat every target as an upright cylinder (Radius, HalfHeight) around its root.

function Combat.inBox(e: Entity, cf: CFrame, size: Vector3): boolean
	local p = cf:PointToObjectSpace(e.Root.Position)
	return math.abs(p.X) <= size.X / 2 + e.Radius and math.abs(p.Y) <= size.Y / 2 + e.HalfHeight and math.abs(p.Z) <= size.Z / 2 + e.Radius
end

function Combat.inSphere(e: Entity, center: Vector3, radius: number): boolean
	local d = e.Root.Position - center
	local flat = Vector3.new(d.X, 0, d.Z).Magnitude
	return flat <= radius + e.Radius and math.abs(d.Y) <= radius + e.HalfHeight
end

-- Pie slice centred on cf's look vector; `height` is how far above/below cf it reaches.
function Combat.inArc(e: Entity, cf: CFrame, radius: number, arcDegrees: number, height: number): boolean
	local p = cf:PointToObjectSpace(e.Root.Position)
	if math.abs(p.Y) > height + e.HalfHeight then
		return false
	end
	local flat = Vector3.new(p.X, 0, p.Z)
	local dist = flat.Magnitude
	if dist > radius + e.Radius then
		return false
	end
	if dist <= e.Radius + 1 then
		return true
	end
	local angle = math.deg(math.atan2(p.X, -p.Z))
	local slack = math.deg(math.atan(e.Radius / dist))
	return math.abs(angle) <= arcDegrees / 2 + slack
end

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude

local function refreshGroundFilter()
	local list: { Instance } = {}
	for model in entities do
		table.insert(list, model)
	end
	local fxFolder = workspace:FindFirstChild("JJK_FX")
	if fxFolder then
		table.insert(list, fxFolder)
	end
	groundParams.FilterDescendantsInstances = list
end

-- Point on the ground below `pos` (ignores characters and bosses).
function Combat.groundAt(pos: Vector3): Vector3
	refreshGroundFilter()
	local hit = workspace:Raycast(pos + Vector3.new(0, 4, 0), Vector3.new(0, -120, 0), groundParams)
	if hit then
		return hit.Position
	end
	return Vector3.new(pos.X, Config.World.ArenaCenter.Y, pos.Z)
end

-- Height of the root above the ground; used for "jump over the shockwave" checks.
function Combat.heightAboveGround(e: Entity): number
	return e.Root.Position.Y - Combat.groundAt(e.Root.Position).Y
end

function Combat.worldRaycast(origin: Vector3, direction: Vector3): RaycastResult?
	refreshGroundFilter()
	return workspace:Raycast(origin, direction, groundParams)
end

function Combat.knockback(target: Entity, velocity: Vector3, duration: number)
	if target.Kind == "Boss" or target.Root.Anchored then
		return
	end
	local root = target.Root
	for _, child in root:GetChildren() do
		if child.Name == "JJK_Knockback" then
			child:Destroy()
		end
	end
	local attachment = root:FindFirstChild("JJK_KnockbackAttachment") :: Attachment?
	if not attachment then
		local a = Instance.new("Attachment")
		a.Name = "JJK_KnockbackAttachment"
		a.Parent = root
		attachment = a
	end
	local force = Instance.new("LinearVelocity")
	force.Name = "JJK_Knockback"
	force.Attachment0 = attachment
	force.RelativeTo = Enum.ActuatorRelativeTo.World
	force.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	force.MaxForce = 1e6
	force.VectorVelocity = velocity
	force.Parent = root
	Debris:AddItem(force, duration)
end

function Combat.stun(target: Entity, duration: number, info: HitInfo?)
	if target.ModifyStun and info then
		duration = target.ModifyStun(duration, info)
	end
	if duration <= 0.05 then
		return
	end
	target.StunnedUntil = math.max(target.StunnedUntil, os.clock() + duration)
	FX.all("Stun", { model = target.Model, duration = duration })
end

local function numberFx(target: Entity, amount: number, tag: string?, color: Color3?)
	local pos = target.Root.Position + Vector3.new(0, target.HalfHeight * 0.6 + 1.5, 0)
	FX.near(pos, 250, "Damage", { pos = pos, amount = amount, tag = tag, color = color })
end

-- Applies a hit. Returns the damage actually dealt.
function Combat.damage(attacker: Entity?, target: Entity, amount: number, info: HitInfo): number
	if not Combat.isAlive(target) then
		return 0
	end
	local now = os.clock()
	local fromBoss = attacker ~= nil and attacker.Kind == "Boss" and target.Kind == "Player"

	if fromBoss and target.DodgeUntil > now then
		numberFx(target, 0, "dodge")
		return 0
	end
	if fromBoss and target.ImmuneUntil > now then
		return 0
	end

	local dmg = amount
	if target.ModifyIncoming then
		dmg = target.ModifyIncoming(dmg, info, attacker)
	end
	if target.Blocking and not info.Unblockable then
		dmg *= 1 - Config.Player.BlockReduction
		info.Tag = info.Tag or "block"
	end
	if fromBoss then
		dmg = math.min(dmg, target.Humanoid.MaxHealth * Config.Boss.MaxHitFraction)
		target.ImmuneUntil = now + Config.Boss.HitInvulnerability
	end
	dmg = math.max(0, dmg)

	if dmg > 0 then
		target.Humanoid:TakeDamage(dmg)
	end
	local stillResisted = info.Tag == "immune"
	if not stillResisted then
		if info.Knockback then
			Combat.knockback(target, info.Knockback, info.KnockbackTime or 0.2)
		end
		if info.Stun then
			Combat.stun(target, info.Stun, info)
		end
	end
	if target.OnDamaged then
		target.OnDamaged(dmg, info, attacker)
	end

	numberFx(target, dmg, info.Tag or (if target.Kind == "Player" then "player" else nil), info.Color)
	if dmg > 0 then
		FX.near(target.Root.Position, 250, "Hit", { pos = target.Root.Position, color = info.Color or Palette.YutaEnergy, big = dmg >= 40 })
	end
	return dmg
end

function Combat.heal(target: Entity, amount: number)
	if not Combat.isAlive(target) then
		return
	end
	local h = target.Humanoid
	local before = h.Health
	h.Health = math.min(h.MaxHealth, h.Health + amount)
	local healed = h.Health - before
	if healed > 0.5 then
		numberFx(target, healed, "heal")
	end
end

return Combat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">FX</string>
          <string name="Source"><![CDATA[--!strict
-- Sends visual-effect events to clients. The server decides what happens; each
-- client builds and animates the effect locally, so nothing heavy replicates.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("JJKShared"):WaitForChild("Net"))

local remote = Net.event("FX")

local FX = {}

function FX.all(name: string, data: { [string]: any })
	remote:FireAllClients(name, data)
end

function FX.to(player: Player, name: string, data: { [string]: any })
	remote:FireClient(player, name, data)
end

-- Only players whose character is within `radius` of `pos`.
function FX.near(pos: Vector3, radius: number, name: string, data: { [string]: any })
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") and (root.Position - pos).Magnitude <= radius then
			remote:FireClient(player, name, data)
		end
	end
end

function FX.shake(pos: Vector3, intensity: number, duration: number, radius: number)
	FX.near(pos, radius, "Shake", { intensity = intensity, duration = duration })
end

return FX
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">MahoragaBoss</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Mahoraga, the boss.

	Adaptation (canon): every technique that hits Mahoraga is tracked. After enough
	casts of the same technique the Dharma wheel turns one step, Mahoraga heals a
	little and takes 25% less damage from that technique. Four turns = fully
	adapted (immune). It also adapts to Infinity, so Six Eyes mode protects less
	and less the longer you rely on it. Vary your techniques.

	Attacks (all telegraphed on the ground)
	  Sword of Extermination sweep, overhead cleave with a shockwave line,
	  three-hit fist combo, earth-shaking stomp, leap slam, rush,
	  and below 50% health: rings of positive energy you must jump over.

	Damage to players goes through Combat.damage, which caps every boss hit at a
	fraction of the player's max health (no instant kills).
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("JJKShared")
local Config = require(Shared:WaitForChild("Config"))
local Palette = require(Shared:WaitForChild("Palette"))
local Util = require(Shared:WaitForChild("Util"))
local Mahoraga = require(Shared:WaitForChild("Assets"):WaitForChild("Mahoraga"))

local Combat = require(script.Parent.Combat)
local FX = require(script.Parent.FX)

local B = Config.Boss
local A = Config.Adaptation
local D = B.Damage

type AdaptState = { Level: number, Casts: number, Seen: { [string]: boolean } }

type Zone = { Center: Vector3, Radius: number, Until: number }

type BossState = {
	Model: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	Entity: Combat.Entity,
	Alive: boolean,
	Busy: boolean,
	Phase: number,
	Anim: string,
	Cooldowns: { [string]: number },
	NextAttack: number,
	Adapt: { [string]: AdaptState },
	WheelTurns: number,
	Threat: { [Player]: number },
	DamageBy: { [Player]: number },
	Target: Combat.Entity?,
	Zone: Zone?,
	IdleTime: number,
	Rng: Random,
	OnEnded: (() -> ())?,
	-- Methods other systems call with ':' (YutaKit uses them for Infinity and the domain).
	AdaptFraction: (any, string) -> number,
	RegisterCast: (any, string, string?) -> (),
	Confine: (any, Vector3, number, number) -> (),
}

local MahoragaBoss = {}

local current: BossState? = nil

-- Helpers ------------------------------------------------------------------------------

local function setAnim(b: BossState, name: string)
	b.Anim = name
	b.Model:SetAttribute("JJK_Anim", name)
	b.Model:SetAttribute("JJK_AnimT", workspace:GetServerTimeNow())
end

local function release(b: BossState)
	b.Root.Anchored = false
	pcall(function()
		b.Root:SetNetworkOwner(nil)
	end)
end

local function groundCF(b: BossState): CFrame
	local ground = Combat.groundAt(b.Root.Position)
	return Util.facing(ground, b.Root.CFrame.LookVector)
end

local function face(b: BossState, pos: Vector3)
	local r = b.Root
	r.CFrame = Util.facing(r.Position, pos - r.Position)
end

local function stop(b: BossState)
	b.Humanoid:MoveTo(b.Root.Position)
end

local function windup(b: BossState, seconds: number): number
	return seconds * (B.WindupScale[b.Phase] or 1)
end

-- Waits, but gives up early if Mahoraga dies or gets stunned (Cursed Speech interrupts attacks).
local function waitFor(b: BossState, seconds: number): boolean
	local t = 0
	while t < seconds do
		t += task.wait(0.05)
		if not b.Alive or b.Entity.StunnedUntil > os.clock() then
			return false
		end
	end
	return true
end

local function inBounds(b: BossState, pos: Vector3): boolean
	if Config.World.BuildArena then
		local c = Config.World.ArenaCenter
		local half = Config.World.ArenaSize / 2 - 14
		if math.abs(pos.X - c.X) > half or math.abs(pos.Z - c.Z) > half then
			return false
		end
	end
	local zone = b.Zone
	if zone and zone.Until > os.clock() and Util.flat(pos - zone.Center).Magnitude > zone.Radius then
		return false
	end
	return true
end

local function clampPoint(b: BossState, pos: Vector3): Vector3
	local p = pos
	if Config.World.BuildArena then
		local c = Config.World.ArenaCenter
		local half = Config.World.ArenaSize / 2 - 14
		p = Vector3.new(math.clamp(p.X, c.X - half, c.X + half), p.Y, math.clamp(p.Z, c.Z - half, c.Z + half))
	end
	local zone = b.Zone
	if zone and zone.Until > os.clock() then
		local offset = Util.flat(p - zone.Center)
		if offset.Magnitude > zone.Radius then
			local edge = zone.Center + offset.Unit * zone.Radius
			p = Vector3.new(edge.X, p.Y, edge.Z)
		end
	end
	return p
end

local function clampLength(b: BossState, cf: CFrame, length: number): number
	local l = length
	while l > 6 and not inBounds(b, (cf * CFrame.new(0, 0, -l)).Position) do
		l -= 4
	end
	return l
end

-- Adaptation -----------------------------------------------------------------------------

local function adaptLevel(b: BossState, kind: string): number
	local a = b.Adapt[kind]
	return if a then a.Level else 0
end

local function resist(b: BossState, kind: string): number
	return math.min(1, adaptLevel(b, kind) * A.ResistPerLevel)
end

local function turnWheel(b: BossState, kind: string, level: number)
	b.WheelTurns += 1
	b.Model:SetAttribute("JJK_WheelTurns", b.WheelTurns)
	local h = b.Humanoid
	local heal = h.MaxHealth * A.HealPerTurn
	h.Health = math.min(h.MaxHealth, h.Health + heal)
	FX.all("WheelTurn", {
		boss = b.Model,
		typeName = A.DisplayNames[kind] or kind,
		level = level,
		maxLevel = A.MaxLevel,
		turns = b.WheelTurns,
		heal = heal,
	})
end

local function registerCast(b: BossState, kind: string, castId: string?)
	local a = b.Adapt[kind]
	if not a then
		a = { Level = 0, Casts = 0, Seen = {} }
		b.Adapt[kind] = a
	end
	local state = a :: AdaptState
	if state.Level >= A.MaxLevel then
		return
	end
	if castId then
		if state.Seen[castId] then
			return
		end
		state.Seen[castId] = true
	end
	state.Casts += 1
	local need = A.CastsPerTurn[kind] or A.CastsPerTurn.Default
	if b.Phase >= 3 then
		need = math.max(1, need - 1)
	end
	if state.Casts >= need then
		state.Casts = 0
		state.Level += 1
		state.Seen = {}
		turnWheel(b, kind, state.Level)
	end
	b.Model:SetAttribute("JJK_Adapt_" .. kind, state.Level + state.Casts / need)
end

-- Phases, threat, death ------------------------------------------------------------------

local function setPhase(b: BossState, phase: number)
	if phase <= b.Phase then
		return
	end
	b.Phase = phase
	b.Model:SetAttribute("JJK_Phase", phase)
	b.Humanoid.WalkSpeed = if phase >= 2 then B.EnragedWalkSpeed else B.WalkSpeed
	if phase == 2 then
		FX.all("Announce", { title = "魔虚羅", sub = "Mahoraga is enraged - watch for the rings!", color = Palette.Danger, time = 2.4 })
	else
		FX.all("Announce", { title = "適応", sub = "Adaptation accelerates", color = Palette.Wheel, time = 2.4 })
	end
end

local function die(b: BossState)
	if not b.Alive then
		return
	end
	b.Alive = false
	b.Busy = true
	Combat.unregister(b.Entity)
	setAnim(b, "Death")
	b.Root.Anchored = true
	local best: Player? = nil
	local bestDamage = 0
	for player, dmg in b.DamageBy do
		if dmg > bestDamage and player.Parent then
			best, bestDamage = player, dmg
		end
	end
	FX.all("BossDeath", { boss = b.Model, pos = b.Root.Position })
	FX.all("Announce", {
		title = "調伏",
		sub = if best then ("Mahoraga has been exorcised!  MVP: %s (%d damage)"):format(best.DisplayName, math.floor(bestDamage)) else "Mahoraga has been exorcised!",
		color = Palette.Wheel,
		time = 4,
	})
	task.delay(4.5, function()
		b.Model:Destroy()
	end)
	if current == b then
		current = nil
	end
	if b.OnEnded then
		b.OnEnded()
	end
end

local function despawn(b: BossState)
	if not b.Alive then
		return
	end
	b.Alive = false
	Combat.unregister(b.Entity)
	FX.all("Summon", { pos = Combat.groundAt(b.Root.Position), time = 1.5, reverse = true })
	FX.all("Announce", { title = "魔虚羅", sub = "Mahoraga sinks back into the shadows", color = Palette.YutaEnergy, time = 2.5 })
	b.Root.Anchored = true
	local tween = TweenService:Create(b.Root, TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		CFrame = b.Root.CFrame * CFrame.new(0, -34, 0),
	})
	tween:Play()
	task.delay(1.6, function()
		b.Model:Destroy()
	end)
	if current == b then
		current = nil
	end
	if b.OnEnded then
		b.OnEnded()
	end
end

local function pickTarget(b: BossState): Combat.Entity?
	local best: Combat.Entity? = nil
	local bestScore = -math.huge
	for _, e in Combat.enemiesOf(b.Entity) do
		local d = (e.Root.Position - b.Root.Position).Magnitude
		if d < 420 and e.Player then
			local score = (b.Threat[e.Player] or 0) / 150 - d / 40
			if e == b.Target then
				score += 1.5
			end
			if score > bestScore then
				best, bestScore = e, score
			end
		end
	end
	return best
end

-- Attacks ------------------------------------------------------------------------------

local attacks: { [string]: (BossState, Combat.Entity) -> () } = {}

attacks.Sweep = function(b, target)
	face(b, target.Root.Position)
	local cf = groundCF(b)
	local wind = windup(b, 0.8)
	setAnim(b, "SweepWindup")
	FX.all("Telegraph", { shape = "arc", cf = cf, radius = 24, arc = 200, time = wind, color = Palette.Danger })
	if not waitFor(b, wind) then
		return
	end
	setAnim(b, "Sweep")
	FX.all("BossSlash", { cf = cf * CFrame.new(0, 9, 0), radius = 19, arc = 200, kind = "sweep" })
	FX.shake(cf.Position, 0.8, 0.35, 140)
	for _, e in Combat.query(b.Entity, function(e)
		return Combat.inArc(e, cf, 24, 200, 12)
	end) do
		local away = Util.flatUnit(e.Root.Position - cf.Position, cf.LookVector)
		Combat.damage(b.Entity, e, D.Sweep, {
			Type = "Sword",
			Knockback = away * 60 + Vector3.new(0, 30, 0),
			KnockbackTime = 0.25,
			Stun = 0.3,
			Color = Palette.Positive,
		})
	end
	task.wait(0.55)
end

attacks.Cleave = function(b, target)
	face(b, target.Root.Position)
	local cf = groundCF(b)
	local length = clampLength(b, cf, 72)
	local width = 10
	local wind = windup(b, 0.9)
	setAnim(b, "CleaveWindup")
	FX.all("Telegraph", { shape = "rect", cf = cf * CFrame.new(0, 0, -3), width = width, length = length, time = wind, color = Palette.Positive })
	if not waitFor(b, wind) then
		return
	end
	setAnim(b, "Cleave")
	FX.all("BossSlash", { cf = cf * CFrame.new(0, 10, -6) * CFrame.Angles(0, 0, math.rad(90)), radius = 12, arc = 160, kind = "cleave" })
	FX.all("BossWave", { cf = cf * CFrame.new(0, 0, -3), length = length, width = width })
	FX.shake(cf.Position, 1.1, 0.5, 160)
	local box = cf * CFrame.new(0, 4, -3 - length / 2)
	local size = Vector3.new(width, 10, length)
	for _, e in Combat.query(b.Entity, function(e)
		return Combat.inBox(e, box, size)
	end) do
		Combat.damage(b.Entity, e, D.Cleave, {
			Type = "Sword",
			Unblockable = true,
			Knockback = cf.LookVector * 30 + Vector3.new(0, 50, 0),
			KnockbackTime = 0.3,
			Stun = 0.4,
			Color = Palette.Positive,
		})
	end
	task.wait(0.7)
end

attacks.Punch = function(b, target)
	for i = 1, 3 do
		if not Combat.isAlive(target) then
			break
		end
		face(b, target.Root.Position)
		local cf = groundCF(b)
		local point = cf * CFrame.new(0, 0, -10)
		local right = i % 2 == 1
		local wind = windup(b, 0.4)
		setAnim(b, if right then "PunchWindupR" else "PunchWindupL")
		FX.all("Telegraph", { shape = "circle", cf = point, radius = 8, time = wind, color = Palette.Danger })
		if not waitFor(b, wind) then
			return
		end
		setAnim(b, if right then "PunchR" else "PunchL")
		FX.all("Impact", { pos = point.Position, radius = 8, color = Palette.Positive, cracks = i == 3 })
		local strong = i == 3
		for _, e in Combat.query(b.Entity, function(e)
			return Combat.inSphere(e, point.Position + Vector3.new(0, 3, 0), 8)
		end) do
			Combat.damage(b.Entity, e, D.Punch, {
				Type = "Fist",
				Knockback = cf.LookVector * (if strong then 70 else 25) + Vector3.new(0, if strong then 35 else 10, 0),
				KnockbackTime = 0.2,
				Stun = 0.25,
				Color = Palette.Positive,
			})
		end
		task.wait(0.22)
	end
	task.wait(0.4)
end

attacks.Stomp = function(b, _target)
	local cf = groundCF(b)
	local radius = 26
	local wind = windup(b, 0.95)
	setAnim(b, "StompWindup")
	FX.all("Telegraph", { shape = "circle", cf = cf, radius = radius, time = wind, color = Palette.Danger })
	if not waitFor(b, wind) then
		return
	end
	setAnim(b, "Stomp")
	FX.all("Impact", { pos = cf.Position, radius = radius, color = Palette.Positive, cracks = true, big = true })
	FX.shake(cf.Position, 1.4, 0.6, 180)
	for _, e in Combat.query(b.Entity, function(e)
		return Combat.inSphere(e, cf.Position, radius) and Combat.heightAboveGround(e) < 7
	end) do
		local away = Util.flatUnit(e.Root.Position - cf.Position)
		Combat.damage(b.Entity, e, D.Stomp, {
			Type = "Fist",
			Knockback = away * 45 + Vector3.new(0, 55, 0),
			KnockbackTime = 0.3,
			Stun = 0.35,
			Color = Palette.Positive,
		})
	end
	task.wait(0.6)
end

attacks.Leap = function(b, target)
	face(b, target.Root.Position)
	local landing = clampPoint(b, Combat.groundAt(target.Root.Position))
	local radius = 20
	local crouch = windup(b, 0.45)
	local air = 1.05
	setAnim(b, "LeapCrouch")
	FX.all("Telegraph", { shape = "circle", cf = CFrame.new(landing), radius = radius, time = crouch + air, color = Palette.Danger })
	if not waitFor(b, crouch) then
		return
	end
	setAnim(b, "LeapAir")
	b.Root.Anchored = true
	local startPos = b.Root.Position
	local endPos = landing + Vector3.new(0, Mahoraga.RootHeight, 0)
	local dir = Util.flatUnit(endPos - startPos, b.Root.CFrame.LookVector)
	local t0 = os.clock()
	while b.Alive do
		local a = math.min(1, (os.clock() - t0) / air)
		local pos = startPos:Lerp(endPos, a) + Vector3.new(0, 104 * a * (1 - a), 0)
		b.Root.CFrame = CFrame.lookAt(pos, pos + dir)
		if a >= 1 then
			break
		end
		RunService.Heartbeat:Wait()
	end
	if not b.Alive then
		return
	end
	release(b)
	setAnim(b, "LeapLand")
	FX.all("Impact", { pos = landing, radius = radius, color = Palette.Positive, cracks = true, big = true, rocks = true })
	FX.shake(landing, 1.8, 0.7, 220)
	for _, e in Combat.query(b.Entity, function(e)
		return Combat.inSphere(e, landing + Vector3.new(0, 3, 0), radius)
	end) do
		local away = Util.flatUnit(e.Root.Position - landing)
		Combat.damage(b.Entity, e, D.Leap, {
			Type = "Fist",
			Knockback = away * 60 + Vector3.new(0, 45, 0),
			KnockbackTime = 0.3,
			Stun = 0.4,
			Color = Palette.Positive,
		})
	end
	task.wait(0.8)
end

attacks.Rush = function(b, target)
	face(b, target.Root.Position)
	local cf = groundCF(b)
	local dist = Util.flat(target.Root.Position - b.Root.Position).Magnitude
	local length = clampLength(b, cf, math.clamp(dist + 14, 20, 70))
	local width = 11
	local wind = windup(b, 0.7)
	setAnim(b, "RushWindup")
	FX.all("Telegraph", { shape = "rect", cf = cf, width = width, length = length + 6, time = wind, color = Palette.Danger })
	if not waitFor(b, wind) then
		return
	end
	setAnim(b, "Rush")
	local startPos = b.Root.Position
	local endPos = startPos + cf.LookVector * length
	FX.all("BossRush", { from = startPos, to = endPos })
	b.Root.Anchored = true
	local duration = 0.45
	local t0 = os.clock()
	local hit: { [Combat.Entity]: boolean } = {}
	while b.Alive do
		local a = math.min(1, (os.clock() - t0) / duration)
		local pos = startPos:Lerp(endPos, a)
		b.Root.CFrame = CFrame.lookAt(pos, pos + cf.LookVector)
		local low = pos - Vector3.new(0, Mahoraga.RootHeight - 3, 0)
		for _, e in Combat.query(b.Entity, function(e)
			return Combat.inSphere(e, low, 7)
		end) do
			if not hit[e] then
				hit[e] = true
				local side = Util.flatUnit(e.Root.Position - low, cf.RightVector)
				Combat.damage(b.Entity, e, D.Rush, {
					Type = "Fist",
					Knockback = cf.LookVector * 55 + side * 25 + Vector3.new(0, 30, 0),
					KnockbackTime = 0.3,
					Stun = 0.35,
					Color = Palette.Positive,
				})
			end
		end
		if a >= 1 then
			break
		end
		RunService.Heartbeat:Wait()
	end
	if not b.Alive then
		return
	end
	release(b)
	task.wait(0.6)
end

-- Phase 2+: rings of positive energy roll outward along the ground. Jump over them.
attacks.Rings = function(b, _target)
	local cf = groundCF(b)
	local count = if b.Phase >= 3 then 4 else 3
	local interval, speed, maxRadius = 0.65, 32, 75
	local wind = windup(b, 1.0)
	setAnim(b, "BurstWindup")
	FX.all("Telegraph", { shape = "circle", cf = cf, radius = maxRadius, time = wind, color = Palette.Positive })
	FX.near(cf.Position, 140, "Notify", { text = "Jump over the rings of positive energy!" })
	if not waitFor(b, wind) then
		return
	end
	setAnim(b, "Burst")
	FX.all("BossRings", { center = cf.Position, count = count, interval = interval, speed = speed, maxRadius = maxRadius })
	local t0 = os.clock()
	local hit: { { [Combat.Entity]: boolean } } = {}
	for k = 1, count do
		hit[k] = {}
	end
	local total = (count - 1) * interval + maxRadius / speed
	while b.Alive and os.clock() - t0 < total do
		local elapsed = os.clock() - t0
		for k = 1, count do
			local r = (elapsed - (k - 1) * interval) * speed
			if r > 0 and r < maxRadius then
				for _, e in Combat.enemiesOf(b.Entity) do
					if not hit[k][e] then
						local d = Util.flat(e.Root.Position - cf.Position).Magnitude
						if math.abs(d - r) <= 2.2 + e.Radius * 0.5 and Combat.heightAboveGround(e) < 4.6 then
							hit[k][e] = true
							Combat.damage(b.Entity, e, D.Ring, {
								Type = "Positive",
								Unblockable = true,
								Knockback = Util.flatUnit(e.Root.Position - cf.Position) * 35 + Vector3.new(0, 30, 0),
								KnockbackTime = 0.2,
								Stun = 0.2,
								Color = Palette.Positive,
							})
						end
					end
				end
			end
		end
		RunService.Heartbeat:Wait()
	end
	task.wait(0.3)
end

local function chooseAttack(b: BossState, dist: number): string?
	local now = os.clock()
	local weights: { [string]: number } = {}
	local function add(name: string, weight: number)
		if (b.Cooldowns[name] or 0) <= now then
			weights[name] = weight
		end
	end
	if dist <= 20 then
		add("Sweep", 3)
		add("Punch", 3)
		add("Stomp", 2)
		add("Cleave", 1.5)
	elseif dist <= 60 then
		add("Cleave", 3)
		add("Rush", 3)
		add("Leap", 2)
	else
		add("Leap", 4)
		add("Rush", 1)
	end
	if b.Phase >= 2 and dist <= 70 then
		add("Rings", 2.5)
	end
	return Util.weightedPick(b.Rng, weights)
end

-- AI -----------------------------------------------------------------------------------

local function step(b: BossState, dt: number)
	for player, threat in b.Threat do
		b.Threat[player] = threat * 0.985
	end
	if b.Busy then
		return
	end
	local now = os.clock()
	if b.Entity.StunnedUntil > now then
		stop(b)
		if b.Anim ~= "Stunned" then
			setAnim(b, "Stunned")
		end
		return
	end

	local target = pickTarget(b)
	b.Target = target
	if not target then
		stop(b)
		if b.Anim ~= "Move" then
			setAnim(b, "Move")
		end
		b.IdleTime += dt
		if b.IdleTime > 40 then
			despawn(b)
		end
		return
	end
	b.IdleTime = 0

	local dist = Util.flat(target.Root.Position - b.Root.Position).Magnitude
	if now >= b.NextAttack then
		local attack = chooseAttack(b, dist)
		if attack then
			b.Busy = true
			b.Cooldowns[attack] = now + (B.Cooldowns[attack] or 5)
			stop(b)
			b.Humanoid.AutoRotate = false
			task.spawn(function()
				local ok, err = pcall(function(): string?
					attacks[attack](b, target)
					return nil
				end)
				if not ok then
					warn("[Mahoraga] attack " .. attack .. " failed: " .. tostring(err))
				end
				if b.Alive then
					release(b)
					b.Humanoid.AutoRotate = true
					b.Busy = false
					b.NextAttack = os.clock() + (B.AttackGap[b.Phase] or 0.5)
					setAnim(b, "Move")
				end
			end)
			return
		end
	end

	if b.Anim ~= "Move" then
		setAnim(b, "Move")
	end
	if dist > 11 then
		b.Humanoid:MoveTo(clampPoint(b, target.Root.Position))
	else
		stop(b)
		face(b, target.Root.Position)
	end
end

-- Summoning ----------------------------------------------------------------------------

function MahoragaBoss.isActive(): boolean
	return current ~= nil
end

-- Rises out of the shadows at `spawnCF`. Yields for the summon animation.
function MahoragaBoss.summon(spawnCF: CFrame, onEnded: (() -> ())?): boolean
	if current then
		return false
	end
	local ground = Combat.groundAt(spawnCF.Position + Vector3.new(0, 10, 0))
	local facing = Util.facing(ground, spawnCF.LookVector)

	local model = Mahoraga.build(facing * CFrame.new(0, -34, 0))
	local root = model.PrimaryPart :: BasePart
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= root then
			d.Anchored = false
		end
	end
	root.Anchored = true
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local hp = B.BaseHealth + B.HealthPerExtraPlayer * math.max(0, #Players:GetPlayers() - 1)
	humanoid.MaxHealth = hp
	humanoid.Health = hp
	humanoid.WalkSpeed = B.WalkSpeed
	-- In games with streaming on, stream the whole rig at once so clients can animate it.
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	model:SetAttribute("JJK_Boss", true)
	model:SetAttribute("JJK_Title", B.Title)
	model:SetAttribute("JJK_Name", B.Name)
	model:SetAttribute("JJK_Kanji", B.Kanji)
	model:SetAttribute("JJK_Phase", 1)
	model:SetAttribute("JJK_WheelTurns", 0)
	model:SetAttribute("JJK_Anim", "Summon")
	model:SetAttribute("JJK_AnimT", workspace:GetServerTimeNow())
	model.Parent = workspace
	CollectionService:AddTag(model, "JJK_Mahoraga")

	local placeholder = {} -- reserve the slot while rising
	current = placeholder :: any

	FX.all("Summon", { pos = ground, time = B.SummonTime })
	FX.all("Announce", { title = "布瑠部由良由良", sub = "With this treasure, I summon...", color = Palette.Wheel, time = 2.2 })
	local rise = TweenService:Create(root, TweenInfo.new(B.SummonTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		CFrame = facing * CFrame.new(0, Mahoraga.RootHeight, 0),
	})
	rise:Play()
	rise.Completed:Wait()
	if not model.Parent then
		current = nil
		return false
	end

	local entity = Combat.register(model, humanoid, root, "Boss", nil)
	local b: BossState
	b = {
		Model = model,
		Humanoid = humanoid,
		Root = root,
		Entity = entity,
		Alive = true,
		Busy = false,
		Phase = 1,
		Anim = "Move",
		Cooldowns = {},
		NextAttack = os.clock() + 1.5,
		Adapt = {},
		WheelTurns = 0,
		Threat = {},
		DamageBy = {},
		Target = nil,
		Zone = nil,
		IdleTime = 0,
		Rng = Random.new(),
		OnEnded = onEnded,
		AdaptFraction = function(_self: any, kind: string): number
			return adaptLevel(b, kind) / A.MaxLevel
		end,
		RegisterCast = function(_self: any, kind: string, castId: string?)
			registerCast(b, kind, castId)
		end,
		Confine = function(_self: any, center: Vector3, radius: number, duration: number)
			b.Zone = { Center = center, Radius = radius, Until = os.clock() + duration }
		end,
	}
	current = b
	entity.Controller = b

	entity.ModifyIncoming = function(amount, info, _attacker)
		local r = resist(b, info.Type)
		registerCast(b, info.Type, info.CastId)
		if r >= 1 then
			info.Tag = "immune"
		elseif r > 0 then
			info.Tag = "adapt"
		end
		return amount * (1 - r)
	end
	entity.ModifyStun = function(duration, info)
		return duration * (1 - resist(b, info.Type))
	end
	entity.OnDamaged = function(amount, _info, attacker)
		local player = attacker and attacker.Player
		if player then
			b.Threat[player] = (b.Threat[player] or 0) + amount
			b.DamageBy[player] = (b.DamageBy[player] or 0) + amount
		end
		local frac = humanoid.Health / humanoid.MaxHealth
		if frac <= B.FinalPhaseAt then
			setPhase(b, 3)
		elseif frac <= B.EnrageAt then
			setPhase(b, 2)
		end
	end
	humanoid.Died:Connect(function()
		die(b)
	end)

	release(b)
	setAnim(b, "Move")
	FX.all("Announce", { title = B.Kanji, sub = B.Title .. " " .. B.Name, color = Palette.Wheel, time = 3 })

	task.spawn(function()
		while b.Alive do
			local dt = task.wait(0.1)
			if not b.Alive then
				break
			end
			if not model.Parent then
				-- Removed by something else (e.g. a map reset): free the altar.
				b.Alive = false
				Combat.unregister(entity)
				if b.OnEnded then
					b.OnEnded()
				end
				break
			end
			local ok, err = pcall(function(): string?
				step(b, dt)
				return nil
			end)
			if not ok then
				warn("[Mahoraga] AI error: " .. tostring(err))
			end
		end
		if current == b then
			current = nil
		end
	end)
	return true
end

return MahoragaBoss
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[--!strict
-- Arena, lighting, the Ten Shadows altar that summons Mahoraga, and training dummies.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("JJKShared")
local Config = require(Shared:WaitForChild("Config"))
local Palette = require(Shared:WaitForChild("Palette"))
local Assets = Shared:WaitForChild("Assets")
local Arena = require(Assets:WaitForChild("Arena"))
local PartKit = require(Assets:WaitForChild("PartKit"))

local Combat = require(script.Parent.Combat)
local FX = require(script.Parent.FX)
local MahoragaBoss = require(script.Parent.MahoragaBoss)

local World = {}

local function ensure(className: string, name: string): Instance
	local existing = Lighting:FindFirstChildOfClass(className)
	if existing then
		return existing
	end
	local inst = Instance.new(className)
	inst.Name = name
	inst.Parent = Lighting
	return inst
end

function World.setupLighting()
	Lighting.ClockTime = 17.4
	Lighting.Brightness = 2.4
	Lighting.Ambient = Color3.fromRGB(64, 56, 78)
	Lighting.OutdoorAmbient = Color3.fromRGB(118, 104, 128)
	Lighting.EnvironmentDiffuseScale = 0.5
	Lighting.EnvironmentSpecularScale = 0.8
	Lighting.GlobalShadows = true

	local atmosphere = ensure("Atmosphere", "JJK_Atmosphere") :: Atmosphere
	atmosphere.Density = 0.3
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(214, 160, 176)
	atmosphere.Decay = Color3.fromRGB(96, 64, 118)
	atmosphere.Glare = 0.35
	atmosphere.Haze = 1.4

	local bloom = ensure("BloomEffect", "JJK_Bloom") :: BloomEffect
	bloom.Intensity = 1.1
	bloom.Size = 28
	bloom.Threshold = 0.92

	local color = ensure("ColorCorrectionEffect", "JJK_Color") :: ColorCorrectionEffect
	color.Brightness = 0.02
	color.Contrast = 0.12
	color.Saturation = 0.1
	color.TintColor = Color3.fromRGB(255, 242, 246)

	local rays = ensure("SunRaysEffect", "JJK_SunRays") :: SunRaysEffect
	rays.Intensity = 0.06
	rays.Spread = 0.7
end

-- A grade 4 cursed spirit that stands still and soaks hits.
local function buildDummy(cf: CFrame): (Model, Humanoid, BasePart)
	local m = PartKit.model("Cursed Spirit")
	local root = PartKit.part({ Name = "HumanoidRootPart", Parent = m, CFrame = cf * CFrame.new(0, 3, 0), Size = Vector3.new(3.4, 4.4, 2.6), Transparency = 1, CanCollide = true })
	m.PrimaryPart = root
	local skin = Color3.fromRGB(88, 64, 112)
	PartKit.ellipsoid({ Name = "Body", Parent = m, CFrame = cf * CFrame.new(0, 3, 0), Size = Vector3.new(4.4, 4.8, 3.8), Color = skin })
	PartKit.ellipsoid({ Name = "Belly", Parent = m, CFrame = cf * CFrame.new(0, 2.5, -1.2), Size = Vector3.new(3.0, 3.0, 1.8), Color = Color3.fromRGB(128, 100, 150) })
	PartKit.ellipsoid({ Name = "Mouth", Parent = m, CFrame = cf * CFrame.new(0, 2.2, -1.95), Size = Vector3.new(1.9, 0.7, 0.4), Color = Palette.Shadow })
	for i, spec in { { 0, 4.1, 1.0 }, { -1.1, 3.6, 0.6 }, { 1.1, 3.6, 0.6 } } do
		local x, y, d = spec[1], spec[2], spec[3]
		PartKit.ball(m, cf * CFrame.new(x, y, -1.75), d, { Color = Color3.fromRGB(245, 240, 220) }, "Eye" .. i)
		PartKit.ball(m, cf * CFrame.new(x, y, -1.75 - d * 0.42), d * 0.45, { Color = Color3.fromRGB(255, 214, 60), Material = Enum.Material.Neon }, "Pupil")
	end
	for _, side in { -1, 1 } do
		PartKit.limb({ Name = "Arm", Parent = m, Color = skin }, (cf * CFrame.new(side * 2.0, 3.4, -0.3)).Position, (cf * CFrame.new(side * 3.1, 1.6, -1.0)).Position, 0.7)
	end
	PartKit.part({ Name = "Head", Parent = m, CFrame = cf * CFrame.new(0, 5.2, 0), Size = Vector3.new(1, 1, 1), Transparency = 1 })
	local humanoid = Instance.new("Humanoid")
	humanoid.DisplayName = "Grade 4 Cursed Spirit"
	humanoid.MaxHealth = 600
	humanoid.Health = 600
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = 0.8
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOn
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	humanoid.NameDisplayDistance = 80
	humanoid.HealthDisplayDistance = 80
	humanoid.Parent = m
	m:SetAttribute("JJK_HitRadius", 2.4)
	m:SetAttribute("JJK_HitHalfHeight", 3)
	return m, humanoid, root
end

function World.spawnDummy(cf: CFrame)
	local m, humanoid, root = buildDummy(cf)
	local folder = workspace:FindFirstChild("JJK_Dummies")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "JJK_Dummies"
		folder.Parent = workspace
	end
	m.Parent = folder
	local entity = Combat.register(m, humanoid, root, "Dummy", nil)
	humanoid.Died:Connect(function()
		Combat.unregister(entity)
		FX.all("Impact", { pos = cf.Position, radius = 6, color = Palette.YutaEnergy })
		task.delay(0.4, function()
			m:Destroy()
		end)
		task.delay(5, function()
			World.spawnDummy(cf)
		end)
	end)
end

function World.setupAltar(pedestal: BasePart, bossSpawn: CFrame): (Player?) -> ()
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "SummonPrompt"
	prompt.ActionText = "Summon Mahoraga"
	prompt.ObjectText = "Ten Shadows Altar"
	prompt.HoldDuration = 1.2
	prompt.KeyboardKeyCode = Enum.KeyCode.P -- E is the block key
	prompt.MaxActivationDistance = 18
	prompt.RequiresLineOfSight = false
	prompt.Parent = pedestal

	local readyAt = 0
	local function summon(who: Player?)
		if MahoragaBoss.isActive() or os.clock() < readyAt then
			if who then
				FX.to(who, "Notify", { text = if MahoragaBoss.isActive() then "Mahoraga is already here." else "The shadows are still settling..." })
			end
			return
		end
		prompt.Enabled = false
		task.spawn(function()
			local ok = MahoragaBoss.summon(bossSpawn, function()
				readyAt = os.clock() + Config.Boss.RespawnCooldown
				task.delay(Config.Boss.RespawnCooldown, function()
					prompt.Enabled = true
				end)
			end)
			if not ok then
				prompt.Enabled = true
			end
		end)
	end
	prompt.Triggered:Connect(summon)
	return summon
end

function World.start()
	if Config.World.SetupLighting then
		World.setupLighting()
	end

	local pedestal: BasePart
	local bossSpawn: CFrame
	local dummyBase: CFrame
	if Config.World.BuildArena then
		local center = CFrame.new(Config.World.ArenaCenter)
		local info = Arena.build(workspace, center, Config.World.ArenaSize)
		pedestal = info.Pedestal
		bossSpawn = info.BossSpawn
		dummyBase = center * CFrame.new(0, 0, Config.World.ArenaSize * 0.27)
	else
		local altarPos = Config.World.AltarPosition
		local bossPos = Config.World.BossSpawnPosition
		local altarCF = CFrame.lookAt(altarPos, Vector3.new(bossPos.X, altarPos.Y, bossPos.Z))
		local _, p = Arena.buildAltar(workspace, altarCF)
		pedestal = p
		bossSpawn = CFrame.lookAt(bossPos, Vector3.new(altarPos.X, bossPos.Y, altarPos.Z)) * CFrame.Angles(0, math.pi, 0)
		dummyBase = CFrame.new(bossPos + Vector3.new(0, 0, 50))
	end

	local summon = World.setupAltar(pedestal, bossSpawn)

	if Config.World.SpawnDummies then
		local count = Config.World.DummyCount
		for i = 1, count do
			local x = (i - (count + 1) / 2) * 16
			local spot = dummyBase * CFrame.new(x, 0, 0)
			local ground = Combat.groundAt(spot.Position + Vector3.new(0, 20, 0))
			World.spawnDummy(CFrame.new(ground) * CFrame.Angles(0, math.pi, 0))
		end
	end

	local autoDelay = Config.Rules.AutoSummonDelay
	if autoDelay and autoDelay > 0 then
		local scheduled = false
		local function schedule()
			if scheduled then
				return
			end
			scheduled = true
			task.delay(autoDelay, function()
				if #Players:GetPlayers() > 0 and not MahoragaBoss.isActive() then
					summon(nil)
				end
			end)
		end
		Players.PlayerAdded:Connect(function(player)
			player.CharacterAdded:Connect(schedule)
		end)
		for _, player in Players:GetPlayers() do
			if player.Character then
				schedule()
			end
			player.CharacterAdded:Connect(schedule)
		end
	end
end

return World
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">YutaKit</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Yuta Okkotsu's kit, server side. Every player gets it.

	Base techniques
	  M1  Katana combo (cursed-energy swordsmanship)
	  Q   Cursed Dash (dodge window)
	  Z   Rika: Partial Manifestation (arm smash)
	  X   Copy - Cursed Speech: "Don't move" (stun, throat backlash)
	  C   Copy - Cursed Speech: "Blast away" (cone launch, throat backlash)
	  V   Reverse Cursed Technique (heals self and allies)
	  F   Rika: Full Manifestation (damage up, auto claws, shield, unlocks R)
	  R   Pure Love: Jun'ai Ho (beam, needs Full Manifestation)
	  T   Domain Expansion: Authentic Mutual Love (sure-hit copied techniques)
	  G   Copy - Kenjaku's body transplant into Gojo's body (Six Eyes mode)
	  E   Cursed energy guard (hold)
	Six Eyes mode swaps Z/X/C for Blue, Red and Hollow Purple and adds Infinity.
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("JJKShared")
local Config = require(Shared:WaitForChild("Config"))
local Palette = require(Shared:WaitForChild("Palette"))
local Abilities = require(Shared:WaitForChild("Abilities"))
local Net = require(Shared:WaitForChild("Net"))
local Util = require(Shared:WaitForChild("Util"))
local Assets = Shared:WaitForChild("Assets")
local Katana = require(Assets:WaitForChild("Katana"))
local SixEyesLook = require(Assets:WaitForChild("SixEyesLook"))

local Combat = require(script.Parent.Combat)
local FX = require(script.Parent.FX)

local Y = Config.Yuta

type Payload = { [string]: any }

type State = {
	Player: Player,
	Character: Model?,
	Humanoid: Humanoid?,
	Root: BasePart?,
	Entity: Combat.Entity?,
	Tool: Tool?,
	Look: Model?,
	SetupFor: Model?,
	Cooldowns: { [string]: number },
	Combo: number,
	LastSlash: number,
	NextSlash: number,
	BusyUntil: number,
	SlowUntil: number,
	RikaUntil: number,
	NextClaw: number,
	SixEyesUntil: number,
	DomainUntil: number,
	DomainCenter: Vector3,
	Blocking: boolean,
	Serial: number,
}

local YutaKit = {}

local states: { [Player]: State } = {}
local handlers: { [string]: (State, Payload) -> () } = {}

-- Helpers ----------------------------------------------------------------------------

local function alive(state: State): boolean
	local e = state.Entity
	return e ~= nil and Combat.isAlive(e)
end

local function entityOf(state: State): Combat.Entity
	return state.Entity :: Combat.Entity
end

local function rootOf(state: State): BasePart
	return state.Root :: BasePart
end

local function nextCast(state: State): string
	state.Serial += 1
	return tostring(state.Player.UserId) .. ":" .. tostring(state.Serial)
end

local function rikaActive(state: State): boolean
	return state.RikaUntil > os.clock()
end

local function sixEyesActive(state: State): boolean
	return state.SixEyesUntil > os.clock()
end

local function inOwnDomain(state: State): boolean
	if state.DomainUntil <= os.clock() or not state.Root then
		return false
	end
	return (rootOf(state).Position - state.DomainCenter).Magnitude <= Y.Domain.Radius
end

local function damageMult(state: State): number
	return if rikaActive(state) then Y.RikaDamageBonus else 1
end

local function ready(state: State, id: string): boolean
	return os.clock() >= (state.Cooldowns[id] or 0)
end

local function startCooldown(state: State, id: string, seconds: number, fixed: boolean?)
	local duration = seconds
	if not fixed then
		if sixEyesActive(state) then
			duration *= Y.SixEyes.CooldownMultiplier
		end
		if inOwnDomain(state) then
			duration *= Y.Domain.CooldownMultiplier
		end
	end
	state.Cooldowns[id] = os.clock() + duration
	FX.to(state.Player, "Cooldown", { id = id, ends = workspace:GetServerTimeNow() + duration, duration = duration })
end

local function stunned(state: State): boolean
	local e = state.Entity
	return e ~= nil and e.StunnedUntil > os.clock()
end

local function canAct(state: State): boolean
	return alive(state) and not stunned(state) and os.clock() >= state.BusyUntil and not state.Blocking
end

local function canCast(state: State, id: string): boolean
	return canAct(state) and ready(state, id)
end

local function notify(state: State, text: string)
	FX.to(state.Player, "Notify", { text = text })
end

local function facing(state: State): CFrame
	local root = rootOf(state)
	return Util.facing(root.Position, root.CFrame.LookVector)
end

-- Flat frame at the root facing the cursor (the client also turns the character,
-- but the aim point is what the server trusts).
local function aimFacing(state: State, payload: Payload): CFrame
	local root = rootOf(state)
	local aim = payload.aim
	local dir = if typeof(aim) == "Vector3" then aim - root.Position else root.CFrame.LookVector
	return Util.facing(root.Position, Util.flatUnit(dir, root.CFrame.LookVector))
end

local function aimPoint(state: State, payload: Payload, range: number): Vector3
	local root = rootOf(state)
	local aim = payload.aim
	if typeof(aim) ~= "Vector3" then
		return root.Position + root.CFrame.LookVector * range
	end
	local offset = aim - root.Position
	if offset.Magnitude > range then
		offset = offset.Unit * range
	end
	return root.Position + offset
end

-- Aim direction from the chest toward the cursor, with the pitch clamped.
local function aimDir(state: State, payload: Payload, maxPitch: number): Vector3
	local root = rootOf(state)
	local origin = root.Position + Vector3.new(0, 1.5, 0)
	local aim = payload.aim
	local dir = if typeof(aim) == "Vector3" then aim - origin else root.CFrame.LookVector
	if dir.Magnitude < 0.01 then
		dir = root.CFrame.LookVector
	end
	dir = dir.Unit
	local flatDir = Util.flatUnit(dir, root.CFrame.LookVector)
	local limit = math.rad(maxPitch)
	local pitch = math.clamp(math.asin(math.clamp(dir.Y, -1, 1)), -limit, limit)
	return (flatDir * math.cos(pitch) + Vector3.new(0, math.sin(pitch), 0)).Unit
end

-- Cursed Speech strains the user's throat.
local function backlash(state: State, amount: number)
	local h = state.Humanoid
	if h and h.Health > amount + 1 then
		h.Health -= amount
		local pos = rootOf(state).Position + Vector3.new(0, 3.5, 0)
		FX.near(pos, 200, "Damage", { pos = pos, amount = amount, tag = "backlash" })
	end
end

-- M1: katana combo ----------------------------------------------------------------------

local function slash(state: State)
	local now = os.clock()
	if not canAct(state) or now < state.NextSlash then
		return
	end
	local K = Y.Katana
	if now - state.LastSlash > K.ComboReset then
		state.Combo = 0
	end
	state.Combo = state.Combo % #K.Damage + 1
	state.LastSlash = now
	local combo = state.Combo
	local finisher = combo == #K.Damage
	state.NextSlash = now + (if finisher then K.FinisherLag else K.Interval)

	local tool = state.Tool
	if tool and tool.Parent == state.Character then
		-- The default Animate script plays the tool slash/lunge animation for this value.
		local anim = Instance.new("StringValue")
		anim.Name = "toolanim"
		anim.Value = if finisher then "Lunge" else "Slash"
		anim.Parent = tool
		Debris:AddItem(anim, 1)
		local handle = tool:FindFirstChild("Handle")
		local trail = handle and handle:FindFirstChild("SwingTrail")
		if trail and trail:IsA("Trail") then
			trail.Enabled = true
			task.delay(0.25, function()
				trail.Enabled = false
			end)
		end
	end

	FX.all("Slash", { char = state.Character, combo = combo, cf = rootOf(state).CFrame })
	task.delay(0.07, function()
		if not alive(state) then
			return
		end
		local cf = facing(state) * CFrame.new(0, 0, -K.Reach / 2)
		local size = Vector3.new(if finisher then 11 else 9, 7, K.Reach)
		local look = cf.LookVector
		local mult = damageMult(state)
		local castId = nextCast(state)
		for _, e in Combat.query(entityOf(state), function(e)
			return Combat.inBox(e, cf, size)
		end) do
			Combat.damage(entityOf(state), e, K.Damage[combo] * mult, {
				Type = "Katana",
				CastId = castId,
				Knockback = if finisher then look * 55 + Vector3.new(0, 25, 0) else look * 8,
				KnockbackTime = if finisher then 0.25 else 0.1,
				Stun = if finisher then 0.5 else 0.35,
				Color = Palette.YutaEnergy,
			})
		end
	end)
end

-- Techniques ---------------------------------------------------------------------------

handlers.Dash = function(state, payload)
	if not alive(state) or stunned(state) or not ready(state, "Dash") then
		return
	end
	startCooldown(state, "Dash", Y.Dash.Cooldown, true)
	entityOf(state).DodgeUntil = os.clock() + Config.Player.DashIFrames
	local dir = payload.dir
	if typeof(dir) ~= "Vector3" or dir.Magnitude < 0.1 then
		dir = rootOf(state).CFrame.LookVector
	end
	FX.all("Dash", { char = state.Character, dir = Util.flatUnit(dir) })
end

handlers.RikaStrike = function(state, payload)
	if not canCast(state, "RikaStrike") then
		return
	end
	local cfg = Y.RikaStrike
	startCooldown(state, "RikaStrike", cfg.Cooldown)
	state.BusyUntil = os.clock() + 0.5
	local full = rikaActive(state)
	local scale = if full then 1.3 else 1
	local cf = aimFacing(state, payload)
	FX.all("RikaArm", { char = state.Character, cf = cf, full = full })
	task.delay(cfg.Windup, function()
		if not alive(state) then
			return
		end
		local center = (cf * CFrame.new(0, 0, -10 * scale)).Position
		local ground = Combat.groundAt(center)
		local hitCF = CFrame.new(center.X, ground.Y + 4, center.Z) * cf.Rotation
		local size = Vector3.new(12, 10, 16) * scale
		local castId = nextCast(state)
		for _, e in Combat.query(entityOf(state), function(e)
			return Combat.inBox(e, hitCF, size)
		end) do
			Combat.damage(entityOf(state), e, cfg.Damage * damageMult(state), {
				Type = "Rika",
				CastId = castId,
				Knockback = cf.LookVector * 30 + Vector3.new(0, 45, 0),
				KnockbackTime = 0.3,
				Stun = 0.6,
				Color = Palette.RikaAura,
			})
		end
		FX.all("Impact", { pos = ground, radius = 10 * scale, color = Palette.RikaAura, cracks = true })
		FX.shake(ground, 0.6, 0.35, 120)
	end)
end

handlers.DontMove = function(state, _payload)
	if not canCast(state, "DontMove") then
		return
	end
	local cfg = Y.DontMove
	startCooldown(state, "DontMove", cfg.Cooldown)
	state.BusyUntil = os.clock() + 0.4
	backlash(state, cfg.Backlash)
	FX.all("Speech", { char = state.Character, word = "DontMove", radius = cfg.Radius })
	task.delay(0.18, function()
		if not alive(state) then
			return
		end
		local center = rootOf(state).Position
		local castId = nextCast(state)
		for _, e in Combat.query(entityOf(state), function(e)
			return Combat.inSphere(e, center, cfg.Radius)
		end) do
			Combat.damage(entityOf(state), e, cfg.Damage * damageMult(state), {
				Type = "CursedSpeech",
				CastId = castId,
				Stun = if e.Kind == "Boss" then cfg.BossStun else cfg.Stun,
				Color = Palette.SpeechRing,
			})
		end
	end)
end

handlers.BlastAway = function(state, payload)
	if not canCast(state, "BlastAway") then
		return
	end
	local cfg = Y.BlastAway
	startCooldown(state, "BlastAway", cfg.Cooldown)
	state.BusyUntil = os.clock() + 0.45
	backlash(state, cfg.Backlash)
	local cf = aimFacing(state, payload)
	FX.all("Speech", { char = state.Character, word = "BlastAway", radius = cfg.Range, cone = cfg.ConeDegrees, cf = cf })
	task.delay(0.15, function()
		if not alive(state) then
			return
		end
		local castId = nextCast(state)
		for _, e in Combat.query(entityOf(state), function(e)
			return Combat.inArc(e, cf, cfg.Range, cfg.ConeDegrees, 8)
		end) do
			local away = Util.flatUnit(e.Root.Position - cf.Position, cf.LookVector)
			Combat.damage(entityOf(state), e, cfg.Damage * damageMult(state), {
				Type = "CursedSpeech",
				CastId = castId,
				Knockback = away * cfg.Knockback + Vector3.new(0, 30, 0),
				KnockbackTime = 0.3,
				Stun = if e.Kind == "Boss" then 0.4 else 0.8,
				Color = Palette.SpeechRing,
			})
		end
	end)
end

handlers.RCT = function(state, _payload)
	if not canCast(state, "RCT") then
		return
	end
	local cfg = Y.RCT
	startCooldown(state, "RCT", cfg.Cooldown)
	state.BusyUntil = os.clock() + 0.45
	local me = entityOf(state)
	me.StunnedUntil = 0
	local root = rootOf(state)
	local allies, allyModels = {}, {}
	for _, ally in Combat.alliesOf(me) do
		if (ally.Root.Position - root.Position).Magnitude <= cfg.AllyRadius then
			table.insert(allies, ally)
			table.insert(allyModels, ally.Model)
		end
	end
	FX.all("RCT", { char = state.Character, duration = cfg.Duration, allies = allyModels })
	task.spawn(function()
		local ticks = 4
		for _ = 1, ticks do
			if not alive(state) then
				return
			end
			Combat.heal(me, me.Humanoid.MaxHealth * cfg.SelfHeal / ticks)
			for _, ally in allies do
				Combat.heal(ally, ally.Humanoid.MaxHealth * cfg.AllyHeal / ticks)
			end
			task.wait(cfg.Duration / ticks)
		end
	end)
end

local function endRika(state: State)
	state.RikaUntil = 0
	local char = state.Character
	if char then
		char:SetAttribute("JJK_RikaFull", false)
	end
	FX.all("RikaVanish", { char = char })
	startCooldown(state, "FullManifestation", Y.FullManifestation.Cooldown, true)
end

handlers.FullManifestation = function(state, _payload)
	if rikaActive(state) or not canCast(state, "FullManifestation") then
		return
	end
	local cfg = Y.FullManifestation
	local now = os.clock()
	state.RikaUntil = now + cfg.Duration
	state.NextClaw = now + 1.5
	state.BusyUntil = now + 0.8
	local char = state.Character :: Model
	char:SetAttribute("JJK_RikaEnds", workspace:GetServerTimeNow() + cfg.Duration)
	char:SetAttribute("JJK_RikaFull", true)
	FX.all("RikaManifest", { char = char })
	FX.to(state.Player, "Announce", { title = "里香", sub = "Rika: Full Manifestation", color = Palette.RikaAura })
	FX.shake(rootOf(state).Position, 0.8, 0.6, 120)
end

-- While fully manifested, Rika claws at the nearest enemy on her own.
local function rikaClaw(state: State)
	local cfg = Y.FullManifestation
	local root = rootOf(state)
	local best: Combat.Entity? = nil
	local bestDist = cfg.ClawRange
	for _, e in Combat.enemiesOf(entityOf(state)) do
		local d = (e.Root.Position - root.Position).Magnitude - e.Radius
		if d < bestDist then
			best, bestDist = e, d
		end
	end
	if not best then
		state.NextClaw = os.clock() + 0.5
		return
	end
	local target: Combat.Entity = best
	state.NextClaw = os.clock() + cfg.ClawInterval
	local aim = target.Root.Position
	FX.all("RikaClaw", { char = state.Character, target = aim })
	task.delay(0.35, function()
		if alive(state) and Combat.isAlive(target) and Combat.inSphere(target, aim, 10) then
			Combat.damage(entityOf(state), target, cfg.ClawDamage * damageMult(state), {
				Type = "Rika",
				CastId = nextCast(state),
				Stun = 0.25,
				Color = Palette.RikaAura,
			})
		end
	end)
end

handlers.PureLove = function(state, payload)
	if not alive(state) then
		return
	end
	if not rikaActive(state) then
		notify(state, "Pure Love needs Rika's Full Manifestation (F).")
		return
	end
	if not canCast(state, "PureLove") then
		return
	end
	local cfg = Y.PureLove
	startCooldown(state, "PureLove", cfg.Cooldown)
	local total = cfg.Charge + cfg.Ticks * cfg.TickInterval + 0.3
	state.BusyUntil = os.clock() + total
	state.SlowUntil = os.clock() + total
	local dir = aimDir(state, payload, 20)
	FX.all("PureLoveCharge", { char = state.Character, time = cfg.Charge, dir = dir })
	FX.to(state.Player, "Announce", { title = "純愛砲", sub = "Pure Love: Jun'ai Ho", color = Palette.PureLove })
	task.delay(cfg.Charge, function()
		if not alive(state) then
			return
		end
		local origin = rootOf(state).Position + Vector3.new(0, 1.5, 0) + dir * 5
		local cf = CFrame.lookAt(origin, origin + dir)
		FX.all("PureLoveBeam", { cf = cf, length = cfg.Length, width = cfg.Width, duration = cfg.Ticks * cfg.TickInterval + 0.3 })
		FX.shake(origin, 1.3, 1.1, 260)
		local castId = nextCast(state)
		local box = cf * CFrame.new(0, 0, -cfg.Length / 2)
		local size = Vector3.new(cfg.Width, cfg.Width, cfg.Length)
		for _ = 1, cfg.Ticks do
			if not alive(state) then
				return
			end
			for _, e in Combat.query(entityOf(state), function(e)
				return Combat.inBox(e, box, size)
			end) do
				Combat.damage(entityOf(state), e, cfg.TickDamage * damageMult(state), {
					Type = "PureLove",
					CastId = castId,
					Knockback = dir * 40,
					KnockbackTime = 0.15,
					Stun = 0.25,
					Color = Palette.PureLove,
				})
			end
			task.wait(cfg.TickInterval)
		end
	end)
end

handlers.Domain = function(state, _payload)
	if state.DomainUntil > os.clock() or not canCast(state, "Domain") then
		return
	end
	local cfg = Y.Domain
	startCooldown(state, "Domain", cfg.Cooldown, true)
	state.BusyUntil = os.clock() + cfg.CastTime
	state.SlowUntil = os.clock() + cfg.CastTime
	FX.all("DomainCast", { char = state.Character, time = cfg.CastTime })
	FX.all("Announce", { title = "領域展開", sub = "Domain Expansion", color = Palette.DomainSky, time = cfg.CastTime })
	task.delay(cfg.CastTime, function()
		if not alive(state) then
			return
		end
		local center = Combat.groundAt(rootOf(state).Position)
		local id = "domain-" .. nextCast(state)
		state.DomainCenter = center
		state.DomainUntil = os.clock() + cfg.Duration
		FX.all("DomainExpand", { id = id, center = center, radius = cfg.Radius, duration = cfg.Duration, char = state.Character })
		FX.all("Announce", { title = "真贋相愛", sub = "Domain Expansion: Authentic Mutual Love", color = Palette.PureLove, time = 2.6 })
		FX.shake(center, 1.0, 1.0, 220)

		-- Anyone caught inside when the domain closes cannot walk out of it.
		for _, e in Combat.query(entityOf(state), function(e)
			return Combat.inSphere(e, center, cfg.Radius)
		end) do
			local controller = e.Controller
			if controller then
				controller:Confine(center, cfg.Radius - 8, cfg.Duration)
			end
		end

		-- Sure-hit: every tick each enemy inside is struck by one of the copied techniques
		-- held in the swords (katana rain, Cursed Speech, or Rika).
		local kinds = { "Swords", "Speech", "Rika" }
		local rng = Random.new()
		local elapsed = 0
		while elapsed < cfg.Duration and alive(state) do
			task.wait(cfg.TickInterval)
			elapsed += cfg.TickInterval
			if not alive(state) then
				break
			end
			for _, e in Combat.query(entityOf(state), function(e)
				return Combat.inSphere(e, center, cfg.Radius)
			end) do
				local kind = kinds[rng:NextInteger(1, #kinds)]
				local info: Combat.HitInfo = { Type = "Domain", CastId = nextCast(state), Color = Palette.PureLove }
				local amount = cfg.SwordDamage
				if kind == "Speech" then
					amount = cfg.SpeechDamage
					info.Stun = cfg.SpeechStun
				elseif kind == "Rika" then
					amount = cfg.RikaDamage
				end
				FX.all("DomainHit", { id = id, kind = kind, pos = e.Root.Position, model = e.Model })
				Combat.damage(entityOf(state), e, amount * damageMult(state), info)
			end
		end
		state.DomainUntil = 0
		FX.all("DomainEnd", { id = id })
	end)
end

local HIDDEN_ACCESSORIES = {
	[Enum.AccessoryType.Hat] = true,
	[Enum.AccessoryType.Hair] = true,
	[Enum.AccessoryType.Unknown] = true,
	[Enum.AccessoryType.Eyebrow] = true,
	[Enum.AccessoryType.Eyelash] = true,
}

local function setHeadAccessoriesHidden(char: Model, hidden: boolean)
	for _, accessory in char:GetChildren() do
		if accessory:IsA("Accessory") then
			local handle = accessory:FindFirstChild("Handle")
			if handle and handle:IsA("BasePart") then
				if hidden and HIDDEN_ACCESSORIES[accessory.AccessoryType] then
					if handle:GetAttribute("JJK_Transparency") == nil then
						handle:SetAttribute("JJK_Transparency", handle.Transparency)
					end
					handle.Transparency = 1
				elseif not hidden then
					local original = handle:GetAttribute("JJK_Transparency")
					if typeof(original) == "number" then
						handle.Transparency = original
						handle:SetAttribute("JJK_Transparency", nil)
					end
				end
			end
		end
	end
end

local function endSixEyes(state: State)
	state.SixEyesUntil = 0
	local char = state.Character
	if char then
		char:SetAttribute("JJK_Mode", "Base")
		setHeadAccessoriesHidden(char, false)
	end
	if state.Look then
		state.Look:Destroy()
		state.Look = nil
	end
	FX.all("SixEyesEnd", { char = char })
	startCooldown(state, "SixEyes", Y.SixEyes.Cooldown, true)
end

handlers.SixEyes = function(state, _payload)
	if sixEyesActive(state) or not canCast(state, "SixEyes") then
		return
	end
	local cfg = Y.SixEyes
	state.BusyUntil = os.clock() + cfg.CastTime
	state.SlowUntil = os.clock() + cfg.CastTime
	FX.all("SixEyesCast", { char = state.Character, time = cfg.CastTime })
	FX.to(state.Player, "Announce", { title = "六眼", sub = "Copy: Body Transplant - Six Eyes & Limitless", color = Palette.SixEyes })
	task.delay(cfg.CastTime, function()
		if not alive(state) then
			return
		end
		local char = state.Character :: Model
		state.SixEyesUntil = os.clock() + cfg.Duration
		char:SetAttribute("JJK_SixEyesEnds", workspace:GetServerTimeNow() + cfg.Duration)
		char:SetAttribute("JJK_Mode", "SixEyes")
		local head = char:FindFirstChild("Head")
		if head and head:IsA("BasePart") then
			local size = head.Size
			local visual = Vector3.new(math.clamp(size.X, 0.9, 1.8), math.clamp(size.Y, 0.9, 1.8), math.clamp(size.Z, 0.9, 1.8))
			if (state.Humanoid :: Humanoid).RigType == Enum.HumanoidRigType.R6 then
				visual = Vector3.new(1.25, 1.25, 1.25)
			end
			local look = SixEyesLook.build(head, visual)
			look.Parent = char
			state.Look = look
			setHeadAccessoriesHidden(char, true)
		end
		FX.all("SixEyesAwaken", { char = char })
	end)
end

handlers.Blue = function(state, payload)
	if not sixEyesActive(state) or not canCast(state, "Blue") then
		return
	end
	local cfg = Y.Blue
	startCooldown(state, "Blue", cfg.Cooldown)
	state.BusyUntil = os.clock() + 0.35
	local point = aimPoint(state, payload, cfg.Range)
	local pos = Combat.groundAt(point) + Vector3.new(0, 5, 0)
	FX.all("Blue", { pos = pos, radius = cfg.Radius, duration = cfg.Duration })
	task.spawn(function()
		local castId = nextCast(state)
		local t = 0
		while t < cfg.Duration and alive(state) do
			for _, e in Combat.query(entityOf(state), function(e)
				return Combat.inSphere(e, pos, cfg.Radius)
			end) do
				local toCenter = pos - e.Root.Position
				Combat.damage(entityOf(state), e, cfg.TickDamage * damageMult(state), {
					Type = "Blue",
					CastId = castId,
					Knockback = if toCenter.Magnitude > 2 then toCenter.Unit * cfg.Pull else nil,
					KnockbackTime = cfg.TickInterval,
					Color = Palette.Blue,
				})
			end
			task.wait(cfg.TickInterval)
			t += cfg.TickInterval
		end
	end)
end

handlers.Red = function(state, payload)
	if not sixEyesActive(state) or not canCast(state, "Red") then
		return
	end
	local cfg = Y.Red
	startCooldown(state, "Red", cfg.Cooldown)
	state.BusyUntil = os.clock() + 0.4
	local dir = aimDir(state, payload, 35)
	local origin = rootOf(state).Position + Vector3.new(0, 1.5, 0) + dir * 2.5
	local id = "red-" .. nextCast(state)
	FX.all("RedFire", { id = id, origin = origin, dir = dir, speed = cfg.Speed, range = cfg.Range })
	task.spawn(function()
		local pos = origin
		local traveled = 0
		local hitPos: Vector3? = nil
		while traveled < cfg.Range do
			local dt = task.wait()
			local step = math.min(cfg.Speed * dt, cfg.Range - traveled)
			local ray = Combat.worldRaycast(pos, dir * step)
			local nextPos = pos + dir * step
			for _, e in Combat.enemiesOf(entityOf(state)) do
				if Combat.inSphere(e, nextPos, cfg.HitRadius) then
					hitPos = nextPos
					break
				end
			end
			if hitPos then
				break
			end
			if ray then
				hitPos = ray.Position
				break
			end
			pos = nextPos
			traveled += step
		end
		local blast = hitPos or pos
		FX.all("RedBoom", { id = id, pos = blast, radius = cfg.BlastRadius })
		FX.shake(blast, 0.9, 0.5, 160)
		if not alive(state) then
			return
		end
		local castId = nextCast(state)
		for _, e in Combat.query(entityOf(state), function(e)
			return Combat.inSphere(e, blast, cfg.BlastRadius)
		end) do
			local away = Util.flatUnit(e.Root.Position - blast, dir)
			Combat.damage(entityOf(state), e, cfg.Damage * damageMult(state), {
				Type = "Red",
				CastId = castId,
				Knockback = away * cfg.Knockback + Vector3.new(0, 35, 0),
				KnockbackTime = 0.3,
				Stun = 0.5,
				Color = Palette.Red,
			})
		end
	end)
end

handlers.HollowPurple = function(state, payload)
	if not sixEyesActive(state) or not canCast(state, "HollowPurple") then
		return
	end
	local cfg = Y.HollowPurple
	startCooldown(state, "HollowPurple", cfg.Cooldown)
	state.BusyUntil = os.clock() + cfg.Charge + 0.5
	state.SlowUntil = os.clock() + cfg.Charge + 0.5
	FX.all("PurpleCharge", { char = state.Character, time = cfg.Charge })
	FX.all("Announce", { title = "虚式「茈」", sub = "Hollow Technique: Purple", color = Palette.Purple, time = 2 })
	task.delay(cfg.Charge, function()
		if not alive(state) then
			return
		end
		local dir = aimDir(state, payload, 25)
		local origin = rootOf(state).Position + Vector3.new(0, 2, 0) + dir * 4
		local id = "purple-" .. nextCast(state)
		FX.all("PurpleFire", { id = id, origin = origin, dir = dir, speed = cfg.Speed, range = cfg.Range, radius = cfg.Radius })
		FX.shake(origin, 1.6, 1.2, 300)
		local castId = nextCast(state)
		local hit: { [Combat.Entity]: boolean } = {}
		local pos = origin
		local traveled = 0
		while traveled < cfg.Range do
			local dt = task.wait()
			local step = cfg.Speed * dt
			pos += dir * step
			traveled += step
			if not alive(state) then
				continue
			end
			for _, e in Combat.query(entityOf(state), function(e)
				return Combat.inSphere(e, pos, cfg.Radius)
			end) do
				if not hit[e] then
					hit[e] = true
					Combat.damage(entityOf(state), e, cfg.Damage * damageMult(state), {
						Type = "HollowPurple",
						CastId = castId,
						Knockback = dir * 90 + Vector3.new(0, 40, 0),
						KnockbackTime = 0.35,
						Stun = 0.8,
						Color = Palette.Purple,
					})
				end
			end
		end
	end)
end

handlers.Block = function(state, payload)
	local on = payload.on == true
	if on and (not alive(state) or stunned(state) or os.clock() < state.BusyUntil) then
		on = false
	end
	state.Blocking = on
	local e = state.Entity
	if e then
		e.Blocking = on
	end
	if state.Character then
		state.Character:SetAttribute("JJK_Blocking", on)
	end
end

-- Character lifecycle ------------------------------------------------------------------

local function setupCharacter(state: State, char: Model)
	if state.SetupFor == char then
		return -- CharacterAdded and the initial check can both fire for the first character
	end
	state.SetupFor = char
	local humanoid = char:WaitForChild("Humanoid", 10)
	local root = char:WaitForChild("HumanoidRootPart", 10)
	if not (humanoid and humanoid:IsA("Humanoid") and root and root:IsA("BasePart")) then
		return
	end
	if state.Player.Character ~= char then
		return
	end

	state.Character = char
	state.Humanoid = humanoid
	state.Root = root
	state.Cooldowns = {}
	state.Combo = 0
	state.NextSlash = 0
	state.BusyUntil = 0
	state.SlowUntil = 0
	state.RikaUntil = 0
	state.SixEyesUntil = 0
	state.DomainUntil = 0
	state.Blocking = false
	state.Look = nil

	humanoid.MaxHealth = Config.Player.MaxHealth
	humanoid.Health = Config.Player.MaxHealth
	humanoid.WalkSpeed = Config.Player.WalkSpeed
	char:SetAttribute("JJK_Yuta", true)
	char:SetAttribute("JJK_Mode", "Base")
	char:SetAttribute("JJK_RikaFull", false)
	char:SetAttribute("JJK_Blocking", false)

	local entity = Combat.register(char, humanoid, root, "Player", state.Player)
	entity.ModifyIncoming = function(amount, info, attacker)
		local dmg = amount
		if rikaActive(state) then
			dmg *= 1 - Y.FullManifestation.Protection
		end
		if sixEyesActive(state) then
			-- Infinity stops most damage, but Mahoraga adapts to it hit by hit.
			local controller = attacker and attacker.Controller
			local adapted = if controller then controller:AdaptFraction("Infinity") else 0
			local reduction = Y.SixEyes.InfinityReduction * (1 - adapted)
			if reduction > 0.01 then
				dmg *= 1 - reduction
				info.Tag = "infinity"
			end
			FX.all("Infinity", { char = char, adapted = adapted })
			if controller then
				controller:RegisterCast("Infinity", "infinity:" .. tostring(os.clock()))
			end
		end
		return dmg
	end
	state.Entity = entity

	humanoid.Died:Connect(function()
		if state.Character ~= char then
			return
		end
		Combat.unregister(entity)
		if state.RikaUntil > 0 then
			char:SetAttribute("JJK_RikaFull", false)
			FX.all("RikaVanish", { char = char })
		end
		state.RikaUntil = 0
		state.SixEyesUntil = 0
		state.DomainUntil = 0
	end)

	-- The Backpack is recreated on every spawn; make sure we use this life's one.
	local backpack = state.Player:FindFirstChildOfClass("Backpack") or state.Player:WaitForChild("Backpack", 5)
	if backpack and state.Player.Character == char then
		local tool = Katana.buildTool()
		tool.Parent = backpack
		state.Tool = tool
		tool.Activated:Connect(function()
			slash(state)
		end)
		task.defer(function()
			if humanoid.Parent and tool.Parent == backpack then
				humanoid:EquipTool(tool)
			end
		end)
	end
	FX.to(state.Player, "Reset", {})
end

local function onPlayerAdded(player: Player)
	local state: State = {
		Player = player,
		Cooldowns = {},
		Combo = 0,
		LastSlash = 0,
		NextSlash = 0,
		BusyUntil = 0,
		SlowUntil = 0,
		RikaUntil = 0,
		NextClaw = 0,
		SixEyesUntil = 0,
		DomainUntil = 0,
		DomainCenter = Vector3.zero,
		Blocking = false,
		Serial = 0,
	}
	states[player] = state
	player.CharacterAdded:Connect(function(char)
		setupCharacter(state, char)
	end)
	if player.Character then
		task.spawn(setupCharacter, state, player.Character)
	end
end

-- Timers and movement, ten times a second.
local function update()
	local now = os.clock()
	for _, state in states do
		if not alive(state) then
			continue
		end
		if state.RikaUntil > 0 and now >= state.RikaUntil then
			endRika(state)
		end
		if state.SixEyesUntil > 0 and now >= state.SixEyesUntil then
			endSixEyes(state)
		end
		if rikaActive(state) and now >= state.NextClaw then
			rikaClaw(state)
		end

		local humanoid = state.Humanoid :: Humanoid
		local isStunned = stunned(state)
		local speed = Config.Player.WalkSpeed
		if isStunned then
			speed = 0
		elseif state.SlowUntil > now then
			speed = Config.Player.CastWalkSpeed
		elseif state.Blocking then
			speed = Config.Player.BlockWalkSpeed
		end
		if humanoid.WalkSpeed ~= speed then
			humanoid.WalkSpeed = speed
		end
		local jumpPower = if isStunned then 0 else Config.Player.JumpPower
		if humanoid.JumpPower ~= jumpPower then
			humanoid.JumpPower = jumpPower
			humanoid.JumpHeight = if isStunned then 0 else Config.Player.JumpHeight
		end
		local char = state.Character :: Model
		if char:GetAttribute("JJK_Stunned") ~= isStunned then
			char:SetAttribute("JJK_Stunned", isStunned)
		end
	end
end

function YutaKit.start()
	local remote = Net.event("Ability")
	remote.OnServerEvent:Connect(function(player: Player, id: any, payload: any)
		if typeof(id) ~= "string" or handlers[id] == nil then
			return
		end
		local state = states[player]
		if not state or not alive(state) then
			return
		end
		local mode = if sixEyesActive(state) then "SixEyes" else "Base"
		if not Abilities.inMode(mode, id) then
			return
		end
		handlers[id](state, if typeof(payload) == "table" then payload else {})
	end)

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 0.1 then
			acc = 0
			update()
		end
	end)
end

return YutaKit
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="23">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="24">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="25">
        <Properties>
          <string name="Name">JJKClient</string>
          <string name="Source"><![CDATA[--!strict
-- Yuta Okkotsu vs Mahoraga: client entry point.

local HUD = require(script:WaitForChild("HUD"))
local CameraFX = require(script:WaitForChild("CameraFX"))
local VFX = require(script:WaitForChild("VFX"))
local Input = require(script:WaitForChild("Input"))
local BossAnimator = require(script:WaitForChild("BossAnimator"))
local RikaFollower = require(script:WaitForChild("RikaFollower"))

HUD.start()
CameraFX.start()
VFX.start()
Input.start()
BossAnimator.start()
RikaFollower.start()
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">BossAnimator</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Animates Mahoraga on every client by driving its Motor6D transforms from the
	server's animation state (the JJK_Anim / JJK_AnimT attributes). No animation
	assets needed: every pose is procedural and blended with springs.

	Angles are in degrees: P(pitch, yaw, roll). For a hanging limb, +pitch swings
	it forward, +roll swings it toward +X (the rig's right).
]]

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local BossAnimator = {}

type Pose = { [string]: CFrame }
type Rig = {
	Model: Model,
	Root: BasePart?,
	Motors: { [string]: Motor6D },
	MotorCount: number,
	Current: { [string]: CFrame },
	WalkPhase: number,
	WheelAngle: number,
	WheelFrom: number,
	WheelTo: number,
	WheelT0: number,
	Turns: number,
	AdaptT0: number,
}

local rigs: { [Model]: Rig } = {}

local function P(pitch: number, yaw: number?, roll: number?): CFrame
	return CFrame.Angles(0, math.rad(yaw or 0), 0) * CFrame.Angles(math.rad(pitch), 0, 0) * CFrame.Angles(0, 0, math.rad(roll or 0))
end

local function T(x: number, y: number, z: number): CFrame
	return CFrame.new(x, y, z)
end

local function merge(base: Pose, over: Pose): Pose
	for k, v in over do
		base[k] = v
	end
	return base
end

local function stance(now: number): Pose
	local b = math.sin(now * 1.6)
	return {
		Root = T(0, -0.35 + b * 0.08, 0),
		Waist = P(-4 + b * 1.2),
		Neck = P(3),
		RightShoulder = P(14, 0, 12),
		RightElbow = P(40),
		RightWrist = P(-8),
		LeftShoulder = P(8, 0, -12),
		LeftElbow = P(22),
		LeftWrist = P(0),
		RightHip = P(8, 0, 3),
		RightKnee = P(-14),
		RightAnkle = P(6),
		LeftHip = P(8, 0, -3),
		LeftKnee = P(-14),
		LeftAnkle = P(6),
	}
end

-- k = stride strength (0 idle .. ~1.6 sprint)
local function walk(now: number, phase: number, k: number): Pose
	local s, c = math.sin(phase), math.cos(phase)
	local amp = 28 * k
	local pose = stance(now)
	return merge(pose, {
		Root = T(0, -0.35 - 0.4 * k + math.abs(c) * 0.7 * k, 0) * P(0, s * 5 * k),
		Waist = P(-4 - 6 * k, -s * 9 * k),
		Neck = P(3 + 2 * k, s * 5 * k),
		RightShoulder = P(14 - s * amp * 0.7, 0, 12),
		RightElbow = P(40 + math.max(0, -s) * 15 * k),
		LeftShoulder = P(8 + s * amp * 0.7, 0, -12),
		LeftElbow = P(22 + math.max(0, s) * 15 * k),
		RightHip = P(8 + s * amp, 0, 3),
		RightKnee = P(-14 - math.max(0, c) * 45 * k),
		RightAnkle = P(6 + math.max(0, c) * 10 * k),
		LeftHip = P(8 - s * amp, 0, -3),
		LeftKnee = P(-14 - math.max(0, -c) * 45 * k),
		LeftAnkle = P(6 + math.max(0, -c) * 10 * k),
	})
end

-- Each attack state returns its target pose (layered over the stance) and a blend rate.
local STATES: { [string]: (number, number) -> (Pose, number) } = {
	SweepWindup = function()
		return {
			Root = T(0, -1.2, 0),
			Waist = P(-6, 32),
			Neck = P(0, -20),
			RightShoulder = P(85, 75, 0),
			RightElbow = P(30),
			LeftShoulder = P(30, 0, -35),
			LeftElbow = P(40),
			RightHip = P(20, 0, 6),
			RightKnee = P(-30),
			LeftHip = P(-5, 0, -6),
			LeftKnee = P(-20),
		},
			9
	end,
	Sweep = function()
		return {
			Root = T(0, -1.4, 0),
			Waist = P(-10, -38),
			Neck = P(0, 15),
			RightShoulder = P(85, -95, 0),
			RightElbow = P(5),
			LeftShoulder = P(20, 0, -45),
			RightHip = P(-5, 0, 6),
			RightKnee = P(-20),
			LeftHip = P(20, 0, -6),
			LeftKnee = P(-30),
		},
			24
	end,
	CleaveWindup = function()
		return {
			Root = T(0, -0.6, 0),
			Waist = P(12, 8),
			Neck = P(10),
			RightShoulder = P(170, 5, 12),
			RightElbow = P(45),
			LeftShoulder = P(60, 0, -25),
			LeftElbow = P(50),
			RightHip = P(-5),
			LeftHip = P(25),
			LeftKnee = P(-30),
		},
			9
	end,
	Cleave = function()
		return {
			Root = T(0, -2.2, 0),
			Waist = P(-32),
			Neck = P(-12),
			RightShoulder = P(35, 0, 6),
			RightElbow = P(0),
			LeftShoulder = P(-10, 0, -30),
			RightHip = P(35),
			RightKnee = P(-55),
			LeftHip = P(-10),
			LeftKnee = P(-25),
		},
			26
	end,
	PunchWindupR = function()
		return { Root = T(0, -0.9, 0), Waist = P(-6, -28), RightShoulder = P(25, 0, 30), RightElbow = P(115), LeftShoulder = P(55, 0, -10), LeftElbow = P(70) }, 12
	end,
	PunchR = function()
		return {
			Root = T(0, -1.1, 0),
			Waist = P(-12, 26),
			RightShoulder = P(90, 12, 0),
			RightElbow = P(4),
			LeftShoulder = P(20, 0, -18),
			LeftElbow = P(90),
			RightHip = P(-8),
			LeftHip = P(22),
			LeftKnee = P(-25),
		},
			28
	end,
	PunchWindupL = function()
		return { Root = T(0, -0.9, 0), Waist = P(-6, 28), LeftShoulder = P(25, 0, -30), LeftElbow = P(115), RightShoulder = P(55, 0, 10), RightElbow = P(70) }, 12
	end,
	PunchL = function()
		return {
			Root = T(0, -1.1, 0),
			Waist = P(-12, -26),
			LeftShoulder = P(90, -12, 0),
			LeftElbow = P(4),
			RightShoulder = P(20, 0, 18),
			RightElbow = P(90),
			LeftHip = P(-8),
			RightHip = P(22),
			RightKnee = P(-25),
		},
			28
	end,
	StompWindup = function()
		return {
			Root = T(0, 0.2, 0),
			Waist = P(6),
			RightHip = P(78, 0, 6),
			RightKnee = P(-88),
			RightAnkle = P(20),
			LeftKnee = P(-8),
			RightShoulder = P(35, 0, 45),
			LeftShoulder = P(35, 0, -45),
			RightElbow = P(50),
			LeftElbow = P(50),
		},
			7
	end,
	Stomp = function()
		return {
			Root = T(0, -1.8, 0),
			Waist = P(-18),
			RightHip = P(10, 0, 6),
			RightKnee = P(-12),
			LeftHip = P(20),
			LeftKnee = P(-38),
			RightShoulder = P(25, 0, 30),
			LeftShoulder = P(25, 0, -30),
		},
			28
	end,
	LeapCrouch = function()
		return {
			Root = T(0, -3, 0),
			Waist = P(-26),
			Neck = P(10),
			RightHip = P(58, 0, 5),
			LeftHip = P(58, 0, -5),
			RightKnee = P(-100),
			LeftKnee = P(-100),
			RightAnkle = P(40),
			LeftAnkle = P(40),
			RightShoulder = P(-45, 0, 22),
			LeftShoulder = P(-45, 0, -22),
		},
			10
	end,
	LeapAir = function()
		return {
			Root = T(0, 0, 0),
			Waist = P(10),
			Neck = P(8),
			RightShoulder = P(165, 0, 22),
			LeftShoulder = P(155, 0, -22),
			RightElbow = P(20),
			LeftElbow = P(25),
			RightHip = P(35),
			RightKnee = P(-70),
			LeftHip = P(-12),
			LeftKnee = P(-30),
		},
			7
	end,
	LeapLand = function()
		return {
			Root = T(0, -2.8, 0),
			Waist = P(-30),
			Neck = P(-8),
			RightShoulder = P(45, 0, 16),
			RightElbow = P(10),
			LeftShoulder = P(10, 0, -40),
			RightHip = P(50, 0, 6),
			LeftHip = P(10, 0, -8),
			RightKnee = P(-85),
			LeftKnee = P(-60),
		},
			22
	end,
	RushWindup = function()
		return {
			Root = T(0, -1.6, 0),
			Waist = P(-30),
			Neck = P(14),
			RightShoulder = P(-35, 0, 25),
			LeftShoulder = P(-35, 0, -25),
			RightHip = P(45),
			RightKnee = P(-65),
			LeftHip = P(-12),
			LeftKnee = P(-32),
		},
			9
	end,
	Rush = function(e, now)
		return merge(walk(now, e * 16, 1.6), {
			Waist = P(-36),
			Neck = P(16),
			RightShoulder = P(-55, 0, 22),
			LeftShoulder = P(-55, 0, -22),
		}),
			16
	end,
	BurstWindup = function()
		return {
			Root = T(0, -1.2, 0),
			Waist = P(-16),
			Neck = P(-12),
			RightShoulder = P(72, 48),
			LeftShoulder = P(72, -48),
			RightElbow = P(70),
			LeftElbow = P(70),
			RightKnee = P(-30),
			LeftKnee = P(-30),
		},
			8
	end,
	Burst = function()
		return {
			Root = T(0, -0.4, 0),
			Waist = P(14),
			Neck = P(22),
			RightShoulder = P(10, 0, 105),
			LeftShoulder = P(10, 0, -105),
			RightElbow = P(5),
			LeftElbow = P(5),
		},
			18
	end,
	Stunned = function(_e, now)
		local shiver = math.sin(now * 40) * 1.5
		return {
			Root = T(0, -1.2, 0),
			Waist = P(-20 + shiver, 0, 6),
			Neck = P(-28, 10),
			RightShoulder = P(4, 0, 6),
			LeftShoulder = P(4, 0, -6),
			RightElbow = P(10),
			LeftElbow = P(10),
			RightKnee = P(-30),
			LeftKnee = P(-24),
		},
			6
	end,
	Summon = function()
		return {
			Root = T(0, -1, 0),
			Waist = P(-12),
			Neck = P(-22),
			RightShoulder = P(45, 62),
			LeftShoulder = P(45, -62),
			RightElbow = P(105),
			LeftElbow = P(105),
		},
			5
	end,
	Death = function()
		return {
			Root = T(0, -6.2, 0) * P(-8),
			Waist = P(-42),
			Neck = P(-32),
			RightHip = P(82, 0, 6),
			LeftHip = P(82, 0, -6),
			RightKnee = P(-105),
			LeftKnee = P(-105),
			RightAnkle = P(30),
			LeftAnkle = P(30),
			RightShoulder = P(8, 0, 10),
			LeftShoulder = P(8, 0, -10),
			RightElbow = P(12),
			LeftElbow = P(12),
		},
			2.5
	end,
}

local function backOut(t: number): number
	local c1 = 1.70158
	local c3 = c1 + 1
	return 1 + c3 * (t - 1) ^ 3 + c1 * (t - 1) ^ 2
end

-- Target joint transforms for an animation state (also used by tools/preview).
function BossAnimator.poseFor(state: string, elapsed: number, now: number): Pose
	local fn = STATES[state]
	if fn then
		local over = fn(elapsed, now)
		return merge(stance(now), over)
	end
	return stance(now)
end

local function refreshMotors(rig: Rig)
	if rig.MotorCount >= 16 then
		return
	end
	local count = 0
	for _, d in rig.Model:GetDescendants() do
		if d:IsA("Motor6D") then
			rig.Motors[d.Name] = d
			count += 1
		end
	end
	rig.MotorCount = count
	local root = rig.Model:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		rig.Root = root
	end
end

local function step(dt: number)
	local now = os.clock()
	local serverNow = workspace:GetServerTimeNow()
	for model, rig in rigs do
		if not model.Parent then
			rigs[model] = nil
			continue
		end
		refreshMotors(rig)

		local state = (model:GetAttribute("JJK_Anim") or "Move") :: string
		local elapsed = serverNow - ((model:GetAttribute("JJK_AnimT") or serverNow) :: number)
		local pose: Pose
		local rate: number
		if state == "Move" then
			local root = rig.Root
			local vel = if root then root.AssemblyLinearVelocity else Vector3.zero
			local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
			local k = math.clamp(speed / 20, 0, 1.3)
			if k < 0.08 then
				pose = stance(now)
				rate = 6
			else
				rig.WalkPhase += dt * speed * 0.45
				pose = walk(now, rig.WalkPhase, k)
				rate = 10
			end
			if now - rig.AdaptT0 < 0.9 then
				pose.Neck = P(22)
				pose.Waist = P(8)
			end
		else
			local fn = STATES[state]
			if fn then
				local over, r = fn(elapsed, now)
				pose = merge(stance(now), over)
				rate = r
			else
				pose = stance(now)
				rate = 6
			end
		end

		local alpha = 1 - math.exp(-rate * dt)
		for name, motor in rig.Motors do
			if name ~= "Wheel" then
				local target = pose[name] or CFrame.identity
				local current = (rig.Current[name] or CFrame.identity):Lerp(target, alpha)
				rig.Current[name] = current
				motor.Transform = current
			end
		end

		-- The Dharma wheel clicks round 45 degrees per adaptation step.
		local turns = (model:GetAttribute("JJK_WheelTurns") or 0) :: number
		if rig.Turns < 0 then
			rig.Turns = turns
			rig.WheelAngle = turns * math.pi / 4
			rig.WheelFrom, rig.WheelTo = rig.WheelAngle, rig.WheelAngle
		elseif turns ~= rig.Turns then
			rig.Turns = turns
			rig.WheelFrom = rig.WheelAngle
			rig.WheelTo = turns * math.pi / 4
			rig.WheelT0 = now
			rig.AdaptT0 = now
		end
		local a = math.clamp((now - rig.WheelT0) / 0.45, 0, 1)
		rig.WheelAngle = rig.WheelFrom + (rig.WheelTo - rig.WheelFrom) * backOut(a)
		local wheel = rig.Motors.Wheel
		if wheel then
			wheel.Transform = CFrame.new(0, math.sin(now * 2) * 0.15, 0)
				* CFrame.Angles(0, rig.WheelAngle, 0)
				* CFrame.Angles(math.rad(math.sin(now * 0.9) * 2), 0, math.rad(math.cos(now * 0.7) * 2))
		end
	end
end

local function track(inst: Instance)
	if not inst:IsA("Model") or rigs[inst] then
		return
	end
	rigs[inst] = {
		Model = inst,
		Root = nil,
		Motors = {},
		MotorCount = 0,
		Current = {},
		WalkPhase = 0,
		WheelAngle = 0,
		WheelFrom = 0,
		WheelTo = 0,
		WheelT0 = 0,
		Turns = -1,
		AdaptT0 = -10,
	}
end

function BossAnimator.start()
	CollectionService:GetInstanceAddedSignal("JJK_Mahoraga"):Connect(track)
	CollectionService:GetInstanceRemovedSignal("JJK_Mahoraga"):Connect(function(inst)
		if inst:IsA("Model") then
			rigs[inst] = nil
		end
	end)
	for _, inst in CollectionService:GetTagged("JJK_Mahoraga") do
		track(inst)
	end
	RunService.Stepped:Connect(function(_time: number, dt: number)
		step(dt)
	end)
end

return BossAnimator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">BossVFX</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Client effects for Mahoraga: ground telegraphs, Sword of Extermination arcs,
	shockwaves, positive-energy rings, the adaptation wheel, summoning and death.
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("JJKShared")
local Palette = require(Shared:WaitForChild("Palette"))
local Util = require(Shared:WaitForChild("Util"))
local Assets = Shared:WaitForChild("Assets")
local PartKit = require(Assets:WaitForChild("PartKit"))
local Effects = require(Assets:WaitForChild("Effects"))
local Mahoraga = require(Assets:WaitForChild("Mahoraga"))

local VfxUtil = require(script.Parent.VfxUtil)
local HUD = require(script.Parent.HUD)
local CameraFX = require(script.Parent.CameraFX)

local NEON = Enum.Material.Neon
local WHITE = Color3.new(1, 1, 1)

local player = Players.LocalPlayer
local rng = VfxUtil.rng

local BossVFX = {}
local handlers: { [string]: (any) -> () } = {}
BossVFX.handlers = handlers

local function near(pos: Vector3, radius: number): boolean
	local root = VfxUtil.root(player.Character)
	return root ~= nil and (root.Position - pos).Magnitude <= radius
end

local function clearRing(ring: VfxUtil.LiveRing)
	for _, p in ring.parts do
		p:Destroy()
	end
end

-- Ground warning that fills up until the attack lands.
handlers.Telegraph = function(d)
	local folder = VfxUtil.folder()
	local color: Color3 = d.color or Palette.Danger
	local time: number = d.time or 0.8
	local cf: CFrame = d.cf
	local shape: string = d.shape or "circle"
	local t: Effects.Telegraph
	if shape == "circle" then
		t = Effects.telegraphCircle(folder, cf, d.radius, color)
	elseif shape == "rect" then
		t = Effects.telegraphRect(folder, cf, d.width, d.length, color)
	else
		t = Effects.telegraphArc(folder, cf, d.radius, d.arc, color)
	end
	local base = cf * CFrame.new(0, 0.16, 0)
	VfxUtil.animate(time, function(a)
		if shape == "circle" then
			local dia = math.max(0.1, d.radius * 2 * a)
			t.Progress[1].Size = Vector3.new(0.05, dia, dia)
		elseif shape == "rect" then
			local len = math.max(0.1, d.length * a)
			t.Progress[1].Size = Vector3.new(d.width, 0.05, len)
			t.Progress[1].CFrame = base * CFrame.new(0, 0, -len / 2)
		else
			local len = math.max(0.1, d.radius * a)
			for _, p in t.Progress do
				local angle = (p:GetAttribute("Angle") or 0) :: number
				p.Size = Vector3.new(p.Size.X, 0.05, len)
				p.CFrame = base * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -len / 2)
			end
		end
		local pulse = 0.15 + 0.35 * math.abs(math.sin(a * math.pi * 5))
		for _, p in t.Outline do
			p.Transparency = pulse
		end
	end, function()
		for _, p in t.Outline do
			p.Transparency = 0
		end
		VfxUtil.fade(t.Model, 0.18)
	end)
end

-- Sword of Extermination: a wide crescent of positive energy.
handlers.BossSlash = function(d)
	local cf: CFrame = d.cf
	local cleave = d.kind == "cleave"
	local slash = Effects.slash(VfxUtil.folder(), cf, d.radius or 19, d.arc or 200, if cleave then 3.2 else 2.8, Palette.Positive, Palette.PositiveCore, 26)
	local n = #slash.Outer
	local outerBase, coreBase = {}, {}
	for i = 1, n do
		outerBase[i] = slash.Outer[i].Transparency
		coreBase[i] = slash.Core[i].Transparency
		slash.Outer[i].Transparency = 1
		slash.Core[i].Transparency = 1
	end
	VfxUtil.animate(0.1, function(a)
		local shown = math.floor(a * n + 0.5)
		for k = 1, shown do
			local i = n - k + 1 -- Mahoraga swings from its left to its right
			slash.Outer[i].Transparency = outerBase[i]
			slash.Core[i].Transparency = coreBase[i]
		end
	end, function()
		VfxUtil.fade(slash.Model, 0.35)
	end)
	for i = 1, n, 4 do
		VfxUtil.burst(slash.Core[i].Position, {
			Texture = PartKit.Textures.Spark,
			Color = ColorSequence.new(Palette.PositiveCore, Palette.Positive),
			LightEmission = 1,
			Size = NumberSequence.new(0.6, 0),
			Lifetime = NumberRange.new(0.25, 0.5),
			Speed = NumberRange.new(10, 22),
			SpreadAngle = Vector2.new(60, 60),
		}, 4)
	end
	VfxUtil.sound("BossSlash", cf.Position)
end

-- Shockwave racing along the cleave line: rock spikes and a bright scar.
handlers.BossWave = function(d)
	local cf: CFrame = d.cf
	local length: number = d.length or 70
	local width: number = d.width or 10
	local folder = VfxUtil.folder()
	local steps = math.floor(length / 5)
	for i = 1, steps do
		task.delay(i * 0.022, function()
			local p = cf * CFrame.new(rng:NextNumber(-width * 0.3, width * 0.3), 0, -i * 5)
			local size = rng:NextNumber(0.7, 1.3)
			local final = p * CFrame.new(0, 1.4 * size, 0) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, 3), rng:NextNumber(-0.4, 0.4))
			local spike = PartKit.part({
				Name = "Spike",
				Parent = folder,
				CFrame = final * CFrame.new(0, -4, 0),
				Size = Vector3.new(2.2, 4.5, 2.2) * size,
				Color = Color3.fromRGB(96, 90, 98),
				Material = Enum.Material.Slate,
			})
			VfxUtil.tween(spike, 0.12, { CFrame = final })
			VfxUtil.fade(spike, 0.5, 0.8)
			local glow = PartKit.part({ Name = "Scar", Parent = folder, CFrame = p * CFrame.new(0, 0.2, 0), Size = Vector3.new(width * 0.7, 0.2, 5.4), Color = Palette.Positive, Material = NEON, Transparency = 0.15 })
			VfxUtil.fade(glow, 0.5, 0.2)
		end)
	end
	local cracks = Effects.cracks(folder, cf * CFrame.new(0, 0, -length * 0.5), length * 0.45, 7, rng)
	VfxUtil.fade(cracks, 1, 2)
end

handlers.BossRush = function(d)
	local from: Vector3 = d.from
	local to: Vector3 = d.to
	local folder = VfxUtil.folder()
	local frame = CFrame.lookAt(from, Vector3.new(to.X, from.Y, to.Z))
	for _ = 1, 12 do
		local x, y = rng:NextNumber(-7, 7), rng:NextNumber(-10, 12)
		local a = (frame * CFrame.new(x, y, 0)).Position
		local b = (frame * CFrame.new(x, y, -(to - from).Magnitude)).Position
		local line = PartKit.segment({ Name = "Wind", Parent = folder, Color = WHITE, Material = NEON, Transparency = 0.35 }, a, b, 0.22)
		VfxUtil.fade(line, 0.35, 0.1)
	end
	for k = 0, 2 do
		local p = from:Lerp(to, k / 2)
		VfxUtil.burst(VfxUtil.ground(p) + Vector3.new(0, 1, 0), {
			Texture = PartKit.Textures.Smoke,
			Color = ColorSequence.new(Color3.fromRGB(130, 122, 132)),
			Size = NumberSequence.new(3, 6),
			Transparency = NumberSequence.new(0.4, 1),
			Lifetime = NumberRange.new(0.6, 1),
			Speed = NumberRange.new(6, 12),
			SpreadAngle = Vector2.new(85, 85),
		}, 10)
	end
end

-- Rings of positive energy rolling outward (jump to avoid them).
handlers.BossRings = function(d)
	local center: Vector3 = d.center
	local count: number = d.count or 3
	local interval: number = d.interval or 0.65
	local speed: number = d.speed or 32
	local maxRadius: number = d.maxRadius or 75
	local folder = VfxUtil.folder()
	for k = 1, count do
		task.delay((k - 1) * interval, function()
			local wall = VfxUtil.liveRing(folder, CFrame.new(center + Vector3.new(0, 1.6, 0)), 56, 3.2, 1.0, Palette.Positive)
			local core = VfxUtil.liveRing(folder, CFrame.new(center + Vector3.new(0, 0.25, 0)), 56, 0.4, 2.2, Palette.PositiveCore)
			VfxUtil.animate(maxRadius / speed, function(a)
				local r = math.max(0.5, maxRadius * a)
				wall.set(r, 0.15 + 0.6 * a ^ 3)
				core.set(r, 0.3 + 0.6 * a ^ 3)
			end, function()
				clearRing(wall)
				clearRing(core)
			end)
			if near(center, maxRadius + 20) then
				CameraFX.shake(0.35, 0.3)
			end
		end)
	end
end

-- The Dharma wheel turns: flash it, burst a golden ring, and call out what it adapted to.
handlers.WheelTurn = function(d)
	local model = d.boss
	if typeof(model) ~= "Instance" or not model:IsA("Model") then
		return
	end
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") and p.Name == "WheelGlow" then
			p.Transparency = 0.05
			VfxUtil.tween(p, 0.9, { Transparency = 1 })
		end
	end
	local core = model:FindFirstChild("WheelCore")
	local pos = if core and core:IsA("BasePart") then core.Position else (model:GetPivot().Position + Vector3.new(0, 28, 0))
	local folder = VfxUtil.folder()
	local ring = VfxUtil.liveRing(folder, CFrame.new(pos), 32, 0.4, 0.5, Palette.Positive)
	VfxUtil.animate(0.6, function(a)
		ring.set(3.6 + a * 16, a)
	end, function()
		clearRing(ring)
	end)
	local level: number = d.level or 1
	local maxLevel: number = d.maxLevel or 4
	local name = string.upper(tostring(d.typeName or "?"))
	local full = level >= maxLevel
	local text = if full then ("FULLY ADAPTED: %s"):format(name) else ("ADAPTING: %s  %d/%d"):format(name, level, maxLevel)
	VfxUtil.kanji(pos + Vector3.new(0, 4.5, 0), text, 2.4, if full then Palette.Danger else Palette.Wheel, 1.8)
	if full and near(pos, 200) then
		HUD.notify(("Mahoraga has fully adapted to %s. Switch techniques!"):format(tostring(d.typeName)))
	end
	VfxUtil.sound("WheelTurn", pos)
end

-- Ten Shadows summoning: a pool of shadow, a pillar of light, and the wheel rising first.
handlers.Summon = function(d)
	local pos: Vector3 = d.pos
	local time: number = d.time or 3
	local folder = VfxUtil.folder()
	local pool = PartKit.cylinderY({ Name = "Pool", Parent = folder, CFrame = CFrame.new(pos + Vector3.new(0, 0.1, 0)), Color = Palette.Shadow }, 0.08, 1)
	VfxUtil.tween(pool, 0.6, { Size = Vector3.new(0.08, 34, 34) })
	local edge = VfxUtil.liveRing(folder, CFrame.new(pos + Vector3.new(0, 0.14, 0)), 40, 0.1, 0.9, Palette.YutaEnergy)
	VfxUtil.animate(0.6, function(a)
		edge.set(0.5 + 16.5 * (1 - (1 - a) ^ 3))
	end)
	local smoke = PartKit.emitter(pool, {
		Texture = PartKit.Textures.Smoke,
		Color = ColorSequence.new(Palette.Shadow, Palette.YutaDark),
		Size = NumberSequence.new(3, 6),
		Transparency = NumberSequence.new(0.2, 1),
		Lifetime = NumberRange.new(1, 1.6),
		Rate = 40,
		Speed = NumberRange.new(2, 6),
		SpreadAngle = Vector2.new(30, 30),
		EmissionDirection = Enum.NormalId.Right, -- cylinder's local +X points up
	})
	if not d.reverse then
		local pillar = Effects.pillar(folder, CFrame.new(pos), 90, 4, Palette.Wheel)
		local pillarFade = VfxUtil.fader(pillar)
		pillarFade.set(0)
		VfxUtil.animate(0.5, function(a)
			pillarFade.set(a)
		end)
		VfxUtil.fade(pillar, 0.6, time - 0.4)
		local wheel = Mahoraga.buildWheel(folder, CFrame.new(pos + Vector3.new(0, 1, 0)), 1.5)
		wheel.WorldPivot = CFrame.new(pos + Vector3.new(0, 1, 0))
		VfxUtil.animate(time, function(a)
			local eased = 1 - (1 - a) ^ 2
			wheel:PivotTo(CFrame.new(pos + Vector3.new(0, 1 + 30 * eased, 0)) * CFrame.Angles(0, a * math.pi * 3, 0))
		end, function()
			VfxUtil.fade(wheel, 0.4)
		end)
		VfxUtil.kanji(pos + Vector3.new(0, 12, 0), "布瑠部由良由良", 3.6, Palette.Wheel, time, 0.1)
		if near(pos, 250) then
			CameraFX.shake(0.5, time)
		end
	end
	task.delay(time, function()
		smoke.Enabled = false
		clearRing(edge)
		VfxUtil.fade(pool, 0.8)
	end)
	VfxUtil.sound("Summon", pos)
end

-- Exorcised: the body bleaches to white and dissolves; the wheel shatters.
handlers.BossDeath = function(d)
	local model = d.boss
	if typeof(model) ~= "Instance" or not model:IsA("Model") then
		return
	end
	local folder = VfxUtil.folder()
	local wheelCore = model:FindFirstChild("WheelCore")
	if wheelCore and wheelCore:IsA("BasePart") then
		local shards = Mahoraga.buildWheel(folder, wheelCore.CFrame, 1)
		for _, p in model:GetDescendants() do
			if p:IsA("BasePart") and (p.Name == "Rim" or p.Name == "InnerRim" or p.Name == "Spoke" or p.Name == "Handle" or p.Name == "Knob" or p.Name == "Hub") then
				p.Transparency = 1
			end
		end
		task.delay(0.6, function()
			for _, shard in shards:GetChildren() do
				if shard:IsA("BasePart") then
					local out = Util.flatUnit(shard.Position - wheelCore.Position, Vector3.new(1, 0, 0))
					VfxUtil.tween(shard, 1.4, {
						CFrame = shard.CFrame + out * rng:NextNumber(6, 14) + Vector3.new(0, rng:NextNumber(-8, 6), 0),
						Transparency = 1,
					})
				end
			end
			Debris:AddItem(shards, 1.5)
		end)
	end
	for _, p in VfxUtil.parts(model) do
		if p.Transparency < 1 then
			task.delay(rng:NextNumber(0.4, 2.4), function()
				VfxUtil.tween(p, 1.2, { Color = WHITE })
				VfxUtil.tween(p, 1.4, { Transparency = 1 })
			end)
		end
	end
	local pos: Vector3 = d.pos
	local pillar = Effects.pillar(folder, CFrame.new(VfxUtil.ground(pos)), 120, 6, WHITE)
	VfxUtil.fade(pillar, 1.2, 2.5)
	local a = Instance.new("Attachment")
	a.WorldPosition = pos
	a.Parent = workspace.Terrain
	PartKit.emitter(a, {
		Texture = PartKit.Textures.Sparkle,
		Color = ColorSequence.new(WHITE, Palette.Wheel),
		LightEmission = 1,
		Size = NumberSequence.new(0.8, 0),
		Lifetime = NumberRange.new(1.5, 2.5),
		Rate = 80,
		Speed = NumberRange.new(4, 10),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, 10, 0),
	})
	Debris:AddItem(a, 4)
	if near(pos, 300) then
		HUD.flash(WHITE, 1.2, 0.6)
		CameraFX.shake(1.2, 1)
	end
end

-- Spinning ring over a stunned target's head.
function BossVFX.stunRing(model: any, duration: number)
	if typeof(model) ~= "Instance" or not model:IsA("Model") then
		return
	end
	local head = model:FindFirstChild("Head")
	local anchorPart = if head and head:IsA("BasePart") then head else model.PrimaryPart
	if not anchorPart then
		return
	end
	local big = anchorPart.Size.Magnitude > 4
	local radius = if big then 3.5 else 1.3
	local lift = if big then 3.5 else 1.8
	local folder = VfxUtil.folder()
	local ringModel = PartKit.model("StunRing", folder)
	PartKit.ring(ringModel, CFrame.new(), radius, 0.16, 0.12, 18, { Color = Palette.SpeechRing, Material = NEON })
	for k = 0, 2 do
		PartKit.ball(ringModel, CFrame.Angles(0, k * math.pi * 2 / 3, 0) * CFrame.new(0, 0, -radius), 0.35 * (if big then 2 else 1), { Color = WHITE, Material = NEON }, "Star")
	end
	ringModel.WorldPivot = CFrame.new()
	VfxUtil.animate(duration, function(a)
		if not anchorPart.Parent then
			return false
		end
		ringModel:PivotTo(CFrame.new(anchorPart.Position + Vector3.new(0, lift, 0)) * CFrame.Angles(0, a * duration * 6, 0))
		return true
	end, function()
		ringModel:Destroy()
	end)
end

return BossVFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">CameraFX</string>
            <string name="Source"><![CDATA[--!strict
-- Camera shake layered on top of the default camera.

local RunService = game:GetService("RunService")

local CameraFX = {}

type Shake = { intensity: number, duration: number, started: number }
local shakes: { Shake } = {}

function CameraFX.shake(intensity: number, duration: number)
	table.insert(shakes, { intensity = intensity, duration = math.max(duration, 0.05), started = os.clock() })
end

function CameraFX.start()
	RunService:BindToRenderStep("JJK_CameraShake", Enum.RenderPriority.Camera.Value + 1, function()
		if #shakes == 0 then
			return
		end
		local now = os.clock()
		local total = 0
		for i = #shakes, 1, -1 do
			local s = shakes[i]
			local t = (now - s.started) / s.duration
			if t >= 1 then
				table.remove(shakes, i)
			else
				total += s.intensity * (1 - t) ^ 2
			end
		end
		if total <= 0 then
			return
		end
		local camera = workspace.CurrentCamera
		local n = now * 38
		local offset = Vector3.new(math.noise(n, 3.1), math.noise(5.2, n), 0) * total * 0.6
		local rx = math.noise(n, 0.3) * total * 0.03
		local ry = math.noise(0.7, n) * total * 0.03
		camera.CFrame = camera.CFrame * CFrame.new(offset) * CFrame.Angles(rx, ry, 0)
	end)
end

return CameraFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Heads-up display: hotbar with cooldowns (tap/click the slots on mobile),
	Yuta's health, technique timers, Mahoraga's boss bar with the adaptation
	wheel, announcements and toasts.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("JJKShared")
local Config = require(Shared:WaitForChild("Config"))
local Palette = require(Shared:WaitForChild("Palette"))
local Abilities = require(Shared:WaitForChild("Abilities"))
local Util = require(Shared:WaitForChild("Util"))

local player = Players.LocalPlayer

local HUD = {}

-- Set by Input: called with (abilityId, pressed) when a slot is clicked/tapped.
HUD.onSlot = nil :: ((string, boolean) -> ())?

type Cooldown = { ends: number, duration: number }
type Slot = {
	Frame: Frame,
	Stroke: UIStroke,
	Accent: Frame,
	Key: TextLabel,
	Kanji: TextLabel,
	Label: TextLabel,
	Shade: Frame,
	Timer: TextLabel,
	State: TextLabel,
	Id: string?,
	WasCooling: boolean,
}

local cooldowns: { [string]: Cooldown } = {}
local slots: { Slot } = {}
local currentMode = ""

local BLACK = Color3.new(0, 0, 0)
local WHITE = Color3.new(1, 1, 1)
local PANEL = Color3.fromRGB(16, 12, 24)
local MUTED = Color3.fromRGB(176, 166, 196)

local function new(className: string, props: { [string]: any }): any
	local inst = Instance.new(className)
	for k, v in props do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function corner(parent: Instance, px: number)
	new("UICorner", { CornerRadius = UDim.new(0, px), Parent = parent })
end

local function stroke(parent: Instance, color: Color3, thickness: number, transparency: number?): UIStroke
	return new("UIStroke", { Color = color, Thickness = thickness, Transparency = transparency or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = parent })
end

local function textStroke(parent: Instance, thickness: number)
	new("UIStroke", { Color = BLACK, Thickness = thickness, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual, Parent = parent })
end

local gui: ScreenGui
local elements: { [string]: any } = {}

-- Cooldowns -----------------------------------------------------------------------------

function HUD.setCooldown(id: string, ends: number, duration: number)
	cooldowns[id] = { ends = ends, duration = duration }
end

function HUD.cooldownRemaining(id: string): number
	local cd = cooldowns[id]
	if not cd then
		return 0
	end
	return math.max(0, cd.ends - workspace:GetServerTimeNow())
end

function HUD.reset()
	table.clear(cooldowns)
end

-- Hotbar -------------------------------------------------------------------------------

local function makeSlot(parent: Instance, index: number): Slot
	local frame = new("Frame", {
		Name = "Slot" .. index,
		LayoutOrder = index,
		Size = UDim2.fromOffset(68, 76),
		BackgroundColor3 = PANEL,
		BackgroundTransparency = 0.12,
		ClipsDescendants = true,
		Parent = parent,
	})
	corner(frame, 8)
	local slot: Slot = {
		Frame = frame,
		Stroke = stroke(frame, Palette.YutaEnergy, 1.5, 0.25),
		Accent = new("Frame", { Size = UDim2.new(1, 0, 0, 3), BorderSizePixel = 0, BackgroundColor3 = Palette.YutaEnergy, Parent = frame }),
		Kanji = new("TextLabel", {
			Size = UDim2.new(1, -8, 0, 32),
			Position = UDim2.fromOffset(4, 12),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBlack,
			TextScaled = true,
			TextColor3 = WHITE,
			Text = "",
			Parent = frame,
		}),
		Key = new("TextLabel", {
			Size = UDim2.fromOffset(18, 16),
			Position = UDim2.fromOffset(4, 6),
			BackgroundColor3 = BLACK,
			BackgroundTransparency = 0.3,
			Font = Enum.Font.GothamBlack,
			TextSize = 12,
			TextColor3 = WHITE,
			Text = "",
			ZIndex = 2,
			Parent = frame,
		}),
		Label = new("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -3),
			Size = UDim2.new(1, -6, 0, 26),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			TextSize = 11,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Bottom,
			TextColor3 = WHITE,
			Text = "",
			Parent = frame,
		}),
		Shade = new("Frame", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.fromScale(1, 0),
			BackgroundColor3 = BLACK,
			BackgroundTransparency = 0.3,
			BorderSizePixel = 0,
			ZIndex = 3,
			Parent = frame,
		}),
		Timer = new("TextLabel", {
			Size = UDim2.fromScale(1, 0.7),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBlack,
			TextSize = 22,
			TextColor3 = WHITE,
			Text = "",
			ZIndex = 4,
			Parent = frame,
		}),
		State = new("TextLabel", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -4, 0, 6),
			Size = UDim2.fromOffset(44, 14),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBlack,
			TextSize = 10,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = WHITE,
			Text = "",
			ZIndex = 4,
			Parent = frame,
		}),
		Id = nil,
		WasCooling = false,
	}
	textStroke(slot.Timer, 1.5)
	local button = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 5, Parent = frame })
	button.InputBegan:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			local id = slot.Id
			if id and HUD.onSlot then
				HUD.onSlot(id, true)
			end
		end
	end)
	button.InputEnded:Connect(function(input: InputObject)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			local id = slot.Id
			if id and HUD.onSlot then
				HUD.onSlot(id, false)
			end
		end
	end)
	return slot
end

local function applySlot(slot: Slot, id: string)
	local def = Abilities.Defs[id]
	slot.Id = id
	slot.Key.Text = def.KeyLabel
	slot.Label.Text = def.Short
	slot.Kanji.Text = def.Kanji or ""
	slot.Kanji.TextColor3 = def.Color
	slot.Accent.BackgroundColor3 = def.Color
	slot.Stroke.Color = def.Color
end

-- Announcements, toasts, flashes -----------------------------------------------------------

local announceSerial = 0
function HUD.announce(title: string, sub: string?, color: Color3?, time: number?)
	if not gui then
		return
	end
	announceSerial += 1
	local serial = announceSerial
	local holder = elements.Announce
	local titleLabel: TextLabel = holder.Title
	local subLabel: TextLabel = holder.Sub
	local line: Frame = holder.Line
	titleLabel.Text = title
	subLabel.Text = sub or ""
	titleLabel.TextColor3 = color or WHITE
	line.BackgroundColor3 = color or WHITE
	titleLabel.TextTransparency = 1
	subLabel.TextTransparency = 1
	line.BackgroundTransparency = 1
	titleLabel.Position = UDim2.new(0.5, 0, 0, 18)
	local info = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(titleLabel, info, { TextTransparency = 0, Position = UDim2.new(0.5, 0, 0, 0) }):Play()
	TweenService:Create(subLabel, info, { TextTransparency = 0 }):Play()
	TweenService:Create(line, info, { BackgroundTransparency = 0.2 }):Play()
	task.delay(time or 2.2, function()
		if serial ~= announceSerial then
			return
		end
		local out = TweenInfo.new(0.45)
		TweenService:Create(titleLabel, out, { TextTransparency = 1 }):Play()
		TweenService:Create(subLabel, out, { TextTransparency = 1 }):Play()
		TweenService:Create(line, out, { BackgroundTransparency = 1 }):Play()
	end)
end

local toastSerial = 0
function HUD.notify(text: string)
	if not gui then
		return
	end
	toastSerial += 1
	local serial = toastSerial
	local toast: TextLabel = elements.Toast
	toast.Text = text
	toast.TextTransparency = 0
	toast.BackgroundTransparency = 0.3
	task.delay(2.6, function()
		if serial == toastSerial then
			TweenService:Create(toast, TweenInfo.new(0.4), { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
		end
	end)
end

function HUD.flash(color: Color3, time: number, peak: number?)
	if not gui then
		return
	end
	local overlay: Frame = elements.Flash
	overlay.BackgroundColor3 = color
	overlay.BackgroundTransparency = 1 - (peak or 0.45)
	TweenService:Create(overlay, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 }):Play()
end

function HUD.toggleHelp()
	local help: Frame? = elements.Help
	if help then
		help.Visible = not help.Visible
	end
end

-- Build ------------------------------------------------------------------------------------

local function buildVitals(parent: Instance)
	local vitals = new("Frame", {
		Name = "Vitals",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 18, 1, -18),
		Size = UDim2.fromOffset(300, 70),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local name = new("TextLabel", {
		Size = UDim2.fromOffset(300, 22),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = WHITE,
		Text = "YUTA OKKOTSU",
		Parent = vitals,
	})
	textStroke(name, 1.5)
	new("TextLabel", {
		Position = UDim2.fromOffset(0, 21),
		Size = UDim2.fromOffset(300, 14),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = MUTED,
		Text = "SPECIAL GRADE SORCERER  -  COPY / RIKA",
		Parent = vitals,
	})
	local barBack = new("Frame", {
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.fromOffset(300, 14),
		BackgroundColor3 = PANEL,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = vitals,
	})
	corner(barBack, 4)
	stroke(barBack, Palette.YutaEnergy, 1, 0.4)
	local ghost = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 0.5, BorderSizePixel = 0, Parent = barBack })
	local fill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = barBack })
	new("UIGradient", { Color = ColorSequence.new(Palette.YutaEnergy, Palette.PureLove), Parent = fill })
	local hpText = new("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 11,
		TextColor3 = WHITE,
		Text = "",
		ZIndex = 3,
		Parent = barBack,
	})
	textStroke(hpText, 1)
	local status = new("TextLabel", {
		Position = UDim2.fromOffset(0, 56),
		Size = UDim2.fromOffset(300, 14),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Palette.SixEyes,
		Text = "",
		Parent = vitals,
	})
	elements.Vitals = { Fill = fill, Ghost = ghost, Text = hpText, Status = status, Shown = 1, GhostShown = 1 }
end

local function buildTimers(parent: Instance)
	local row = new("Frame", {
		Name = "Timers",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -104),
		Size = UDim2.fromOffset(520, 24),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 8), Parent = row })
	local function chip(color: Color3): TextLabel
		local label = new("TextLabel", {
			Size = UDim2.fromOffset(210, 24),
			BackgroundColor3 = PANEL,
			BackgroundTransparency = 0.15,
			Font = Enum.Font.GothamBlack,
			TextSize = 13,
			TextColor3 = color,
			Text = "",
			Visible = false,
			Parent = row,
		})
		corner(label, 6)
		stroke(label, color, 1.5, 0.2)
		return label
	end
	elements.RikaTimer = chip(Palette.RikaAura)
	elements.SixEyesTimer = chip(Palette.SixEyes)
end

local function buildWheelIcon(parent: Instance, size: number): Frame
	local icon = new("Frame", { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1, Parent = parent })
	local ring = new("Frame", { Size = UDim2.fromScale(0.7, 0.7), Position = UDim2.fromScale(0.15, 0.15), BackgroundTransparency = 1, Parent = icon })
	corner(ring, size)
	stroke(ring, Palette.Wheel, 2.5)
	for k = 0, 3 do
		new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, 0, 0, 2),
			Rotation = k * 45,
			BackgroundColor3 = Palette.Wheel,
			BorderSizePixel = 0,
			Parent = icon,
		})
	end
	return icon
end

local function buildBoss(parent: Instance)
	local boss = new("Frame", {
		Name = "Boss",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 58),
		Size = UDim2.fromOffset(640, 118),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = parent,
	})
	local title = new("TextLabel", {
		Size = UDim2.fromOffset(640, 14),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = Palette.Wheel,
		Text = string.upper(Config.Boss.Title),
		Parent = boss,
	})
	textStroke(title, 1)
	local name = new("TextLabel", {
		Position = UDim2.fromOffset(0, 12),
		Size = UDim2.fromOffset(640, 34),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		TextSize = 32,
		TextColor3 = WHITE,
		Text = string.upper(Config.Boss.Name),
		Parent = boss,
	})
	textStroke(name, 2)
	local kanji = new("TextLabel", {
		Position = UDim2.fromOffset(0, 18),
		Size = UDim2.fromOffset(200, 22),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = MUTED,
		Text = Config.Boss.Kanji,
		Parent = boss,
	})
	textStroke(kanji, 1)
	local wheelHolder = new("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 12), Size = UDim2.fromOffset(110, 32), BackgroundTransparency = 1, Parent = boss })
	local wheel = buildWheelIcon(wheelHolder, 30)
	local turns = new("TextLabel", {
		Position = UDim2.fromOffset(34, 0),
		Size = UDim2.fromOffset(76, 32),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Palette.Wheel,
		Text = "x0",
		Parent = wheelHolder,
	})
	textStroke(turns, 1.5)

	local barBack = new("Frame", {
		Position = UDim2.fromOffset(0, 50),
		Size = UDim2.fromOffset(640, 18),
		BackgroundColor3 = PANEL,
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = boss,
	})
	corner(barBack, 4)
	stroke(barBack, Palette.Wheel, 1.5, 0.2)
	local ghost = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 0.45, BorderSizePixel = 0, Parent = barBack })
	local fill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = barBack })
	new("UIGradient", { Color = ColorSequence.new(Palette.Danger, Palette.Wheel), Parent = fill })
	for _, at in { Config.Boss.EnrageAt, Config.Boss.FinalPhaseAt } do
		new("Frame", { Position = UDim2.new(at, -1, 0, 0), Size = UDim2.new(0, 2, 1, 0), BackgroundColor3 = WHITE, BackgroundTransparency = 0.2, BorderSizePixel = 0, ZIndex = 3, Parent = barBack })
	end
	local hpText = new("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		TextSize = 12,
		TextColor3 = WHITE,
		Text = "",
		ZIndex = 4,
		Parent = barBack,
	})
	textStroke(hpText, 1.2)
	local chips = new("Frame", { Position = UDim2.fromOffset(0, 74), Size = UDim2.fromOffset(640, 44), BackgroundTransparency = 1, Parent = boss })
	new("UIGridLayout", {
		CellSize = UDim2.fromOffset(152, 20),
		CellPadding = UDim2.fromOffset(6, 4),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = chips,
	})
	elements.Boss = {
		Frame = boss,
		Fill = fill,
		Ghost = ghost,
		Text = hpText,
		Turns = turns,
		Wheel = wheel,
		Chips = chips,
		Signature = "",
		Shown = 1,
		GhostShown = 1,
		WheelAngle = 0,
	}
end

local function buildHelp(parent: Instance)
	local lines = {
		"M1 (click)  Katana combo",
		"Q  Cursed Dash",
		"Z  Rika: Partial Manifestation",
		"X  Cursed Speech: Don't Move",
		"C  Cursed Speech: Blast Away",
		"V  Reverse Cursed Technique",
		"F  Rika: Full Manifestation",
		"R  Pure Love beam (needs F)",
		"T  Domain: Authentic Mutual Love",
		"G  Six Eyes (Z Blue, X Red, C Purple)",
		"E  Guard (hold)",
		"P  Summon Mahoraga at the altar",
		"H  Hide / show this panel",
	}
	local help = new("Frame", {
		Name = "Help",
		Position = UDim2.fromOffset(16, 64),
		Size = UDim2.fromOffset(268, 30 + #lines * 17),
		BackgroundColor3 = PANEL,
		BackgroundTransparency = 0.2,
		Parent = parent,
	})
	corner(help, 8)
	stroke(help, Palette.YutaEnergy, 1, 0.4)
	new("TextLabel", {
		Position = UDim2.fromOffset(12, 6),
		Size = UDim2.new(1, -24, 0, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Palette.YutaCore,
		Text = "CONTROLS",
		Parent = help,
	})
	for i, line in lines do
		new("TextLabel", {
			Position = UDim2.fromOffset(12, 10 + i * 17),
			Size = UDim2.new(1, -24, 0, 16),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = MUTED,
			Text = line,
			Parent = help,
		})
	end
	elements.Help = help
	task.delay(18, function()
		help.Visible = false
	end)
end

local function build()
	gui = new("ScreenGui", {
		Name = "JJK_HUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 5,
	})
	local scale = new("UIScale", { Parent = gui })
	local camera = workspace.CurrentCamera
	local function rescale()
		local vp = camera.ViewportSize
		scale.Scale = math.clamp(math.min(vp.X / 1280, vp.Y / 720), 0.55, 1.2)
	end
	rescale()
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

	local bar = new("Frame", {
		Name = "Hotbar",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, if UserInputService.TouchEnabled then -150 else -16),
		Size = UDim2.fromOffset(10 * 74, 76),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = bar,
	})
	for i = 1, #Abilities.Bars.Base do
		slots[i] = makeSlot(bar, i)
	end

	buildVitals(gui)
	buildTimers(gui)
	buildBoss(gui)
	buildHelp(gui)

	local announce = new("Frame", {
		Name = "Announce",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.24),
		Size = UDim2.fromOffset(900, 130),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local title = new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.new(1, 0, 0, 76),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		TextSize = 64,
		TextColor3 = WHITE,
		TextTransparency = 1,
		Text = "",
		Parent = announce,
	})
	textStroke(title, 3)
	local line = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 82),
		Size = UDim2.fromOffset(420, 2),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = announce,
	})
	local sub = new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 90),
		Size = UDim2.new(1, 0, 0, 28),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 22,
		TextColor3 = WHITE,
		TextTransparency = 1,
		Text = "",
		Parent = announce,
	})
	textStroke(sub, 1.5)
	elements.Announce = { Title = title, Sub = sub, Line = line }

	local toast = new("TextLabel", {
		Name = "Toast",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, if UserInputService.TouchEnabled then -268 else -136),
		Size = UDim2.fromOffset(560, 30),
		BackgroundColor3 = PANEL,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 16,
		TextColor3 = WHITE,
		TextTransparency = 1,
		Text = "",
		Parent = gui,
	})
	corner(toast, 6)
	elements.Toast = toast

	elements.Flash = new("Frame", {
		Name = "Flash",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 50,
		Parent = gui,
	})

	gui.Parent = player:WaitForChild("PlayerGui")
end

-- Per-frame updates ------------------------------------------------------------------------

local function updateSlots(char: Model?)
	local mode = (char and char:GetAttribute("JJK_Mode") or "Base") :: string
	if mode ~= currentMode then
		currentMode = mode
		local bar = Abilities.Bars[mode] or Abilities.Bars.Base
		for i, id in bar do
			applySlot(slots[i], id)
		end
	end
	local now = workspace:GetServerTimeNow()
	local rikaFull = char ~= nil and char:GetAttribute("JJK_RikaFull") == true
	for _, slot in slots do
		local id = slot.Id
		if not id then
			continue
		end
		local cd = cooldowns[id]
		local remaining = if cd then math.max(0, cd.ends - now) else 0
		local fraction = if cd and cd.duration > 0 then remaining / cd.duration else 0
		slot.Shade.Size = UDim2.fromScale(1, fraction)
		slot.Timer.Text = if remaining <= 0 then "" elseif remaining >= 10 then tostring(math.ceil(remaining)) else string.format("%.1f", remaining)
		if slot.WasCooling and remaining <= 0 then
			slot.Stroke.Transparency = 0
			slot.Stroke.Thickness = 4
			TweenService:Create(slot.Stroke, TweenInfo.new(0.4), { Thickness = 1.5, Transparency = 0.25 }):Play()
		end
		slot.WasCooling = remaining > 0

		local state, active, locked = "", false, false
		if id == "FullManifestation" and rikaFull and char then
			active = true
			state = Util.formatTime(((char:GetAttribute("JJK_RikaEnds") or now) :: number) - now)
		elseif id == "SixEyes" and mode == "SixEyes" and char then
			active = true
			state = Util.formatTime(((char:GetAttribute("JJK_SixEyesEnds") or now) :: number) - now)
		elseif id == "PureLove" and not rikaFull then
			locked = true
			state = "NEED F"
		elseif id == "Block" then
			state = if char and char:GetAttribute("JJK_Blocking") then "GUARD" else "HOLD"
		end
		slot.State.Text = state
		slot.Kanji.TextTransparency = if locked then 0.75 else 0.1
		if active then
			slot.Stroke.Thickness = 3
			slot.Stroke.Transparency = 0
		end
	end
end

local function updateVitals(char: Model?, dt: number)
	local v = elements.Vitals
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local frac = if humanoid.MaxHealth > 0 then math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1) else 0
	v.Shown += (frac - v.Shown) * math.min(1, dt * 12)
	if frac < v.GhostShown then
		v.GhostShown = math.max(frac, v.GhostShown - dt * 0.35)
	else
		v.GhostShown = frac
	end
	v.Fill.Size = UDim2.fromScale(v.Shown, 1)
	v.Ghost.Size = UDim2.fromScale(v.GhostShown, 1)
	v.Text.Text = ("%d / %d"):format(math.ceil(humanoid.Health), humanoid.MaxHealth)
	local tags = {}
	if char and char:GetAttribute("JJK_RikaFull") then
		table.insert(tags, "RIKA")
	end
	if char and char:GetAttribute("JJK_Mode") == "SixEyes" then
		table.insert(tags, "INFINITY")
	end
	if char and char:GetAttribute("JJK_Stunned") then
		table.insert(tags, "STUNNED")
	end
	v.Status.Text = table.concat(tags, "  /  ")

	local now = workspace:GetServerTimeNow()
	local rika: TextLabel = elements.RikaTimer
	local rikaOn = char ~= nil and char:GetAttribute("JJK_RikaFull") == true
	rika.Visible = rikaOn
	if rikaOn and char then
		rika.Text = "RIKA: FULL MANIFESTATION  " .. Util.formatTime(((char:GetAttribute("JJK_RikaEnds") or now) :: number) - now)
	end
	local six: TextLabel = elements.SixEyesTimer
	local sixOn = char ~= nil and char:GetAttribute("JJK_Mode") == "SixEyes"
	six.Visible = sixOn
	if sixOn and char then
		six.Text = "SIX EYES / INFINITY  " .. Util.formatTime(((char:GetAttribute("JJK_SixEyesEnds") or now) :: number) - now)
	end
end

local function rebuildChips(b: any, model: Model)
	local entries = {}
	for name, value in model:GetAttributes() do
		local kind = string.match(name, "^JJK_Adapt_(.+)$")
		if kind and typeof(value) == "number" and value > 0 then
			table.insert(entries, { kind = kind, value = value })
		end
	end
	table.sort(entries, function(x, y)
		return x.value > y.value
	end)
	local parts = {}
	for _, e in entries do
		table.insert(parts, e.kind .. string.format("%.2f", e.value))
	end
	local signature = table.concat(parts, ",")
	if signature == b.Signature then
		return
	end
	b.Signature = signature
	for _, child in b.Chips:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local maxLevel = Config.Adaptation.MaxLevel
	for i, e in entries do
		if i > 8 then
			break
		end
		local level = math.floor(e.value)
		local full = level >= maxLevel
		local chip = new("Frame", { LayoutOrder = i, BackgroundColor3 = PANEL, BackgroundTransparency = 0.15, Parent = b.Chips })
		corner(chip, 5)
		stroke(chip, if full then Palette.Danger else Palette.Wheel, 1, 0.3)
		new("TextLabel", {
			Position = UDim2.fromOffset(6, 0),
			Size = UDim2.new(1, -60, 1, 0),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			TextSize = 10,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextColor3 = if full then Palette.Danger else WHITE,
			Text = string.upper((Config.Adaptation.ShortNames :: any)[e.kind] or e.kind),
			Parent = chip,
		})
		for p = 1, maxLevel do
			local filled = p <= level
			local partial = p == level + 1 and e.value - level or 0
			local pip = new("Frame", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -6 - (maxLevel - p) * 12, 0.5, 0),
				Size = UDim2.fromOffset(9, 9),
				Rotation = 45,
				BackgroundColor3 = if filled then (if full then Palette.Danger else Palette.Wheel) else Color3.fromRGB(60, 52, 70),
				BorderSizePixel = 0,
				Parent = chip,
			})
			if partial > 0 then
				new("Frame", {
					AnchorPoint = Vector2.new(0.5, 1),
					Position = UDim2.fromScale(0.5, 1),
					Size = UDim2.fromScale(1, partial),
					BackgroundColor3 = Palette.Wheel,
					BackgroundTransparency = 0.3,
					BorderSizePixel = 0,
					Parent = pip,
				})
			end
		end
	end
end

local function updateBoss(dt: number)
	local b = elements.Boss
	local model = CollectionService:GetTagged("JJK_Mahoraga")[1]
	local humanoid = model and model:FindFirstChildOfClass("Humanoid")
	if not model or not humanoid or not model:IsA("Model") then
		b.Frame.Visible = false
		return
	end
	b.Frame.Visible = true
	local frac = if humanoid.MaxHealth > 0 then math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1) else 0
	b.Shown += (frac - b.Shown) * math.min(1, dt * 10)
	if frac < b.GhostShown then
		b.GhostShown = math.max(frac, b.GhostShown - dt * 0.25)
	else
		b.GhostShown = frac
	end
	b.Fill.Size = UDim2.fromScale(b.Shown, 1)
	b.Ghost.Size = UDim2.fromScale(b.GhostShown, 1)
	b.Text.Text = ("%d / %d"):format(math.ceil(humanoid.Health), humanoid.MaxHealth)
	local turns = (model:GetAttribute("JJK_WheelTurns") or 0) :: number
	b.Turns.Text = "x" .. turns
	b.WheelAngle += (turns * 45 - b.WheelAngle) * math.min(1, dt * 8)
	b.Wheel.Rotation = b.WheelAngle
	rebuildChips(b, model)
end

function HUD.start()
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	end)
	build()
	RunService.RenderStepped:Connect(function(dt: number)
		local char = player.Character
		updateSlots(char)
		updateVitals(char, dt)
		updateBoss(dt)
	end)
end

return HUD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Input</string>
            <string name="Source"><![CDATA[--!strict
-- Keyboard + hotbar input. Aimed techniques send the cursor's world position;
-- the dash moves the character locally for instant response.

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("JJKShared")
local Config = require(Shared:WaitForChild("Config"))
local Abilities = require(Shared:WaitForChild("Abilities"))
local Net = require(Shared:WaitForChild("Net"))
local Util = require(Shared:WaitForChild("Util"))

local HUD = require(script.Parent.HUD)

local player = Players.LocalPlayer
local remote = Net.event("Ability")

local Input = {}

local AIMED = {
	RikaStrike = true,
	BlastAway = true,
	PureLove = true,
	Blue = true,
	Red = true,
	HollowPurple = true,
}

local blocking = false
local aimParams = RaycastParams.new()
aimParams.FilterType = Enum.RaycastFilterType.Exclude

local function character(): (Model?, BasePart?, Humanoid?)
	local char = player.Character
	if not char then
		return nil, nil, nil
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not (root and root:IsA("BasePart") and humanoid and humanoid.Health > 0) then
		return nil, nil, nil
	end
	return char, root, humanoid
end

local function mode(): string
	local char = player.Character
	return (char and char:GetAttribute("JJK_Mode") or "Base") :: string
end

-- World point under the cursor (screen centre on touch-only devices).
local function aimPosition(): Vector3
	local camera = workspace.CurrentCamera
	local screen = UserInputService:GetMouseLocation()
	if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
		screen = camera.ViewportSize / 2
	end
	local ray = camera:ViewportPointToRay(screen.X, screen.Y)
	local ignore: { Instance } = {}
	if player.Character then
		table.insert(ignore, player.Character)
	end
	local fx = workspace:FindFirstChild("JJK_FX")
	if fx then
		table.insert(ignore, fx)
	end
	aimParams.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 800, aimParams)
	return if hit then hit.Position else ray.Origin + ray.Direction * 300
end

local function face(root: BasePart, aim: Vector3)
	local flat = Vector3.new(aim.X, root.Position.Y, aim.Z)
	if (flat - root.Position).Magnitude > 1 then
		root.CFrame = CFrame.lookAt(root.Position, flat)
	end
end

local function dash()
	local char, root, humanoid = character()
	if not (char and root and humanoid) or char:GetAttribute("JJK_Stunned") then
		return
	end
	if HUD.cooldownRemaining("Dash") > 0.05 then
		return
	end
	local cooldown = Config.Yuta.Dash.Cooldown
	HUD.setCooldown("Dash", workspace:GetServerTimeNow() + cooldown, cooldown)
	local dir = humanoid.MoveDirection
	if dir.Magnitude < 0.1 then
		dir = workspace.CurrentCamera.CFrame.LookVector
	end
	dir = Util.flatUnit(dir, root.CFrame.LookVector)
	local attachment = root:FindFirstChild("JJK_DashAttachment") :: Attachment?
	if not attachment then
		local a = Instance.new("Attachment")
		a.Name = "JJK_DashAttachment"
		a.Parent = root
		attachment = a
	end
	local velocity = Instance.new("LinearVelocity")
	velocity.Name = "JJK_Dash"
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	velocity.MaxForce = 1e6
	velocity.VectorVelocity = dir * (Config.Player.DashDistance / Config.Player.DashTime)
	velocity.Parent = root
	Debris:AddItem(velocity, Config.Player.DashTime)
	remote:FireServer("Dash", { dir = dir })
end

local function setBlock(on: boolean)
	if blocking == on then
		return
	end
	blocking = on
	remote:FireServer("Block", { on = on })
end

function Input.use(id: string)
	if id == "Dash" then
		dash()
		return
	end
	if id == "Block" then
		return
	end
	local char, root = character()
	if not (char and root) or char:GetAttribute("JJK_Stunned") then
		return
	end
	if HUD.cooldownRemaining(id) > 0.05 then
		return
	end
	local aim = aimPosition()
	if AIMED[id] then
		face(root, aim)
	end
	remote:FireServer(id, { aim = aim })
end

function Input.start()
	HUD.onSlot = function(id: string, pressed: boolean)
		if id == "Block" then
			setBlock(pressed)
		elseif pressed then
			Input.use(id)
		end
	end

	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed then
			return
		end
		local key = input.KeyCode
		if key == Enum.KeyCode.H then
			HUD.toggleHelp()
			return
		end
		if key == Enum.KeyCode.E then
			setBlock(true)
			return
		end
		local def = Abilities.forKey(mode(), key)
		if def then
			Input.use(def.Id)
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.KeyCode == Enum.KeyCode.E then
			setBlock(false)
		end
	end)
	player.CharacterAdded:Connect(function()
		blocking = false
	end)
end

return Input
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">RikaFollower</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Rika's full manifestation, drawn locally on every client: she floats behind
	Yuta, sways, claws at enemies on her own and wraps around him while he
	charges Pure Love. Driven by the character's JJK_RikaFull attribute.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("JJKShared")
local Rika = require(Shared:WaitForChild("Assets"):WaitForChild("Rika"))
local VfxUtil = require(script.Parent.VfxUtil)

local RikaFollower = {}

local SCALE = 0.85
local OFFSET = CFrame.new(0, 6.5, 6.5) -- behind and above Yuta's root

type Follower = {
	Model: Model,
	Body: Model,
	Left: Model,
	Right: Model,
	CF: CFrame,
	Fader: VfxUtil.Fader,
	Visible: number,
	Leaving: boolean,
	Action: string?,
	ActionStart: number,
	ActionTime: number,
	Target: Vector3?,
}

local followers: { [Model]: Follower } = {}

local function spawnFor(char: Model)
	local existing = followers[char]
	if existing then
		if not existing.Leaving then
			return
		end
		existing.Model:Destroy()
		followers[char] = nil
	end
	local root = VfxUtil.root(char)
	if not root then
		return
	end
	local start = root.CFrame * OFFSET * CFrame.new(0, -12, 2)
	local model = Rika.build(VfxUtil.folder(), start, SCALE)
	local fader = VfxUtil.fader(model)
	fader.set(0)
	followers[char] = {
		Model = model,
		Body = model:FindFirstChild("Body") :: Model,
		Left = model:FindFirstChild("LeftArm") :: Model,
		Right = model:FindFirstChild("RightArm") :: Model,
		CF = start,
		Fader = fader,
		Visible = 0,
		Leaving = false,
		Action = nil,
		ActionStart = 0,
		ActionTime = 0,
		Target = nil,
	}
end

function RikaFollower.get(char: Model): Model?
	local f = followers[char]
	return if f then f.Model else nil
end

function RikaFollower.claw(char: Model, target: Vector3)
	local f = followers[char]
	if f then
		f.Action = "claw"
		f.ActionStart = os.clock()
		f.ActionTime = 0.6
		f.Target = target
	end
end

function RikaFollower.charge(char: Model, time: number)
	local f = followers[char]
	if f then
		f.Action = "charge"
		f.ActionStart = os.clock()
		f.ActionTime = time + 1.3
		f.Target = nil
	end
end

local function idleArm(now: number, side: number): CFrame
	return CFrame.Angles(math.rad(10 + math.sin(now * 1.3 + side) * 8), 0, math.rad(side * (12 + math.sin(now * 1.7) * 5)))
end

local function update(dt: number)
	local now = os.clock()
	for char, f in followers do
		local root = VfxUtil.root(char)
		if not root or not char.Parent or char:GetAttribute("JJK_RikaFull") ~= true then
			f.Leaving = true
		end
		local goalVisible = if f.Leaving then 0 else 1
		f.Visible += (goalVisible - f.Visible) * math.min(1, dt * (if f.Leaving then 5 else 3))
		if f.Leaving and f.Visible < 0.03 then
			f.Model:Destroy()
			followers[char] = nil
			continue
		end
		f.Fader.set(f.Visible)
		if not root then
			continue
		end

		local action = f.Action
		if action and now - f.ActionStart > f.ActionTime then
			f.Action = nil
			action = nil
		end
		local goal = root.CFrame * OFFSET * CFrame.new(0, math.sin(now * 1.8) * 0.5, 0)
		if action == "charge" then
			goal = root.CFrame * CFrame.new(0, 4.6, 3.4)
		elseif action == "claw" and f.Target then
			local pos = goal.Position
			local target = f.Target :: Vector3
			local flat = Vector3.new(target.X, pos.Y, target.Z)
			if (flat - pos).Magnitude > 1 then
				goal = CFrame.lookAt(pos, flat) * CFrame.new(0, 0, -1.5)
			end
		end
		f.CF = f.CF:Lerp(goal, 1 - math.exp(-dt * 7))
		f.Body:PivotTo(f.CF)

		local left = idleArm(now, -1)
		local right = idleArm(now, 1)
		if action == "claw" then
			local a = (now - f.ActionStart) / 0.6
			local pitch = if a < 0.35 then 10 + a / 0.35 * 140 elseif a < 0.55 then 150 - (a - 0.35) / 0.2 * 120 else 30
			right = CFrame.Angles(math.rad(pitch), 0, math.rad(18))
		elseif action == "charge" then
			left = CFrame.Angles(math.rad(75), 0, math.rad(22))
			right = CFrame.Angles(math.rad(75), 0, math.rad(-22))
		end
		f.Left:PivotTo(f.CF * CFrame.new(Rika.Shoulders.Left * SCALE) * left)
		f.Right:PivotTo(f.CF * CFrame.new(Rika.Shoulders.Right * SCALE) * right)
	end
end

local function watch(char: Model)
	local function refresh()
		if char:GetAttribute("JJK_RikaFull") == true then
			spawnFor(char)
		end
	end
	char:GetAttributeChangedSignal("JJK_RikaFull"):Connect(refresh)
	refresh()
end

local function onPlayer(p: Player)
	p.CharacterAdded:Connect(watch)
	if p.Character then
		watch(p.Character)
	end
end

function RikaFollower.start()
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in Players:GetPlayers() do
		onPlayer(p)
	end
	RunService.RenderStepped:Connect(update)
end

return RikaFollower
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">VFX</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Client effects for Yuta's techniques and the dispatcher for every FX event
	the server sends. Mahoraga's effects live in BossVFX.
]]

local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("JJKShared")
local Palette = require(Shared:WaitForChild("Palette"))
local Net = require(Shared:WaitForChild("Net"))
local Util = require(Shared:WaitForChild("Util"))
local Assets = Shared:WaitForChild("Assets")
local PartKit = require(Assets:WaitForChild("PartKit"))
local Effects = require(Assets:WaitForChild("Effects"))
local Katana = require(Assets:WaitForChild("Katana"))
local Rika = require(Assets:WaitForChild("Rika"))
local Domain = require(Assets:WaitForChild("Domain"))

local VfxUtil = require(script.Parent.VfxUtil)
local HUD = require(script.Parent.HUD)
local CameraFX = require(script.Parent.CameraFX)
local RikaFollower = require(script.Parent.RikaFollower)
local BossVFX = require(script.Parent.BossVFX)

local NEON = Enum.Material.Neon
local WHITE = Color3.new(1, 1, 1)

local player = Players.LocalPlayer
local rng = VfxUtil.rng

local VFX = {}
local handlers: { [string]: (any) -> () } = {}

local function near(pos: Vector3, radius: number): boolean
	local root = VfxUtil.root(player.Character)
	return root ~= nil and (root.Position - pos).Magnitude <= radius
end

local function isMe(char: any): boolean
	return char ~= nil and char == player.Character
end

-- HUD / camera events -------------------------------------------------------------------

handlers.Cooldown = function(d)
	HUD.setCooldown(d.id, d.ends, d.duration)
end
handlers.Announce = function(d)
	HUD.announce(d.title, d.sub, d.color, d.time)
end
handlers.Notify = function(d)
	HUD.notify(d.text)
end
handlers.Shake = function(d)
	CameraFX.shake(d.intensity or 1, d.duration or 0.4)
end
handlers.Reset = function()
	HUD.reset()
end

-- Generic hit feedback ----------------------------------------------------------------------

handlers.Hit = function(d)
	local pos: Vector3 = d.pos
	local color: Color3 = d.color or Palette.YutaEnergy
	local big = d.big == true
	local m = Effects.spikes(VfxUtil.folder(), pos, if big then 10 else 6, if big then 4.2 else 2.6, color, rng)
	local flash = m:FindFirstChild("Flash")
	if flash and flash:IsA("BasePart") then
		VfxUtil.tween(flash, 0.18, { Size = Vector3.one * (if big then 5 else 3), Transparency = 1 })
	end
	VfxUtil.fade(m, 0.2, 0.05)
	VfxUtil.burst(pos, {
		Texture = PartKit.Textures.Spark,
		Color = ColorSequence.new(color),
		LightEmission = 1,
		Size = NumberSequence.new(0.4, 0),
		Lifetime = NumberRange.new(0.2, 0.45),
		Speed = NumberRange.new(18, 34),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 4,
	}, if big then 18 else 8)
end

local DAMAGE_COLORS: { [string]: Color3 } = {
	immune = Palette.Wheel,
	adapt = Color3.fromRGB(255, 200, 110),
	infinity = Palette.SixEyes,
	block = Color3.fromRGB(190, 190, 205),
	dodge = Color3.fromRGB(235, 235, 255),
	player = Color3.fromRGB(255, 82, 82),
	heal = Color3.fromRGB(120, 255, 160),
	backlash = Color3.fromRGB(190, 40, 60),
}

handlers.Damage = function(d)
	local pos: Vector3 = d.pos
	local amount: number = d.amount or 0
	local tag: string? = d.tag
	local text = tostring(math.floor(amount + 0.5))
	if tag == "immune" then
		text = "ADAPTED"
	elseif tag == "dodge" then
		text = "DODGE"
	elseif tag == "heal" then
		text = "+" .. text
	elseif tag == "infinity" then
		text = "INFINITY " .. text
	elseif tag == "block" then
		text = text .. " GUARD"
	end
	local color = if tag then DAMAGE_COLORS[tag] or WHITE else WHITE
	local size = math.clamp(1.3 + amount / 70, 1.3, 3)
	local anchor = PartKit.part({
		Name = "DamageNumber",
		Parent = VfxUtil.folder(),
		CFrame = CFrame.new(pos + Vector3.new(rng:NextNumber(-1.5, 1.5), rng:NextNumber(0, 1.5), rng:NextNumber(-1.5, 1.5))),
		Size = Vector3.new(0.2, 0.2, 0.2),
		Transparency = 1,
	})
	local gui = PartKit.billboardText(anchor, text, size * math.max(2, #text * 0.6), size, color)
	gui.MaxDistance = 260
	VfxUtil.tween(anchor, 0.8, { CFrame = anchor.CFrame + Vector3.new(0, 3.2, 0) })
	VfxUtil.fade(anchor, 0.3, 0.55)
end

handlers.Impact = function(d)
	local pos: Vector3 = d.pos
	local radius: number = d.radius or 8
	local color: Color3 = d.color or Palette.YutaEnergy
	local big = d.big == true
	local folder = VfxUtil.folder()
	local base = CFrame.new(pos + Vector3.new(0, 0.3, 0))
	local ring = VfxUtil.liveRing(folder, base, 32, if big then 1.6 else 0.9, if big then 1.4 else 0.8, color)
	VfxUtil.animate(0.45, function(a)
		local eased = 1 - (1 - a) ^ 3
		ring.set(radius * (0.2 + 0.9 * eased), 0.1 + 0.9 * a)
	end, function()
		for _, p in ring.parts do
			p:Destroy()
		end
	end)
	local dome = PartKit.ball(folder, base, radius * 0.6, { Color = color, Material = NEON, Transparency = 0.45 }, "Dome")
	VfxUtil.tween(dome, 0.3, { Size = Vector3.one * radius * 1.4, Transparency = 1 })
	Debris:AddItem(dome, 0.35)
	VfxUtil.burst(pos + Vector3.new(0, 1, 0), {
		Texture = PartKit.Textures.Smoke,
		Color = ColorSequence.new(Color3.fromRGB(128, 118, 128)),
		Size = NumberSequence.new(radius * 0.2, radius * 0.45),
		Transparency = NumberSequence.new(0.35, 1),
		Lifetime = NumberRange.new(0.6, 1.1),
		Speed = NumberRange.new(radius * 1.2, radius * 2),
		SpreadAngle = Vector2.new(85, 85),
		Drag = 3,
		Acceleration = Vector3.new(0, 4, 0),
	}, if big then 28 else 12)
	if d.cracks then
		local cracks = Effects.cracks(folder, CFrame.new(pos), radius * 0.9, if big then 10 else 6, rng)
		VfxUtil.fade(cracks, 1, 2.5)
	end
	if d.rocks then
		local rocks = Effects.rocks(folder, CFrame.new(pos), radius * 0.8, 10, rng)
		for _, rock in rocks:GetChildren() do
			if rock:IsA("BasePart") then
				local out = Util.flatUnit(rock.Position - pos)
				local up = rock.CFrame + out * rng:NextNumber(3, 8) + Vector3.new(0, rng:NextNumber(4, 9), 0)
				VfxUtil.tween(rock, 0.35, { CFrame = up * CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), 0) })
				task.delay(0.35, function()
					VfxUtil.tween(rock, 0.5, { CFrame = rock.CFrame - Vector3.new(0, 9, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				end)
			end
		end
		VfxUtil.fade(rocks, 0.5, 1.1)
	end
	if near(pos, radius * 4) then
		CameraFX.shake(if big then 0.9 else 0.35, 0.3)
	end
	VfxUtil.sound("Impact", pos, if big then 1 else 0.6)
end

handlers.Stun = function(d)
	BossVFX.stunRing(d.model, d.duration or 1)
end

-- Katana ------------------------------------------------------------------------------------

local SLASH_ROLL = { 35, -35, 0, 90 }

handlers.Slash = function(d)
	local root = VfxUtil.root(d.char)
	local base: CFrame = if root then root.CFrame else d.cf
	local combo: number = d.combo or 1
	local finisher = combo == 4
	local cf = base * CFrame.new(0, 0.4, -1.2) * CFrame.Angles(0, 0, math.rad(SLASH_ROLL[combo] or 0))
	local slash = Effects.slash(VfxUtil.folder(), cf, if finisher then 7 else 5.2, if finisher then 210 else 165, if finisher then 1.8 else 1.2, Palette.YutaEnergy, Palette.YutaCore)
	local n = #slash.Outer
	local outerBase, coreBase = {}, {}
	for i = 1, n do
		outerBase[i] = slash.Outer[i].Transparency
		coreBase[i] = slash.Core[i].Transparency
		slash.Outer[i].Transparency = 1
		slash.Core[i].Transparency = 1
	end
	local reverse = combo % 2 == 0
	VfxUtil.animate(0.08, function(a)
		local shown = math.floor(a * n + 0.5)
		for k = 1, shown do
			local i = if reverse then n - k + 1 else k
			slash.Outer[i].Transparency = outerBase[i]
			slash.Core[i].Transparency = coreBase[i]
		end
	end, function()
		VfxUtil.fade(slash.Model, 0.22)
	end)
	VfxUtil.sound(if finisher then "Lunge" else "Slash", root)
end

handlers.Dash = function(d)
	local char = d.char
	local root = VfxUtil.root(char)
	if not root then
		return
	end
	local folder = VfxUtil.folder()
	VfxUtil.burst(root.Position - Vector3.new(0, 2.5, 0), {
		Texture = PartKit.Textures.Smoke,
		Color = ColorSequence.new(Palette.YutaEnergy),
		LightEmission = 0.4,
		Size = NumberSequence.new(1.2, 2.6),
		Transparency = NumberSequence.new(0.4, 1),
		Lifetime = NumberRange.new(0.3, 0.5),
		Speed = NumberRange.new(6, 12),
		SpreadAngle = Vector2.new(80, 80),
	}, 10)
	for k = 0, 2 do
		task.delay(k * 0.06, function()
			if not char.Parent then
				return
			end
			local ghost = PartKit.model("Afterimage", folder)
			for _, p in char:GetChildren() do
				if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" and p.Transparency < 1 then
					PartKit.part({ Name = "Ghost", Parent = ghost, CFrame = p.CFrame, Size = p.Size, Color = Palette.YutaEnergy, Material = NEON, Transparency = 0.55 })
				end
			end
			VfxUtil.fade(ghost, 0.3)
		end)
	end
	VfxUtil.sound("Lunge", root, 0.5)
end

-- Rika ------------------------------------------------------------------------------------

handlers.RikaArm = function(d)
	local root = VfxUtil.root(d.char)
	local base: CFrame = d.cf or (if root then root.CFrame else CFrame.identity)
	local scale = if d.full then 1.35 else 1.05
	local ground = VfxUtil.ground(base.Position)
	local folder = VfxUtil.folder()
	local pivot = CFrame.new(ground) * base.Rotation * CFrame.new(1.6, 9.5 * scale, 3.2)
	local arm = Rika.buildArm(folder, pivot * CFrame.Angles(math.rad(200), 0, 0), 1, scale)
	local fader = VfxUtil.fader(arm)
	fader.set(0)

	local portal = PartKit.model("Portal", folder)
	PartKit.ring(portal, pivot * CFrame.Angles(math.rad(90), 0, 0), 2.4 * scale, 0.5, 0.3, 20, { Color = Palette.RikaAura, Material = NEON })
	PartKit.cylinderZ({ Name = "Void", Parent = portal, CFrame = pivot, Color = Palette.Shadow }, 0.15, 4.6 * scale)
	VfxUtil.fade(portal, 0.4, 0.55)
	VfxUtil.burst(pivot.Position, {
		Texture = PartKit.Textures.Smoke,
		Color = ColorSequence.new(Palette.YutaDark, Palette.RikaAura),
		Size = NumberSequence.new(1.5, 3.5),
		Transparency = NumberSequence.new(0.3, 1),
		Lifetime = NumberRange.new(0.5, 0.9),
		Speed = NumberRange.new(4, 9),
		SpreadAngle = Vector2.new(180, 180),
	}, 16)

	VfxUtil.animate(0.42, function(a)
		local t = math.clamp((a - 0.1) / 0.9, 0, 1)
		local pitch = 200 - 152 * t * t * t
		arm:PivotTo(pivot * CFrame.Angles(math.rad(pitch), 0, 0))
		fader.set(math.min(1, a * 4))
	end, function()
		VfxUtil.fade(arm, 0.35, 0.25)
	end)
end

handlers.RikaManifest = function(d)
	local root = VfxUtil.root(d.char)
	if not root then
		return
	end
	local folder = VfxUtil.folder()
	local base = root.CFrame * CFrame.new(0, 4, 6)
	local portal = PartKit.model("RikaPortal", folder)
	PartKit.ring(portal, base * CFrame.Angles(math.rad(90), 0, 0), 5.5, 0.9, 0.5, 28, { Color = Palette.RikaAura, Material = NEON })
	PartKit.cylinderZ({ Name = "Void", Parent = portal, CFrame = base, Color = Palette.Shadow }, 0.2, 10.5)
	VfxUtil.fade(portal, 0.6, 1.2)
	VfxUtil.burst(base.Position, {
		Texture = PartKit.Textures.Smoke,
		Color = ColorSequence.new(Palette.YutaDark, Palette.RikaAura),
		Size = NumberSequence.new(3, 7),
		Transparency = NumberSequence.new(0.2, 1),
		Lifetime = NumberRange.new(0.8, 1.4),
		Speed = NumberRange.new(8, 16),
		SpreadAngle = Vector2.new(180, 180),
	}, 30)
	local ground = VfxUtil.ground(root.Position)
	local ring = VfxUtil.liveRing(folder, CFrame.new(ground + Vector3.new(0, 0.3, 0)), 36, 1.2, 1.2, Palette.RikaAura)
	VfxUtil.animate(0.6, function(a)
		ring.set(4 + 30 * (1 - (1 - a) ^ 3), a)
	end, function()
		for _, p in ring.parts do
			p:Destroy()
		end
	end)
	VfxUtil.kanji(root.Position + Vector3.new(0, 11, 0), "里香", 4, Palette.RikaAura, 1.4, 0.3)
	if near(root.Position, 90) then
		CameraFX.shake(0.6, 0.5)
	end
end

handlers.RikaVanish = function(d)
	local model = if typeof(d.char) == "Instance" and d.char:IsA("Model") then RikaFollower.get(d.char) else nil
	local pos = if model and model.PrimaryPart then model.PrimaryPart.Position else nil
	if pos then
		VfxUtil.burst(pos, {
			Texture = PartKit.Textures.Smoke,
			Color = ColorSequence.new(Palette.YutaDark, Palette.RikaAura),
			Size = NumberSequence.new(3, 6),
			Transparency = NumberSequence.new(0.3, 1),
			Lifetime = NumberRange.new(0.8, 1.2),
			Speed = NumberRange.new(3, 8),
			SpreadAngle = Vector2.new(180, 180),
		}, 24)
	end
end

handlers.RikaClaw = function(d)
	if typeof(d.char) ~= "Instance" or not d.char:IsA("Model") then
		return
	end
	local char: Model = d.char
	local target: Vector3 = d.target
	RikaFollower.claw(char, target)
	task.delay(0.3, function()
		local root = VfxUtil.root(char)
		local from = if root then root.Position else target + Vector3.new(0, 0, 6)
		local dir = Util.flatUnit(target - from)
		local claws = Effects.claws(VfxUtil.folder(), Util.facing(target - dir * 4 + Vector3.new(0, 2, 0), dir), 5, Palette.RikaAura)
		VfxUtil.fade(claws, 0.3, 0.15)
	end)
end

-- Cursed Speech & RCT ---------------------------------------------------------------------

handlers.Speech = function(d)
	local head = VfxUtil.head(d.char)
	local root = VfxUtil.root(d.char)
	if not head or not root then
		return
	end
	local folder = VfxUtil.folder()
	local blast = d.word == "BlastAway"
	VfxUtil.kanji(head.Position + Vector3.new(0, 3.2, 0), if blast then "吹っ飛べ" else "動くな", 3.2, WHITE, 1.1, 0.25)
	local facing: CFrame = d.cf or Util.facing(root.Position, root.CFrame.LookVector)
	local mouth = CFrame.new(head.Position) * facing.Rotation * CFrame.new(0, -0.2, -0.8)
	local waves = Effects.speechWaves(folder, mouth, 4, 2.2, 0.8, Palette.SpeechRing)
	VfxUtil.fade(waves, 0.45, 0.15)
	local radius: number = d.radius or 30
	if blast then
		local cone = Effects.cone(folder, CFrame.new(root.Position) * facing.Rotation, radius, d.cone or 80, Palette.SpeechRing)
		local fader = VfxUtil.fader(cone)
		fader.set(0)
		VfxUtil.animate(0.12, function(a)
			fader.set(a)
		end, function()
			VfxUtil.fade(cone, 0.35, 0.1)
		end)
	else
		local shell = PartKit.ball(folder, CFrame.new(root.Position), 2, { Color = Palette.SpeechRing, Material = Enum.Material.ForceField }, "Shell")
		VfxUtil.tween(shell, 0.35, { Size = Vector3.one * radius * 2 })
		VfxUtil.fade(shell, 0.4, 0.3)
		local ground = VfxUtil.ground(root.Position)
		local ring = VfxUtil.liveRing(folder, CFrame.new(ground + Vector3.new(0, 0.3, 0)), 40, 0.6, 1, Palette.SpeechRing)
		VfxUtil.animate(0.4, function(a)
			ring.set(2 + (radius - 2) * (1 - (1 - a) ^ 2), a * 0.9)
		end, function()
			for _, p in ring.parts do
				p:Destroy()
			end
		end)
	end
	-- The words tear Yuta's throat.
	VfxUtil.burst(mouth.Position, {
		Texture = PartKit.Textures.Sparkle,
		Color = ColorSequence.new(Color3.fromRGB(160, 20, 30)),
		Size = NumberSequence.new(0.2, 0),
		Lifetime = NumberRange.new(0.3, 0.5),
		Speed = NumberRange.new(3, 6),
		SpreadAngle = Vector2.new(25, 25),
		Acceleration = Vector3.new(0, -25, 0),
	}, 8)
	if near(root.Position, radius + 20) then
		CameraFX.shake(0.4, 0.35)
	end
	VfxUtil.sound("Speech", head)
end

local function healAura(model: Model, duration: number, size: number)
	local root = VfxUtil.root(model)
	if not root then
		return
	end
	local folder = VfxUtil.folder()
	local aura = PartKit.ball(folder, root.CFrame, size, { Color = Palette.RCT, Material = Enum.Material.ForceField }, "Aura")
	local ringModel = PartKit.model("HealRing", folder)
	PartKit.ring(ringModel, CFrame.new(), size * 0.5, 0.3, 0.1, 20, { Color = Palette.RCT, Material = NEON })
	ringModel.WorldPivot = CFrame.new()
	VfxUtil.animate(duration, function(a)
		if not root.Parent then
			return false
		end
		aura.CFrame = root.CFrame
		aura.Transparency = 0.1 + 0.8 * a
		ringModel:PivotTo(CFrame.new(root.Position - Vector3.new(0, 2.8, 0)) * CFrame.Angles(0, a * 8, 0))
		return true
	end, function()
		aura:Destroy()
		ringModel:Destroy()
	end)
	local att = Instance.new("Attachment")
	att.Parent = root
	PartKit.emitter(att, {
		Texture = PartKit.Textures.Sparkle,
		Color = ColorSequence.new(Palette.RCT),
		LightEmission = 1,
		Size = NumberSequence.new(0.35, 0),
		Lifetime = NumberRange.new(0.8, 1.3),
		Rate = 30,
		Speed = NumberRange.new(2, 5),
		SpreadAngle = Vector2.new(60, 60),
		Acceleration = Vector3.new(0, 6, 0),
	})
	Debris:AddItem(att, duration)
end

handlers.RCT = function(d)
	local root = VfxUtil.root(d.char)
	if not root then
		return
	end
	local duration: number = d.duration or 2
	healAura(d.char, duration, 7)
	for _, ally in d.allies or {} do
		if typeof(ally) == "Instance" and ally:IsA("Model") then
			healAura(ally, duration, 5)
		end
	end
	VfxUtil.kanji(root.Position + Vector3.new(0, 5, 0), "反転術式", 2, Palette.RCT, 1.2)
end

-- Pure Love ---------------------------------------------------------------------------------

handlers.PureLoveCharge = function(d)
	if typeof(d.char) ~= "Instance" or not d.char:IsA("Model") then
		return
	end
	local char: Model = d.char
	local root = VfxUtil.root(char)
	if not root then
		return
	end
	local time: number = d.time or 1.35
	RikaFollower.charge(char, time)
	local dir: Vector3 = d.dir or root.CFrame.LookVector
	local folder = VfxUtil.folder()
	local function focus(): Vector3
		return root.Position + Vector3.new(0, 1.5, 0) + dir * 3
	end
	local core = PartKit.ball(folder, CFrame.new(focus()), 0.5, { Color = Palette.PureLoveCore, Material = NEON }, "Core")
	local glow = PartKit.ball(folder, CFrame.new(focus()), 1, { Color = Palette.PureLove, Material = NEON, Transparency = 0.5 }, "Glow")
	PartKit.light(core, Palette.PureLove, 24, 3)
	type Mote = { part: Part, from: Vector3, delay: number }
	local motes: { Mote } = {}
	for i = 1, 18 do
		local p = PartKit.ball(folder, CFrame.new(focus() + Effects.randomUnit(rng) * rng:NextNumber(7, 14)), rng:NextNumber(0.3, 0.7), {
			Color = if i % 2 == 0 then Palette.PureLove else Palette.PureLoveCore,
			Material = NEON,
		}, "Mote")
		table.insert(motes, { part = p, from = p.Position, delay = rng:NextNumber(0, time * 0.4) })
	end
	local ground = VfxUtil.ground(root.Position)
	local ring = VfxUtil.liveRing(folder, CFrame.new(ground + Vector3.new(0, 0.3, 0)), 30, 0.5, 0.8, Palette.PureLove)
	VfxUtil.animate(time, function(a)
		local f = focus()
		core.CFrame = CFrame.new(f)
		glow.CFrame = CFrame.new(f)
		core.Size = Vector3.one * (0.5 + a * 3.2)
		glow.Size = Vector3.one * (1 + a * 6)
		for _, m in motes do
			local t = math.clamp((a * time - m.delay) / math.max(0.05, time - m.delay), 0, 1)
			m.part.Position = m.from:Lerp(f, t * t)
			m.part.Transparency = t * 0.8
		end
		ring.set(9 - 6 * a, 0.2 + 0.6 * a)
	end, function()
		for _, m in motes do
			m.part:Destroy()
		end
		for _, p in ring.parts do
			p:Destroy()
		end
		VfxUtil.fade(core, 0.2)
		VfxUtil.fade(glow, 0.2)
	end)
	VfxUtil.kanji(root.Position + Vector3.new(0, 8, 0), "純愛砲", 3.6, Palette.PureLove, time + 0.4, 0.2)
	VfxUtil.sound("Beam", root)
end

handlers.PureLoveBeam = function(d)
	local cf: CFrame = d.cf
	local length: number = d.length or 180
	local width: number = d.width or 14
	local duration: number = d.duration or 1.3
	local folder = VfxUtil.folder()
	local beam = Effects.beam(folder, cf, length, width, Palette.PureLove, Palette.PureLove, Palette.PureLoveCore)
	local layers: { { part: BasePart, scale: number } } = {}
	for _, spec in { { name = "Outer", scale = 1 }, { name = "Mid", scale = 0.72 }, { name = "Core", scale = 0.38 } } do
		local p = beam:FindFirstChild(spec.name)
		if p and p:IsA("BasePart") then
			table.insert(layers, { part = p, scale = spec.scale })
		end
	end
	local function set(l: number, w: number)
		for _, layer in layers do
			local dia = math.max(0.05, width * layer.scale * w)
			layer.part.Size = Vector3.new(math.max(0.1, l), dia, dia)
			layer.part.CFrame = cf * CFrame.new(0, 0, -l / 2) * CFrame.Angles(0, math.rad(90), 0)
		end
	end
	set(0.5, 1)
	VfxUtil.animate(0.14, function(a)
		set(length * a, 1)
	end, function()
		VfxUtil.animate(duration, function(a)
			set(length, 1 + math.sin(a * 40) * 0.06)
		end, function()
			VfxUtil.animate(0.3, function(a)
				set(length, 1 - a)
			end, function()
				beam:Destroy()
			end)
		end)
	end)
	-- Scorched line on the ground under the beam.
	local ground = VfxUtil.ground(cf.Position)
	if cf.Position.Y - ground.Y < width then
		local flatDir = Util.flatUnit(cf.LookVector)
		local scar = PartKit.part({
			Name = "Scorch",
			Parent = folder,
			CFrame = Util.facing(ground + Vector3.new(0, 0.07, 0), flatDir) * CFrame.new(0, 0, -length / 2),
			Size = Vector3.new(width * 0.8, 0.1, length),
			Color = Color3.fromRGB(40, 12, 34),
			Material = Enum.Material.Slate,
		})
		VfxUtil.fade(scar, 2, 4)
	end
	if near(cf.Position, 140) then
		HUD.flash(Palette.PureLove, 0.5, 0.35)
	end
	VfxUtil.sound("Beam", cf.Position)
end

-- Domain Expansion: Authentic Mutual Love ------------------------------------------------------

type DomainRecord = { Model: Model?, Conn: RBXScriptConnection?, Tint: ColorCorrectionEffect?, Center: Vector3, Radius: number }
local domains: { [string]: DomainRecord } = {}

handlers.DomainCast = function(d)
	local root = VfxUtil.root(d.char)
	if not root then
		return
	end
	local time: number = d.time or 1.6
	local folder = VfxUtil.folder()
	local ground = VfxUtil.ground(root.Position)
	local column = PartKit.cylinderY({ Name = "Column", Parent = folder, CFrame = CFrame.new(ground + Vector3.new(0, 20, 0)), Color = Palette.Shadow, Material = NEON, Transparency = 1 }, 40, 7)
	VfxUtil.tween(column, time * 0.6, { Transparency = 0.35 })
	VfxUtil.fade(column, 0.3, time)
	local ring = VfxUtil.liveRing(folder, CFrame.new(ground + Vector3.new(0, 0.3, 0)), 32, 0.4, 0.7, Palette.DomainSky)
	VfxUtil.animate(time, function(a)
		ring.set(3 + a * 6, 0.2)
	end, function()
		for _, p in ring.parts do
			p:Destroy()
		end
	end)
	VfxUtil.kanji(root.Position + Vector3.new(0, 6, 0), "領域展開", 3, WHITE, time, 0.15)
	if isMe(d.char) then
		HUD.flash(Color3.new(0, 0, 0), time, 0.25)
	end
end

local function endDomain(id: string)
	local record = domains[id]
	if not record then
		return
	end
	domains[id] = nil
	if record.Conn then
		record.Conn:Disconnect()
	end
	if record.Tint then
		record.Tint:Destroy()
	end
	local model = record.Model
	if not model then
		return
	end
	local dome = model:FindFirstChild("Dome")
	if dome then
		for _, panel in dome:GetChildren() do
			if panel:IsA("BasePart") then
				VfxUtil.tween(panel, 0.9, { CFrame = panel.CFrame * CFrame.new(0, 0, rng:NextNumber(4, 10)), Transparency = 1 })
			end
		end
	end
	VfxUtil.fade(model, 0.9, 0.1)
end

handlers.DomainExpand = function(d)
	local id: string = d.id
	local center: Vector3 = d.center
	local radius: number = d.radius or 62
	local duration: number = d.duration or 14
	local folder = VfxUtil.folder()
	local record: DomainRecord = { Center = center, Radius = radius }
	domains[id] = record

	-- The domain closes like a black sphere first.
	local void = PartKit.ball(folder, CFrame.new(center), 2, { Color = Palette.Shadow }, "Void")
	VfxUtil.tween(void, 0.45, { Size = Vector3.one * radius * 2.05 }, Enum.EasingStyle.Quart)
	if near(center, radius + 30) then
		CameraFX.shake(1, 0.8)
		HUD.flash(Color3.new(0, 0, 0), 0.8, 0.8)
	end

	task.spawn(function()
		local seed = math.floor(math.abs(center.X * 7 + center.Z * 13)) % 9973 + 1
		local model = Domain.build(nil, CFrame.new(center), radius, seed, 48, function(i: number)
			if i % 12 == 0 then
				RunService.Heartbeat:Wait()
			end
		end)
		if domains[id] ~= record then
			model:Destroy()
			return
		end
		record.Model = model

		-- Swords start buried and rise out of the ground.
		type Rising = { model: Model, final: CFrame, delay: number }
		local rising: { Rising } = {}
		local swords = model:FindFirstChild("Swords")
		if swords then
			for _, sword in swords:GetChildren() do
				if sword:IsA("Model") then
					local final = sword:GetPivot()
					sword:PivotTo(final * CFrame.new(0, 9, 0))
					table.insert(rising, { model = sword, final = final, delay = rng:NextNumber(0, 0.5) })
				end
			end
		end
		model.Parent = folder
		VfxUtil.tween(void, 0.5, { Transparency = 1 })
		Debris:AddItem(void, 0.6)
		VfxUtil.animate(1.1, function(a)
			local t = a * 1.1
			for _, r in rising do
				local k = math.clamp((t - r.delay) / 0.5, 0, 1)
				local eased = 1 - (1 - k) ^ 3
				r.model:PivotTo(r.final * CFrame.new(0, 9 * (1 - eased), 0))
			end
		end)

		type Gear = { model: Model, base: CFrame, speed: number }
		local gears: { Gear } = {}
		local gearFolder = model:FindFirstChild("Gears")
		if gearFolder then
			for i, gear in gearFolder:GetChildren() do
				if gear:IsA("Model") then
					table.insert(gears, { model = gear, base = gear:GetPivot(), speed = (if i % 2 == 0 then 1 else -1) * (0.15 + i * 0.04) })
				end
			end
		end
		local started = os.clock()
		record.Conn = RunService.RenderStepped:Connect(function()
			local t = os.clock() - started
			for _, g in gears do
				g.model:PivotTo(g.base * CFrame.Angles(t * g.speed, 0, 0))
			end
			local inside = near(center, radius)
			if inside and not record.Tint then
				local tint = Instance.new("ColorCorrectionEffect")
				tint.Name = "JJK_DomainTint"
				tint.TintColor = Color3.fromRGB(255, 196, 204)
				tint.Contrast = 0.18
				tint.Saturation = -0.12
				tint.Parent = Lighting
				record.Tint = tint
			elseif not inside and record.Tint then
				record.Tint:Destroy()
				record.Tint = nil
			end
		end)
	end)

	-- Safety net if the end event is missed.
	task.delay(duration + 4, function()
		endDomain(id)
	end)
	VfxUtil.sound("Domain", center)
end

handlers.DomainHit = function(d)
	local pos: Vector3 = d.pos
	local folder = VfxUtil.folder()
	if d.kind == "Swords" then
		for i = 1, 4 do
			task.delay((i - 1) * 0.05, function()
				local target = pos + Vector3.new(rng:NextNumber(-2.5, 2.5), rng:NextNumber(-1, 1), rng:NextNumber(-2.5, 2.5))
				local start = target + Vector3.new(rng:NextNumber(-7, 7), 24, rng:NextNumber(-7, 7))
				local aim = PartKit.lookAt(start, target) * CFrame.Angles(math.rad(-90), 0, 0)
				local sword = Katana.buildModel(folder, aim, 1.4, "lite")
				local offset = target - start
				VfxUtil.animate(0.16, function(a)
					sword:PivotTo(aim + offset * (a * a))
				end, function()
					handlers.Hit({ pos = target, color = Palette.PureLove, big = false })
					VfxUtil.fade(sword, 0.3, 0.4)
				end)
			end)
		end
	elseif d.kind == "Speech" then
		VfxUtil.kanji(pos + Vector3.new(0, 6, 0), "動くな", 3, WHITE, 0.8, 0.3)
		local ring = VfxUtil.liveRing(folder, CFrame.new(pos), 24, 0.4, 0.5, Palette.SpeechRing)
		VfxUtil.animate(0.35, function(a)
			ring.set(1 + a * 8, a)
		end, function()
			for _, p in ring.parts do
				p:Destroy()
			end
		end)
	else
		local claws = Effects.claws(folder, CFrame.new(pos + Vector3.new(0, 1, 3)), 5, Palette.RikaAura)
		VfxUtil.fade(claws, 0.3, 0.2)
	end
end

handlers.DomainEnd = function(d)
	endDomain(d.id)
end

-- Six Eyes / Limitless -----------------------------------------------------------------------

handlers.SixEyesCast = function(d)
	local head = VfxUtil.head(d.char)
	local root = VfxUtil.root(d.char)
	if not head or not root then
		return
	end
	local time: number = d.time or 1.4
	local folder = VfxUtil.folder()
	for _, side in { -1, 1 } do
		local eye = PartKit.ball(folder, head.CFrame * CFrame.new(side * 0.22, 0.08, -0.62), 0.2, { Color = Palette.SixEyes, Material = NEON }, "Eye")
		VfxUtil.tween(eye, time, { Size = Vector3.one * 1.2 })
		VfxUtil.fade(eye, 0.2, time)
	end
	local ring = VfxUtil.liveRing(folder, head.CFrame * CFrame.Angles(math.rad(90), 0, 0), 24, 0.12, 0.2, Palette.SixEyes)
	VfxUtil.animate(time, function(a)
		ring.set(1 + a * 3, 0.2 + a * 0.6)
	end, function()
		for _, p in ring.parts do
			p:Destroy()
		end
	end)
	VfxUtil.kanji(head.Position + Vector3.new(0, 3.2, 0), "六眼", 2.6, Palette.SixEyes, time, 0.1)
	local att = Instance.new("Attachment")
	att.Parent = root
	PartKit.emitter(att, {
		Texture = PartKit.Textures.Sparkle,
		Color = ColorSequence.new(Palette.SixEyes, WHITE),
		LightEmission = 1,
		Size = NumberSequence.new(0.3, 0),
		Lifetime = NumberRange.new(0.6, 1),
		Rate = 40,
		Speed = NumberRange.new(3, 6),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, 8, 0),
	})
	Debris:AddItem(att, time)
end

handlers.SixEyesAwaken = function(d)
	local root = VfxUtil.root(d.char)
	if not root then
		return
	end
	local folder = VfxUtil.folder()
	local flash = PartKit.ball(folder, root.CFrame, 2, { Color = WHITE, Material = NEON, Transparency = 0.2 }, "Flash")
	VfxUtil.tween(flash, 0.35, { Size = Vector3.one * 26, Transparency = 1, Color = Palette.SixEyes })
	Debris:AddItem(flash, 0.4)
	local shell = Effects.infinity(folder, root.Position, 4)
	VfxUtil.fade(shell, 0.6, 0.3)
	if isMe(d.char) then
		HUD.flash(Palette.SixEyes, 0.6, 0.5)
	end
	if near(root.Position, 90) then
		CameraFX.shake(0.7, 0.5)
	end
end

handlers.SixEyesEnd = function(d)
	local root = VfxUtil.root(d.char)
	if root then
		VfxUtil.burst(root.Position + Vector3.new(0, 2, 0), {
			Texture = PartKit.Textures.Sparkle,
			Color = ColorSequence.new(Palette.SixEyes),
			LightEmission = 1,
			Size = NumberSequence.new(0.4, 0),
			Lifetime = NumberRange.new(0.4, 0.8),
			Speed = NumberRange.new(4, 9),
			SpreadAngle = Vector2.new(180, 180),
		}, 20)
	end
end

local lastInfinity: { [Instance]: number } = {}
handlers.Infinity = function(d)
	local char = d.char
	local root = VfxUtil.root(char)
	if not root then
		return
	end
	local now = os.clock()
	if (lastInfinity[char] or 0) > now - 0.15 then
		return
	end
	lastInfinity[char] = now
	local adapted: number = d.adapted or 0
	local shell = Effects.infinity(VfxUtil.folder(), root.Position, 3.2)
	local color = Palette.SixEyes:Lerp(Palette.Danger, adapted)
	for _, p in VfxUtil.parts(shell) do
		p.Color = color
	end
	VfxUtil.fade(shell, 0.35, 0.05)
end

handlers.Blue = function(d)
	local pos: Vector3 = d.pos
	local radius: number = d.radius or 16
	local duration: number = d.duration or 1.6
	local folder = VfxUtil.folder()
	local m = Effects.blue(folder, pos, radius)
	m.WorldPivot = CFrame.new(pos)
	local shellPart = PartKit.ball(folder, CFrame.new(pos), radius * 1.6, { Transparency = 1 }, "Pull")
	local emitter = PartKit.emitter(shellPart, {
		Texture = PartKit.Textures.Sparkle,
		Color = ColorSequence.new(Palette.BlueCore, Palette.Blue),
		LightEmission = 1,
		Size = NumberSequence.new(0.5, 0.1),
		Lifetime = NumberRange.new(0.4, 0.6),
		Rate = 90,
		Speed = NumberRange.new(20, 28),
	})
	pcall(function()
		emitter.Shape = Enum.ParticleEmitterShape.Sphere
		emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		emitter.ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward
	end)
	local core = m:FindFirstChild("Core")
	VfxUtil.animate(duration, function(a)
		m:PivotTo(CFrame.new(pos) * CFrame.Angles(0, a * duration * 7, 0))
		if core and core:IsA("BasePart") then
			core.Size = Vector3.one * radius * 0.2 * (1 + math.sin(a * 60) * 0.15)
		end
	end, function()
		emitter.Enabled = false
		Debris:AddItem(shellPart, 0.7)
		local flash = PartKit.ball(folder, CFrame.new(pos), radius * 0.5, { Color = Palette.BlueCore, Material = NEON, Transparency = 0.2 }, "Implode")
		VfxUtil.tween(flash, 0.18, { Size = Vector3.one * 0.2, Transparency = 1 })
		Debris:AddItem(flash, 0.2)
		VfxUtil.fade(m, 0.15)
	end)
	VfxUtil.kanji(pos + Vector3.new(0, radius * 0.5 + 3, 0), "蒼", 3, Palette.Blue, 0.9)
	VfxUtil.sound("Blue", pos)
end

type Projectile = { Model: Model, Alive: boolean }
local projectiles: { [string]: Projectile } = {}

handlers.RedFire = function(d)
	local id: string = d.id
	local origin: Vector3 = d.origin
	local dir: Vector3 = d.dir
	local speed: number = d.speed or 150
	local range: number = d.range or 95
	local m = Effects.red(VfxUtil.folder(), origin, 1.4, rng)
	m.WorldPivot = CFrame.new(origin)
	local record: Projectile = { Model = m, Alive = true }
	projectiles[id] = record
	local core = m:FindFirstChild("Core")
	if core and core:IsA("BasePart") then
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, 0.8, 0)
		a0.Parent = core
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -0.8, 0)
		a1.Parent = core
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Lifetime = 0.25
		trail.LightEmission = 1
		trail.FaceCamera = true
		trail.Color = ColorSequence.new(Palette.RedCore, Palette.Red)
		trail.Transparency = NumberSequence.new(0.1, 1)
		trail.WidthScale = NumberSequence.new(1, 0.2)
		trail.Parent = core
	end
	local start = os.clock()
	VfxUtil.animate(range / speed + 0.6, function()
		if not record.Alive then
			return false
		end
		local t = os.clock() - start
		m:PivotTo(CFrame.new(origin + dir * math.min(range, t * speed)) * CFrame.Angles(t * 9, t * 7, 0))
		return true
	end, function()
		if record.Alive then
			record.Alive = false
			m:Destroy()
			projectiles[id] = nil
		end
	end)
	VfxUtil.sound("Red", origin)
end

handlers.RedBoom = function(d)
	local record = projectiles[d.id]
	if record then
		record.Alive = false
		record.Model:Destroy()
		projectiles[d.id] = nil
	end
	local pos: Vector3 = d.pos
	local radius: number = d.radius or 15
	local folder = VfxUtil.folder()
	local blast = PartKit.ball(folder, CFrame.new(pos), 2, { Color = Palette.Red, Material = NEON, Transparency = 0.1 }, "Blast")
	VfxUtil.tween(blast, 0.25, { Size = Vector3.one * radius * 2, Transparency = 1 })
	Debris:AddItem(blast, 0.3)
	local core = PartKit.ball(folder, CFrame.new(pos), 1, { Color = Palette.RedCore, Material = NEON }, "BlastCore")
	VfxUtil.tween(core, 0.2, { Size = Vector3.one * radius * 0.8, Transparency = 1 })
	Debris:AddItem(core, 0.25)
	local spikes = Effects.spikes(folder, pos, 12, radius * 0.7, Palette.Red, rng)
	VfxUtil.fade(spikes, 0.25, 0.05)
	handlers.Impact({ pos = VfxUtil.ground(pos), radius = radius, color = Palette.Red, cracks = true })
	VfxUtil.kanji(pos + Vector3.new(0, 5, 0), "赫", 3, Palette.Red, 0.8)
	if near(pos, 60) then
		HUD.flash(Palette.Red, 0.3, 0.25)
	end
end

handlers.PurpleCharge = function(d)
	local root = VfxUtil.root(d.char)
	if not root then
		return
	end
	local time: number = d.time or 1.6
	local folder = VfxUtil.folder()
	local blue = Effects.orb(folder, root.Position, 1.1, Palette.BlueCore, Palette.Blue)
	local red = Effects.orb(folder, root.Position, 1.1, Palette.RedCore, Palette.Red)
	blue.WorldPivot = CFrame.new(root.Position)
	red.WorldPivot = CFrame.new(root.Position)
	local mergePoint = root.Position
	VfxUtil.animate(time, function(a)
		if not root.Parent then
			return false
		end
		local cf = root.CFrame
		local spread = 3.4 * (1 - a) ^ 1.4 + 0.1
		local forward = -1.5 - a * 1.8
		local wobble = math.sin(a * math.pi * 6) * 0.3 * (1 - a)
		blue:PivotTo(CFrame.new((cf * CFrame.new(-spread, 2 + wobble, forward)).Position))
		red:PivotTo(CFrame.new((cf * CFrame.new(spread, 2 - wobble, forward)).Position))
		mergePoint = (cf * CFrame.new(0, 2, forward)).Position
		return true
	end, function()
		blue:Destroy()
		red:Destroy()
		local flash = PartKit.ball(folder, CFrame.new(mergePoint), 1, { Color = Palette.PurpleCore, Material = NEON }, "Merge")
		VfxUtil.tween(flash, 0.25, { Size = Vector3.one * 12, Transparency = 1, Color = Palette.Purple })
		Debris:AddItem(flash, 0.3)
	end)
	VfxUtil.kanji(root.Position + Vector3.new(0, 7, 0), "虚式「茈」", 3, Palette.Purple, time + 0.3, 0.1)
	if isMe(d.char) then
		HUD.flash(Palette.Purple, time, 0.15)
	end
	VfxUtil.sound("Purple", root)
end

handlers.PurpleFire = function(d)
	local origin: Vector3 = d.origin
	local dir: Vector3 = d.dir
	local speed: number = d.speed or 115
	local range: number = d.range or 230
	local radius: number = d.radius or 9
	local folder = VfxUtil.folder()
	local m = Effects.purple(folder, origin, radius * 0.8, rng)
	m.WorldPivot = CFrame.new(origin)
	local start = os.clock()
	local lastScar = 0
	VfxUtil.animate(range / speed, function()
		local t = os.clock() - start
		local dist = math.min(range, t * speed)
		local pos = origin + dir * dist
		m:PivotTo(CFrame.new(pos) * CFrame.Angles(t * 4, t * 6, t * 2))
		if dist - lastScar > 7 then
			lastScar = dist
			local ground = VfxUtil.ground(pos)
			if pos.Y - ground.Y < radius * 1.5 then
				local scar = PartKit.part({
					Name = "Erased",
					Parent = folder,
					CFrame = Util.facing(ground + Vector3.new(0, 0.06, 0), dir),
					Size = Vector3.new(radius * 1.7, 0.1, 8),
					Color = Color3.fromRGB(26, 10, 36),
					Material = Enum.Material.Slate,
				})
				VfxUtil.fade(scar, 1.5, 3)
				local glow = PartKit.part({
					Name = "ErasedGlow",
					Parent = folder,
					CFrame = Util.facing(ground + Vector3.new(0, 0.1, 0), dir),
					Size = Vector3.new(radius * 0.5, 0.08, 8),
					Color = Palette.Purple,
					Material = NEON,
				})
				VfxUtil.fade(glow, 0.8, 0.4)
			end
		end
	end, function()
		VfxUtil.fade(m, 0.4)
	end)
	if near(origin, 160) then
		HUD.flash(Palette.Purple, 0.5, 0.35)
	end
	VfxUtil.sound("Purple", origin)
end

-- Dispatcher ---------------------------------------------------------------------------------

function VFX.start()
	for name, handler in BossVFX.handlers do
		if not handlers[name] then
			handlers[name] = handler
		end
	end
	local remote = Net.event("FX")
	remote.OnClientEvent:Connect(function(name: any, data: any)
		if typeof(name) ~= "string" then
			return
		end
		local handler = handlers[name]
		if not handler then
			return
		end
		task.spawn(function()
			xpcall(handler, function(err)
				warn(("[JJK FX] %s failed: %s"):format(name, tostring(err)))
			end, if typeof(data) == "table" then data else {})
		end)
	end)
end

return VFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">VfxUtil</string>
            <string name="Source"><![CDATA[--!strict
-- Shared helpers for client effects: local folder, tweens, per-frame animations,
-- fades, expanding rings, particles, sounds and floating kanji.

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("JJKShared")
local Config = require(Shared:WaitForChild("Config"))
local Assets = Shared:WaitForChild("Assets")
local PartKit = require(Assets:WaitForChild("PartKit"))

local VfxUtil = {}

VfxUtil.rng = Random.new()

-- Local-only folder for effects (never replicated).
function VfxUtil.folder(): Folder
	local existing = workspace:FindFirstChild("JJK_FX")
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = "JJK_FX"
	folder.Parent = workspace
	return folder
end

function VfxUtil.tween(inst: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?): Tween
	local tween = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

-- Calls step(alpha) every frame for `duration` seconds, alpha going 0 -> 1.
-- Returning false from step ends the animation early. `done` always runs once.
function VfxUtil.animate(duration: number, step: (number) -> ...any, done: (() -> ())?)
	local start = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local a = if duration <= 0 then 1 else math.clamp((os.clock() - start) / duration, 0, 1)
		local ok, keep = pcall(step, a)
		if not ok then
			warn("[JJK FX] animation error: " .. tostring(keep))
		end
		if not ok or keep == false or a >= 1 then
			conn:Disconnect()
			if done then
				done()
			end
		end
	end)
end

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude

-- Ground point below `pos`, ignoring characters, bosses, dummies and effects.
function VfxUtil.ground(pos: Vector3): Vector3
	local ignore: { Instance } = { VfxUtil.folder() }
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	for _, m in CollectionService:GetTagged("JJK_Mahoraga") do
		table.insert(ignore, m)
	end
	local dummies = workspace:FindFirstChild("JJK_Dummies")
	if dummies then
		table.insert(ignore, dummies)
	end
	groundParams.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(pos + Vector3.new(0, 3, 0), Vector3.new(0, -80, 0), groundParams)
	return if hit then hit.Position else pos - Vector3.new(0, 3, 0)
end

function VfxUtil.parts(inst: Instance): { BasePart }
	local list = {}
	if inst:IsA("BasePart") then
		table.insert(list, inst)
	end
	for _, d in inst:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(list, d)
		end
	end
	return list
end

-- Fades every part, light, emitter and label under `inst`, then destroys it.
function VfxUtil.fade(inst: Instance, time: number, delay: number?)
	local function run()
		for _, p in VfxUtil.parts(inst) do
			VfxUtil.tween(p, time, { Transparency = 1 })
		end
		for _, d in inst:GetDescendants() do
			if d:IsA("PointLight") then
				VfxUtil.tween(d, time, { Brightness = 0 })
			elseif d:IsA("ParticleEmitter") then
				d.Enabled = false
			elseif d:IsA("TextLabel") then
				VfxUtil.tween(d, time, { TextTransparency = 1, TextStrokeTransparency = 1 })
			end
		end
		Debris:AddItem(inst, time + 0.1)
	end
	if delay and delay > 0 then
		task.delay(delay, run)
	else
		run()
	end
end

-- Sets transparency on a group of parts, remembering each part's own base value.
export type Fader = { set: (number) -> () }
function VfxUtil.fader(inst: Instance): Fader
	local base: { [BasePart]: number } = {}
	for _, p in VfxUtil.parts(inst) do
		base[p] = p.Transparency
	end
	return {
		set = function(visibility: number)
			for p, t in base do
				p.Transparency = 1 - (1 - t) * visibility
			end
		end,
	}
end

-- A flat ring of segments that can be resized every frame (shockwaves).
export type LiveRing = { parts: { Part }, set: (radius: number, transparency: number?) -> () }
function VfxUtil.liveRing(parent: Instance, cf: CFrame, segments: number, height: number, thickness: number, color: Color3, material: Enum.Material?): LiveRing
	local parts: { Part } = {}
	for i = 1, segments do
		parts[i] = PartKit.part({
			Name = "Ring",
			Parent = parent,
			CFrame = cf,
			Size = Vector3.new(0.1, height, thickness),
			Color = color,
			Material = material or Enum.Material.Neon,
		})
	end
	return {
		parts = parts,
		set = function(radius: number, transparency: number?)
			local segLen = math.max(0.05, 2 * math.pi * radius / segments * 1.05)
			for i, p in parts do
				local a = (i - 0.5) / segments * math.pi * 2
				p.CFrame = cf * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -radius)
				p.Size = Vector3.new(segLen, height, thickness)
				if transparency then
					p.Transparency = transparency
				end
			end
		end,
	}
end

-- One-shot particle burst at a world position.
function VfxUtil.burst(pos: Vector3, props: { [string]: any }, count: number)
	local a = Instance.new("Attachment")
	a.WorldPosition = pos
	a.Parent = workspace.Terrain
	local emitter = PartKit.emitter(a, props)
	emitter.Enabled = false
	emitter:Emit(count)
	Debris:AddItem(a, emitter.Lifetime.Max + 0.5)
end

function VfxUtil.sound(name: string, at: (Instance | Vector3)?, volume: number?)
	local spec = (Config.Sounds :: any)[name]
	if not spec or spec.Id == "" then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = spec.Id
	sound.Volume = spec.Volume * (volume or 1)
	sound.PlaybackSpeed = spec.Speed
	sound.RollOffMinDistance = 15
	sound.RollOffMaxDistance = 450
	if typeof(at) == "Vector3" then
		local a = Instance.new("Attachment")
		a.WorldPosition = at
		a.Parent = workspace.Terrain
		sound.Parent = a
		Debris:AddItem(a, 10)
	elseif typeof(at) == "Instance" then
		sound.Parent = at
		Debris:AddItem(sound, 10)
	else
		sound.Parent = SoundService
		Debris:AddItem(sound, 10)
	end
	sound:Play()
end

function VfxUtil.root(char: any): BasePart?
	if typeof(char) ~= "Instance" or not char:IsA("Model") then
		return nil
	end
	local r = char:FindFirstChild("HumanoidRootPart")
	return if r and r:IsA("BasePart") then r else nil
end

function VfxUtil.head(char: any): BasePart?
	if typeof(char) ~= "Instance" or not char:IsA("Model") then
		return nil
	end
	local h = char:FindFirstChild("Head")
	return if h and h:IsA("BasePart") then h else nil
end

-- Big floating text (kanji call-outs). Pops in, shakes, fades.
function VfxUtil.kanji(pos: Vector3, text: string, size: number, color: Color3, life: number, shake: number?)
	local anchor = PartKit.part({ Name = "Kanji", Parent = VfxUtil.folder(), CFrame = CFrame.new(pos), Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1 })
	local chars = utf8.len(text) or #text
	local width = size * math.max(1, chars) * 1.05
	local gui, label = PartKit.billboardText(anchor, text, width, size, color)
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	gui.Size = UDim2.new(width * 0.6, 0, size * 0.6, 0)
	VfxUtil.tween(gui, 0.18, { Size = UDim2.new(width, 0, size, 0) }, Enum.EasingStyle.Back)
	local amount = shake or 0
	if amount > 0 then
		VfxUtil.animate(life, function()
			gui.StudsOffset = Vector3.new(VfxUtil.rng:NextNumber(-1, 1), VfxUtil.rng:NextNumber(-1, 1), 0) * amount
		end)
	end
	VfxUtil.fade(anchor, 0.35, life)
end

return VfxUtil
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="34">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>