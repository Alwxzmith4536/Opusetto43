      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Abilities</string>
          <string name="Source"><![CDATA[--!strict
-- Hotbar definitions shared by the server (validation) and the client (input + HUD).

local Palette = require(script.Parent.Palette)

export type Def = {
	Id: string,
	Name: string,
	Short: string,
	Key: Enum.KeyCode,
	KeyLabel: string,
	Color: Color3,
	Kanji: string?,
	Hold: boolean?,
	Description: string,
}

local Abilities = {}

local defs: { [string]: Def } = {
	Dash = {
		Id = "Dash",
		Name = "Cursed Dash",
		Short = "Dash",
		Key = Enum.KeyCode.Q,
		KeyLabel = "Q",
		Color = Palette.YutaEnergy,
		Description = "Burst of cursed energy. Brief dodge window.",
	},
	RikaStrike = {
		Id = "RikaStrike",
		Name = "Rika: Partial Manifestation",
		Short = "Rika Strike",
		Key = Enum.KeyCode.Z,
		KeyLabel = "Z",
		Color = Palette.RikaAura,
		Kanji = "里香",
		Description = "Rika's arm tears out of the air behind Yuta and crushes the ground ahead.",
	},
	DontMove = {
		Id = "DontMove",
		Name = "Cursed Speech: Don't Move",
		Short = "Don't Move",
		Key = Enum.KeyCode.X,
		KeyLabel = "X",
		Color = Palette.SpeechRing,
		Kanji = "動くな",
		Description = "Copied from Toge Inumaki. Freezes every enemy nearby. Hurts Yuta's throat.",
	},
	BlastAway = {
		Id = "BlastAway",
		Name = "Cursed Speech: Blast Away",
		Short = "Blast Away",
		Key = Enum.KeyCode.C,
		KeyLabel = "C",
		Color = Palette.SpeechRing,
		Kanji = "吹っ飛べ",
		Description = "Copied from Toge Inumaki. A cone of words that launches enemies.",
	},
	RCT = {
		Id = "RCT",
		Name = "Reverse Cursed Technique",
		Short = "RCT Heal",
		Key = Enum.KeyCode.V,
		KeyLabel = "V",
		Color = Palette.RCT,
		Kanji = "反転術式",
		Description = "Positive energy heals Yuta and nearby allies. Clears stuns.",
	},
	FullManifestation = {
		Id = "FullManifestation",
		Name = "Rika: Full Manifestation",
		Short = "Full Rika",
		Key = Enum.KeyCode.F,
		KeyLabel = "F",
		Color = Palette.RikaAura,
		Kanji = "完全顕現",
		Description = "Rika manifests completely: +25% damage, auto claws, shields Yuta, unlocks Pure Love.",
	},
	PureLove = {
		Id = "PureLove",
		Name = "Pure Love: Jun'ai Ho",
		Short = "Pure Love",
		Key = Enum.KeyCode.R,
		KeyLabel = "R",
		Color = Palette.PureLove,
		Kanji = "純愛砲",
		Description = "Needs Full Manifestation. Yuta and Rika fire a colossal beam of cursed energy.",
	},
	Domain = {
		Id = "Domain",
		Name = "Domain Expansion: Authentic Mutual Love",
		Short = "Domain",
		Key = Enum.KeyCode.T,
		KeyLabel = "T",
		Color = Palette.DomainSky,
		Kanji = "真贋相愛",
		Description = "A field of countless katanas, each holding a copied technique. Sure-hit on everyone inside.",
	},
	SixEyes = {
		Id = "SixEyes",
		Name = "Copy: Body Transplant (Six Eyes)",
		Short = "Six Eyes",
		Key = Enum.KeyCode.G,
		KeyLabel = "G",
		Color = Palette.SixEyes,
		Kanji = "六眼",
		Description = "Kenjaku's copied technique moves Yuta into Gojo's body: Infinity, Blue, Red and Hollow Purple.",
	},
	Block = {
		Id = "Block",
		Name = "Cursed Energy Guard",
		Short = "Block",
		Key = Enum.KeyCode.E,
		KeyLabel = "E",
		Color = Palette.YutaCore,
		Hold = true,
		Description = "Hold to guard. Cuts blockable damage by 55%.",
	},
	Blue = {
		Id = "Blue",
		Name = "Cursed Technique Lapse: Blue",
		Short = "Blue",
		Key = Enum.KeyCode.Z,
		KeyLabel = "Z",
		Color = Palette.Blue,
		Kanji = "蒼",
		Description = "A point of attraction at your cursor that drags and crushes enemies.",
	},
	Red = {
		Id = "Red",
		Name = "Cursed Technique Reversal: Red",
		Short = "Red",
		Key = Enum.KeyCode.X,
		KeyLabel = "X",
		Color = Palette.Red,
		Kanji = "赫",
		Description = "A repelling blast fired at your cursor.",
	},
	HollowPurple = {
		Id = "HollowPurple",
		Name = "Hollow Technique: Purple",
		Short = "Purple",
		Key = Enum.KeyCode.C,
		KeyLabel = "C",
		Color = Palette.Purple,
		Kanji = "茈",
		Description = "Blue and Red collide into imaginary mass that erases everything in its path.",
	},
}

Abilities.Defs = defs

-- Hotbar layout per mode. Keys are read from the defs, so Z/X/C swap to
-- Blue/Red/Purple while Yuta is in Gojo's body.
Abilities.Bars = {
	Base = { "Dash", "RikaStrike", "DontMove", "BlastAway", "RCT", "FullManifestation", "PureLove", "Domain", "SixEyes", "Block" },
	SixEyes = { "Dash", "Blue", "Red", "HollowPurple", "RCT", "FullManifestation", "PureLove", "Domain", "SixEyes", "Block" },
}

function Abilities.forKey(mode: string, key: Enum.KeyCode): Def?
	local bar = Abilities.Bars[mode] or Abilities.Bars.Base
	for _, id in bar do
		local def = defs[id]
		if def and def.Key == key then
			return def
		end
	end
	return nil
end

function Abilities.inMode(mode: string, id: string): boolean
	local bar = Abilities.Bars[mode] or Abilities.Bars.Base
	return table.find(bar, id) ~= nil
end

return Abilities
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="3">
        <Properties>
          <string name="Name">Assets</string>
        </Properties>
        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">Arena</string>
            <string name="Source"><![CDATA[--!strict
--[[
	The shrine courtyard where Mahoraga is summoned: stone floor with a shikigami
	seal, torii gate, stone lanterns, sakura trees, broken pillars, the Ten Shadows
	altar guarded by the two Divine Dogs, and a spawn point.
]]

local PartKit = require(script.Parent.PartKit)
local Palette = require(script.Parent.Parent.Palette)

local Arena = {}

export type Info = {
	Model: Model,
	Pedestal: BasePart,
	AltarCFrame: CFrame,
	BossSpawn: CFrame,
	Spawn: CFrame,
}

local STONE = Color3.fromRGB(86, 82, 88)
local STONE_LIGHT = Color3.fromRGB(122, 116, 118)
local COURT = Color3.fromRGB(104, 98, 104)
local TORII = Color3.fromRGB(192, 40, 34)
local TORII_BLACK = Color3.fromRGB(28, 24, 26)
local LANTERN_LIGHT = Color3.fromRGB(255, 176, 96)
local SAKURA = Color3.fromRGB(255, 178, 208)
local SAKURA_DEEP = Color3.fromRGB(240, 132, 172)
local BARK = Color3.fromRGB(70, 46, 40)
local PLASTER = Color3.fromRGB(226, 220, 206)
local ROOF = Color3.fromRGB(52, 56, 66)
local GRAVEL = Color3.fromRGB(118, 114, 120)
local PATH = Color3.fromRGB(104, 98, 104)

local function solid(props: PartKit.Props): Part
	props.CanCollide = true
	props.CastShadow = true
	return PartKit.part(props)
end

function Arena.buildTorii(parent: Instance?, cf: CFrame, s: number): Model
	local m = PartKit.model("Torii", parent)
	for _, side in { -1, 1 } do
		local pillar = PartKit.cylinderY({ Name = "Pillar", Parent = m, CFrame = cf * CFrame.new(side * 5.5 * s, 7 * s, 0), Color = TORII, Material = Enum.Material.Wood, CanCollide = true, CastShadow = true }, 14 * s, 1.3 * s)
		pillar.Name = "Pillar"
		solid({ Name = "Base", Parent = m, CFrame = cf * CFrame.new(side * 5.5 * s, 0.7 * s, 0), Size = Vector3.new(1.9, 1.4, 1.9) * s, Color = TORII_BLACK })
		solid({
			Name = "KasagiEnd",
			Parent = m,
			CFrame = cf * CFrame.new(side * 8.7 * s, 14.25 * s, 0) * CFrame.Angles(0, 0, math.rad(side * 12)),
			Size = Vector3.new(2.6, 0.95, 1.45) * s,
			Color = TORII_BLACK,
		})
	end
	solid({ Name = "Nuki", Parent = m, CFrame = cf * CFrame.new(0, 11 * s, 0), Size = Vector3.new(14.4, 0.9, 0.8) * s, Color = TORII, Material = Enum.Material.Wood })
	solid({ Name = "Shimaki", Parent = m, CFrame = cf * CFrame.new(0, 13.05 * s, 0), Size = Vector3.new(15.6, 0.8, 1.1) * s, Color = TORII, Material = Enum.Material.Wood })
	solid({ Name = "Kasagi", Parent = m, CFrame = cf * CFrame.new(0, 13.9 * s, 0), Size = Vector3.new(15.4, 1.1, 1.45) * s, Color = TORII_BLACK })
	solid({ Name = "Gakuzuka", Parent = m, CFrame = cf * CFrame.new(0, 12.0 * s, 0), Size = Vector3.new(0.9, 2.1, 0.7) * s, Color = TORII, Material = Enum.Material.Wood })
	PartKit.part({ Name = "Plaque", Parent = m, CFrame = cf * CFrame.new(0, 12.05 * s, -0.45 * s), Size = Vector3.new(1.9, 2.4, 0.3) * s, Color = TORII_BLACK })
	PartKit.part({ Name = "PlaqueTrim", Parent = m, CFrame = cf * CFrame.new(0, 12.05 * s, -0.62 * s), Size = Vector3.new(1.4, 1.9, 0.05) * s, Color = Palette.Wheel, Material = Enum.Material.Metal })
	return m
end

function Arena.buildLantern(parent: Instance?, cf: CFrame, s: number): Model
	local m = PartKit.model("Lantern", parent)
	solid({ Name = "Base", Parent = m, CFrame = cf * CFrame.new(0, 0.3 * s, 0), Size = Vector3.new(2.2, 0.6, 2.2) * s, Color = STONE })
	PartKit.cylinderY({ Name = "Pole", Parent = m, CFrame = cf * CFrame.new(0, 2.2 * s, 0), Color = STONE_LIGHT, Material = Enum.Material.Granite, CanCollide = true, CastShadow = true }, 3.2 * s, 0.9 * s)
	solid({ Name = "Platform", Parent = m, CFrame = cf * CFrame.new(0, 4.05 * s, 0), Size = Vector3.new(2.4, 0.5, 2.4) * s, Color = STONE })
	local box = solid({ Name = "Firebox", Parent = m, CFrame = cf * CFrame.new(0, 5.1 * s, 0), Size = Vector3.new(1.8, 1.6, 1.8) * s, Color = STONE_LIGHT, Material = Enum.Material.Granite })
	PartKit.part({ Name = "Window", Parent = m, CFrame = cf * CFrame.new(0, 5.1 * s, 0), Size = Vector3.new(1.1, 0.9, 1.85) * s, Color = LANTERN_LIGHT, Material = Enum.Material.Neon })
	PartKit.part({ Name = "Window", Parent = m, CFrame = cf * CFrame.new(0, 5.1 * s, 0), Size = Vector3.new(1.85, 0.9, 1.1) * s, Color = LANTERN_LIGHT, Material = Enum.Material.Neon })
	solid({ Name = "Roof", Parent = m, CFrame = cf * CFrame.new(0, 6.15 * s, 0), Size = Vector3.new(3.0, 0.45, 3.0) * s, Color = STONE })
	solid({ Name = "RoofTop", Parent = m, CFrame = cf * CFrame.new(0, 6.6 * s, 0), Size = Vector3.new(1.7, 0.5, 1.7) * s, Color = STONE })
	PartKit.ball(m, cf * CFrame.new(0, 7.1 * s, 0), 0.65 * s, { Color = STONE_LIGHT }, "Hoju")
	PartKit.light(box, LANTERN_LIGHT, 24, 1.8)
	return m
end

function Arena.buildSakura(parent: Instance?, cf: CFrame, s: number, rng: Random): Model
	local m = PartKit.model("Sakura", parent)
	local function pt(x: number, y: number, z: number): Vector3
		return cf * (Vector3.new(x, y, z) * s)
	end
	local top = pt(0.6, 7, 0.3)
	PartKit.limb({ Name = "Trunk", Parent = m, Color = BARK, Material = Enum.Material.Wood }, pt(0, -0.5, 0), top, 1.5 * s)
	local crowns = {}
	for i = 1, 4 do
		local a = i / 4 * math.pi * 2 + rng:NextNumber() * 0.6
		local tip = top + cf.Rotation * (Vector3.new(math.cos(a) * 4.2, 2.2 + rng:NextNumber() * 1.6, math.sin(a) * 4.2) * s)
		PartKit.limb({ Name = "Branch", Parent = m, Color = BARK, Material = Enum.Material.Wood }, top, tip, 0.7 * s)
		table.insert(crowns, tip)
	end
	table.insert(crowns, top + cf.Rotation * (Vector3.new(0, 3.5, 0) * s))
	local blossom: Part? = nil
	for i, c in crowns do
		blossom = PartKit.ball(m, CFrame.new(c), (4.6 + rng:NextNumber() * 1.8) * s, {
			Color = if i % 2 == 0 then SAKURA_DEEP else SAKURA,
			Material = Enum.Material.SmoothPlastic,
		}, "Blossom")
	end
	if blossom then
		PartKit.emitter(blossom, {
			Name = "Petals",
			Texture = PartKit.Textures.Sparkle,
			Color = ColorSequence.new(SAKURA),
			Size = NumberSequence.new(0.35, 0.2),
			Transparency = NumberSequence.new(0.1, 1),
			Lifetime = NumberRange.new(3, 5),
			Rate = 3,
			Speed = NumberRange.new(0.5, 1.5),
			SpreadAngle = Vector2.new(90, 90),
			Acceleration = Vector3.new(0.6, -1.2, 0.4),
			RotSpeed = NumberRange.new(-90, 90),
		})
	end
	return m
end

-- Roofed temple wall running along cf's X axis (cf = ground point at its centre).
function Arena.buildWall(parent: Instance?, cf: CFrame, length: number): Model
	local m = PartKit.model("TempleWall", parent)
	solid({ Name = "Base", Parent = m, CFrame = cf * CFrame.new(0, 1.2, 0), Size = Vector3.new(length, 2.4, 4.2), Color = STONE, Material = Enum.Material.Slate })
	solid({ Name = "Plaster", Parent = m, CFrame = cf * CFrame.new(0, 6.4, 0), Size = Vector3.new(length, 8, 3), Color = PLASTER })
	solid({ Name = "Beam", Parent = m, CFrame = cf * CFrame.new(0, 10.2, 0), Size = Vector3.new(length, 0.6, 3.3), Color = BARK, Material = Enum.Material.Wood })
	for _, side in { -1, 1 } do
		local roof = PartKit.wedge({
			Name = "Roof",
			Parent = m,
			CFrame = cf * CFrame.new(0, 11.4, side * 1.4) * CFrame.Angles(0, if side < 0 then 0 else math.pi, 0),
			Size = Vector3.new(length + 1, 1.8, 2.8),
			Color = ROOF,
			CanCollide = true,
			CastShadow = true,
		})
		roof.Name = "Roof"
	end
	solid({ Name = "Ridge", Parent = m, CFrame = cf * CFrame.new(0, 12.35, 0), Size = Vector3.new(length + 1, 0.5, 0.7), Color = ROOF })
	return m
end

-- Main shrine hall (honden); cf = ground point at its centre, front facing cf's -Z.
function Arena.buildHall(parent: Instance?, cf: CFrame): Model
	local m = PartKit.model("ShrineHall", parent)
	local function at(x: number, y: number, z: number): CFrame
		return cf * CFrame.new(x, y, z)
	end
	solid({ Name = "Platform", Parent = m, CFrame = at(0, 1.5, 0), Size = Vector3.new(48, 3, 34), Color = STONE_LIGHT, Material = Enum.Material.Slate })
	for i = 1, 3 do
		solid({ Name = "Step", Parent = m, CFrame = at(0, 1.5 - i * 0.5 + 0.25, -17 - i * 1.4 + 0.7), Size = Vector3.new(22, 3 - i + 0.5, 1.4), Color = STONE, Material = Enum.Material.Slate })
	end
	solid({ Name = "Floor", Parent = m, CFrame = at(0, 3.2, 0), Size = Vector3.new(46, 0.4, 32), Color = Color3.fromRGB(120, 82, 58), Material = Enum.Material.Wood })
	for _, z in { -14, 14 } do
		for _, x in { -20, -10, 0, 10, 20 } do
			if not (z < 0 and x == 0) then
				PartKit.cylinderY({ Name = "Pillar", Parent = m, CFrame = at(x, 9.9, z), Color = TORII, Material = Enum.Material.Wood, CanCollide = true, CastShadow = true }, 13.4, 1.7)
			end
		end
	end
	solid({ Name = "BackWall", Parent = m, CFrame = at(0, 9.6, 15.2), Size = Vector3.new(42, 12.6, 0.8), Color = Color3.fromRGB(78, 52, 40), Material = Enum.Material.Wood })
	for _, side in { -1, 1 } do
		solid({ Name = "SideWall", Parent = m, CFrame = at(side * 21.4, 9.6, 1), Size = Vector3.new(0.8, 12.6, 28), Color = Color3.fromRGB(78, 52, 40), Material = Enum.Material.Wood })
	end
	solid({ Name = "FrontBeam", Parent = m, CFrame = at(0, 16.2, -14), Size = Vector3.new(46, 1.3, 1.3), Color = TORII, Material = Enum.Material.Wood })
	solid({ Name = "BackBeam", Parent = m, CFrame = at(0, 16.2, 14), Size = Vector3.new(46, 1.3, 1.3), Color = TORII, Material = Enum.Material.Wood })
	PartKit.part({ Name = "Plaque", Parent = m, CFrame = at(0, 14.4, -14.8), Size = Vector3.new(6, 2.4, 0.3), Color = Color3.fromRGB(26, 22, 24) })
	PartKit.part({ Name = "PlaqueTrim", Parent = m, CFrame = at(0, 14.4, -14.97), Size = Vector3.new(5.2, 1.7, 0.05), Color = Palette.Wheel, Material = Enum.Material.Metal })
	for _, side in { -1, 1 } do
		PartKit.wedge({
			Name = "Roof",
			Parent = m,
			CFrame = at(0, 20.3, side * 11) * CFrame.Angles(0, if side < 0 then 0 else math.pi, 0),
			Size = Vector3.new(56, 7.2, 22),
			Color = ROOF,
			CanCollide = true,
			CastShadow = true,
		})
	end
	solid({ Name = "Ridge", Parent = m, CFrame = at(0, 24.05, 0), Size = Vector3.new(58, 1.3, 1.8), Color = ROOF })
	for _, side in { -1, 1 } do
		PartKit.ball(m, at(side * 29, 24.4, 0), 1.6, { Color = Palette.Wheel, Material = Enum.Material.Metal }, "RidgeOrnament")
	end
	solid({ Name = "OfferingBox", Parent = m, CFrame = at(0, 4.4, -12), Size = Vector3.new(5, 2, 2.4), Color = Color3.fromRGB(96, 64, 44), Material = Enum.Material.Wood })
	local rope = PartKit.cylinderZ({ Name = "Shimenawa", Parent = m, CFrame = at(0, 13.2, -14.9) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(214, 190, 140), Material = Enum.Material.Fabric }, 18, 1.1)
	rope.Name = "Shimenawa"
	for _, x in { -6, -2, 2, 6 } do
		PartKit.part({ Name = "Shide", Parent = m, CFrame = at(x, 11.8, -15.2), Size = Vector3.new(0.9, 2.2, 0.05), Color = Color3.fromRGB(250, 250, 246) })
	end
	return m
end

function Arena.buildBoulders(parent: Instance?, cf: CFrame, rng: Random): Model
	local m = PartKit.model("Boulders", parent)
	for i = 1, 4 do
		local size = 3 + rng:NextNumber() * 5
		solid({
			Name = "Boulder",
			Parent = m,
			CFrame = cf * CFrame.new(rng:NextNumber(-6, 6), size * 0.3, rng:NextNumber(-6, 6)) * CFrame.Angles(rng:NextNumber(-0.5, 0.5), rng:NextNumber() * 3, rng:NextNumber(-0.5, 0.5)),
			Size = Vector3.new(size, size * 0.7, size * (0.8 + i * 0.1)),
			Color = if i % 2 == 0 then STONE else Color3.fromRGB(98, 104, 88),
			Material = Enum.Material.Slate,
		})
	end
	return m
end

-- One of Megumi's Divine Dogs, sitting on a plinth, facing cf's -Z.
function Arena.buildDivineDog(parent: Instance?, cf: CFrame, color: Color3, eyes: Color3): Model
	local m = PartKit.model("DivineDog", parent)
	local function at(x: number, y: number, z: number): CFrame
		return cf * CFrame.new(x, y, z)
	end
	local function pt(x: number, y: number, z: number): Vector3
		return cf * Vector3.new(x, y, z)
	end
	solid({ Name = "Plinth", Parent = m, CFrame = at(0, 0.6, 0), Size = Vector3.new(3.4, 1.2, 4.4), Color = STONE })
	PartKit.ellipsoid({ Name = "Haunch", Parent = m, CFrame = at(0, 2.8, 0.5) * CFrame.Angles(math.rad(20), 0, 0), Size = Vector3.new(2.3, 3.0, 2.8), Color = color })
	PartKit.ellipsoid({ Name = "Chest", Parent = m, CFrame = at(0, 3.5, -0.55), Size = Vector3.new(1.9, 2.4, 1.7), Color = color })
	for _, side in { -1, 1 } do
		PartKit.ellipsoid({ Name = "HindLeg", Parent = m, CFrame = at(side * 1.0, 1.9, 0.6), Size = Vector3.new(1.0, 1.6, 2.2), Color = color })
		PartKit.limb({ Name = "ForeLeg", Parent = m, Color = color }, pt(side * 0.6, 3.2, -0.95), pt(side * 0.6, 1.3, -1.3), 0.62)
		PartKit.ellipsoid({ Name = "Paw", Parent = m, CFrame = at(side * 0.6, 1.35, -1.55), Size = Vector3.new(0.7, 0.4, 0.9), Color = color })
		PartKit.wedge({ Name = "Ear", Parent = m, CFrame = at(side * 0.55, 6.35, -0.75), Size = Vector3.new(0.35, 1.0, 0.7), Color = color })
		PartKit.ball(m, at(side * 0.45, 5.55, -1.85), 0.28, { Color = eyes, Material = Enum.Material.Neon }, "Eye")
	end
	PartKit.ellipsoid({ Name = "Head", Parent = m, CFrame = at(0, 5.3, -0.9), Size = Vector3.new(1.8, 1.7, 2.0), Color = color })
	PartKit.ellipsoid({ Name = "Snout", Parent = m, CFrame = at(0, 5.0, -2.0), Size = Vector3.new(1.0, 0.8, 1.3), Color = color })
	PartKit.ball(m, at(0, 5.15, -2.65), 0.3, { Color = Palette.Shadow }, "Nose")
	PartKit.limb({ Name = "Tail", Parent = m, Color = color }, pt(0, 1.8, 1.6), pt(0, 3.4, 2.4), 0.5)
	return m
end

function Arena.buildAltar(parent: Instance?, cf: CFrame): (Model, Part)
	local m = PartKit.model("TenShadowsAltar", parent)
	local function at(x: number, y: number, z: number): CFrame
		return cf * CFrame.new(x, y, z)
	end
	solid({ Name = "Tier1", Parent = m, CFrame = at(0, 0.6, 0), Size = Vector3.new(28, 1.2, 22), Color = STONE, Material = Enum.Material.Slate })
	solid({ Name = "Tier2", Parent = m, CFrame = at(0, 1.8, 0.8), Size = Vector3.new(21, 1.2, 16), Color = STONE_LIGHT, Material = Enum.Material.Slate })
	solid({ Name = "Tier3", Parent = m, CFrame = at(0, 2.95, 1.4), Size = Vector3.new(14, 1.1, 11), Color = STONE, Material = Enum.Material.Slate })
	PartKit.cylinderY({ Name = "ShadowPool", Parent = m, CFrame = at(0, 3.52, 1.2), Color = Palette.Shadow }, 0.06, 8.2)
	PartKit.ring(m, at(0, 3.53, 1.2), 4.15, 0.18, 0.06, 28, { Color = Palette.YutaEnergy, Material = Enum.Material.Neon })
	local pedestal = solid({ Name = "Pedestal", Parent = m, CFrame = at(0, 5.0, 5.4), Size = Vector3.new(3.2, 3.0, 1.4), Color = STONE_LIGHT, Material = Enum.Material.Granite })
	PartKit.part({ Name = "Seal", Parent = m, CFrame = at(0, 5.2, 4.65), Size = Vector3.new(1.6, 2.0, 0.08), Color = Color3.fromRGB(236, 226, 196), Material = Enum.Material.Fabric })
	PartKit.part({ Name = "SealMark", Parent = m, CFrame = at(0, 5.3, 4.6), Size = Vector3.new(0.9, 0.9, 0.04), Color = Palette.Danger })
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		local c = at(math.cos(a) * 5.4, 3.5, 1.2 + math.sin(a) * 4.2)
		PartKit.cylinderY({ Name = "Candle", Parent = m, CFrame = c * CFrame.new(0, 0.5, 0), Color = Color3.fromRGB(240, 234, 220) }, 1.0, 0.35)
		local flame = PartKit.ball(m, c * CFrame.new(0, 1.15, 0), 0.26, { Color = LANTERN_LIGHT, Material = Enum.Material.Neon }, "Flame")
		if i % 2 == 0 then
			PartKit.light(flame, LANTERN_LIGHT, 10, 1.2)
		end
	end
	Arena.buildDivineDog(m, at(-8.2, 2.4, -3.2) * CFrame.Angles(0, math.rad(-12), 0), Color3.fromRGB(238, 238, 242), Palette.SixEyes)
	Arena.buildDivineDog(m, at(8.2, 2.4, -3.2) * CFrame.Angles(0, math.rad(12), 0), Color3.fromRGB(30, 30, 36), Palette.Danger)
	return m, pedestal
end

function Arena.buildSeal(parent: Instance?, cf: CFrame): Model
	local m = PartKit.model("ShikigamiSeal", parent)
	local style = { Color = Palette.YutaEnergy, Material = Enum.Material.Neon, Transparency = 0.45 }
	PartKit.ring(m, cf, 34, 0.5, 0.08, 48, style)
	PartKit.ring(m, cf, 56, 0.6, 0.08, 64, style)
	PartKit.ring(m, cf, 20, 0.3, 0.08, 32, style)
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		PartKit.part({
			Name = "Spoke",
			Parent = m,
			CFrame = cf * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -45),
			Size = Vector3.new(0.45, 0.08, 22),
			Color = style.Color,
			Material = style.Material,
			Transparency = style.Transparency,
		})
		PartKit.part({
			Name = "Rune",
			Parent = m,
			CFrame = cf * CFrame.Angles(0, a + math.pi / 8, 0) * CFrame.new(0, 0, -27) * CFrame.Angles(0, math.rad(45), 0),
			Size = Vector3.new(3, 0.08, 3),
			Color = style.Color,
			Material = style.Material,
			Transparency = 0.6,
		})
	end
	return m
end

function Arena.build(parent: Instance?, center: CFrame, size: number): Info
	local rng = Random.new(7)
	local m = PartKit.model("JJK_Arena", parent)
	local half = size / 2

	solid({ Name = "Floor", Parent = m, CFrame = center * CFrame.new(0, -2, 0), Size = Vector3.new(size, 4, size), Color = GRAVEL, Material = Enum.Material.Pebble })
	PartKit.cylinderY({ Name = "Courtyard", Parent = m, CFrame = center * CFrame.new(0, 0.04, 0), Color = COURT, Material = Enum.Material.Cobblestone }, 0.1, 150)
	Arena.buildSeal(m, center * CFrame.new(0, 0.1, 0))

	-- Stone paths from the courtyard to each wall.
	local pathLength = half - 75
	for k = 0, 3 do
		local dir = center * CFrame.Angles(0, k * math.pi / 2, 0)
		PartKit.part({
			Name = "Path",
			Parent = m,
			CFrame = dir * CFrame.new(0, 0.03, -(75 + pathLength / 2)),
			Size = Vector3.new(18, 0.1, pathLength + 2),
			Color = PATH,
			Material = Enum.Material.Slate,
		})
	end

	-- Roofed temple walls around the grounds, with an invisible boundary above them.
	for k = 0, 3 do
		local side = center * CFrame.Angles(0, k * math.pi / 2, 0) * CFrame.new(0, 0, -half)
		Arena.buildWall(m, side, size + 4.2)
		solid({ Name = "Boundary", Parent = m, CFrame = side * CFrame.new(0, 90, 0), Size = Vector3.new(size, 160, 4), Transparency = 1 })
	end

	-- North axis: altar, torii and the main hall behind it.
	local altarCF = center * CFrame.new(0, 0, -half * 0.5) * CFrame.Angles(0, math.pi, 0)
	local _, pedestal = Arena.buildAltar(m, altarCF)
	Arena.buildTorii(m, center * CFrame.new(0, 0, -half * 0.64) * CFrame.Angles(0, math.pi, 0), 1.6)
	Arena.buildHall(m, center * CFrame.new(0, 0, -half * 0.84) * CFrame.Angles(0, math.pi, 0))
	Arena.buildTorii(m, center * CFrame.new(0, 0, half * 0.84), 1.25)

	-- Lanterns: a ring around the courtyard and pairs lining the north/south paths.
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2 + math.pi / 12
		Arena.buildLantern(m, center * CFrame.new(math.cos(a) * 92, 0, math.sin(a) * 92), 1.3)
	end
	for _, z in { -110, 110, 170 } do
		for _, x in { -14, 14 } do
			Arena.buildLantern(m, center * CFrame.new(x, 0, z), 1.2)
		end
	end

	-- Sakura along the east and west walls, boulders in the corners.
	for _, x in { -1, 1 } do
		for z = -190, 190, 76 do
			local jitter = rng:NextNumber(-10, 10)
			Arena.buildSakura(m, center * CFrame.new(x * (half - 30), 0, z + jitter) * CFrame.Angles(0, rng:NextNumber() * 6, 0), 1.4 + rng:NextNumber() * 0.5, rng)
		end
	end
	for _, corner in { Vector3.new(-1, 0, -1), Vector3.new(1, 0, -1), Vector3.new(-1, 0, 1), Vector3.new(1, 0, 1) } do
		Arena.buildBoulders(m, center * CFrame.new(corner * (half - 26)), rng)
	end

	local spawnCF = center * CFrame.new(0, 0.5, half * 0.62)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "JJK_Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(14, 1, 14)
	spawn.CFrame = spawnCF
	spawn.Neutral = true
	spawn.Duration = 3
	spawn.Color = STONE_LIGHT
	spawn.Material = Enum.Material.Slate
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = m

	return {
		Model = m,
		Pedestal = pedestal,
		AltarCFrame = altarCF,
		BossSpawn = CFrame.lookAt(center.Position, center.Position + Vector3.new(0, 0, 1)),
		Spawn = spawnCF,
	}
end

return Arena
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">Domain</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Domain Expansion: Authentic Mutual Love (Shingan Soai).
	A dome closes over a field of countless katanas stuck in the ground, each one
	holding a technique Yuta has copied, under a crimson sky of giant gears.

	`center` is the ground point in the middle of the domain.
]]

local PartKit = require(script.Parent.PartKit)
local Katana = require(script.Parent.Katana)
local Palette = require(script.Parent.Parent.Palette)

local Domain = {}

local GEAR = Color3.fromRGB(86, 60, 44)
local GROUND = Color3.fromRGB(46, 40, 48)

-- Gear lying in cf's XZ plane (axis = cf's Y axis).
function Domain.buildGear(parent: Instance?, cf: CFrame, radius: number, teeth: number): Model
	local m = PartKit.model("Gear", parent)
	local style = { Color = GEAR, Material = Enum.Material.Metal }
	local hub = PartKit.cylinderY({ Name = "Hub", Parent = m, CFrame = cf, Color = GEAR, Material = Enum.Material.Metal }, radius * 0.14, radius * 0.42)
	m.PrimaryPart = hub
	PartKit.ring(m, cf, radius * 0.84, radius * 0.2, radius * 0.12, 18, style)
	PartKit.ring(m, cf, radius * 0.36, radius * 0.08, radius * 0.1, 10, style)
	PartKit.ring(m, cf * CFrame.new(0, radius * 0.065, 0), radius * 0.84, radius * 0.03, radius * 0.01, 18, {
		Color = Palette.DomainSky,
		Material = Enum.Material.Neon,
	})
	for k = 1, teeth do
		local a = (k - 0.5) / teeth * math.pi * 2
		PartKit.part({
			Name = "Tooth",
			Parent = m,
			CFrame = cf * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -radius * 1.0),
			Size = Vector3.new(radius * 0.15, radius * 0.12, radius * 0.2),
			Color = GEAR,
			Material = Enum.Material.Metal,
		})
	end
	for k = 1, 6 do
		local a = k / 6 * math.pi * 2
		PartKit.part({
			Name = "Spoke",
			Parent = m,
			CFrame = cf * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -radius * 0.58),
			Size = Vector3.new(radius * 0.1, radius * 0.09, radius * 0.5),
			Color = GEAR,
			Material = Enum.Material.Metal,
		})
	end
	return m
end

-- Katana stuck point-first into the ground at `ground`.
function Domain.buildGroundSword(parent: Instance?, ground: CFrame, scale: number, embed: number): Model
	local tipDistance = (0.86 + Katana.BladeLength + 0.36) * scale
	local handleFrame = ground * CFrame.new(0, tipDistance - embed, 0) * CFrame.Angles(math.pi, 0, 0)
	return Katana.buildModel(parent, handleFrame, scale, "lite")
end

-- `onStep` (optional) runs after each sword so the client can spread the build over frames.
function Domain.build(parent: Instance?, center: CFrame, radius: number, seed: number, swordCount: number?, onStep: ((number) -> ())?): Model
	local rng = Random.new(seed)
	local model = PartKit.model("AuthenticMutualLove", parent)

	PartKit.cylinderY({
		Name = "Floor",
		Parent = model,
		CFrame = center * CFrame.new(0, 0.06, 0),
		Color = GROUND,
		Material = Enum.Material.Slate,
	}, 0.12, radius * 2)

	-- Dome: bands of panels facing inward, glowing crimson at the horizon and black overhead.
	local dome = PartKit.model("Dome", model)
	local bands = 6
	local maxLat = math.rad(78)
	local lonSegments = 24
	local centerPos = center.Position
	for b = 0, bands - 1 do
		local lat0 = b / bands * maxLat
		local lat1 = (b + 1) / bands * maxLat
		local lat = (lat0 + lat1) / 2
		local ringRadius = radius * math.cos(lat)
		local height = radius * (lat1 - lat0) * 1.3
		local width = 2 * math.pi * ringRadius / lonSegments * 1.25
		-- Self-lit (Neon) so the dome reads as one sky: crimson horizon fading to black.
		local t = b / (bands - 1)
		local color = Palette.DomainSky:Lerp(Palette.DomainTop, t ^ 0.45)
		for i = 1, lonSegments do
			local lon = (i - 0.5) / lonSegments * math.pi * 2
			local normal = center.Rotation * Vector3.new(math.cos(lat) * math.sin(lon), math.sin(lat), math.cos(lat) * math.cos(lon))
			local pos = centerPos + normal * radius
			PartKit.part({
				Name = "Panel",
				Parent = dome,
				CFrame = PartKit.lookAt(pos, centerPos),
				Size = Vector3.new(width, height, 1.6),
				Color = color,
				Material = Enum.Material.Neon,
			})
		end
	end
	PartKit.cylinderY({
		Name = "Cap",
		Parent = dome,
		CFrame = center * CFrame.new(0, radius * math.sin(maxLat), 0),
		Color = Palette.DomainTop,
		Material = Enum.Material.Neon,
	}, 1, radius * math.cos(maxLat) * 2.25)

	-- From outside, the domain is a sealed black sphere. Parts are only drawn from
	-- the outside, so this shell is invisible to anyone standing inside it.
	PartKit.ball(dome, center, (radius + 2.5) * 2, { Color = Color3.fromRGB(6, 4, 8) }, "Shell")

	-- Gears turning in the sky.
	local gears = PartKit.model("Gears", model)
	local gearSpots = {
		{ at = Vector3.new(-0.48, 0.58, -0.45), size = 0.24 },
		{ at = Vector3.new(0.52, 0.5, -0.36), size = 0.2 },
		{ at = Vector3.new(0.02, 0.72, 0.3), size = 0.26 },
		{ at = Vector3.new(-0.42, 0.45, 0.5), size = 0.18 },
		{ at = Vector3.new(0.45, 0.62, 0.45), size = 0.16 },
	}
	for i, spot in gearSpots do
		local pos = center * (spot.at * radius)
		local cf = PartKit.lookAt(pos, centerPos) * CFrame.Angles(math.rad(-90), 0, 0)
		local gear = Domain.buildGear(gears, cf, radius * spot.size, 12 + i * 2)
		gear.Name = "Gear" .. i
	end

	-- The sword field. Each sword keeps its ground CFrame so the client can raise it out of the floor.
	local swords = PartKit.model("Swords", model)
	for i = 1, swordCount or 56 do
		local dist = math.sqrt(rng:NextNumber()) * (radius - 10) + 6
		local angle = rng:NextNumber() * math.pi * 2
		local ground = center
			* CFrame.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
			* CFrame.Angles(0, rng:NextNumber() * math.pi * 2, 0)
			* CFrame.Angles(math.rad(rng:NextNumber(-18, 18)), 0, math.rad(rng:NextNumber(-18, 18)))
		local sword = Domain.buildGroundSword(swords, ground, 1.7 + rng:NextNumber() * 0.7, 1.1)
		sword.Name = "Sword" .. i
		sword:SetAttribute("Ground", ground.Position)
		if onStep then
			onStep(i)
		end
	end

	local glow = PartKit.part({ Name = "Glow", Parent = model, CFrame = center * CFrame.new(0, radius * 0.5, 0), Size = Vector3.one, Transparency = 1 })
	PartKit.light(glow, Palette.DomainSky, math.min(radius, 60), 1.2)
	return model
end

return Domain
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Geometry for every visual effect. These functions only build parts; the
	client's VFX module animates them (tweens, reveals, fades).
]]

local PartKit = require(script.Parent.PartKit)
local Palette = require(script.Parent.Parent.Palette)

local Effects = {}

local NEON = Enum.Material.Neon

export type Slash = { Model: Model, Outer: { Part }, Core: { Part } }
export type Telegraph = { Model: Model, Fill: { Part }, Progress: { Part }, Outline: { Part } }

local function randomUnit(rng: Random): Vector3
	local theta = rng:NextNumber() * math.pi * 2
	local z = rng:NextNumber() * 2 - 1
	local r = math.sqrt(1 - z * z)
	return Vector3.new(r * math.cos(theta), z, r * math.sin(theta))
end
Effects.randomUnit = randomUnit

-- Crescent sword arc in cf's XZ plane: a translucent body with a bright leading edge.
function Effects.slash(
	parent: Instance?,
	cf: CFrame,
	radius: number,
	arcDegrees: number,
	thickness: number,
	color: Color3,
	core: Color3,
	segments: number?
): Slash
	local m = PartKit.model("Slash", parent)
	local n = segments or 20
	local outer = PartKit.crescent(m, cf, radius, arcDegrees, thickness, 0.1, n, { Color = color, Material = NEON, Transparency = 0.3 })
	local inner = PartKit.crescent(m, cf * CFrame.new(0, 0.03, 0), radius + thickness * 0.45, arcDegrees * 0.94, thickness * 0.38, 0.12, n, {
		Color = core,
		Material = NEON,
	})
	return { Model = m, Outer = outer, Core = inner }
end

function Effects.orb(parent: Instance?, pos: Vector3, radius: number, core: Color3, shell: Color3): Model
	local m = PartKit.model("Orb", parent)
	local c = PartKit.ball(m, CFrame.new(pos), radius * 1.1, { Color = core, Material = NEON }, "Core")
	PartKit.ball(m, CFrame.new(pos), radius * 2, { Color = shell, Material = Enum.Material.ForceField }, "Shell")
	PartKit.ball(m, CFrame.new(pos), radius * 2.7, { Color = shell, Material = NEON, Transparency = 0.84 }, "Halo")
	PartKit.light(c, shell, math.min(radius * 6, 60), 3)
	m.PrimaryPart = c
	return m
end

-- Beam running from cf along its look vector.
function Effects.beam(parent: Instance?, cf: CFrame, length: number, width: number, outer: Color3, mid: Color3, core: Color3): Model
	local m = PartKit.model("Beam", parent)
	local center = cf * CFrame.new(0, 0, -length / 2)
	PartKit.cylinderZ({ Name = "Outer", Parent = m, CFrame = center, Color = outer, Material = Enum.Material.ForceField }, length, width)
	PartKit.cylinderZ({ Name = "Mid", Parent = m, CFrame = center, Color = mid, Material = NEON, Transparency = 0.35 }, length, width * 0.72)
	PartKit.cylinderZ({ Name = "Core", Parent = m, CFrame = center, Color = core, Material = NEON }, length, width * 0.38)
	local rings = PartKit.model("Rings", m)
	local d = 10
	while d < length do
		PartKit.ring(rings, cf * CFrame.new(0, 0, -d) * CFrame.Angles(math.rad(90), 0, 0), width * 0.6, width * 0.07, width * 0.08, 12, {
			Color = core,
			Material = NEON,
			Transparency = 0.25,
		})
		d += 22
	end
	PartKit.ball(m, cf, width * 0.8, { Color = mid, Material = NEON, Transparency = 0.35 }, "Muzzle")
	return m
end

local function ground(cf: CFrame): CFrame
	return cf * CFrame.new(0, 0.14, 0)
end

function Effects.telegraphCircle(parent: Instance?, cf: CFrame, radius: number, color: Color3): Telegraph
	local m = PartKit.model("Telegraph", parent)
	local base = ground(cf)
	local fill = PartKit.cylinderY({ Name = "Fill", Parent = m, CFrame = base, Color = color, Material = NEON, Transparency = 0.84 }, 0.05, radius * 2)
	local progress = PartKit.cylinderY({ Name = "Progress", Parent = m, CFrame = base * CFrame.new(0, 0.02, 0), Color = color, Material = NEON, Transparency = 0.6 }, 0.05, 0.1)
	local outline = PartKit.ring(m, base * CFrame.new(0, 0.03, 0), radius, 0.4, 0.06, 40, { Color = color, Material = NEON })
	return { Model = m, Fill = { fill }, Progress = { progress }, Outline = outline }
end

-- Rectangle starting at cf and running `length` studs along cf's look vector.
function Effects.telegraphRect(parent: Instance?, cf: CFrame, width: number, length: number, color: Color3): Telegraph
	local m = PartKit.model("Telegraph", parent)
	local base = ground(cf)
	local fill = PartKit.part({ Name = "Fill", Parent = m, CFrame = base * CFrame.new(0, 0, -length / 2), Size = Vector3.new(width, 0.05, length), Color = color, Material = NEON, Transparency = 0.84 })
	local progress = PartKit.part({ Name = "Progress", Parent = m, CFrame = base * CFrame.new(0, 0.02, -0.05), Size = Vector3.new(width, 0.05, 0.1), Color = color, Material = NEON, Transparency = 0.6 })
	local outline: { Part } = {}
	for _, side in { -1, 1 } do
		table.insert(outline, PartKit.part({ Name = "Edge", Parent = m, CFrame = base * CFrame.new(side * width / 2, 0.03, -length / 2), Size = Vector3.new(0.4, 0.06, length), Color = color, Material = NEON }))
	end
	for _, z in { 0, -length } do
		table.insert(outline, PartKit.part({ Name = "Edge", Parent = m, CFrame = base * CFrame.new(0, 0.03, z), Size = Vector3.new(width, 0.06, 0.4), Color = color, Material = NEON }))
	end
	return { Model = m, Fill = { fill }, Progress = { progress }, Outline = outline }
end

-- Pie slice of `arcDegrees` centred on cf's look vector.
function Effects.telegraphArc(parent: Instance?, cf: CFrame, radius: number, arcDegrees: number, color: Color3): Telegraph
	local m = PartKit.model("Telegraph", parent)
	local base = ground(cf)
	local arc = math.rad(arcDegrees)
	local rays = math.max(10, math.floor(arcDegrees / 6))
	local rayWidth = radius * arc / rays * 1.15
	local fill: { Part }, progress: { Part } = {}, {}
	for i = 1, rays do
		local a = -arc / 2 + arc * (i - 0.5) / rays
		local f = PartKit.part({ Name = "Fill", Parent = m, CFrame = base * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -radius / 2), Size = Vector3.new(rayWidth, 0.05, radius), Color = color, Material = NEON, Transparency = 0.86 })
		f:SetAttribute("Angle", a)
		table.insert(fill, f)
		local p = PartKit.part({ Name = "Progress", Parent = m, CFrame = base * CFrame.Angles(0, a, 0) * CFrame.new(0, 0.02, -0.05), Size = Vector3.new(rayWidth, 0.05, 0.1), Color = color, Material = NEON, Transparency = 0.65 })
		p:SetAttribute("Angle", a)
		table.insert(progress, p)
	end
	local outline = PartKit.crescent(m, base * CFrame.new(0, 0.03, 0), radius - 0.2, arcDegrees, 0.4, 0.06, rays, { Color = color, Material = NEON })
	for _, a in { -arc / 2, arc / 2 } do
		table.insert(outline, PartKit.part({ Name = "Edge", Parent = m, CFrame = base * CFrame.Angles(0, a, 0) * CFrame.new(0, 0.03, -radius / 2), Size = Vector3.new(0.4, 0.06, radius), Color = color, Material = NEON }))
	end
	return { Model = m, Fill = fill, Progress = progress, Outline = outline }
end

function Effects.cracks(parent: Instance?, cf: CFrame, radius: number, count: number, rng: Random): Model
	local m = PartKit.model("Cracks", parent)
	local base = cf * CFrame.new(0, 0.09, 0)
	for _ = 1, count do
		local a = rng:NextNumber() * math.pi * 2
		local p = base * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -radius * 0.12)
		local steps = 3
		local len = radius * (0.5 + rng:NextNumber() * 0.5) / steps
		for s = 1, steps do
			local turn = CFrame.Angles(0, rng:NextNumber(-0.5, 0.5), 0)
			p = p * turn
			PartKit.part({
				Name = "Crack",
				Parent = m,
				CFrame = p * CFrame.new(0, 0, -len / 2),
				Size = Vector3.new(0.5 * (1.2 - s * 0.25), 0.08, len),
				Color = Color3.fromRGB(18, 14, 20),
			})
			p = p * CFrame.new(0, 0, -len)
		end
	end
	return m
end

function Effects.rocks(parent: Instance?, cf: CFrame, radius: number, count: number, rng: Random): Model
	local m = PartKit.model("Rocks", parent)
	for _ = 1, count do
		local a = rng:NextNumber() * math.pi * 2
		local r = radius * (0.4 + rng:NextNumber() * 0.6)
		local size = 0.45 + rng:NextNumber() * 0.9
		local props: PartKit.Props = {
			Name = "Rock",
			Parent = m,
			CFrame = cf * CFrame.new(math.cos(a) * r, size * 0.4, math.sin(a) * r) * CFrame.Angles(rng:NextNumber() * 3, rng:NextNumber() * 3, rng:NextNumber() * 3),
			Size = Vector3.new(size, size * 0.7, size * 1.2),
			Color = Color3.fromRGB(88, 82, 90),
			Material = Enum.Material.Slate,
		}
		if rng:NextNumber() < 0.5 then
			PartKit.wedge(props)
		else
			PartKit.part(props)
		end
	end
	return m
end

function Effects.kanji(parent: Instance?, cf: CFrame, text: string, width: number, height: number, color: Color3): (Part, TextLabel)
	local anchor = PartKit.part({ Name = "KanjiAnchor", Parent = parent, CFrame = cf, Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1 })
	local _, label = PartKit.billboardText(anchor, text, width, height, color)
	return anchor, label
end

-- Burst of glowing needles for hit sparks.
function Effects.spikes(parent: Instance?, pos: Vector3, count: number, length: number, color: Color3, rng: Random): Model
	local m = PartKit.model("Spikes", parent)
	PartKit.ball(m, CFrame.new(pos), length * 0.55, { Color = Palette.White, Material = NEON }, "Flash")
	for _ = 1, count do
		local dir = randomUnit(rng)
		local len = length * (0.6 + rng:NextNumber() * 0.7)
		PartKit.segment({ Name = "Spike", Parent = m, Color = color, Material = NEON }, pos + dir * length * 0.2, pos + dir * len, 0.14 + rng:NextNumber() * 0.08)
	end
	return m
end

-- Three parallel claw arcs, as left by Rika's hand.
function Effects.claws(parent: Instance?, cf: CFrame, size: number, color: Color3): Model
	local m = PartKit.model("Claws", parent)
	for k = -1, 1 do
		Effects.slash(m, cf * CFrame.new(k * size * 0.3, 0, 0) * CFrame.Angles(0, 0, math.rad(72)), size, 80, size * 0.12, color, Palette.White, 10)
	end
	return m
end

function Effects.shadowPool(parent: Instance?, cf: CFrame, radius: number): Model
	local m = PartKit.model("ShadowPool", parent)
	PartKit.cylinderY({ Name = "Pool", Parent = m, CFrame = cf * CFrame.new(0, 0.1, 0), Color = Palette.Shadow }, 0.08, radius * 2)
	PartKit.ring(m, cf * CFrame.new(0, 0.13, 0), radius, 0.7, 0.06, 40, { Color = Palette.YutaEnergy, Material = NEON })
	PartKit.ring(m, cf * CFrame.new(0, 0.13, 0), radius * 0.62, 0.35, 0.06, 32, { Color = Palette.YutaEnergy, Material = NEON, Transparency = 0.5 })
	return m
end

function Effects.pillar(parent: Instance?, cf: CFrame, height: number, radius: number, color: Color3): Model
	local m = PartKit.model("Pillar", parent)
	PartKit.cylinderY({ Name = "Glow", Parent = m, CFrame = cf * CFrame.new(0, height / 2, 0), Color = color, Material = NEON, Transparency = 0.45 }, height, radius * 2)
	PartKit.cylinderY({ Name = "Core", Parent = m, CFrame = cf * CFrame.new(0, height / 2, 0), Color = Palette.White, Material = NEON }, height, radius * 0.7)
	return m
end

-- Rings of sound rippling forward from the speaker's mouth (cf faces forward).
function Effects.speechWaves(parent: Instance?, cf: CFrame, count: number, spacing: number, baseRadius: number, color: Color3): Model
	local m = PartKit.model("SpeechWaves", parent)
	for i = 1, count do
		PartKit.ring(m, cf * CFrame.new(0, 0, -i * spacing) * CFrame.Angles(math.rad(90), 0, 0), baseRadius * (1 + i * 0.55), 0.3, 0.18, 22, {
			Color = color,
			Material = NEON,
			Transparency = math.min(0.85, 0.15 + i * 0.12),
		})
	end
	return m
end

-- Fan of force lines for "Blast Away".
function Effects.cone(parent: Instance?, cf: CFrame, length: number, angleDegrees: number, color: Color3): Model
	local m = PartKit.model("Cone", parent)
	local rays = 9
	local arc = math.rad(angleDegrees)
	for i = 1, rays do
		local a = -arc / 2 + arc * (i - 0.5) / rays
		local dir = (cf * CFrame.Angles(0, a, 0)).LookVector
		PartKit.segment({ Name = "Ray", Parent = m, Color = color, Material = NEON, Transparency = 0.45 }, cf.Position + dir * 2, cf.Position + dir * length, 0.5, 0.12)
	end
	for _, f in { 0.35, 0.65, 0.95 } do
		PartKit.crescent(m, cf, length * f, angleDegrees, 1.1, 0.2, 16, { Color = Palette.White, Material = NEON, Transparency = 0.2 })
	end
	return m
end

function Effects.infinity(parent: Instance?, pos: Vector3, radius: number): Model
	local m = PartKit.model("Infinity", parent)
	PartKit.ball(m, CFrame.new(pos), radius * 2, { Color = Palette.SixEyes, Material = Enum.Material.ForceField }, "Shell")
	for i, tilt in { 0, 60, -60 } do
		PartKit.ring(m, CFrame.new(pos) * CFrame.Angles(math.rad(tilt), math.rad(i * 40), 0), radius * 1.02, 0.12, 0.08, 20, {
			Color = Palette.SixEyes,
			Material = NEON,
			Transparency = 0.35,
		})
	end
	return m
end

-- Curved translucent guard in front of a character (cf = root, facing forward).
function Effects.guard(parent: Instance?, cf: CFrame): Model
	local m = PartKit.model("Guard", parent)
	for i = -3, 3 do
		local a = math.rad(i * 18)
		local panel = cf * CFrame.Angles(0, a, 0) * CFrame.new(0, 0.3, -2.6)
		PartKit.part({ Name = "Panel", Parent = m, CFrame = panel, Size = Vector3.new(0.86, 5.4, 0.08), Color = Palette.YutaEnergy, Material = NEON, Transparency = 0.72 })
		PartKit.part({ Name = "Line", Parent = m, CFrame = panel * CFrame.new(0, 2.7, 0), Size = Vector3.new(0.86, 0.08, 0.1), Color = Palette.YutaCore, Material = NEON })
	end
	m.PrimaryPart = m:FindFirstChild("Panel") :: BasePart?
	return m
end

-- Imaginary mass: violet orb crackling with arcs of energy.
function Effects.purple(parent: Instance?, pos: Vector3, radius: number, rng: Random): Model
	local m = Effects.orb(parent, pos, radius, Palette.PurpleCore, Palette.Purple)
	m.Name = "HollowPurple"
	for _ = 1, 10 do
		local dir = randomUnit(rng)
		local p = pos + dir * radius * 1.05
		for _ = 1, 4 do
			local q = pos + (dir + randomUnit(rng) * 0.45).Unit * radius * (1.0 + rng:NextNumber() * 0.4)
			PartKit.segment({ Name = "Arc", Parent = m, Color = Palette.PurpleCore, Material = NEON }, p, q, 0.22)
			p = q
		end
	end
	for i, tilt in { 20, -35, 70 } do
		PartKit.ring(m, CFrame.new(pos) * CFrame.Angles(math.rad(tilt), math.rad(i * 55), 0), radius * 1.6, 0.35, 0.2, 30, {
			Color = Palette.Purple,
			Material = NEON,
			Transparency = 0.3,
		})
	end
	return m
end

-- Blue: a crushing point of attraction wrapped in inward spirals.
function Effects.blue(parent: Instance?, pos: Vector3, radius: number): Model
	local m = Effects.orb(parent, pos, radius * 0.18, Palette.BlueCore, Palette.Blue)
	m.Name = "Blue"
	for k = 1, 3 do
		local r = radius * (0.35 + k * 0.2)
		PartKit.ring(m, CFrame.new(pos) * CFrame.Angles(math.rad(-20 + k * 15), math.rad(k * 40), 0), r, 0.3, 0.15, 26, {
			Color = Palette.Blue,
			Material = NEON,
			Transparency = 0.2 + k * 0.15,
		})
	end
	for i = 1, 16 do
		local a = i / 16 * math.pi * 2
		local r = radius * (0.3 + (i % 4) * 0.15)
		local p = pos + Vector3.new(math.cos(a) * r, (i % 3 - 1) * 1.2, math.sin(a) * r)
		local q = pos + Vector3.new(math.cos(a + 0.9) * r * 0.55, (i % 3 - 1) * 0.6, math.sin(a + 0.9) * r * 0.55)
		PartKit.segment({ Name = "Streak", Parent = m, Color = Palette.BlueCore, Material = NEON, Transparency = 0.3 }, p, q, 0.18)
	end
	return m
end

-- Red: an unstable repelling orb ringed with spikes.
function Effects.red(parent: Instance?, pos: Vector3, radius: number, rng: Random): Model
	local m = Effects.orb(parent, pos, radius, Palette.RedCore, Palette.Red)
	m.Name = "Red"
	for _ = 1, 12 do
		local dir = randomUnit(rng)
		PartKit.segment({ Name = "Spike", Parent = m, Color = Palette.Red, Material = NEON }, pos + dir * radius, pos + dir * radius * 2.6, 0.2)
	end
	return m
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Katana</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Yuta's katana. The blade runs along the handle's +Y axis with the edge facing
	-Z and a slight curve (sori) toward the spine, like a real katana.

	buildParts: anchored parts around a handle frame (previews, the domain's sword field).
	buildTool: the equippable Tool with welded parts and a swing trail.
]]

local PartKit = require(script.Parent.PartKit)
local Palette = require(script.Parent.Parent.Palette)

local Katana = {}

local STEEL = Color3.fromRGB(198, 204, 216)
local EDGE = Color3.fromRGB(242, 245, 252)
local WRAP = Color3.fromRGB(20, 18, 26)
local SAME = Color3.fromRGB(206, 200, 214)
local GUARD = Color3.fromRGB(40, 38, 46)
local GOLD = Color3.fromRGB(214, 176, 92)

Katana.BladeLength = 3.4

-- detail "full" = tool / close-up, "lite" = sword field (fewer parts).
function Katana.buildParts(parent: Instance, h: CFrame, scale: number, detail: string): Part
	local s = scale
	local full = detail == "full"

	local handle = PartKit.part({
		Name = "Handle",
		Parent = parent,
		CFrame = h,
		Size = Vector3.new(0.24, 1.2, 0.32) * s,
		Color = WRAP,
		Material = Enum.Material.Fabric,
	})
	PartKit.part({
		Name = "Kashira",
		Parent = parent,
		CFrame = h * CFrame.new(0, -0.64 * s, 0),
		Size = Vector3.new(0.27, 0.12, 0.36) * s,
		Color = GUARD,
		Material = Enum.Material.Metal,
	})
	PartKit.cylinderY({
		Name = "Tsuba",
		Parent = parent,
		CFrame = h * CFrame.new(0, 0.64 * s, 0),
		Color = GUARD,
		Material = Enum.Material.Metal,
	}, 0.08 * s, 0.8 * s)
	PartKit.part({
		Name = "Habaki",
		Parent = parent,
		CFrame = h * CFrame.new(0, 0.77 * s, 0.01 * s),
		Size = Vector3.new(0.12, 0.18, 0.28) * s,
		Color = GOLD,
		Material = Enum.Material.Metal,
	})

	if full then
		-- Diamond pattern of the handle wrap (tsuka-ito over ray skin).
		for i = 0, 4 do
			local y = (-0.44 + i * 0.22) * s
			for _, side in { -1, 1 } do
				PartKit.part({
					Name = "Ito",
					Parent = parent,
					CFrame = h * CFrame.new(side * 0.121 * s, y, 0) * CFrame.Angles(math.rad(45), 0, 0),
					Size = Vector3.new(0.02, 0.11, 0.11) * s,
					Color = SAME,
				})
			end
		end
	end

	local segments = if full then 6 else 3
	local segLen = Katana.BladeLength * s / segments
	local bend = math.rad(if full then 1.7 else 3.4)
	local cursor = h * CFrame.new(0, 0.86 * s, 0)
	local width = 0.25 * s
	for i = 1, segments do
		width = (0.25 - 0.012 * i) * s
		local center = cursor * CFrame.new(0, segLen / 2, 0)
		PartKit.part({
			Name = "Blade",
			Parent = parent,
			CFrame = center,
			Size = Vector3.new(0.07 * s, segLen * 1.02, width),
			Color = STEEL,
			Material = Enum.Material.Metal,
			Reflectance = 0.15,
		})
		if full then
			PartKit.part({
				Name = "Edge",
				Parent = parent,
				CFrame = center * CFrame.new(0, 0, -width / 2 - 0.012 * s),
				Size = Vector3.new(0.04 * s, segLen * 1.02, 0.03 * s),
				Color = EDGE,
			})
		end
		cursor = cursor * CFrame.new(0, segLen, 0) * CFrame.Angles(bend, 0, 0)
	end
	-- Kissaki: the wedge's high edge sits on the spine side, so the point curves like a real tip.
	PartKit.wedge({
		Name = "Kissaki",
		Parent = parent,
		CFrame = cursor * CFrame.new(0, 0.18 * s, 0),
		Size = Vector3.new(0.07 * s, 0.36 * s, width),
		Color = STEEL,
		Material = Enum.Material.Metal,
		Reflectance = 0.15,
	})
	return handle
end

function Katana.buildModel(parent: Instance?, h: CFrame, scale: number, detail: string): Model
	local model = PartKit.model("Katana", parent)
	local handle = Katana.buildParts(model, h, scale, detail)
	model.PrimaryPart = handle
	return model
end

function Katana.buildTool(): Tool
	local tool = Instance.new("Tool")
	tool.Name = "Katana"
	tool.ToolTip = "Yuta's katana - click to slash"
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	-- With an identity-rotation grip the handle's +Y points up while the arm is raised,
	-- so the blade stands upright in the default tool pose.
	tool.Grip = CFrame.new(0, -0.2, 0)

	local handle = Katana.buildParts(tool, CFrame.identity, 1, "full")
	for _, d in tool:GetChildren() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.Massless = true
			if d ~= handle then
				PartKit.weld(handle, d)
			end
		end
	end

	-- Swing trail along the blade, switched on by the server during slashes.
	local base = Instance.new("Attachment")
	base.Name = "BladeBase"
	base.Position = Vector3.new(0, 0.95, 0)
	base.Parent = handle
	local tip = Instance.new("Attachment")
	tip.Name = "BladeTip"
	tip.Position = Vector3.new(0, 4.2, 0.22)
	tip.Parent = handle
	local trail = Instance.new("Trail")
	trail.Name = "SwingTrail"
	trail.Attachment0 = base
	trail.Attachment1 = tip
	trail.Lifetime = 0.16
	trail.LightEmission = 1
	trail.FaceCamera = false
	trail.Color = ColorSequence.new(Palette.YutaCore, Palette.YutaEnergy)
	trail.Transparency = NumberSequence.new(0.15, 1)
	trail.Enabled = false
	trail.Parent = handle

	-- Faint cursed energy wisps on the blade.
	local aura = Instance.new("Attachment")
	aura.Name = "Aura"
	aura.Position = Vector3.new(0, 2.6, 0.1)
	aura.Parent = handle
	PartKit.emitter(aura, {
		Name = "CursedWisps",
		Texture = PartKit.Textures.Sparkle,
		Color = ColorSequence.new(Palette.YutaEnergy),
		LightEmission = 1,
		Size = NumberSequence.new(0.25, 0),
		Transparency = NumberSequence.new(0.3, 1),
		Lifetime = NumberRange.new(0.3, 0.6),
		Rate = 8,
		Speed = NumberRange.new(0.5, 1.5),
		SpreadAngle = Vector2.new(180, 180),
	})
	return tool
end

return Katana
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Mahoraga</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Eight-Handled Sword Divergent Sila Divine General Mahoraga.

	A 29-stud rig built from parts: Motor6D joints so the client can animate it,
	the eight-handled Dharma wheel floating above its head (its adaptation wheel),
	two pairs of head wings over the eyes, and the Sword of Extermination fused to
	its right forearm.

	Built anchored and facing -Z with `cf` as the ground point under its feet.
	The server unanchors it when the fight starts.
]]

local PartKit = require(script.Parent.PartKit)
local Palette = require(script.Parent.Parent.Palette)

local Mahoraga = {}

Mahoraga.HipHeight = 10.7 -- bottom of HumanoidRootPart above the ground
Mahoraga.RootHeight = 13.2 -- centre of HumanoidRootPart above the ground
Mahoraga.HitRadius = 5.5
Mahoraga.HitHalfHeight = 14

local SKIN = Color3.fromRGB(231, 227, 219)
local SHADE = Color3.fromRGB(212, 205, 196)
local LIPS = Color3.fromRGB(118, 42, 48)
local WING = Color3.fromRGB(247, 246, 242)
local CLOTH = Color3.fromRGB(238, 236, 228)
local CLOTH_FOLD = Color3.fromRGB(214, 211, 202)
local ROPE = Color3.fromRGB(70, 58, 50)
local BLADE = Color3.fromRGB(214, 218, 228)
local GUARD = Color3.fromRGB(150, 118, 64)

type Limb = { name: string, center: Vector3, size: Vector3 }
type Joint = { name: string, part0: string, part1: string, pivot: Vector3 }

local LIMBS: { Limb } = {
	{ name = "LowerTorso", center = Vector3.new(0, 13.0, 0), size = Vector3.new(5.2, 2.8, 3.4) },
	{ name = "UpperTorso", center = Vector3.new(0, 17.5, 0), size = Vector3.new(6.8, 6.2, 3.8) },
	{ name = "Head", center = Vector3.new(0, 23.1, -0.2), size = Vector3.new(2.8, 3.2, 3.0) },
	{ name = "RightUpperArm", center = Vector3.new(4.55, 16.9, 0), size = Vector3.new(2.1, 5.6, 2.1) },
	{ name = "RightLowerArm", center = Vector3.new(4.6, 12.0, 0), size = Vector3.new(1.8, 4.8, 1.8) },
	{ name = "RightHand", center = Vector3.new(4.6, 8.7, -0.1), size = Vector3.new(1.5, 1.9, 1.2) },
	{ name = "LeftUpperArm", center = Vector3.new(-4.55, 16.9, 0), size = Vector3.new(2.1, 5.6, 2.1) },
	{ name = "LeftLowerArm", center = Vector3.new(-4.6, 12.0, 0), size = Vector3.new(1.8, 4.8, 1.8) },
	{ name = "LeftHand", center = Vector3.new(-4.6, 8.7, -0.1), size = Vector3.new(1.5, 1.9, 1.2) },
	{ name = "RightUpperLeg", center = Vector3.new(1.75, 9.3, 0), size = Vector3.new(2.5, 5.8, 2.5) },
	{ name = "RightLowerLeg", center = Vector3.new(1.8, 3.8, 0), size = Vector3.new(2.0, 5.2, 2.0) },
	{ name = "RightFoot", center = Vector3.new(1.8, 0.5, -0.5), size = Vector3.new(1.9, 1.0, 3.2) },
	{ name = "LeftUpperLeg", center = Vector3.new(-1.75, 9.3, 0), size = Vector3.new(2.5, 5.8, 2.5) },
	{ name = "LeftLowerLeg", center = Vector3.new(-1.8, 3.8, 0), size = Vector3.new(2.0, 5.2, 2.0) },
	{ name = "LeftFoot", center = Vector3.new(-1.8, 0.5, -0.5), size = Vector3.new(1.9, 1.0, 3.2) },
}

local JOINTS: { Joint } = {
	{ name = "Root", part0 = "HumanoidRootPart", part1 = "LowerTorso", pivot = Vector3.new(0, 13.0, 0) },
	{ name = "Waist", part0 = "LowerTorso", part1 = "UpperTorso", pivot = Vector3.new(0, 14.4, 0) },
	{ name = "Neck", part0 = "UpperTorso", part1 = "Head", pivot = Vector3.new(0, 21.2, -0.1) },
	{ name = "RightShoulder", part0 = "UpperTorso", part1 = "RightUpperArm", pivot = Vector3.new(4.4, 19.6, 0) },
	{ name = "RightElbow", part0 = "RightUpperArm", part1 = "RightLowerArm", pivot = Vector3.new(4.6, 14.3, 0) },
	{ name = "RightWrist", part0 = "RightLowerArm", part1 = "RightHand", pivot = Vector3.new(4.6, 9.6, -0.05) },
	{ name = "LeftShoulder", part0 = "UpperTorso", part1 = "LeftUpperArm", pivot = Vector3.new(-4.4, 19.6, 0) },
	{ name = "LeftElbow", part0 = "LeftUpperArm", part1 = "LeftLowerArm", pivot = Vector3.new(-4.6, 14.3, 0) },
	{ name = "LeftWrist", part0 = "LeftLowerArm", part1 = "LeftHand", pivot = Vector3.new(-4.6, 9.6, -0.05) },
	{ name = "RightHip", part0 = "LowerTorso", part1 = "RightUpperLeg", pivot = Vector3.new(1.75, 12.1, 0) },
	{ name = "RightKnee", part0 = "RightUpperLeg", part1 = "RightLowerLeg", pivot = Vector3.new(1.8, 6.4, 0) },
	{ name = "RightAnkle", part0 = "RightLowerLeg", part1 = "RightFoot", pivot = Vector3.new(1.8, 1.1, 0) },
	{ name = "LeftHip", part0 = "LowerTorso", part1 = "LeftUpperLeg", pivot = Vector3.new(-1.75, 12.1, 0) },
	{ name = "LeftKnee", part0 = "LeftUpperLeg", part1 = "LeftLowerLeg", pivot = Vector3.new(-1.8, 6.4, 0) },
	{ name = "LeftAnkle", part0 = "LeftLowerLeg", part1 = "LeftFoot", pivot = Vector3.new(-1.8, 1.1, 0) },
	{ name = "Wheel", part0 = "Head", part1 = "WheelCore", pivot = Vector3.new(0, 28.6, 0.2) },
}

Mahoraga.JointNames = {} :: { string }
for _, j in JOINTS do
	table.insert(Mahoraga.JointNames, j.name)
end

-- Adds a welded decoration to `limb`.
local function deco(limb: BasePart, props: PartKit.Props, ellipsoid: boolean?): Part
	props.Parent = limb.Parent
	local p = if ellipsoid then PartKit.ellipsoid(props) else PartKit.part(props)
	PartKit.weld(limb, p)
	return p
end

local function decoSegment(limb: BasePart, props: PartKit.Props, a: Vector3, b: Vector3, thickness: number, depth: number?): Part
	props.Parent = limb.Parent
	local p = PartKit.segment(props, a, b, thickness, depth)
	PartKit.weld(limb, p)
	return p
end

function Mahoraga.build(cf: CFrame): Model
	local model = PartKit.model("Mahoraga")
	local function at(v: Vector3): CFrame
		return cf * CFrame.new(v)
	end
	local function pt(x: number, y: number, z: number): Vector3
		return cf * Vector3.new(x, y, z)
	end

	local parts: { [string]: Part } = {}
	local hrp = PartKit.part({
		Name = "HumanoidRootPart",
		Parent = model,
		CFrame = at(Vector3.new(0, Mahoraga.RootHeight, 0)),
		Size = Vector3.new(5.4, 5, 3.4),
		Transparency = 1,
		CanCollide = true,
	})
	hrp.CustomPhysicalProperties = PhysicalProperties.new(100, 0.3, 0.5)
	parts.HumanoidRootPart = hrp
	model.PrimaryPart = hrp

	for _, limb in LIMBS do
		parts[limb.name] = PartKit.part({
			Name = limb.name,
			Parent = model,
			CFrame = at(limb.center),
			Size = limb.size,
			Color = SKIN,
		})
	end
	-- Round every limb core so the body reads as muscle rather than boxes (feet stay blocky).
	for _, name in {
		"UpperTorso",
		"LowerTorso",
		"RightUpperArm",
		"LeftUpperArm",
		"RightLowerArm",
		"LeftLowerArm",
		"RightHand",
		"LeftHand",
		"RightUpperLeg",
		"LeftUpperLeg",
		"RightLowerLeg",
		"LeftLowerLeg",
	} do
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = parts[name]
	end
	parts.Head.Transparency = 1

	parts.WheelCore = PartKit.part({
		Name = "WheelCore",
		Parent = model,
		CFrame = at(Vector3.new(0, 28.6, 0.2)),
		Size = Vector3.new(1, 1, 1),
		Transparency = 1,
	})

	-- Torso musculature ----------------------------------------------------------
	-- V-shaped torso: broad ribcage, narrow waist, defined pecs and a six-pack.
	local chest = parts.UpperTorso
	chest.Size = Vector3.new(6.2, 5.2, 3.5)
	deco(chest, { Name = "Ribcage", CFrame = at(Vector3.new(0, 18.4, 0.1)), Size = Vector3.new(7.0, 4.0, 3.7), Color = SKIN }, true)
	deco(chest, { Name = "Waist", CFrame = at(Vector3.new(0, 15.6, 0.1)), Size = Vector3.new(4.6, 3.6, 3.0), Color = SKIN }, true)
	for _, side in { -1, 1 } do
		deco(chest, {
			Name = "Pec",
			CFrame = at(Vector3.new(side * 1.6, 18.75, -1.55)) * CFrame.Angles(0, math.rad(side * -14), 0),
			Size = Vector3.new(3.1, 2.0, 1.0),
			Color = SHADE,
		}, true)
		deco(chest, { Name = "Lat", CFrame = at(Vector3.new(side * 2.85, 17.4, 0.35)), Size = Vector3.new(1.3, 3.8, 2.6), Color = SKIN }, true)
		deco(chest, { Name = "Oblique", CFrame = at(Vector3.new(side * 1.85, 15.4, -0.9)), Size = Vector3.new(1.0, 2.4, 1.4), Color = SHADE }, true)
		for row, y in { 16.95, 16.05, 15.2 } do
			deco(chest, {
				Name = "Ab",
				CFrame = at(Vector3.new(side * 0.55, y, -1.42 + row * 0.03)),
				Size = Vector3.new(0.95, 0.72, 0.4),
				Color = SHADE,
			}, true)
		end
	end
	deco(chest, { Name = "Traps", CFrame = at(Vector3.new(0, 20.35, 0.45)), Size = Vector3.new(4.2, 1.4, 2.4), Color = SKIN }, true)
	deco(chest, { Name = "NeckMuscle", CFrame = at(Vector3.new(0, 21.0, -0.1)), Size = Vector3.new(1.9, 2.0, 1.9), Color = SKIN }, true)

	-- Head: jaw, lips, nose, and two pairs of wings covering the eyes -------------
	local head = parts.Head
	deco(head, { Name = "Skull", CFrame = at(Vector3.new(0, 23.4, -0.15)), Size = Vector3.new(2.7, 3.0, 2.9), Color = SKIN }, true)
	deco(head, { Name = "Jaw", CFrame = at(Vector3.new(0, 22.3, -0.55)), Size = Vector3.new(2.3, 1.8, 2.3), Color = SKIN }, true)
	deco(head, { Name = "Lips", CFrame = at(Vector3.new(0, 22.05, -1.62)), Size = Vector3.new(1.0, 0.32, 0.3), Color = LIPS }, true)
	local nose = PartKit.wedge({
		Name = "Nose",
		Parent = model,
		CFrame = at(Vector3.new(0, 22.85, -1.55)),
		Size = Vector3.new(0.35, 0.7, 0.45),
		Color = SHADE,
	})
	PartKit.weld(head, nose)
	deco(head, { Name = "WingBand", CFrame = at(Vector3.new(0, 23.45, -1.0)), Size = Vector3.new(2.95, 0.8, 1.3), Color = WING }, true)
	for _, side in { -1, 1 } do
		local eyeRoot = pt(side * 1.25, 23.45, -0.9)
		for k = 0, 2 do
			decoSegment(head, { Name = "EyeWing", Color = WING }, eyeRoot, eyeRoot + cf.Rotation * Vector3.new(side * (2.3 - k * 0.3), 0.35 + k * 0.4, 0.9 + k * 0.35), 0.2, 0.62 - k * 0.1)
		end
		local topRoot = pt(side * 0.85, 24.6, -0.1)
		for k = 0, 2 do
			decoSegment(head, { Name = "CrownWing", Color = WING }, topRoot, topRoot + cf.Rotation * Vector3.new(side * (1.1 + k * 0.35), 1.5 + k * 0.25, 0.7 + k * 0.3), 0.18, 0.55 - k * 0.1)
		end
	end

	-- Arms -------------------------------------------------------------------------
	for _, side in { -1, 1 } do
		local prefix = if side > 0 then "Right" else "Left"
		local upper = parts[prefix .. "UpperArm"]
		local lower = parts[prefix .. "LowerArm"]
		local hand = parts[prefix .. "Hand"]
		deco(upper, { Name = "Deltoid", CFrame = at(Vector3.new(side * 4.4, 19.25, 0)), Size = Vector3.new(2.6, 2.4, 2.5), Color = SKIN }, true)
		deco(upper, { Name = "Bicep", CFrame = at(Vector3.new(side * 4.5, 17.0, -0.4)), Size = Vector3.new(1.8, 2.9, 1.5), Color = SHADE }, true)
		deco(upper, { Name = "Tricep", CFrame = at(Vector3.new(side * 4.6, 17.2, 0.45)), Size = Vector3.new(1.7, 3.3, 1.4), Color = SKIN }, true)
		deco(lower, { Name = "Forearm", CFrame = at(Vector3.new(side * 4.6, 12.9, 0)), Size = Vector3.new(2.0, 3.0, 1.9), Color = SKIN }, true)
		deco(lower, { Name = "Wrist", CFrame = at(Vector3.new(side * 4.6, 10.1, 0)), Size = Vector3.new(1.5, 1.6, 1.5), Color = SKIN }, true)
		for f = 0, 3 do
			deco(hand, {
				Name = "Finger",
				CFrame = at(Vector3.new(side * (4.6 + (f - 1.5) * 0.36), 7.5, -0.2)),
				Size = Vector3.new(0.34, 1.2, 0.45),
				Color = SKIN,
			}, true)
		end
		deco(hand, { Name = "Thumb", CFrame = at(Vector3.new(side * 3.95, 8.3, -0.45)) * CFrame.Angles(0, 0, math.rad(side * -25)), Size = Vector3.new(0.36, 0.9, 0.42), Color = SKIN })
	end

	-- Sword of Extermination fused to the right forearm. Its edge carries positive energy.
	local swordArm = parts.RightLowerArm
	local guard = PartKit.cylinderY({ Name = "SwordGuard", Parent = model, CFrame = at(Vector3.new(4.6, 10.6, -0.2)), Color = GUARD, Material = Enum.Material.Metal }, 0.9, 2.3)
	PartKit.weld(swordArm, guard)
	local bladeTop = 11.2
	local bladeBottom = 1.6
	local segs = 3
	local segLen = (bladeTop - bladeBottom) / segs
	for i = 1, segs do
		local y = bladeTop - segLen * (i - 0.5)
		local width = 1.25 - i * 0.09
		deco(swordArm, {
			Name = "Blade",
			CFrame = at(Vector3.new(4.6, y, -1.35)),
			Size = Vector3.new(0.3, segLen * 1.02, width),
			Color = BLADE,
			Material = Enum.Material.Metal,
			Reflectance = 0.2,
		})
		deco(swordArm, {
			Name = "SwordEdge",
			CFrame = at(Vector3.new(4.6, y, -1.35 - width / 2 - 0.06)),
			Size = Vector3.new(0.14, segLen * 1.02, 0.14),
			Color = Palette.Positive,
			Material = Enum.Material.Neon,
		})
		deco(swordArm, {
			Name = "Fuller",
			CFrame = at(Vector3.new(4.6, y, -1.25)),
			Size = Vector3.new(0.34, segLen * 0.9, 0.12),
			Color = Color3.fromRGB(120, 124, 136),
			Material = Enum.Material.Metal,
		})
	end
	local tip = PartKit.wedge({
		Name = "SwordTip",
		Parent = model,
		CFrame = at(Vector3.new(4.6, bladeBottom - 0.6, -1.35)) * CFrame.Angles(math.rad(180), 0, 0),
		Size = Vector3.new(0.3, 1.2, 0.98),
		Color = BLADE,
		Material = Enum.Material.Metal,
	})
	PartKit.weld(swordArm, tip)
	local glow = Instance.new("Attachment")
	glow.Name = "SwordGlow"
	glow.Position = swordArm.CFrame:PointToObjectSpace(pt(4.6, 6.5, -1.4))
	glow.Parent = swordArm
	PartKit.light(glow, Palette.Positive, 14, 1.5)

	-- Legs, loincloth skirt and rope belt ---------------------------------------------
	for _, side in { -1, 1 } do
		local prefix = if side > 0 then "Right" else "Left"
		deco(parts[prefix .. "UpperLeg"], { Name = "Quad", CFrame = at(Vector3.new(side * 1.75, 9.6, -0.4)), Size = Vector3.new(2.6, 5.2, 2.2), Color = SHADE }, true)
		deco(parts[prefix .. "LowerLeg"], { Name = "Calf", CFrame = at(Vector3.new(side * 1.8, 4.3, 0.4)), Size = Vector3.new(1.9, 3.4, 1.9), Color = SKIN }, true)
		for t = 0, 3 do
			deco(parts[prefix .. "Foot"], {
				Name = "Toe",
				CFrame = at(Vector3.new(side * (1.8 + (t - 1.5) * 0.42), 0.3, -2.1)),
				Size = Vector3.new(0.38, 0.55, 0.6),
				Color = SKIN,
			}, true)
		end
	end
	local pelvis = parts.LowerTorso
	for _, seg in PartKit.ring(model, at(Vector3.new(0, 14.3, 0)), 2.95, 0.5, 0.6, 16, { Color = ROPE, Material = Enum.Material.Fabric }) do
		PartKit.weld(pelvis, seg)
	end
	deco(pelvis, { Name = "Knot", CFrame = at(Vector3.new(0, 14.1, -3.1)), Size = Vector3.new(1.1, 0.9, 0.7), Color = ROPE, Material = Enum.Material.Fabric }, true)
	for _, side in { -1, 1 } do
		decoSegment(pelvis, { Name = "RopeEnd", Color = ROPE, Material = Enum.Material.Fabric }, pt(side * 0.45, 13.7, -3.25), pt(side * 0.55, 10.4, -3.45), 0.28)
	end
	-- Knee-length loincloth: tiled panels flaring gently from the belt, plus a front flap.
	local panels = 16
	for i = 1, panels do
		local a = (i - 0.5) / panels * math.pi * 2
		local dir = Vector3.new(math.sin(a), 0, math.cos(a))
		local top = pt(0, 14.0, 0) + cf.Rotation * (dir * 2.75)
		local bottom = pt(0, 6.4, 0) + cf.Rotation * (dir * 3.45)
		decoSegment(pelvis, {
			Name = "Skirt",
			Color = if i % 2 == 0 then CLOTH else CLOTH_FOLD,
			Material = Enum.Material.Fabric,
		}, top, bottom, 1.5, 0.25)
	end
	decoSegment(pelvis, { Name = "Flap", Color = CLOTH, Material = Enum.Material.Fabric }, pt(0, 13.9, -3.05), pt(0, 5.4, -3.9), 2.4, 0.2)

	-- The Dharma wheel: rim, eight spokes and eight handles -------------------------
	local wheel = parts.WheelCore
	local wheelCF = wheel.CFrame
	local wheelStyle = { Color = Palette.Wheel, Material = Enum.Material.Metal }
	local hub = PartKit.cylinderY({ Name = "Hub", Parent = model, CFrame = wheelCF, Color = Palette.Wheel, Material = Enum.Material.Metal }, 0.7, 1.7)
	PartKit.weld(wheel, hub)
	for _, seg in PartKit.ring(model, wheelCF, 3.6, 0.45, 0.55, 24, wheelStyle) do
		seg.Name = "Rim"
		PartKit.weld(wheel, seg)
	end
	for _, seg in PartKit.ring(model, wheelCF, 2.1, 0.22, 0.3, 16, wheelStyle) do
		seg.Name = "InnerRim"
		PartKit.weld(wheel, seg)
	end
	for _, seg in PartKit.ring(model, wheelCF, 3.6, 0.7, 0.75, 24, { Color = Palette.Positive, Material = Enum.Material.Neon, Transparency = 1 }) do
		seg.Name = "WheelGlow"
		PartKit.weld(wheel, seg)
	end
	for k = 0, 7 do
		local spin = wheelCF * CFrame.Angles(0, k * math.pi / 4, 0)
		deco(wheel, { Name = "Spoke", CFrame = spin * CFrame.new(0, 0, -2.2), Size = Vector3.new(0.34, 0.34, 2.9), Color = Palette.Wheel, Material = Enum.Material.Metal })
		deco(wheel, { Name = "Handle", CFrame = spin * CFrame.new(0, 0, -4.45), Size = Vector3.new(0.3, 0.3, 1.3), Color = Palette.Wheel, Material = Enum.Material.Metal })
		local knob = PartKit.ball(model, spin * CFrame.new(0, 0, -5.25), 0.62, wheelStyle, "Knob")
		PartKit.weld(wheel, knob)
	end

	-- Joints ---------------------------------------------------------------------------
	for _, j in JOINTS do
		local p0 = parts[j.part0]
		local p1 = parts[j.part1]
		local pivot = at(j.pivot)
		local motor = Instance.new("Motor6D")
		motor.Name = j.name
		motor.Part0 = p0
		motor.Part1 = p1
		motor.C0 = p0.CFrame:Inverse() * pivot
		motor.C1 = p1.CFrame:Inverse() * pivot
		motor.Parent = p1
	end

	-- Physics: only the root collides; everything else is visual and massless.
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= hrp then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
		end
	end

	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = Mahoraga.HipHeight
	humanoid.AutomaticScalingEnabled = false
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.WalkSpeed = 19
	humanoid.Parent = model

	model:SetAttribute("JJK_HitRadius", Mahoraga.HitRadius)
	model:SetAttribute("JJK_HitHalfHeight", Mahoraga.HitHalfHeight)
	return model
end

-- Just the wheel, for previews and the summon effect.
function Mahoraga.buildWheel(parent: Instance?, cf: CFrame, scale: number): Model
	local model = PartKit.model("DharmaWheel", parent)
	local style = { Color = Palette.Wheel, Material = Enum.Material.Metal }
	local hub = PartKit.cylinderY({ Name = "Hub", Parent = model, CFrame = cf, Color = Palette.Wheel, Material = Enum.Material.Metal }, 0.7 * scale, 1.7 * scale)
	model.PrimaryPart = hub
	PartKit.ring(model, cf, 3.6 * scale, 0.45 * scale, 0.55 * scale, 24, style)
	PartKit.ring(model, cf, 2.1 * scale, 0.22 * scale, 0.3 * scale, 16, style)
	for k = 0, 7 do
		local spin = cf * CFrame.Angles(0, k * math.pi / 4, 0)
		PartKit.part({ Name = "Spoke", Parent = model, CFrame = spin * CFrame.new(0, 0, -2.2 * scale), Size = Vector3.new(0.34, 0.34, 2.9) * scale, Color = Palette.Wheel, Material = Enum.Material.Metal })
		PartKit.part({ Name = "Handle", Parent = model, CFrame = spin * CFrame.new(0, 0, -4.45 * scale), Size = Vector3.new(0.3, 0.3, 1.3) * scale, Color = Palette.Wheel, Material = Enum.Material.Metal })
		PartKit.ball(model, spin * CFrame.new(0, 0, -5.25 * scale), 0.62 * scale, style, "Knob")
	end
	return model
end

return Mahoraga
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">PartKit</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Procedural part helpers. Every model and effect in this kit is built from
	plain Roblox parts at runtime, so there are no meshes to upload and no asset
	ids that can break.

	All builders only construct instances (no services, no tweens), which lets
	tools/preview render them outside Roblox.
]]

local PartKit = {}

export type Props = {
	Name: string?,
	Parent: Instance?,
	CFrame: CFrame?,
	Size: Vector3?,
	Color: Color3?,
	Material: Enum.Material?,
	Transparency: number?,
	Reflectance: number?,
	Shape: Enum.PartType?,
	Anchored: boolean?,
	CanCollide: boolean?,
	CastShadow: boolean?,
}

export type Style = {
	Color: Color3?,
	Material: Enum.Material?,
	Transparency: number?,
}

PartKit.Textures = {
	Sparkle = "rbxasset://textures/particles/sparkles_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Fire = "rbxasset://textures/particles/fire_main.dds",
	Spark = "rbxasset://textures/particles/fire_sparks_main.dds",
	Glow = "rbxasset://textures/particles/forcefield_glow_main.dds",
}

local function apply(p: BasePart, props: Props)
	p.Anchored = if props.Anchored == nil then true else props.Anchored
	p.CanCollide = props.CanCollide == true
	if not p.CanCollide then
		p.CanQuery = false
		p.CanTouch = false
	end
	p.CastShadow = props.CastShadow == true
	p.Material = props.Material or Enum.Material.SmoothPlastic
	p.Color = props.Color or Color3.new(1, 1, 1)
	p.Transparency = props.Transparency or 0
	p.Reflectance = props.Reflectance or 0
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = props.Size or Vector3.one
	p.CFrame = props.CFrame or CFrame.identity
	p.Name = props.Name or p.ClassName
	if props.Parent then
		p.Parent = props.Parent
	end
end

function PartKit.part(props: Props): Part
	local p = Instance.new("Part")
	if props.Shape then
		p.Shape = props.Shape
	end
	apply(p, props)
	return p
end

function PartKit.wedge(props: Props): WedgePart
	local p = Instance.new("WedgePart")
	apply(p, props)
	return p
end

function PartKit.ball(parent: Instance?, cf: CFrame, diameter: number, style: Style, name: string?): Part
	return PartKit.part({
		Name = name or "Ball",
		Parent = parent,
		CFrame = cf,
		Size = Vector3.new(diameter, diameter, diameter),
		Shape = Enum.PartType.Ball,
		Color = style.Color,
		Material = style.Material,
		Transparency = style.Transparency,
	})
end

-- A block with a sphere SpecialMesh, which renders as an ellipsoid filling the part's size.
function PartKit.ellipsoid(props: Props): Part
	local p = PartKit.part(props)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

-- Roblox cylinders run along X; this one runs along cf's Y axis.
function PartKit.cylinderY(props: Props, height: number, diameter: number): Part
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(height, diameter, diameter)
	props.CFrame = (props.CFrame or CFrame.identity) * CFrame.Angles(0, 0, math.rad(90))
	return PartKit.part(props)
end

-- Cylinder running along cf's look (-Z) axis, centred on cf.
function PartKit.cylinderZ(props: Props, length: number, diameter: number): Part
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(length, diameter, diameter)
	props.CFrame = (props.CFrame or CFrame.identity) * CFrame.Angles(0, math.rad(90), 0)
	return PartKit.part(props)
end

-- CFrame.lookAt that survives looking straight up or down.
function PartKit.lookAt(from: Vector3, to: Vector3): CFrame
	local dir = to - from
	if dir.Magnitude < 1e-5 then
		return CFrame.new(from)
	end
	local up = Vector3.new(0, 1, 0)
	if math.abs(dir.Unit:Dot(up)) > 0.995 then
		up = Vector3.new(0, 0, 1)
	end
	return CFrame.lookAt(from, to, up)
end

-- Block stretched from a to b (its Z axis runs along the segment).
function PartKit.segment(props: Props, a: Vector3, b: Vector3, thickness: number, depth: number?): Part
	local len = (b - a).Magnitude
	props.CFrame = PartKit.lookAt((a + b) / 2, b)
	props.Size = Vector3.new(thickness, depth or thickness, math.max(len, 0.05))
	return PartKit.part(props)
end

-- Rounded limb from a to b (ellipsoid that overlaps its joints slightly).
function PartKit.limb(props: Props, a: Vector3, b: Vector3, thickness: number, depth: number?): Part
	local len = (b - a).Magnitude
	props.CFrame = PartKit.lookAt((a + b) / 2, b)
	props.Size = Vector3.new(thickness, depth or thickness, len + thickness * 0.5)
	return PartKit.ellipsoid(props)
end

-- Cylinder from a to b with rounded ends, for organic limbs and fingers. Returns the body.
function PartKit.capsule(props: Props, a: Vector3, b: Vector3, diameter: number): Part
	local style = { Color = props.Color, Material = props.Material, Transparency = props.Transparency }
	local len = (b - a).Magnitude
	props.Shape = Enum.PartType.Cylinder
	props.CFrame = PartKit.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.rad(90), 0)
	props.Size = Vector3.new(math.max(len, 0.05), diameter, diameter)
	local body = PartKit.part(props)
	PartKit.ball(props.Parent, CFrame.new(a), diameter, style, "Cap")
	PartKit.ball(props.Parent, CFrame.new(b), diameter, style, "Cap")
	return body
end

-- Flat ring lying in cf's XZ plane.
function PartKit.ring(
	parent: Instance?,
	cf: CFrame,
	radius: number,
	thickness: number,
	height: number,
	segments: number,
	style: Style
): { Part }
	local list = {}
	local segLen = 2 * math.pi * radius / segments * 1.04
	for i = 1, segments do
		local a = (i - 0.5) / segments * math.pi * 2
		list[i] = PartKit.part({
			Name = "RingSeg",
			Parent = parent,
			CFrame = cf * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -radius),
			Size = Vector3.new(segLen, height, thickness),
			Color = style.Color,
			Material = style.Material,
			Transparency = style.Transparency,
		})
	end
	return list
end

-- Crescent in cf's XZ plane around cf's -Z axis; swells in the middle like a sword arc.
-- Segment 1 sits on the right (+X) end.
function PartKit.crescent(
	parent: Instance?,
	cf: CFrame,
	radius: number,
	arcDegrees: number,
	maxThickness: number,
	height: number,
	segments: number,
	style: Style
): { Part }
	local list = {}
	local arc = math.rad(arcDegrees)
	local segLen = radius * arc / segments * 1.1
	for i = 1, segments do
		local t = (i - 0.5) / segments
		local a = -arc / 2 + arc * t
		local thick = math.max(0.06, maxThickness * math.sin(math.pi * t) ^ 0.7)
		list[i] = PartKit.part({
			Name = "ArcSeg",
			Parent = parent,
			CFrame = cf * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -(radius + thick * 0.5)),
			Size = Vector3.new(segLen, height, thick),
			Color = style.Color,
			Material = style.Material,
			Transparency = style.Transparency,
		})
	end
	return list
end

function PartKit.model(name: string, parent: Instance?): Model
	local m = Instance.new("Model")
	m.Name = name
	if parent then
		m.Parent = parent
	end
	return m
end

function PartKit.weld(a: BasePart, b: BasePart): WeldConstraint
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
	return w
end

-- Turns an anchored build into one physics assembly welded to `root`.
function PartKit.weldAllTo(container: Instance, root: BasePart)
	for _, d in container:GetDescendants() do
		if d:IsA("BasePart") and d ~= root then
			PartKit.weld(root, d)
			d.Anchored = false
			d.Massless = true
			d.CanCollide = false
		end
	end
	root.Anchored = false
end

function PartKit.light(parent: Instance, color: Color3, range: number, brightness: number): PointLight
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = parent
	return l
end

function PartKit.emitter(parent: Instance, props: { [string]: any }): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	for k, v in props do
		(e :: any)[k] = v
	end
	e.Parent = parent
	return e
end

-- Screen-facing text floating over `adornee`. Size is in studs.
function PartKit.billboardText(
	adornee: BasePart,
	text: string,
	width: number,
	height: number,
	color: Color3,
	stroke: Color3?
): (BillboardGui, TextLabel)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Text"
	gui.Size = UDim2.new(width, 0, height, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Adornee = adornee
	gui.Parent = adornee
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 1, 0)
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.GothamBlack
	label.TextColor3 = color
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = stroke or Color3.new(0, 0, 0)
	label.Parent = gui
	return gui, label
end

return PartKit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Rika</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Rika Orimoto, Queen of Curses, as Yuta's fully manifested cursed spirit.

	Built as three anchored sub-models so the client can animate her:
	  Body      pivot = chest centre, facing -Z
	  LeftArm   pivot = left shoulder (arm hangs along -Y)
	  RightArm  pivot = right shoulder
]]

local PartKit = require(script.Parent.PartKit)
local Palette = require(script.Parent.Parent.Palette)

local Rika = {}

local SKIN = Palette.RikaSkin
local SKIN_DARK = Color3.fromRGB(150, 142, 166)
local TAIL = Color3.fromRGB(96, 70, 120)
local HAIR = Color3.fromRGB(26, 20, 36)
local MOUTH = Color3.fromRGB(34, 8, 20)
local TOOTH = Color3.fromRGB(244, 240, 230)
local EYE = Color3.fromRGB(10, 8, 14)
local CLAW = Color3.fromRGB(22, 14, 28)

-- Shoulder pivots relative to the body pivot (multiply by scale).
Rika.Shoulders = {
	Left = Vector3.new(-3.1, 1.3, 0.2),
	Right = Vector3.new(3.1, 1.3, 0.2),
}

-- side: -1 = left arm, 1 = right arm.
function Rika.buildArm(parent: Instance?, pivot: CFrame, side: number, scale: number): Model
	local s = scale
	local arm = PartKit.model(if side < 0 then "LeftArm" else "RightArm", parent)
	local root = PartKit.part({
		Name = "Pivot",
		Parent = arm,
		CFrame = pivot,
		Size = Vector3.new(0.4, 0.4, 0.4) * s,
		Transparency = 1,
	})
	arm.PrimaryPart = root

	local function pt(x: number, y: number, z: number): Vector3
		return pivot * (Vector3.new(x, y, z) * s)
	end
	local function dir(x: number, y: number, z: number): Vector3
		return pivot.Rotation * (Vector3.new(x, y, z) * s)
	end

	local shoulder = pt(0, 0, 0)
	local elbow = pt(side * 0.55, -4.6, 0.3)
	local wrist = pt(side * 0.7, -8.8, -0.4)

	PartKit.ellipsoid({ Name = "Deltoid", Parent = arm, CFrame = CFrame.new(shoulder), Size = Vector3.new(2.4, 2.3, 2.3) * s, Color = SKIN })
	PartKit.limb({ Name = "UpperArm", Parent = arm, Color = SKIN }, shoulder, elbow, 1.75 * s)
	PartKit.ball(arm, CFrame.new(elbow), 1.45 * s, { Color = SKIN_DARK }, "Elbow")
	PartKit.limb({ Name = "Forearm", Parent = arm, Color = SKIN }, elbow, wrist, 1.6 * s)
	PartKit.ball(arm, CFrame.new(wrist), 1.2 * s, { Color = SKIN }, "Wrist")

	-- Huge hand with long black claws; fingers curl forward (-Z).
	local palm = wrist + dir(0, -1.3, -0.3)
	PartKit.ellipsoid({ Name = "Palm", Parent = arm, CFrame = CFrame.new(palm) * pivot.Rotation, Size = Vector3.new(2.7, 2.9, 1.2) * s, Color = SKIN })
	for i, fx in { -0.9, -0.3, 0.3, 0.9 } do
		local len = if i == 2 or i == 3 then 1.0 else 0.85
		local base = palm + dir(side * 0 + fx, -1.3, -0.1)
		local knuckle = base + dir(0, -1.6 * len, -0.35)
		local tipBase = knuckle + dir(0, -1.3 * len, -0.7)
		local tip = tipBase + dir(0, -0.9 * len, -1.3)
		PartKit.limb({ Name = "Finger", Parent = arm, Color = SKIN }, base, knuckle, 0.62 * s)
		PartKit.ball(arm, CFrame.new(knuckle), 0.5 * s, { Color = SKIN_DARK }, "Knuckle")
		PartKit.limb({ Name = "Finger", Parent = arm, Color = SKIN }, knuckle, tipBase, 0.52 * s)
		PartKit.limb({ Name = "Claw", Parent = arm, Color = CLAW, Material = Enum.Material.Glass }, tipBase, tip, 0.34 * s)
	end
	local thumbBase = palm + dir(-side * 1.2, -0.4, -0.3)
	local thumbMid = thumbBase + dir(-side * 0.8, -1.1, -0.6)
	local thumbTip = thumbMid + dir(-side * 0.3, -0.8, -1.0)
	PartKit.limb({ Name = "Thumb", Parent = arm, Color = SKIN }, thumbBase, thumbMid, 0.66 * s)
	PartKit.limb({ Name = "Claw", Parent = arm, Color = CLAW, Material = Enum.Material.Glass }, thumbMid, thumbTip, 0.36 * s)
	return arm
end

function Rika.build(parent: Instance?, cf: CFrame, scale: number): Model
	local s = scale
	local model = PartKit.model("Rika", parent)
	local body = PartKit.model("Body", model)
	local root = PartKit.part({
		Name = "Pivot",
		Parent = body,
		CFrame = cf,
		Size = Vector3.new(0.5, 0.5, 0.5) * s,
		Transparency = 1,
	})
	body.PrimaryPart = root
	model.PrimaryPart = root

	local function at(x: number, y: number, z: number): CFrame
		return cf * CFrame.new(x * s, y * s, z * s)
	end
	local function pt(x: number, y: number, z: number): Vector3
		return cf * (Vector3.new(x, y, z) * s)
	end

	-- Torso
	PartKit.ellipsoid({ Name = "Chest", Parent = body, CFrame = at(0, 0, 0), Size = Vector3.new(5.9, 5.1, 4.1) * s, Color = SKIN })
	PartKit.ellipsoid({ Name = "Traps", Parent = body, CFrame = at(0, 1.8, 0.3), Size = Vector3.new(7.0, 2.3, 3.3) * s, Color = SKIN })
	PartKit.ellipsoid({ Name = "Back", Parent = body, CFrame = at(0, 0.3, 1.1), Size = Vector3.new(5.2, 4.8, 2.6) * s, Color = SKIN_DARK })
	PartKit.ellipsoid({ Name = "Belly", Parent = body, CFrame = at(0, -2.7, 0.3), Size = Vector3.new(4.9, 4.2, 3.7) * s, Color = SKIN })
	PartKit.part({ Name = "Sternum", Parent = body, CFrame = at(0, 0.1, -1.86), Size = Vector3.new(0.18, 2.6, 0.2) * s, Color = SKIN_DARK })
	for _, y in { 0.9, 0.05, -0.8 } do
		for _, side in { -1, 1 } do
			PartKit.part({
				Name = "Rib",
				Parent = body,
				CFrame = at(side * 1.25, y, -1.78) * CFrame.Angles(0, 0, math.rad(side * -14)),
				Size = Vector3.new(1.7, 0.16, 0.25) * s,
				Color = SKIN_DARK,
			})
		end
	end

	-- Wispy tail instead of legs; she floats.
	local tail = {
		{ at = Vector3.new(0, -5.0, 0.9), size = Vector3.new(3.9, 3.6, 3.1), color = SKIN_DARK, fade = 0 },
		{ at = Vector3.new(0, -6.9, 1.9), size = Vector3.new(2.8, 3.2, 2.4), color = TAIL, fade = 0.05 },
		{ at = Vector3.new(0, -8.6, 3.0), size = Vector3.new(1.9, 2.8, 1.8), color = TAIL, fade = 0.2 },
		{ at = Vector3.new(0, -10.1, 4.2), size = Vector3.new(1.1, 2.2, 1.1), color = TAIL, fade = 0.4 },
	}
	local tailEnd: Part? = nil
	for i, t in tail do
		tailEnd = PartKit.ellipsoid({
			Name = "Tail" .. i,
			Parent = body,
			CFrame = at(t.at.X, t.at.Y, t.at.Z),
			Size = t.size * s,
			Color = t.color,
			Transparency = t.fade,
		})
	end

	-- Head
	PartKit.ellipsoid({ Name = "Neck", Parent = body, CFrame = at(0, 3.0, -0.2), Size = Vector3.new(2.6, 2.4, 2.6) * s, Color = SKIN })
	local hd = at(0, 5.3, -0.7) * CFrame.Angles(math.rad(-8), 0, 0)
	local function h(x: number, y: number, z: number): CFrame
		return hd * CFrame.new(x * s, y * s, z * s)
	end
	PartKit.ellipsoid({ Name = "Head", Parent = body, CFrame = hd, Size = Vector3.new(5.6, 5.0, 4.8) * s, Color = SKIN })
	PartKit.ellipsoid({ Name = "Brow", Parent = body, CFrame = h(0, 1.55, -1.75), Size = Vector3.new(4.4, 0.75, 1.3) * s, Color = SKIN_DARK })
	for _, side in { -1, 1 } do
		PartKit.ellipsoid({ Name = "Eye", Parent = body, CFrame = h(side * 1.25, 0.75, -2.15), Size = Vector3.new(1.4, 1.8, 0.8) * s, Color = EYE, Reflectance = 0.3 })
		PartKit.ball(body, h(side * 1.2, 0.95, -2.55), 0.3 * s, { Color = Palette.White, Material = Enum.Material.Neon }, "Pupil")
		PartKit.ellipsoid({ Name = "Cheek", Parent = body, CFrame = h(side * 2.2, -0.6, -1.4), Size = Vector3.new(1.4, 1.8, 1.6) * s, Color = SKIN })
	end

	-- The grin: dark mouth, lips and two rows of teeth.
	PartKit.ellipsoid({ Name = "Mouth", Parent = body, CFrame = h(0, -1.05, -2.1), Size = Vector3.new(4.1, 1.6, 1.0) * s, Color = MOUTH })
	PartKit.ellipsoid({ Name = "UpperLip", Parent = body, CFrame = h(0, -0.3, -2.2), Size = Vector3.new(4.4, 0.5, 0.9) * s, Color = SKIN })
	PartKit.ellipsoid({ Name = "LowerLip", Parent = body, CFrame = h(0, -1.8, -2.15), Size = Vector3.new(3.9, 0.55, 0.9) * s, Color = SKIN })
	for i = 1, 9 do
		PartKit.part({
			Name = "Tooth",
			Parent = body,
			CFrame = h(-1.6 + (i - 1) * 0.4, -0.58, -2.55) * CFrame.Angles(0, 0, math.rad(45)),
			Size = Vector3.new(0.3, 0.3, 0.14) * s,
			Color = TOOTH,
		})
	end
	for i = 1, 8 do
		PartKit.part({
			Name = "Tooth",
			Parent = body,
			CFrame = h(-1.4 + (i - 1) * 0.4, -1.52, -2.5) * CFrame.Angles(0, 0, math.rad(45)),
			Size = Vector3.new(0.3, 0.3, 0.14) * s,
			Color = TOOTH,
		})
	end

	-- Crown of horns.
	for _, x in { -1.6, -0.8, 0, 0.8, 1.6 } do
		PartKit.limb({ Name = "Horn", Parent = body, Color = SKIN_DARK }, pt(x, 7.3, -0.8), pt(x * 1.3, 8.9 - 0.25 * math.abs(x), -0.4), 0.45 * s)
	end

	-- Long strands of hair flowing down her back.
	for i = 1, 14 do
		local a = math.rad(-120 + (i - 1) * (240 / 13))
		local root0 = pt(math.sin(a) * 2.3, 7.0 - 0.3 * math.abs(math.sin(a)), -0.2 + math.cos(a) * 1.8)
		local p1 = root0 + cf.Rotation * (Vector3.new(math.sin(a) * 0.9, -2.2, 1.1) * s)
		local p2 = p1 + cf.Rotation * (Vector3.new(math.sin(a) * 0.5, -2.6, 0.8) * s)
		local p3 = p2 + cf.Rotation * (Vector3.new(math.sin(a) * 0.3, -2.4, 0.5) * s)
		PartKit.limb({ Name = "Hair", Parent = body, Color = HAIR }, root0, p1, 0.6 * s)
		PartKit.limb({ Name = "Hair", Parent = body, Color = HAIR }, p1, p2, 0.48 * s)
		PartKit.limb({ Name = "Hair", Parent = body, Color = HAIR }, p2, p3, 0.32 * s)
	end

	PartKit.light(root, Palette.RikaAura, 22 * s, 2)
	if tailEnd then
		PartKit.emitter(tailEnd, {
			Name = "CurseSmoke",
			Texture = PartKit.Textures.Smoke,
			Color = ColorSequence.new(Palette.YutaDark, Palette.RikaAura),
			LightEmission = 0.3,
			Size = NumberSequence.new(2 * s, 4 * s),
			Transparency = NumberSequence.new(0.5, 1),
			Lifetime = NumberRange.new(0.8, 1.4),
			Rate = 14,
			Speed = NumberRange.new(1, 3),
			SpreadAngle = Vector2.new(40, 40),
			Acceleration = Vector3.new(0, -2, 0),
		})
	end

	for _, side in { -1, 1 } do
		local offset = if side < 0 then Rika.Shoulders.Left else Rika.Shoulders.Right
		Rika.buildArm(model, cf * CFrame.new(offset * s), side, s)
	end
	return model
end

return Rika
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">SixEyesLook</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Yuta after copying Kenjaku's technique and moving into Gojo Satoru's body:
	white hair, glowing Six Eyes, and the stitched scar across the forehead.
	`visual` is the visible size of the head (R6 heads are meshes smaller than their part).
]]

local PartKit = require(script.Parent.PartKit)
local Palette = require(script.Parent.Parent.Palette)

local SixEyesLook = {}

local HAIR = Color3.fromRGB(222, 228, 240)
local STITCH = Color3.fromRGB(58, 30, 36)

function SixEyesLook.build(head: BasePart, visual: Vector3): Model
	local m = PartKit.model("JJK_SixEyesLook")
	local hc = head.CFrame
	local w, h, d = visual.X, visual.Y, visual.Z
	local function at(x: number, y: number, z: number): CFrame
		return hc * CFrame.new(x * w, y * h, z * d)
	end
	local function off(x: number, y: number, z: number): Vector3
		return hc.Rotation * Vector3.new(x * w, y * h, z * d)
	end

	PartKit.ellipsoid({ Name = "HairCap", Parent = m, CFrame = at(0, 0.3, 0.05), Size = Vector3.new(w * 1.06, h * 0.58, d * 1.08), Color = HAIR })
	-- Gojo's spiky white hair: two rings of thin spikes swept up and back.
	for ring = 0, 1 do
		local count = if ring == 0 then 14 else 9
		for i = 1, count do
			local a = math.rad(-160 + (i - 1) * (320 / (count - 1)))
			local lift = 0.4 + ring * 0.14
			local spread = 0.44 - ring * 0.16
			local root = at(math.sin(a) * spread, lift, math.cos(a) * spread * 0.9 + 0.04).Position
			local tip = root + off(math.sin(a) * (0.3 - ring * 0.1), 0.34 + 0.1 * math.cos(i * 1.9) + ring * 0.08, math.cos(a) * 0.26 + 0.14)
			PartKit.limb({ Name = "Spike", Parent = m, Color = HAIR }, root, tip, (0.11 - ring * 0.015) * w)
		end
	end
	for _, x in { -0.3, -0.15, 0, 0.15, 0.3 } do
		local root = at(x, 0.5, -0.3).Position
		PartKit.limb({ Name = "Bang", Parent = m, Color = HAIR }, root, root + off(x * 0.35, -0.1, -0.26), 0.12 * w)
	end
	for _, side in { -1, 1 } do
		PartKit.part({
			Name = "SixEye",
			Parent = m,
			CFrame = at(side * 0.19, 0.05, -0.505),
			Size = Vector3.new(0.11 * w, 0.045 * h, 0.02 * d),
			Color = Palette.SixEyes,
			Material = Enum.Material.Neon,
		})
	end
	-- Kenjaku's stitches across the forehead.
	PartKit.part({ Name = "Stitch", Parent = m, CFrame = at(0, 0.21, -0.505), Size = Vector3.new(0.8 * w, 0.025 * h, 0.015 * d), Color = STITCH })
	for k = -3, 3 do
		PartKit.part({ Name = "StitchMark", Parent = m, CFrame = at(k * 0.1, 0.21, -0.51), Size = Vector3.new(0.018 * w, 0.09 * h, 0.015 * d), Color = STITCH })
	end

	for _, d2 in m:GetDescendants() do
		if d2:IsA("BasePart") then
			d2.Anchored = false
			d2.Massless = true
			PartKit.weld(head, d2)
		end
	end
	return m
end

return SixEyesLook
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Yuta Okkotsu vs Mahoraga: every tunable number lives here.

	Canon notes:
	  * Rika's full manifestation and the copied Kenjaku technique (moving into
	    Gojo's body) are both limited to 5 minutes in the manga. Durations here are
	    shorter so the fight stays fast; set them to 300 for manga-accurate timers.
	  * Mahoraga adapts to anything that hits it. Each wheel turn is one step of
	    adaptation; four turns means it is fully adapted (immune) to that technique.
]]

local Config = {}

Config.World = {
	BuildArena = true, -- build the shrine arena, altar and spawn at runtime (turn off to use your own map)
	SetupLighting = true, -- sunset lighting + bloom so the neon effects glow
	ArenaCenter = Vector3.new(0, 0, 0), -- top surface of the arena floor
	ArenaSize = 520,
	SpawnDummies = true, -- cursed-spirit training dummies to test moves on
	DummyCount = 3,
	-- Used when BuildArena is false: where the altar and boss go.
	AltarPosition = Vector3.new(0, 0, -150),
	BossSpawnPosition = Vector3.new(0, 0, -60),
}

Config.Rules = {
	PvP = false, -- true lets players damage each other with the kit
	AutoSummonDelay = 25, -- seconds after the first player spawns; 0 disables auto-summon
}

Config.Player = {
	MaxHealth = 300,
	WalkSpeed = 20,
	BlockWalkSpeed = 9,
	CastWalkSpeed = 5,
	JumpPower = 50,
	JumpHeight = 7.2,
	BlockReduction = 0.55, -- blocking removes 55% of blockable damage
	DashDistance = 32,
	DashTime = 0.22,
	DashIFrames = 0.28, -- dash gives a short dodge window
}

Config.Yuta = {
	RikaDamageBonus = 1.25, -- all damage x1.25 while Rika is fully manifested

	Katana = {
		Damage = { 10, 10, 12, 20 },
		Interval = 0.3,
		FinisherLag = 0.8,
		ComboReset = 1.2,
		Reach = 9,
	},
	Dash = { Cooldown = 2.2 },
	RikaStrike = { Cooldown = 7, Damage = 38, Windup = 0.42 },
	DontMove = { Cooldown = 12, Damage = 8, Radius = 34, Stun = 1.6, BossStun = 1.3, Backlash = 5 },
	BlastAway = { Cooldown = 10, Damage = 34, Range = 32, ConeDegrees = 80, Knockback = 90, Backlash = 7 },
	RCT = { Cooldown = 22, SelfHeal = 0.32, AllyHeal = 0.18, AllyRadius = 24, Duration = 2 },
	FullManifestation = {
		Cooldown = 45,
		Duration = 60, -- canon: 300
		ClawDamage = 22,
		ClawInterval = 2.2,
		ClawRange = 45,
		Protection = 0.25, -- Rika absorbs 25% of incoming damage
	},
	PureLove = { Cooldown = 25, Charge = 1.35, Length = 180, Width = 14, Ticks = 6, TickInterval = 0.18, TickDamage = 42 },
	Domain = {
		Cooldown = 75,
		CastTime = 1.6,
		Duration = 14,
		Radius = 62,
		TickInterval = 1.1,
		CooldownMultiplier = 0.6, -- copied techniques come back faster inside the domain
		SwordDamage = 24,
		SpeechDamage = 10,
		SpeechStun = 0.7,
		RikaDamage = 30,
	},
	SixEyes = {
		Cooldown = 110,
		CastTime = 1.4,
		Duration = 45, -- canon: 300
		InfinityReduction = 0.85, -- Infinity stops 85% of damage until Mahoraga adapts to it
		CooldownMultiplier = 0.7, -- Six Eyes efficiency
	},
	Blue = { Cooldown = 6, Range = 70, Radius = 16, Duration = 1.6, TickInterval = 0.2, TickDamage = 7, Pull = 38 },
	Red = { Cooldown = 8, Speed = 150, Range = 95, HitRadius = 5, BlastRadius = 15, Damage = 75, Knockback = 110 },
	HollowPurple = { Cooldown = 30, Charge = 1.6, Speed = 115, Range = 230, Radius = 9, Damage = 300 },
}

Config.Boss = {
	Title = "Eight-Handled Sword Divergent Sila Divine General",
	Name = "Mahoraga",
	Kanji = "八握剣異戒神将魔虚羅",
	BaseHealth = 7500,
	HealthPerExtraPlayer = 4000,
	WalkSpeed = 19,
	EnragedWalkSpeed = 25,
	RespawnCooldown = 12,
	SummonTime = 3.2,

	-- No instant kills: a single Mahoraga hit can never deal more than this share
	-- of a player's max health, and each hit grants a short immunity window.
	MaxHitFraction = 0.25,
	HitInvulnerability = 0.45,

	Damage = {
		Sweep = 80,
		Cleave = 95,
		Punch = 30,
		Stomp = 55,
		Leap = 70,
		Rush = 60,
		Ring = 35,
	},
	Cooldowns = {
		Sweep = 4,
		Punch = 3,
		Stomp = 6,
		Cleave = 5,
		Rush = 7,
		Leap = 8,
		Rings = 14,
	},
	AttackGap = { 0.7, 0.4, 0.3 }, -- pause between attacks per phase
	WindupScale = { 1, 0.85, 0.72 }, -- telegraph length multiplier per phase
	EnrageAt = 0.5, -- phase 2 below 50% health
	FinalPhaseAt = 0.2, -- phase 3 below 20% health
}

Config.Adaptation = {
	MaxLevel = 4, -- four turns of the wheel = fully adapted
	ResistPerLevel = 0.25, -- 25% less damage from that technique per turn
	HealPerTurn = 0.015, -- Mahoraga regenerates when it adapts
	CastsPerTurn = {
		Default = 3,
		Katana = 6,
		Domain = 4,
		Infinity = 2,
	},
	-- Short labels for the boss bar's adaptation chips.
	ShortNames = {
		Katana = "Katana",
		Rika = "Rika",
		CursedSpeech = "Cursed Speech",
		PureLove = "Pure Love",
		Domain = "Domain",
		Blue = "Blue",
		Red = "Red",
		HollowPurple = "Purple",
		Infinity = "Infinity",
	},
	DisplayNames = {
		Katana = "Katana",
		Rika = "Rika",
		CursedSpeech = "Cursed Speech",
		PureLove = "Pure Love Beam",
		Domain = "Authentic Mutual Love",
		Blue = "Lapse: Blue",
		Red = "Reversal: Red",
		HollowPurple = "Hollow Purple",
		Infinity = "Infinity",
	},
}

--[[
	Sounds. The three katana sounds ship with Roblox. For the big techniques paste
	any audio id you like from the Creator Store, e.g. "rbxassetid://1234567890".
	Empty strings are skipped.
]]
Config.Sounds = {
	Slash = { Id = "rbxasset://sounds/swordslash.wav", Volume = 0.6, Speed = 1.1 },
	Lunge = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 0.7, Speed = 1 },
	Unsheath = { Id = "rbxasset://sounds/unsheath.wav", Volume = 0.6, Speed = 1 },
	WheelTurn = { Id = "rbxasset://sounds/unsheath.wav", Volume = 1, Speed = 0.42 },
	BossSlash = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 1, Speed = 0.55 },
	Impact = { Id = "", Volume = 1, Speed = 1 },
	Beam = { Id = "", Volume = 1, Speed = 1 },
	Speech = { Id = "", Volume = 1, Speed = 1 },
	Domain = { Id = "", Volume = 1, Speed = 1 },
	Blue = { Id = "", Volume = 1, Speed = 1 },
	Red = { Id = "", Volume = 1, Speed = 1 },
	Purple = { Id = "", Volume = 1, Speed = 1 },
	Summon = { Id = "", Volume = 1, Speed = 1 },
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--!strict
-- RemoteEvents are created by the server at runtime, so the kit also works when
-- the scripts are copied into a game by hand (no Rojo needed).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "JJK_Remotes"

local Net = {}

local function getFolder(): Instance
	if RunService:IsServer() then
		local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if existing then
			return existing
		end
		local folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = ReplicatedStorage
		return folder
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME)
end

function Net.event(name: string): RemoteEvent
	local folder = getFolder()
	if RunService:IsServer() then
		local existing = folder:FindFirstChild(name)
		if existing and existing:IsA("RemoteEvent") then
			return existing
		end
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
		return remote
	end
	return folder:WaitForChild(name) :: RemoteEvent
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
